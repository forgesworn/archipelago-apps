[Unit]
Description=Bounded public Spry credential issuer
After=network.target spry-public-credentials.service

[Service]
User=spry-issuer
Group=spry-issuer
ExecStart=/opt/archipelago/spry-public-issuer/spry-public-issuer /var/lib/spry-public-issuer/credentials /var/lib/spry-public-issuer/runtime/cursor demo.forgesworn.dev
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET
CapabilityBoundingSet=
ReadWritePaths=/var/lib/spry-public-issuer/runtime
InaccessiblePaths=/var/lib/archipelago/secrets /run/user/1000
MemoryMax=24M
CPUQuota=10%
TasksMax=8
LimitNOFILE=32
UMask=0077
StandardOutput=null

[Install]
WantedBy=multi-user.target
