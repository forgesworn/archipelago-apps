ARCHY_RELEASE=v1.9.0-alpha
ARCHY_REF=7abd04a7f680e72105ae783cecbe2268e3c8e71b
# SHA-256 of the ARCHY_RELEASE frontend asset node/install-lite.sh installs:
# releases/download/${ARCHY_RELEASE}/archipelago-frontend-${ARCHY_RELEASE#v}.tar.gz
FRONTEND_SHA256=6d5135fa8e79b1bc84c8ed972770ebf99fe6611d819e5c1453f38f1593c26e66
