# Hash-pinned fallback for the two directories retained from the upstream
# frontend asset. This p6 bundle was produced from the same ARCHY_RELEASE and
# preserves aiui/ and archipelago-runtime/ byte-for-byte.
FRONTEND_FALLBACK_URL=https://github.com/forgesworn/archipelago-apps/releases/download/frontend-v1.9.0-alpha-p6/frontend.tar.gz
FRONTEND_FALLBACK_SHA256=3215f29a08f2f38a75526c33adaf7d2d6426be758203f31ecf02d7990ea71ab0
