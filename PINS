WILDBLOOM_NODE_REF=2ea211e78e0bcd2624d6e4bc17031456c0742cef
# Packaging revisions: bump when the image changes without an upstream pin change.
# The node never re-pulls an existing tag, so every image change needs a new tag.
WILDBLOOM_PKG_REV=1
WILDBLOOM_NODE_PKG_REV=1
# Bumped whenever upstream/patches changes; names the backend release asset.
BACKEND_PATCH_LEVEL=1
# Frontend build: bumped whenever upstream/patches or the build recipe changes;
# names the frontend release asset. Node major matches archy's own CI (ci.yml NODE_VERSION).
FRONTEND_PATCH_LEVEL=1
FRONTEND_NODE_MAJOR=20
