# Pinned inputs. Sourced by scripts and CI. Change deliberately, one pin per commit.
ARCHY_REPO=https://source.archipelago-foundation.org/lfg2025/archy.git
ARCHY_RELEASE=v2.1.0-beta.2
ARCHY_REF=5aac0d20571e6f673b8a5df95a5c8fcab2932c39
# SHA-256 of the ARCHY_RELEASE frontend asset node/install-lite.sh installs:
# releases/download/${ARCHY_RELEASE}/archipelago-frontend-${ARCHY_RELEASE#v}.tar.gz
FRONTEND_SHA256=c2ef014b5ce3c660c5c0f09a552202923d1425e63610a4976745b50bd5340195
# Optional hash-pinned fallback for upstream built runtime assets.
# Leave disabled unless it is proven to retain the exact upstream runtime;
# a patched ForgeSworn beta frontend is not an unmodified upstream fallback.
# Leave empty after an ARCHY_RELEASE bump until that release's first bundle is
# published; a build then fails rather than mixing in another release's files.
FRONTEND_FALLBACK_URL=https://github.com/forgesworn/archipelago-apps/releases/download/frontend-base-v2.1.0-beta.2/upstream-archipelago-frontend-2.1.0-beta.2.tar.gz
FRONTEND_FALLBACK_SHA256=c2ef014b5ce3c660c5c0f09a552202923d1425e63610a4976745b50bd5340195
WILDBLOOM_REF=ee21ed5b2590c729e98ca596914640b2dab47089
WILDBLOOM_NODE_REF=b9a7cf48752037fe3588e62ec3a6a12aaebf7ee5
# Packaging revisions: bump when the image changes without an upstream pin change.
# The node never re-pulls an existing tag, so every image change needs a new tag.
WILDBLOOM_PKG_REV=5
WILDBLOOM_NODE_PKG_REV=3
SPRY_REF=6b34f061ab25cac402bfaa833ce6ef95e98d0621
SPRY_PKG_REV=4
# Bumped whenever upstream/patches changes; names the backend release asset.
BACKEND_PATCH_LEVEL=4
# Frontend build: bumped whenever upstream/patches or the build recipe changes;
# names the frontend release asset. Beta's locked Vitest/vue-i18n require newer
# Node than upstream's stale Node 20 CI setting; use the qualified Node 24 line.
FRONTEND_PATCH_LEVEL=4
FRONTEND_NODE_MAJOR=24
# Ingle (game hosting on a Keep: Stampede and Twang rooms on one port): hand-loaded into the node's podman, not built or pushed by CI.
# Bump to the new build's tag whenever the image changes: the node never re-pulls a tag it has.
INGLE_TAG=k2-2
