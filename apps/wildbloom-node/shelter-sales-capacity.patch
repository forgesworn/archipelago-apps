+
+    /// New-customer capacity bounded by both store commitments and seller allocation.
+    /// Both reads use one SQLite snapshot. This observation reserves nothing.
+    pub fn remaining_paid_sale_capacity(&self, max_paid_bytes: u64) -> Result<u64, StoreError> {
+        let ceiling = as_i64(max_paid_bytes)? as u64;
+        let mut db = self.connection()?;
+        let tx = db.transaction()?;
+        let now = unix_time()?;
+        let sold = paid_capacity_claimed(&tx, now)? as u64;
+        let committed = committed_usage(&tx, now)? as u64;
+        Ok(ceiling
+            .saturating_sub(sold)
+            .min(self.quota_bytes().saturating_sub(committed)))
+    }
+}
+
+fn paid_capacity_claimed(db: &Connection, now: i64) -> Result<i64, StoreError> {
+    Ok(db.query_row(
+        "SELECT COALESCE((SELECT SUM(capacity) FROM paid_allowances a
+                WHERE retains > ?1 OR EXISTS (SELECT 1 FROM paid_sales s
+                    WHERE s.renews=a.id AND s.activated IS NULL AND s.expires > ?1)),0)
+             + COALESCE((SELECT SUM(capacity) FROM paid_sales
+                WHERE activated IS NULL AND expires > ?1 AND renews IS NULL),0)",
+        [now],
+        |row| row.get(0),
+    )?)
 }

