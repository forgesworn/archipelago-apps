+
+#[test]
+fn packaged_paid_discovery_respects_seller_ceiling_without_exposing_it() {
+    let temp = tempfile::tempdir().unwrap();
+    let s = store(temp.path());
+    // Total quota is 1000, offer is 600, seller allocation only 500.
+    let c = checkout(s.clone(), temp.path())
+        .with_sales_capacity(Some(500))
+        .unwrap();
+    let svc = services(profile(), s.clone(), Some(c), false).unwrap();
+    let d = svc.snapshot(1, false).unwrap();
+    assert_eq!(d.services[0].availability(), Availability::Full);
+    let value = serde_json::to_value(d).unwrap();
+    assert!(!value.to_string().contains("max_paid_bytes"));
+    assert!(!value.to_string().contains("owner_reserved_bytes"));
+    drop(svc);
+    let c = checkout(s.clone(), temp.path())
+        .with_sales_capacity(Some(600))
+        .unwrap();
+    let svc = services(profile(), s.clone(), Some(c), false).unwrap();
+    assert_eq!(
+        svc.snapshot(2, false).unwrap().services[0].availability(),
+        Availability::Accepting
+    );
+    let hold = PaidSale {
+        order_id: "ceiling-held".into(),
+        signer_pubkey: keys(2).public_key().to_hex(),
+        capacity_bytes: 1,
+        duration_seconds: 600,
+        grace_seconds: 60,
+        hold_expires_at: now().unwrap() + 600,
+        renews: None,
+    };
+    s.reserve_paid_sale_with_ceiling(&hold, 600).unwrap();
+    assert_eq!(
+        svc.snapshot(3, false).unwrap().services[0].availability(),
+        Availability::Full
+    );
+}
