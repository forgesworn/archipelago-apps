diff --git a/neode-ui/src/views/settings/StorageRefund.vue b/neode-ui/src/views/settings/StorageRefund.vue
new file mode 100644
index 0000000..57ce5fc
--- /dev/null
+++ b/neode-ui/src/views/settings/StorageRefund.vue
@@ -0,0 +1,35 @@
+<script setup lang="ts">
+import { computed, ref } from 'vue'
+import { rpcClient } from '@/api/rpc-client'
+const props = defineProps<{ orderId: string; priceMsat: number }>()
+const emit = defineEmits<{ recorded: [] }>()
+const open = ref(false), busy = ref(false), confirmed = ref(false), hash = ref(''), error = ref('')
+const valid = computed(() => confirmed.value && /^[0-9a-f]{64}$/.test(hash.value.trim().toLowerCase()))
+async function record() {
+  if (busy.value || !valid.value) return
+  busy.value = true; error.value = ''
+  try {
+    await rpcClient.call({ method: 'wildbloom.storage.record-refund', params: { order_id: props.orderId,
+      amount_msat: props.priceMsat, payment_hash: hash.value.trim().toLowerCase(), confirm_received: confirmed.value }, maxRetries: 1 })
+    hash.value = ''; confirmed.value = false; open.value = false; emit('recorded')
+  } catch { error.value = 'The refund record could not be verified. Refresh the sales page before retrying. No money was sent.' }
+  finally { busy.value = false }
+}
+</script>
+<template>
+  <div class="border-t border-white/10 pt-3 text-sm">
+    <button v-if="!open" class="glass-button rounded-lg px-3 py-2" @click="open = true">Record completed refund</button>
+    <form v-else class="space-y-4" @submit.prevent="record">
+      <h3 class="font-semibold">Record a completed refund · {{ (priceMsat / 1000).toLocaleString() }} sats</h3>
+      <p class="text-white/70">Send the refund directly from your own wallet first and confirm receipt. This saves your record of a full refund; it does not send money or revoke the customer’s storage.</p>
+      <label class="block">Refund payment hash
+        <input v-model="hash" type="text" autocomplete="off" spellcheck="false" maxlength="64" :disabled="busy" class="mt-2 w-full rounded-lg border border-white/20 bg-black/20 p-3 font-mono text-xs" placeholder="64 hexadecimal characters" required>
+      </label>
+      <p class="text-xs text-white/60">Use the payment hash from the completed refund, not the original purchase. Do not paste an invoice, note or secret.</p>
+      <label class="flex items-start gap-3"><input v-model="confirmed" type="checkbox" :disabled="busy" class="mt-1"><span>I have confirmed that the customer received the full {{ (priceMsat / 1000).toLocaleString() }}-sat refund.</span></label>
+      <p v-if="error" role="alert" class="text-red-200">{{ error }}</p>
+      <div class="flex flex-wrap gap-3"><button type="submit" :disabled="busy || !valid" class="glass-button rounded-lg px-4 py-2 disabled:opacity-40">{{ busy ? 'Saving…' : 'Save refund record' }}</button>
+      <button type="button" :disabled="busy" class="rounded-lg px-4 py-2" @click="open = false; hash = ''; confirmed = false; error = ''">Cancel</button></div>
+    </form>
+  </div>
+</template>
