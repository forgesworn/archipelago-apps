+import { flushPromises, mount } from '@vue/test-utils'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+vi.mock('@/api/rpc-client', () => ({ rpcClient: { call: vi.fn() } }))
+import { rpcClient } from '@/api/rpc-client'
+import StorageRefund from '../StorageRefund.vue'
+const rpc = vi.mocked(rpcClient.call)
+const page = () => mount(StorageRefund, { props: { orderId: 'order-a', priceMsat: 50000 } })
+describe('Operator refund record', () => {
+  beforeEach(() => { rpc.mockReset(); rpc.mockResolvedValue({ status: 'recorded' }) })
+  it('makes no request until the operator opens, enters a hash and confirms receipt', async () => {
+    const w = page(); expect(rpc).not.toHaveBeenCalled()
+    await w.get('button').trigger('click')
+    expect(w.get('button[type=submit]').attributes('disabled')).toBeDefined()
+    await w.get('input[type=text]').setValue('ab'.repeat(32))
+    expect(w.get('button[type=submit]').attributes('disabled')).toBeDefined()
+    await w.get('input[type=checkbox]').setValue(true)
+    await w.get('form').trigger('submit'); await flushPromises()
+    expect(rpc).toHaveBeenCalledTimes(1)
+    expect(rpc).toHaveBeenCalledWith({ method: 'wildbloom.storage.record-refund', params: {
+      order_id: 'order-a', amount_msat: 50000, payment_hash: 'ab'.repeat(32), confirm_received: true }, maxRetries: 1 })
+    expect(w.emitted('recorded')).toHaveLength(1)
+  })
+  it('refuses bearer assets and clears a cancelled form', async () => {
+    const w = page(); await w.get('button').trigger('click')
+    await w.get('input[type=text]').setValue('lnurl-bearer-secret')
+    await w.get('input[type=checkbox]').setValue(true)
+    await w.get('form').trigger('submit'); expect(rpc).not.toHaveBeenCalled()
+    await w.findAll('button').find(b => b.text() === 'Cancel')!.trigger('click')
+    await w.get('button').trigger('click')
+    expect((w.get('input[type=text]').element as HTMLInputElement).value).toBe('')
+  })
+  it('keeps uncertain recording errors distinct from a failed refund', async () => {
+    rpc.mockRejectedValue(new Error('secret backend details'))
+    const w = page(); await w.get('button').trigger('click')
+    await w.get('input[type=text]').setValue('ab'.repeat(32)); await w.get('input[type=checkbox]').setValue(true)
+    await w.get('form').trigger('submit'); await flushPromises()
+    expect(w.get('[role=alert]').text()).toContain('Refresh the sales page before retrying')
+    expect(w.text()).not.toContain('secret backend details'); expect(w.emitted('recorded')).toBeUndefined()
+  })
+})
