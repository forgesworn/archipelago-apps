diff --git a/core/archipelago/src/settings/wildbloom_refunds.rs b/core/archipelago/src/settings/wildbloom_refunds.rs
new file mode 100644
index 0000000..7d02a2d
--- /dev/null
+++ b/core/archipelago/src/settings/wildbloom_refunds.rs
@@ -0,0 +1,229 @@
+//! Private attestations of refunds the operator has already completed elsewhere.
+//! This journal cannot send money or alter checkout/allowance state.
+use super::{wildbloom_sales as sales, wildbloom_storage as storage};
+use anyhow::{ensure, Context, Result};
+use rusqlite::OptionalExtension;
+use serde::{Deserialize, Serialize};
+use std::{collections::BTreeMap, path::Path};
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct Refund {
+    pub order_id: String,
+    pub amount_msat: u64,
+    pub payment_hash: String,
+    pub recorded_at: u64,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Request {
+    pub order_id: String,
+    pub amount_msat: u64,
+    pub payment_hash: String,
+    pub confirm_received: bool,
+}
+fn hash(v: &str) -> bool {
+    v.len() == 64
+        && v.bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+fn valid(r: &Refund) -> bool {
+    sales::id(&r.order_id)
+        && hash(&r.payment_hash)
+        && r.amount_msat > 0
+        && r.amount_msat <= storage::MAX
+        && r.amount_msat % 1000 == 0
+        && r.recorded_at > 0
+        && r.recorded_at <= storage::MAX
+}
+pub fn read(root: &Path) -> Result<BTreeMap<String, Refund>> {
+    let path = root.join("operator/refunds.json");
+    let meta = match std::fs::symlink_metadata(&path) {
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(BTreeMap::new()),
+        other => other?,
+    };
+    use std::os::unix::fs::PermissionsExt;
+    ensure!(
+        meta.is_file() && meta.len() <= 4_000_000 && meta.permissions().mode() & 0o077 == 0,
+        "Invalid refund journal"
+    );
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Journal {
+        version: u8,
+        refunds: Vec<Refund>,
+    }
+    let journal: Journal = serde_json::from_slice(&std::fs::read(path)?)?;
+    ensure!(
+        journal.version == 1 && journal.refunds.len() <= 10000,
+        "Unsupported refund journal"
+    );
+    let mut records = BTreeMap::new();
+    let mut hashes = std::collections::BTreeSet::new();
+    for r in journal.refunds {
+        ensure!(
+            valid(&r) && hashes.insert(r.payment_hash.clone()),
+            "Invalid refund record"
+        );
+        ensure!(
+            records.insert(r.order_id.clone(), r).is_none(),
+            "Duplicate refund record"
+        );
+    }
+    Ok(records)
+}
+/// Caller holds storage::LOCK, including throughout the blocking write.
+pub fn record(root: &Path, request: Request) -> Result<Refund> {
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)?
+        .as_secs();
+    let refund = Refund {
+        order_id: request.order_id,
+        amount_msat: request.amount_msat,
+        payment_hash: request.payment_hash,
+        recorded_at: now,
+    };
+    ensure!(
+        request.confirm_received && valid(&refund),
+        "Confirm the completed refund and enter a valid payment hash"
+    );
+    sales::directory(root)?;
+    let dir = root.join("operator");
+    sales::directory(&dir)?;
+    sales::directory(&dir.join("checkout"))?;
+    let db = sales::open(&dir.join("checkout/checkout.sqlite3"))?;
+    let version: i64 = db.query_row("PRAGMA user_version", [], |r| r.get(0))?;
+    ensure!(version == 1, "Unsupported checkout schema");
+    let (state, quote): (String, String) = db
+        .query_row(
+            "SELECT state,CASE WHEN length(quote)<=65536 THEN quote END FROM orders WHERE id=?1",
+            [&refund.order_id],
+            |r| Ok((r.get(0)?, r.get(1)?)),
+        )
+        .optional()?
+        .context("Order unavailable")?;
+    ensure!(
+        ["active", "refund_required"].contains(&state.as_str()),
+        "Reconcile the payment before recording a refund"
+    );
+    let quote: serde_json::Value = serde_json::from_str(&quote)?;
+    ensure!(
+        quote["order_id"] == refund.order_id
+            && quote["offer"]["price_msat"].as_u64() == Some(refund.amount_msat),
+        "This journal records a full refund of the original storage price"
+    );
+    let mut records = read(root)?;
+    if let Some(existing) = records.get(&refund.order_id) {
+        ensure!(
+            existing.amount_msat == refund.amount_msat
+                && existing.payment_hash == refund.payment_hash,
+            "A different refund is already recorded for this order"
+        );
+        return Ok(existing.clone());
+    }
+    ensure!(
+        records.len() < 10000
+            && !records
+                .values()
+                .any(|r| r.payment_hash == refund.payment_hash),
+        "Refund reference already recorded or journal full"
+    );
+    records.insert(refund.order_id.clone(), refund.clone());
+    let bytes = serde_json::to_vec(
+        &serde_json::json!({"version":1,"refunds":records.values().collect::<Vec<_>>()}),
+    )?;
+    let temp = dir.join(format!("refunds-{}.tmp", uuid::Uuid::new_v4()));
+    storage::write_private(&temp, &bytes)?;
+    std::fs::rename(temp, dir.join("refunds.json"))?;
+    std::fs::File::open(dir)?.sync_all()?;
+    Ok(refund)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::PermissionsExt;
+    fn fixture(state: &str) -> tempfile::TempDir {
+        let d = tempfile::tempdir().unwrap();
+        std::fs::create_dir_all(d.path().join("operator/checkout")).unwrap();
+        let p = d.path().join("operator/checkout/checkout.sqlite3");
+        let db = rusqlite::Connection::open(&p).unwrap();
+        db.execute_batch(
+            "PRAGMA user_version=1; CREATE TABLE orders(id TEXT,state TEXT,quote TEXT)",
+        )
+        .unwrap();
+        for id in ["order-a", "order-b"] {
+            db.execute(
+                "INSERT INTO orders VALUES(?1,?2,?3)",
+                rusqlite::params![
+                    id,
+                    state,
+                    serde_json::json!({"order_id":id,"offer":{"price_msat":50000}}).to_string()
+                ],
+            )
+            .unwrap();
+        }
+        drop(db);
+        std::fs::set_permissions(p, std::fs::Permissions::from_mode(0o600)).unwrap();
+        d
+    }
+    fn request() -> Request {
+        Request {
+            order_id: "order-a".into(),
+            amount_msat: 50000,
+            payment_hash: "ab".repeat(32),
+            confirm_received: true,
+        }
+    }
+    #[test]
+    fn refund_records_are_idempotent_private_and_never_change_checkout() {
+        let d = fixture("refund_required");
+        let p = d.path().join("operator/checkout/checkout.sqlite3");
+        let before = std::fs::read(&p).unwrap();
+        let first = record(d.path(), request()).unwrap();
+        assert_eq!(record(d.path(), request()).unwrap(), first);
+        assert_eq!(read(d.path()).unwrap().len(), 1);
+        assert_eq!(std::fs::read(p).unwrap(), before);
+        let mut other = request();
+        other.payment_hash = "cd".repeat(32);
+        assert!(record(d.path(), other).is_err());
+        let mut other = request();
+        other.order_id = "order-b".into();
+        assert!(record(d.path(), other).is_err());
+    }
+    #[test]
+    fn refunds_refuse_uncertain_orders_partial_amounts_and_missing_confirmation() {
+        for state in [
+            "lnurl_pending",
+            "settled",
+            "awaiting_payment",
+            "quoted",
+            "invoice_pending",
+        ] {
+            let d = fixture(state);
+            assert!(record(d.path(), request()).is_err());
+            assert!(!d.path().join("operator/refunds.json").exists());
+        }
+        let d = fixture("active");
+        let mut r = request();
+        r.amount_msat = 49000;
+        assert!(record(d.path(), r).is_err());
+        let mut r = request();
+        r.confirm_received = false;
+        assert!(record(d.path(), r).is_err());
+        let mut r = request();
+        r.payment_hash = "lnurl-bearer-secret".into();
+        assert!(record(d.path(), r).is_err());
+        record(d.path(), request()).unwrap();
+    }
+    #[test]
+    fn corrupt_or_public_refund_journals_fail_closed() {
+        let d = fixture("active");
+        record(d.path(), request()).unwrap();
+        let p = d.path().join("operator/refunds.json");
+        std::fs::write(&p, "broken").unwrap();
+        assert!(read(d.path()).is_err());
+        std::fs::set_permissions(&p, std::fs::Permissions::from_mode(0o644)).unwrap();
+        assert!(record(d.path(), request()).is_err());
+    }
+}
