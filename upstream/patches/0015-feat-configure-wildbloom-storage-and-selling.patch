+<script setup lang="ts">
+import { computed, onMounted, ref } from 'vue'
+import { RouterLink } from 'vue-router'
+import { rpcClient } from '@/api/rpc-client'
+
+type Settings = {
+  quota_bytes: number; owner_reserved_bytes: number; max_blob_bytes: number
+  offer_capacity_bytes: number; price_sats: number; duration_seconds: number
+  grace_seconds: number; delivery_bytes: number; seller_name: string
+  refund_policy: string; moneyer_ips: string[]; additional_browser_origins: string[]; moneyer_terms_accepted: boolean; sales_enabled: boolean
+}
+type Active = { revision: number; checkout_started: boolean; settings: Settings }
+type Status = {
+  revision: number; settings: Settings; active: Active | null; applied: boolean
+  runtime: { quota_bytes: number; used_bytes: number; committed_bytes: number; settings_revision: number | null; checkout_started: boolean } | null
+  disk: { free_bytes: number; total_bytes: number; headroom_bytes: number } | null
+  has_draft: boolean; can_apply: boolean; external_configuration: boolean; origin: string | null
+}
+type NumberKey = 'quota_bytes' | 'owner_reserved_bytes' | 'max_blob_bytes' | 'offer_capacity_bytes' | 'price_sats' | 'duration_seconds' | 'grace_seconds' | 'delivery_bytes'
+const GiB = 2 ** 30
+const fields: { key: NumberKey; label: string; scale: number; min: number; help?: string }[] = [
+  { key: 'quota_bytes', label: 'Total storage quota (GiB)', scale: GiB, min: 1 / GiB },
+  { key: 'owner_reserved_bytes', label: 'Reserved for you (GiB)', scale: GiB, min: 0, help: 'Customers cannot buy this part of your quota.' },
+  { key: 'max_blob_bytes', label: 'Maximum file size (GiB)', scale: GiB, min: 1 / GiB },
+  { key: 'offer_capacity_bytes', label: 'Storage per customer (GiB)', scale: GiB, min: 1 / GiB },
+  { key: 'price_sats', label: 'Price per term (sats)', scale: 1, min: 1 },
+  { key: 'duration_seconds', label: 'Term (days)', scale: 86400, min: 1 / 86400 },
+  { key: 'grace_seconds', label: 'Recovery grace (days)', scale: 86400, min: 0, help: 'Time to retrieve files after the paid term ends.' },
+  { key: 'delivery_bytes', label: 'Delivery allowance per term (GiB)', scale: GiB, min: 1 / GiB, help: 'Managed by you; downloads are not automatically metered.' },
+]
+const status = ref<Status | null>(null)
+const form = ref<Settings | null>(null)
+const amounts = ref<Partial<Record<NumberKey, number>>>({})
+const pins = ref('')
+const customerApps = ref('')
+const busy = ref(false)
+const error = ref('')
+const message = ref('')
+const review = ref(false)
+const confirmed = ref(false)
+const loadedForm = ref('')
+const currentForm = computed(() => JSON.stringify({ form: form.value, amounts: amounts.value, pins: pins.value, customerApps: customerApps.value }))
+const dirty = computed(() => currentForm.value !== loadedForm.value)
+const saleCapacity = computed(() => Math.max(0, Number(amounts.value.quota_bytes) - Number(amounts.value.owner_reserved_bytes)))
+const usableQuota = computed(() => status.value?.disk && status.value.runtime
+  ? Math.max(0, status.value.disk.free_bytes + status.value.runtime.used_bytes - status.value.disk.headroom_bytes) : null)
+const tooLarge = computed(() => usableQuota.value !== null && Number(amounts.value.quota_bytes) * GiB > usableQuota.value)
+const liveLabel = computed(() => {
+  if (!status.value?.runtime) return 'Node status unavailable'
+  if (status.value.external_configuration) return 'Managed outside the dashboard'
+  if (!status.value.active) return 'Sales off'
+  if (!status.value.applied) return 'Apply pending — running settings not verified'
+  return status.value.active.settings.sales_enabled ? 'Sales enabled' : status.value.active.checkout_started ? 'New sales paused' : 'Sales off'
+})
+const canReview = computed(() => status.value?.has_draft && status.value.can_apply && status.value.runtime && !dirty.value && !tooLarge.value && !busy.value)
+const size = (bytes: number) => `${(bytes / GiB).toLocaleString(undefined, { maximumFractionDigits: 2 })} GiB`
+
+function show(data: Status) {
+  status.value = data
+  form.value = structuredClone(data.settings)
+  amounts.value = Object.fromEntries(fields.map(f => [f.key, data.settings[f.key] / f.scale]))
+  pins.value = data.settings.moneyer_ips.join('\n')
+  customerApps.value = data.settings.additional_browser_origins.join('\n')
+  loadedForm.value = currentForm.value
+  review.value = false; confirmed.value = false
+}
+async function load() {
+  busy.value = true; error.value = ''; message.value = ''
+  try { show(await rpcClient.call<Status>({ method: 'wildbloom.storage.get', maxRetries: 1 })) }
+  catch (e) { error.value = e instanceof Error ? e.message : String(e) }
+  finally { busy.value = false }
+}
+function settings(): Settings {
+  if (!form.value) throw new Error('Load your node settings first.')
+  const result = { ...form.value, moneyer_ips: [...form.value.moneyer_ips] }
+  for (const f of fields) {
+    const raw = amounts.value[f.key]
+    if (typeof raw !== 'number' || !Number.isFinite(raw) || raw < f.min) throw new Error(`Enter a valid value for ${f.label.toLowerCase()}.`)
+    const value = raw * f.scale
+    if (!Number.isSafeInteger(value)) throw new Error(`${f.label} must resolve to a whole number of bytes, seconds or sats.`)
+    result[f.key] = value
+  }
+  result.moneyer_ips = [...new Set(pins.value.split(/[\s,]+/).filter(Boolean))]
+  result.additional_browser_origins = [...new Set(customerApps.value.split(/[\s,]+/).filter(Boolean))]
+  return result
+}
+async function save() {
+  busy.value = true; error.value = ''; message.value = ''; review.value = false
+  try {
+    const draft = settings()
+    const response = await rpcClient.call<{ revision: number }>({ method: 'wildbloom.storage.save', params: { revision: status.value!.revision, settings: draft }, maxRetries: 1 })
+    show({ ...status.value!, revision: response.revision, settings: draft, has_draft: true })
+    message.value = 'Draft saved. Your running node has not changed.'
+  } catch (e) { error.value = e instanceof Error ? e.message : String(e) }
+  finally { busy.value = false }
+}
+async function resolve() {
+  busy.value = true; error.value = ''; review.value = false
+  try {
+    const result = await rpcClient.call<{ addresses: string[] }>({ method: 'wildbloom.storage.resolve-moneyer', maxRetries: 1 })
+    pins.value = result.addresses.join('\n')
+    message.value = 'Moneyer addresses resolved. Save the draft to keep them.'
+  } catch (e) { error.value = e instanceof Error ? e.message : String(e) }
+  finally { busy.value = false }
+}
+async function apply() {
+  if (!confirmed.value || !canReview.value) return
+  busy.value = true; error.value = ''; message.value = ''
+  try {
+    const result = await rpcClient.call<{ status: string; message?: string }>({ method: 'wildbloom.storage.apply', params: { revision: status.value!.revision, confirm_restart: true }, timeout: 120000, maxRetries: 1 })
+    show(await rpcClient.call<Status>({ method: 'wildbloom.storage.get', maxRetries: 1 }))
+    message.value = result.status === 'applied' && status.value?.applied
+      ? 'Settings applied. The node is healthy and running this configuration.'
+      : (result.message || 'Settings saved. Reload status to verify the running node.')
+  } catch (e) {
+    error.value = `${e instanceof Error ? e.message : String(e)} Reload status before retrying; an apply may still be completing.`
+    review.value = false; confirmed.value = false
+  } finally { busy.value = false }
+}
+onMounted(load)
+</script>
+
+<template>
+  <div class="mx-auto max-w-4xl space-y-6 pb-8">
+    <RouterLink to="/dashboard/settings" class="text-sm text-white/70 hover:text-white">← Settings</RouterLink>
+    <header class="flex flex-wrap items-start justify-between gap-4">
+      <div><h1 class="text-2xl font-semibold text-white">Storage &amp; selling</h1>
+        <p class="mt-2 text-sm text-white/65">Your Wildbloom node, your capacity and your prices.</p></div>
+      <button class="glass-button px-4 py-2 rounded-lg" :disabled="busy" @click="load">Reload status</button>
+    </header>
+    <p v-if="error" role="alert" class="rounded-lg border border-red-400/40 bg-red-500/10 p-4 text-red-200">{{ error }}</p>
+    <p v-if="message" role="status" class="rounded-lg border border-emerald-400/30 bg-emerald-500/10 p-4 text-emerald-100">{{ message }}</p>
+    <p v-if="!status && busy" role="status">Loading storage settings…</p>
+    <template v-if="status && form">
+      <section class="glass-card p-6 space-y-4" aria-label="Running node">
+        <div class="flex flex-wrap justify-between gap-2"><h2 class="text-lg font-semibold">Your node</h2><strong>{{ liveLabel }}</strong></div>
+        <p v-if="status.origin" class="break-all text-sm text-white/70">{{ status.origin }}</p>
+        <p v-else class="text-amber-200">Configure a public hostname for this Archipelago before applying storage settings.</p>
+        <dl class="grid grid-cols-2 gap-4 text-sm sm:grid-cols-4">
+          <div><dt class="text-white/60">Current quota</dt><dd class="mt-1 text-lg">{{ status.runtime ? size(status.runtime.quota_bytes) : 'Unavailable' }}</dd></div>
+          <div><dt class="text-white/60">Files stored</dt><dd class="mt-1 text-lg">{{ status.runtime ? size(status.runtime.used_bytes) : 'Unavailable' }}</dd></div>
+          <div><dt class="text-white/60">Disk free</dt><dd class="mt-1 text-lg">{{ status.disk ? size(status.disk.free_bytes) : 'Unavailable' }}</dd></div>
+          <div><dt class="text-white/60">Usable quota now</dt><dd class="mt-1 text-lg">{{ usableQuota !== null ? size(usableQuota) : 'Unavailable' }}</dd></div>
+        </dl>
+        <p class="text-xs text-white/60">Keep at least 5 GiB or 5% of the disk free for Archipelago and other apps. Capacity is checked again when you apply.</p>
+        <p v-if="status.external_configuration" class="text-amber-200 text-sm">This node already has sales configured outside the dashboard. Its receiving state must be migrated before you can apply changes here.</p>
+        <p v-else-if="!status.can_apply || !status.runtime" class="text-amber-200 text-sm">Applying requires a healthy, compatible Wildbloom Node installed through Archipelago. You can still prepare a draft.</p>
+      </section>
+
+      <form class="glass-card p-6 space-y-6" @submit.prevent="save">
+        <fieldset :disabled="busy" class="space-y-6">
+          <legend class="text-lg font-semibold">Storage and offer</legend>
+          <p class="text-sm text-white/65">Start with the suggestions, then set values that suit your node. Existing installations keep their current quota.</p>
+          <div class="grid gap-5 sm:grid-cols-2">
+            <div v-for="field in fields" :key="field.key">
+              <label :for="field.key" class="mb-2 block text-sm font-medium">{{ field.label }}</label>
+              <input :id="field.key" v-model.number="amounts[field.key]" type="number" :min="field.min" :step="field.key === 'price_sats' ? 1 : 'any'" required class="storage-input" :aria-describedby="field.help ? `${field.key}-help` : undefined" @input="review = false" />
+              <p v-if="field.help" :id="`${field.key}-help`" class="mt-2 text-xs text-white/60">{{ field.help }}</p>
+            </div>
+          </div>
+          <p class="rounded-lg bg-white/5 p-3 text-sm">Available for customers: <strong>{{ saleCapacity.toLocaleString() }} GiB</strong> in total, shared across all customer allowances and pending quotes. Stored sizes include encryption overhead.</p>
+          <p v-if="tooLarge" role="alert" class="text-amber-200 text-sm">This quota exceeds usable disk capacity. Reduce it before applying.</p>
+          <p v-if="status.active?.checkout_started" class="text-sm text-white/65">Existing customer promises are preserved. Once selling has begun, this screen cannot reduce total quota or increase your reserved share.</p>
+
+          <div class="border-t border-white/10 pt-6 space-y-4">
+            <h2 class="text-lg font-semibold">Payments and terms</h2>
+            <p class="text-sm text-white/65">Accept LNURLcash issued by moneyer.dev. Payments are received by your node. Review <a href="https://moneyer.dev" target="_blank" rel="noopener noreferrer" class="underline">Moneyer’s terms</a> before enabling sales.</p>
+            <div><label for="seller-name" class="block text-sm mb-2">Seller name</label><input id="seller-name" v-model="form.seller_name" maxlength="128" required class="storage-input" @input="review = false" /></div>
+            <div><label for="refund-policy" class="block text-sm mb-2">Contact and refund terms</label><textarea id="refund-policy" v-model="form.refund_policy" rows="3" maxlength="2048" class="storage-input" placeholder="How customers contact you, and when you offer a refund" @input="review = false" /><p class="mt-2 text-xs text-white/60">Published with your offer. Use a single paragraph.</p></div>
+            <div><label for="customer-apps" class="block text-sm mb-2">Other customer app origins</label><textarea id="customer-apps" v-model="customerApps" rows="2" class="storage-input" placeholder="https://customer-app.example" @input="review = false" /><p class="mt-2 text-xs text-white/60">Your packaged Wildbloom app is already allowed. To accept customers using another web app, add its exact HTTPS origin, one per line, without a path. Only add apps you choose to support.</p></div>
+            <details class="rounded-lg border border-white/15 p-4">
+              <summary class="cursor-pointer text-sm font-medium">Moneyer connection</summary>
+              <p class="my-3 text-xs text-white/60">Only “Resolve Moneyer addresses” makes a DNS lookup. Loading or saving this page never contacts Moneyer. Saved addresses stay pinned until you change them.</p>
+              <label for="moneyer-pins" class="block text-sm mb-2">Public issuer IP addresses</label>
+              <textarea id="moneyer-pins" v-model="pins" rows="3" class="storage-input font-mono" @input="review = false" />
+              <button type="button" class="glass-button mt-3 px-4 py-2 rounded-lg" @click="resolve">Resolve Moneyer addresses</button>
+            </details>
+            <label class="flex items-start gap-3 text-sm"><input v-model="form.moneyer_terms_accepted" type="checkbox" class="mt-1" @change="review = false" /><span>I have reviewed and accept the terms and risks of using Moneyer as my issuer.</span></label>
+          </div>
+
+          <div class="border-t border-white/10 pt-6 space-y-3">
+            <label class="flex items-center gap-3 font-medium"><input v-model="form.sales_enabled" type="checkbox" @change="review = false" />Accept new storage sales</label>
+            <p class="text-sm text-white/65">Off by default. Pausing blocks new quotes; existing customer access and payment recovery continue. Previously issued quotes can still be paid during their 10-minute validity.</p>
+            <div class="flex flex-wrap gap-3 pt-2">
+              <button type="submit" class="glass-button px-5 py-3 rounded-lg">{{ busy ? 'Working…' : 'Save draft' }}</button>
+              <button type="button" class="glass-button px-5 py-3 rounded-lg disabled:opacity-40" :disabled="!canReview" @click="review = true; confirmed = false">Review and apply</button>
+            </div>
+            <p class="text-xs text-white/60">{{ dirty ? 'Unsaved changes. Save your draft before applying.' : 'Saving a draft does not change the running node.' }}</p>
+          </div>
+        </fieldset>
+      </form>
+
+      <section v-if="review && !dirty" class="glass-card border border-amber-300/30 p-6 space-y-4" aria-label="Review changes">
+        <h2 class="text-lg font-semibold">Apply to your node</h2>
+        <p class="text-sm">{{ status.settings.sales_enabled ? 'Enable new sales' : 'Keep new sales off' }} with a {{ size(status.settings.quota_bytes) }} quota and {{ size(status.settings.owner_reserved_bytes) }} reserved for you.</p>
+        <p class="text-sm">Offer {{ size(status.settings.offer_capacity_bytes) }} for {{ status.settings.price_sats }} sats per {{ status.settings.duration_seconds / 86400 }} days, with {{ status.settings.grace_seconds / 86400 }} days for recovery.</p>
+        <p class="text-sm text-white/65">Wildbloom Node restarts briefly. Files, existing customer allowances and receiving state are retained. New quotes use these terms; existing quotes retain their original terms.</p>
+        <label class="flex items-start gap-3 text-sm"><input v-model="confirmed" type="checkbox" :disabled="busy" class="mt-1" />I’m ready to apply these settings and briefly restart Wildbloom Node.</label>
+        <button class="glass-button px-5 py-3 rounded-lg disabled:opacity-40" :disabled="!confirmed || busy" @click="apply">{{ busy ? 'Applying…' : 'Apply to node' }}</button>
+      </section>
+    </template>
+  </div>
+</template>
+
+<style scoped>
