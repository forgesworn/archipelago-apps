+import { flushPromises, mount, type VueWrapper } from '@vue/test-utils'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+vi.mock('@/api/rpc-client', () => ({ rpcClient: { call: vi.fn() } }))
+import { rpcClient } from '@/api/rpc-client'
+import StorageSelling from '../StorageSelling.vue'
+
+const GiB = 2 ** 30
+const rpc = vi.mocked(rpcClient.call)
+const initial = () => ({
+  revision: 0, active: null as null | Record<string, unknown>, applied: false, has_draft: false,
+  external_configuration: false, can_apply: true, origin: 'https://node.example:3742',
+  runtime: { quota_bytes: 10 * GiB, used_bytes: GiB, committed_bytes: GiB, settings_revision: null, checkout_started: false },
+  disk: { free_bytes: 29 * GiB, total_bytes: 38 * GiB, headroom_bytes: 5 * GiB },
+  settings: { quota_bytes: 10 * GiB, owner_reserved_bytes: 5 * GiB, max_blob_bytes: GiB,
+    offer_capacity_bytes: 5 * GiB, price_sats: 500, duration_seconds: 30 * 86400,
+    grace_seconds: 7 * 86400, delivery_bytes: 100 * GiB, seller_name: 'My node',
+    refund_policy: '', moneyer_ips: [] as string[], additional_browser_origins: [] as string[], moneyer_terms_accepted: false, sales_enabled: false },
+})
+function button(w: VueWrapper, text: string) { return w.findAll('button').find(b => b.text() === text)! }
+async function page() {
+  const w = mount(StorageSelling, { global: { stubs: { RouterLink: true } } })
+  await flushPromises(); return w
+}
+describe('Storage & selling', () => {
+  beforeEach(() => { rpc.mockReset(); rpc.mockResolvedValue(initial()) })
+  it('loads the current quota, with sales off, and makes no issuer call', async () => {
+    const w = await page()
+    expect((w.get('#quota_bytes').element as HTMLInputElement).value).toBe('10')
+    expect(w.text()).toContain('Sales off')
+    expect(button(w, 'Review and apply').attributes('disabled')).toBeDefined()
+    expect(rpc.mock.calls.map(([o]) => o.method)).toEqual(['wildbloom.storage.get'])
+  })
+  it('saves exact operator choices without applying or losing zero values', async () => {
+    const w = await page()
+    await w.get('#price_sats').setValue(123)
+    await w.get('#owner_reserved_bytes').setValue(0)
+    await w.get('#grace_seconds').setValue(0)
+    await w.get('#customer-apps').setValue('https://customer-app.example')
+    rpc.mockResolvedValueOnce({ revision: 1 })
+    await w.get('form').trigger('submit'); await flushPromises()
+    expect(rpc).toHaveBeenLastCalledWith(expect.objectContaining({ method: 'wildbloom.storage.save',
+      params: { revision: 0, settings: expect.objectContaining({ price_sats: 123, owner_reserved_bytes: 0, grace_seconds: 0, sales_enabled: false, additional_browser_origins: ['https://customer-app.example'] }) } }))
+    expect(w.text()).toContain('Draft saved. Your running node has not changed.')
+    expect(button(w, 'Review and apply').attributes('disabled')).toBeUndefined()
+    expect(rpc.mock.calls.some(([o]) => o.method === 'wildbloom.storage.apply')).toBe(false)
+  })
+  it('requires a saved review and explicit restart confirmation', async () => {
+    const data = initial(); data.has_draft = true; data.revision = 1
+    rpc.mockResolvedValueOnce(data)
+    const w = await page()
+    await button(w, 'Review and apply').trigger('click')
+    const review = w.get('[aria-label="Review changes"]')
+    expect(button(w, 'Apply to node').attributes('disabled')).toBeDefined()
+    await review.get('input[type="checkbox"]').setValue(true)
+    rpc.mockResolvedValueOnce({ status: 'applied' })
+    rpc.mockResolvedValueOnce({ ...data, applied: true, active: { revision: 2, settings: data.settings, checkout_started: false } })
+    await button(w, 'Apply to node').trigger('click'); await flushPromises()
+    expect(rpc).toHaveBeenCalledWith(expect.objectContaining({ method: 'wildbloom.storage.apply', maxRetries: 1, params: { revision: 1, confirm_restart: true } }))
+    expect(w.text()).toContain('node is healthy and running this configuration')
+  })
+  it('does not offer an oversized draft for apply', async () => {
+    const data = initial(); data.has_draft = true; data.settings.quota_bytes = 200 * GiB
+    rpc.mockResolvedValueOnce(data)
+    const w = await page()
+    expect(w.text()).toContain('quota exceeds usable disk capacity')
+    expect(button(w, 'Review and apply').attributes('disabled')).toBeDefined()
+  })
+  it('invalidates review when any offer value changes', async () => {
+    rpc.mockResolvedValueOnce({ ...initial(), has_draft: true })
+    const w = await page(); await button(w, 'Review and apply').trigger('click')
+    await w.get('#seller-name').setValue('Another name')
+    expect(w.find('[aria-label="Review changes"]').exists()).toBe(false)
+    expect(button(w, 'Review and apply').attributes('disabled')).toBeDefined()
+  })
+  it('keeps unknown or failed application distinct from success', async () => {
+    const data = { ...initial(), has_draft: true }
+    rpc.mockResolvedValueOnce(data)
+    const w = await page(); await button(w, 'Review and apply').trigger('click')
