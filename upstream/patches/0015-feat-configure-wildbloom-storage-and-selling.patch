+//! Private operator settings. Drafts never affect the daemon; only an explicit
+//! apply publishes a new immutable profile, reusing the same receiving ledger.
+use anyhow::{ensure, Context, Result};
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use std::{net::IpAddr, path::Path};
+
+pub const GIB: u64 = 1 << 30;
+pub const MAX: u64 = 9_007_199_254_740_991;
+pub const MONEYER_KEY: &str = "0218865ec3352afb85695bd1b6089323f802ecbf3ae2103bf8fd4d3e6fb571f0e4";
+pub static LOCK: tokio::sync::Mutex<()> = tokio::sync::Mutex::const_new(());
+
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct Settings {
+    pub quota_bytes: u64,
+    pub owner_reserved_bytes: u64,
+    pub max_blob_bytes: u64,
+    pub offer_capacity_bytes: u64,
+    pub price_sats: u64,
+    pub duration_seconds: u64,
+    pub grace_seconds: u64,
+    pub delivery_bytes: u64,
+    pub seller_name: String,
+    pub refund_policy: String,
+    pub moneyer_ips: Vec<IpAddr>,
+    pub additional_browser_origins: Vec<String>,
+    pub moneyer_terms_accepted: bool,
+    pub sales_enabled: bool,
+}
+
+impl Settings {
+    pub fn defaults(quota: u64) -> Self {
+        Self {
+            quota_bytes: quota,
+            owner_reserved_bytes: (quota / 2).min(100 * GIB),
+            max_blob_bytes: GIB.min(quota),
+            offer_capacity_bytes: (10 * GIB).min(quota - (quota / 2).min(100 * GIB)),
+            price_sats: 500,
+            duration_seconds: 30 * 86400,
+            grace_seconds: 7 * 86400,
+            delivery_bytes: 100 * GIB,
+            seller_name: "My Archipelago node".into(),
+            refund_policy: String::new(),
+            moneyer_ips: vec![],
+            additional_browser_origins: vec![],
+            moneyer_terms_accepted: false,
+            sales_enabled: false,
+        }
+    }
+
+    pub fn validate(&self) -> Result<()> {
+        for value in [
+            self.quota_bytes,
+            self.max_blob_bytes,
+            self.offer_capacity_bytes,
+            self.price_sats,
+            self.duration_seconds,
+            self.delivery_bytes,
+        ] {
+            ensure!(
+                (1..=MAX).contains(&value),
+                "Wildbloom values must be positive safe integers"
+            );
+        }
+        ensure!(
+            self.price_sats <= MAX / 1000 && self.grace_seconds <= MAX,
+            "Wildbloom price or grace period is too large"
+        );
+        ensure!(
+            self.owner_reserved_bytes < self.quota_bytes
+                && self.offer_capacity_bytes <= self.quota_bytes - self.owner_reserved_bytes
+                && self.max_blob_bytes <= self.quota_bytes,
+            "Wildbloom offer must fit quota minus owner reserve; file limit must fit quota"
+        );
+        plain(&self.seller_name, 128, false)?;
+        plain(&self.refund_policy, 2048, true)?;
+        ensure!(self.additional_browser_origins.len() <= 15
+            && self.additional_browser_origins.iter().all(|value| browser_origin(value)),
+            "Wildbloom customer apps need exact HTTPS origins without paths (at most 15 additional apps)");
+        ensure!(
+            self.moneyer_ips.len() <= 16 && self.moneyer_ips.iter().all(public_ip),
+            "Wildbloom issuer addresses must be public IPs (at most 16)"
+        );
+        Ok(())
+    }
+
+    pub fn validate_receiver(&self) -> Result<()> {
+        ensure!(self.moneyer_terms_accepted && !self.refund_policy.trim().is_empty()
+            && !self.refund_policy.starts_with("REPLACE") && !self.moneyer_ips.is_empty(),
+            "Wildbloom selling requires issuer addresses, acceptance of Moneyer terms, and your contact/refund terms");
+        Ok(())
+    }
+}
+
+fn browser_origin(value: &str) -> bool {
+    reqwest::Url::parse(value).is_ok_and(|url| {
+        value.len() <= 2048
+            && !value.contains('*')
+            && url.scheme() == "https"
+            && url.username().is_empty()
+            && url.password().is_none()
+            && url.query().is_none()
+            && url.fragment().is_none()
+            && url.port() != Some(0)
+            && url.host_str().is_some_and(|h| !h.ends_with(".onion"))
+            && url.origin().ascii_serialization() == value
+    })
+}
+
+fn plain(value: &str, limit: usize, empty: bool) -> Result<()> {
+    ensure!(
+        (empty || !value.trim().is_empty())
+            && value.len() <= limit
+            && !value.chars().any(char::is_control),
+        "Wildbloom text is missing, too long, or contains control characters"
+    );
+    Ok(())
+}
+
+// Explicitly reject non-routable and translation ranges. DNS results are pins,
+// never URLs; the receiver still verifies TLS for moneyer.dev.
+pub fn public_ip(ip: &IpAddr) -> bool {
+    match ip {
+        IpAddr::V4(ip) => {
+            let [a, b, c, _] = ip.octets();
+            !ip.is_private()
+                && !ip.is_loopback()
+                && !ip.is_link_local()
+                && !ip.is_broadcast()
+                && !ip.is_documentation()
+                && !ip.is_multicast()
+                && a != 0
+                && a < 240
+                && !(a == 100 && (64..=127).contains(&b))
+                && !(a == 192 && b == 0)
+                && !(a == 198 && (b == 18 || b == 19))
+                && !(a == 192 && b == 88 && c == 99)
+        }
+        IpAddr::V6(ip) => {
+            let s = ip.segments();
+            // Current global unicast only. Excludes mapped IPv4, NAT64,
+            // link/site-local, multicast, ULA and protocol/documentation blocks.
+            s[0] & 0xe000 == 0x2000
+                && s[0] != 0x2002
+                && !(s[0] == 0x2001 && (s[1] < 0x200 || s[1] == 0xdb8))
+                && !(s[0] == 0x3fff && s[1] < 0x1000)
+        }
+    }
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Active {
+    pub revision: u64,
+    pub origin: String,
+    pub checkout_started: bool,
+    pub settings: Settings,
+}
+
+#[derive(Clone, Default, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Record {
+    pub revision: u64,
+    pub draft: Option<Settings>,
+    pub active: Option<Active>,
+}
+
+pub fn path(data: &Path) -> std::path::PathBuf {
+    data.join("settings/wildbloom-storage/settings.json")
+}
+
+pub fn load(data: &Path) -> Result<Record> {
+    let path = path(data);
+    match std::fs::symlink_metadata(&path) {
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => Ok(Record::default()),
+        Err(e) => Err(e.into()),
+        Ok(meta) => {
+            ensure!(
+                meta.is_file() && meta.len() <= 65536,
+                "Wildbloom settings file is invalid"
+            );
+            let record: Record = serde_json::from_slice(&std::fs::read(path)?).context(
+                "Wildbloom settings cannot be read; existing configuration was preserved",
+            )?;
+            if let Some(s) = &record.draft {
+                s.validate()?;
+            }
+            if let Some(a) = &record.active {
+                a.settings.validate()?;
+            }
+            Ok(record)
+        }
+    }
+}
+
+pub fn private_dir(dir: &Path) -> Result<()> {
+    use std::os::unix::fs::PermissionsExt;
+    if !dir.exists() {
+        std::fs::create_dir(dir)?;
+    }
+    let meta = std::fs::symlink_metadata(dir)?;
+    ensure!(
+        meta.is_dir() && !meta.file_type().is_symlink(),
+        "Wildbloom private directory is invalid"
+    );
+    std::fs::set_permissions(dir, std::fs::Permissions::from_mode(0o700))?;
+    Ok(())
+}
+
+pub fn write_private(path: &Path, bytes: &[u8]) -> Result<()> {
+    use std::io::Write;
+    use std::os::unix::fs::OpenOptionsExt;
+    let mut file = std::fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(path)?;
+    file.write_all(bytes)?;
+    file.sync_all()?;
+    Ok(())
+}
+
+pub fn save(data: &Path, record: &Record) -> Result<()> {
+    let parent = data.join("settings");
+    std::fs::create_dir_all(&parent)?;
+    let dir = parent.join("wildbloom-storage");
+    private_dir(&dir)?;
+    let temp = dir.join(format!("{}.tmp", uuid::Uuid::new_v4()));
+    write_private(&temp, &serde_json::to_vec(record)?)?;
+    std::fs::rename(&temp, path(data))?;
+    std::fs::File::open(dir)?.sync_all()?;
+    Ok(())
+}
+
+pub fn validate_capacity(
+    s: &Settings,
+    free: u64,
+    total: u64,
+    used: u64,
+    committed: u64,
+    previous: Option<&Active>,
+) -> Result<()> {
+    let headroom = (5 * GIB).max(total / 20);
+    ensure!(
+        s.quota_bytes >= committed,
+        "Wildbloom quota cannot be below committed storage"
+    );
+    ensure!(
+        s.quota_bytes <= free.saturating_add(used).saturating_sub(headroom),
+        "Wildbloom quota exceeds usable disk space; leave at least 5 GiB or 5% free for the node"
+    );
+    if let Some(a) = previous.filter(|a| a.checkout_started) {
+        ensure!(s.quota_bytes >= a.settings.quota_bytes,
+            "Wildbloom quota cannot shrink after selling begins; existing customer promises must be preserved");
+        ensure!(s.owner_reserved_bytes <= a.settings.owner_reserved_bytes,
+            "Wildbloom owner reserve cannot increase after selling begins; existing customer promises must be preserved");
+    }
+    Ok(())
+}
+
+pub fn profile(a: &Active) -> Value {
+    let s = &a.settings;
+    let mut browsers = vec![a.origin.replace(":3742", ":3743")];
+    for origin in &s.additional_browser_origins {
+        if !browsers.contains(origin) {
+            browsers.push(origin.clone());
+        }
+    }
+    let ips: Vec<String> = s
+        .moneyer_ips
+        .iter()
+        .map(|ip| std::net::SocketAddr::new(*ip, 443).to_string())
+        .collect();
+    json!({
+        "checkout": {"origin": format!("{}/", a.origin), "seller_id": "my-archipelago",
+            "seller_name": s.seller_name, "network": "bitcoin", "quote_seconds": 600,
+            "allow_loopback_http": false, "tor_only": false,
+            "offers": [{"id": "storage-month", "revision": a.revision,
+                "capacity_bytes": s.offer_capacity_bytes, "duration_seconds": s.duration_seconds,
+                "grace_seconds": s.grace_seconds, "price_msat": s.price_sats * 1000,
+                "delivery_bytes": s.delivery_bytes,
+                "delivery_policy": "Operator-managed delivery; no automatic bandwidth meter",
+                "retention_policy": format!("{} seconds of writes and {} further seconds for recovery", s.duration_seconds, s.grace_seconds),
+                "refund_policy": s.refund_policy}],
+            "issuers": [{"id": "moneyer-dev", "note_endpoint": "https://moneyer.dev/w",
+                "callback": "https://moneyer.dev/w/cb", "mint_pubkey": MONEYER_KEY}]},
+        "state": "/data/operator/checkout",
+        // Zero blocks every new reservation while existing quotes, receiving
+        // recovery and activated allowances continue against the same ledger.
+        "max_paid_bytes": if s.sales_enabled { s.quota_bytes - s.owner_reserved_bytes } else { 0 },
+        "browser_origins": browsers, "phoenixd": null,
+        "notes": (["https://moneyer.dev/w", "https://moneyer.dev/w/cb"].map(|endpoint| json!({
+            "endpoint": endpoint, "destination": {"origin": "https://moneyer.dev/", "addresses": ips, "allow_loopback_http": false}})))
+    })
+}
+
+pub fn profile_name(revision: u64) -> String {
+    format!("dashboard-profile-{revision}.json")
+}
+
+pub fn prepare_profile(root: &Path, a: &Active) -> Result<()> {
+    if !a.checkout_started {
+        return Ok(());
+    }
+    let dir = root.join("operator");
+    private_dir(&dir)?;
+    let path = dir.join(profile_name(a.revision));
+    let bytes = serde_json::to_vec(&profile(a))?;
+    if path.exists() {
+        ensure!(
+            std::fs::symlink_metadata(&path)?.is_file() && std::fs::read(&path)? == bytes,
+            "Wildbloom immutable profile already exists with different contents"
+        );
+    } else {
+        write_private(&path, &bytes)?;
+    }
+    std::fs::File::open(dir)?.sync_all()?;
+    Ok(())
+}
+
+pub fn apply_environment(env: &mut Vec<String>, a: &Active) {
+    let keys = [
+        "WILDBLOOM_QUOTA_BYTES=",
+        "WILDBLOOM_MAX_BLOB_BYTES=",
+        "WILDBLOOM_PUBLIC_URL=",
+        "WILDBLOOM_CHECKOUT_PROFILE=",
+        "WILDBLOOM_ARCHIPELAGO_SETTINGS_REVISION=",
+    ];
+    env.retain(|e| !keys.iter().any(|k| e.starts_with(k)));
+    env.extend([
+        format!("WILDBLOOM_QUOTA_BYTES={}", a.settings.quota_bytes),
+        format!("WILDBLOOM_MAX_BLOB_BYTES={}", a.settings.max_blob_bytes),
+        format!("WILDBLOOM_PUBLIC_URL={}", a.origin),
+        format!("WILDBLOOM_ARCHIPELAGO_SETTINGS_REVISION={}", a.revision),
+    ]);
+    if a.checkout_started {
+        env.push(format!(
+            "WILDBLOOM_CHECKOUT_PROFILE=/data/operator/{}",
+            profile_name(a.revision)
+        ));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn customer_apps_are_explicit_exact_origins_and_keep_the_own_app() {
+        let mut a = active();
+        a.settings.additional_browser_origins = vec!["https://customer-app.example".into()];
+        a.settings.validate().unwrap();
+        assert_eq!(
+            profile(&a)["browser_origins"],
+            json!(["https://node.example:3743", "https://customer-app.example"])
+        );
+        for value in [
+            "*",
+            "http://app.example",
+            "https://app.example/path",
+            "https://user@app.example",
+            "https://app.example?x",
+            "https://app.example#x",
+            "https://*.example",
+            "https://app.example:0",
+            "https://app.onion",
+        ] {
+            a.settings.additional_browser_origins = vec![value.into()];
+            assert!(a.settings.validate().is_err(), "{value}");
+        }
+    }
+    fn active() -> Active {
+        let mut settings = Settings::defaults(200 * GIB);
+        settings.moneyer_ips = vec!["1.1.1.1".parse().unwrap()];
+        settings.refund_policy = "Contact the operator for refunds".into();
+        settings.moneyer_terms_accepted = true;
+        settings.sales_enabled = true;
+        Active {
+            revision: 2,
+            origin: "https://node.example:3742".into(),
+            checkout_started: true,
+            settings,
+        }
+    }
+    #[test]
+    fn defaults_use_current_quota_and_preserve_zero_choices() {
+        let mut s = Settings::defaults(10 * GIB);
+        assert_eq!(s.owner_reserved_bytes, 5 * GIB);
+        assert_eq!(s.offer_capacity_bytes, 5 * GIB);
+        assert!(!s.sales_enabled);
+        s.owner_reserved_bytes = 0;
+        s.grace_seconds = 0;
+        s.validate().unwrap();
+        s.offer_capacity_bytes = 11 * GIB;
+        assert!(s.validate().is_err());
+    }
+    #[test]
+    fn capacity_protects_disk_and_existing_promises() {
+        let a = active();
+        let mut s = a.settings.clone();
+        assert!(validate_capacity(&s, 30 * GIB, 38 * GIB, 0, 0, None).is_err());
+        validate_capacity(&s, 300 * GIB, 400 * GIB, 0, 0, Some(&a)).unwrap();
+        s.quota_bytes -= GIB;
+        assert!(validate_capacity(&s, 300 * GIB, 400 * GIB, 0, 0, Some(&a)).is_err());
+        s = a.settings.clone();
+        s.owner_reserved_bytes += GIB;
+        assert!(validate_capacity(&s, 300 * GIB, 400 * GIB, 0, 0, Some(&a)).is_err());
+    }
+    #[test]
+    fn pause_keeps_receiver_and_ledger_but_refuses_new_capacity() {
+        let mut a = active();
+        let before = profile(&a);
+        a.settings.sales_enabled = false;
+        let after = profile(&a);
+        assert_eq!(after["max_paid_bytes"], 0);
+        assert_eq!(before["state"], after["state"]);
+        assert_eq!(before["checkout"], after["checkout"]);
+        let mut env = vec![
+            "WILDBLOOM_ALLOW_PUBKEYS=owner".into(),
+            "WILDBLOOM_QUOTA_BYTES=1".into(),
+        ];
+        apply_environment(&mut env, &a);
+        assert!(env.contains(&"WILDBLOOM_ALLOW_PUBKEYS=owner".into()));
+        assert!(env
+            .iter()
+            .any(|e| e.starts_with("WILDBLOOM_CHECKOUT_PROFILE=")));
+        assert_eq!(
+            env.iter()
+                .filter(|e| e.starts_with("WILDBLOOM_QUOTA_BYTES="))
+                .count(),
+            1
+        );
+    }
+    #[test]
+    fn receiver_rejects_private_pins_and_incomplete_terms() {
+        let mut s = active().settings;
+        for ip in [
+            "127.0.0.1",
+            "10.1.1.1",
+            "100.64.0.1",
+            "169.254.169.254",
+            "192.0.2.1",
+            "::1",
+            "::ffff:127.0.0.1",
+            "64:ff9b::1",
+            "2001:db8::1",
+            "fc00::1",
+        ] {
+            s.moneyer_ips = vec![ip.parse().unwrap()];
+            assert!(s.validate().is_err(), "{ip}");
+        }
+        s.moneyer_ips = vec![];
+        assert!(s.validate_receiver().is_err());
+        s.moneyer_ips = vec!["1.1.1.1".parse().unwrap()];
+        s.validate_receiver().unwrap();
+        s.refund_policy.clear();
+        assert!(s.validate_receiver().is_err());
+    }
+    #[test]
+    fn drafts_are_private_and_corruption_is_never_defaulted() {
+        use std::os::unix::fs::PermissionsExt;
+        let dir = tempfile::tempdir().unwrap();
+        let record = Record {
+            revision: 1,
+            draft: Some(Settings::defaults(10 * GIB)),
+            active: None,
+        };
+        save(dir.path(), &record).unwrap();
+        assert!(load(dir.path()).unwrap().active.is_none());
+        assert_eq!(
+            std::fs::metadata(path(dir.path()))
+                .unwrap()
+                .permissions()
+                .mode()
+                & 0o777,
+            0o600
+        );
+        std::fs::write(path(dir.path()), b"broken").unwrap();
+        assert!(load(dir.path()).is_err());
+    }
+    #[test]
+    fn profiles_are_immutable_and_do_not_reset_receiving_state() {
+        let dir = tempfile::tempdir().unwrap();
+        let mut a = active();
+        prepare_profile(dir.path(), &a).unwrap();
+        prepare_profile(dir.path(), &a).unwrap();
+        a.settings.price_sats += 1;
+        assert!(prepare_profile(dir.path(), &a).is_err());
+        a.revision += 1;
+        prepare_profile(dir.path(), &a).unwrap();
+        assert!(!dir.path().join("operator/checkout").exists());
+    }
+}
