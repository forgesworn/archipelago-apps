diff --git a/core/archipelago/src/api/rpc/wildbloom.rs b/core/archipelago/src/api/rpc/wildbloom.rs
new file mode 100644
index 0000000..51d5d4f
--- /dev/null
+++ b/core/archipelago/src/api/rpc/wildbloom.rs
@@ -0,0 +1,415 @@
+//! Authenticated dashboard controls for the packaged, rootless Wildbloom node.
+use super::RpcHandler;
+use crate::settings::wildbloom_storage::{self as storage, Active, Record, Settings, GIB, MAX};
+use anyhow::{ensure, Context, Result};
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use std::{path::Path, sync::Arc, time::Duration};
+
+pub(super) fn origin_allowed(headers: &hyper::HeaderMap, dev_mode: bool) -> bool {
+    super::signer_login::signer_prompt_origin_allowed(headers, dev_mode)
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Save {
+    revision: u64,
+    settings: Settings,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Apply {
+    revision: u64,
+    confirm_restart: bool,
+}
+
+#[derive(Serialize)]
+struct Runtime {
+    image: String,
+    quota_bytes: u64,
+    used_bytes: u64,
+    committed_bytes: u64,
+    max_blob_bytes: u64,
+    settings_revision: Option<u64>,
+    checkout_started: bool,
+    #[serde(skip)]
+    checkout_profile: Option<String>,
+}
+
+fn external_configuration(record: &Record, runtime: &Runtime, ledger_exists: bool) -> bool {
+    if ledger_exists && !record.active.as_ref().is_some_and(|a| a.checkout_started) {
+        return true;
+    }
+    if let Some(profile) = &runtime.checkout_profile {
+        let Some(revision) = runtime.settings_revision else {
+            return true;
+        };
+        return !record
+            .active
+            .as_ref()
+            .is_some_and(|a| a.checkout_started && revision <= a.revision)
+            || *profile != format!("/data/operator/{}", storage::profile_name(revision));
+    }
+    false
+}
+
+fn number(v: &Value, key: &str) -> Result<u64> {
+    v.get(key)
+        .and_then(Value::as_u64)
+        .filter(|v| *v <= MAX)
+        .ok_or_else(|| anyhow::anyhow!("Wildbloom storage status is incomplete"))
+}
+
+async fn runtime() -> Result<Runtime> {
+    let mut command = tokio::process::Command::new("podman");
+    command
+        .args([
+            "inspect",
+            "wildbloom-node",
+            "--format",
+            "{\"env\":{{json .Config.Env}},\"image\":{{json .ImageName}}}",
+        ])
+        .kill_on_drop(true);
+    let output = tokio::time::timeout(Duration::from_secs(5), command.output()).await??;
+    ensure!(
+        output.status.success(),
+        "Wildbloom node is not installed or cannot be inspected"
+    );
+    let inspected: Value = serde_json::from_slice(&output.stdout)?;
+    let env: Vec<String> = serde_json::from_value(inspected["env"].clone())?;
+    let image = inspected["image"]
+        .as_str()
+        .context("Wildbloom image is unavailable")?
+        .to_string();
+    let value = |key: &str| env.iter().find_map(|e| e.strip_prefix(key));
+    let client = reqwest::Client::builder()
+        .no_proxy()
+        .redirect(reqwest::redirect::Policy::none())
+        .timeout(Duration::from_secs(3))
+        .build()?;
+    let response = client
+        .get("http://127.0.0.1:3742/healthz")
+        .send()
+        .await?
+        .error_for_status()?;
+    let bytes = response.bytes().await?;
+    ensure!(bytes.len() <= 8192, "Wildbloom storage status is too large");
+    let health: Value = serde_json::from_slice(&bytes)?;
+    ensure!(health["status"] == "ok", "Wildbloom node is not healthy");
+    let s = &health["storage"];
+    Ok(Runtime {
+        image,
+        quota_bytes: number(s, "quota_bytes")?,
+        used_bytes: number(s, "bytes")?,
+        committed_bytes: number(s, "committed_bytes")?,
+        max_blob_bytes: value("WILDBLOOM_MAX_BLOB_BYTES=")
+            .map(str::parse)
+            .transpose()?
+            .unwrap_or(GIB),
+        settings_revision: value("WILDBLOOM_ARCHIPELAGO_SETTINGS_REVISION=")
+            .map(str::parse)
+            .transpose()?,
+        checkout_started: value("WILDBLOOM_CHECKOUT_PROFILE=").is_some(),
+        checkout_profile: value("WILDBLOOM_CHECKOUT_PROFILE=").map(str::to_string),
+    })
+}
+
+fn disk_values(stdout: &str) -> Result<(u64, u64)> {
+    let parts: Vec<_> = stdout
+        .lines()
+        .last()
+        .unwrap_or("")
+        .split_whitespace()
+        .collect();
+    ensure!(parts.len() >= 6, "Wildbloom disk capacity is unavailable");
+    let total = parts[1].parse::<u64>()?.checked_mul(1024);
+    let free = parts[3].parse::<u64>()?.checked_mul(1024);
+    match (free, total) {
+        (Some(free), Some(total)) if total > 0 && free <= total => Ok((free, total)),
+        _ => anyhow::bail!("Wildbloom disk capacity is unavailable"),
+    }
+}
+
+async fn disk(root: &Path) -> Result<(u64, u64)> {
+    let mut command = tokio::process::Command::new("df");
+    command
+        .arg("-Pk")
+        .arg(root)
+        .env("LC_ALL", "C")
+        .kill_on_drop(true);
+    let out = tokio::time::timeout(Duration::from_secs(5), command.output()).await??;
+    ensure!(
+        out.status.success(),
+        "Wildbloom disk capacity is unavailable"
+    );
+    disk_values(&String::from_utf8_lossy(&out.stdout))
+}
+
+fn check_revision(record: &Record, expected: u64) -> Result<()> {
+    ensure!(
+        record.revision == expected,
+        "Wildbloom settings changed in another session. Reload before saving"
+    );
+    ensure!(
+        record.revision < MAX,
+        "Wildbloom settings revision is exhausted"
+    );
+    Ok(())
+}
+
+impl RpcHandler {
+    pub(super) async fn handle_wildbloom_get(&self) -> Result<Value> {
+        let record = storage::load(&self.config.data_dir)?;
+        let runtime = runtime().await.ok();
+        let root = match &self.orchestrator {
+            Some(o) => o.wildbloom_settings_root().await.ok(),
+            None => None,
+        };
+        let disk = match &root {
+            Some(root) => disk(root).await.ok(),
+            None => None,
+        };
+        let mut defaults =
+            Settings::defaults(runtime.as_ref().map(|r| r.quota_bytes).unwrap_or(200 * GIB));
+        if let Some(r) = &runtime {
+            defaults.max_blob_bytes = r.max_blob_bytes;
+        }
+        let settings = record
+            .draft
+            .clone()
+            .or_else(|| record.active.as_ref().map(|a| a.settings.clone()))
+            .unwrap_or(defaults);
+        let external = runtime.as_ref().is_some_and(|r| {
+            external_configuration(
+                &record,
+                r,
+                root.as_ref()
+                    .is_some_and(|root| root.join("operator/checkout").exists()),
+            )
+        });
+        let applied = record.active.as_ref().is_some_and(|a| {
+            runtime.as_ref().is_some_and(|r| {
+                r.settings_revision == Some(a.revision)
+                    && r.quota_bytes == a.settings.quota_bytes
+                    && r.max_blob_bytes == a.settings.max_blob_bytes
+                    && r.checkout_started == a.checkout_started
+            })
+        });
+        Ok(
+            json!({"revision": record.revision, "settings": settings, "active": record.active,
+            "has_draft": record.draft.is_some(), "applied": applied, "runtime": runtime, "external_configuration": external,
+            "can_apply": root.is_some() && disk.is_some() && !external && self.config.public_host.is_some()
+                && runtime.as_ref().is_some_and(|r| r.image == "ghcr.io/forgesworn/wildbloom-node:0.3.5-2ea211e-2"),
+            "origin": self.config.public_host.as_ref().map(|h| format!("https://{h}:3742")),
+            "disk": disk.map(|(free,total)| json!({"free_bytes":free,"total_bytes":total,"headroom_bytes":(5*GIB).max(total/20)}))}),
+        )
+    }
+
+    pub(super) async fn handle_wildbloom_save(&self, params: Option<Value>) -> Result<Value> {
+        let request: Save = serde_json::from_value(params.context("Missing Wildbloom settings")?)
+            .context("Invalid Wildbloom settings")?;
+        request.settings.validate()?;
+        let _guard = storage::LOCK.lock().await;
+        let mut record = storage::load(&self.config.data_dir)?;
+        check_revision(&record, request.revision)?;
+        record.revision += 1;
+        record.draft = Some(request.settings);
+        storage::save(&self.config.data_dir, &record)?;
+        Ok(json!({"revision":record.revision}))
+    }
+
+    pub(super) async fn handle_wildbloom_resolve(&self) -> Result<Value> {
+        // Only this explicit action contacts DNS. Loading/saving a form never
+        // discovers or calls the payment issuer. No arbitrary hostname input.
+        let addresses = tokio::time::timeout(
+            Duration::from_secs(5),
+            tokio::net::lookup_host(("moneyer.dev", 443)),
+        )
+        .await??;
+        let mut ips: Vec<_> = addresses
+            .map(|a| a.ip())
+            .filter(storage::public_ip)
+            .collect();
+        ips.sort();
+        ips.dedup();
+        ensure!(
+            !ips.is_empty() && ips.len() <= 16,
+            "Wildbloom could not resolve public Moneyer addresses"
+        );
+        Ok(json!({"addresses":ips}))
+    }
+
+    pub(super) async fn handle_wildbloom_apply(
+        self: Arc<Self>,
+        params: Option<Value>,
+    ) -> Result<Value> {
+        let request: Apply =
+            serde_json::from_value(params.context("Missing Wildbloom apply request")?)
+                .context("Invalid Wildbloom apply request")?;
+        ensure!(
+            request.confirm_restart,
+            "Wildbloom apply requires confirmation of the node restart"
+        );
+        // A request disconnect must not cancel between publishing desired
+        // settings and restarting. The detached task completes and a reload
+        // compares the running revision with the desired revision.
+        tokio::spawn(async move { self.apply_wildbloom(request.revision).await }).await?
+    }
+
+    async fn apply_wildbloom(&self, revision: u64) -> Result<Value> {
+        let _guard = storage::LOCK.lock().await;
+        let mut record = storage::load(&self.config.data_dir)?;
+        check_revision(&record, revision)?;
+        let settings = record
+            .draft
+            .clone()
+            .context("Wildbloom save a draft before applying")?;
+        settings.validate()?;
+        let host = self
+            .config
+            .public_host
+            .as_ref()
+            .context("Wildbloom requires a configured public hostname")?;
+        let origin = format!("https://{host}:3742");
+        let orch = self
+            .orchestrator
+            .as_ref()
+            .context("Wildbloom container management is unavailable")?;
+        let root = orch.wildbloom_settings_root().await?;
+        let current = runtime()
+            .await
+            .context("Wildbloom start the node and wait for healthy storage before applying")?;
+        ensure!(
+            current.image == "ghcr.io/forgesworn/wildbloom-node:0.3.5-2ea211e-2",
+            "Wildbloom installed image is not compatible with dashboard settings"
+        );
+        ensure!(!external_configuration(&record, &current, root.join("operator/checkout").exists()),
+            "Wildbloom existing external sales configuration must be migrated before dashboard changes");
+        if let Some(a) = &record.active {
+            ensure!(
+                !a.checkout_started || a.origin == origin,
+                "Wildbloom public hostname cannot change while payment recovery may be outstanding"
+            );
+        }
+        let (free, total) = disk(&root).await?;
+        storage::validate_capacity(
+            &settings,
+            free,
+            total,
+            current.used_bytes,
+            current.committed_bytes,
+            record.active.as_ref(),
+        )?;
+        let started =
+            settings.sales_enabled || record.active.as_ref().is_some_and(|a| a.checkout_started);
+        if started {
+            settings.validate_receiver()?;
+        }
+        let active = Active {
+            revision: record.revision + 1,
+            origin,
+            checkout_started: started,
+            settings,
+        };
+        storage::prepare_profile(&root, &active)?;
+        record.revision = active.revision;
+        record.active = Some(active.clone());
+        storage::save(&self.config.data_dir, &record)?;
+        // The normal Quadlet restart regenerates only this app's unit. No
+        // image update, uninstallation, volume removal or ledger replacement.
+        if orch.restart("wildbloom-node").await.is_err() {
+            return Ok(json!({"status":"pending","revision":record.revision,
+                "message":"Settings saved, but the node restart failed. Check the app and retry Apply."}));
+        }
+        for _ in 0..10 {
+            if let Ok(r) = runtime().await {
+                if r.settings_revision == Some(active.revision)
+                    && r.quota_bytes == active.settings.quota_bytes
+                    && r.max_blob_bytes == active.settings.max_blob_bytes
+                    && r.checkout_started == active.checkout_started
+                {
+                    return Ok(json!({"status":"applied","revision":record.revision}));
+                }
+            }
+            tokio::time::sleep(Duration::from_millis(500)).await;
+        }
+        Ok(json!({"status":"pending","revision":record.revision,
+            "message":"Settings saved; the running configuration has not been verified. Reload status before retrying."}))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn inactive_manual_receiving_state_is_not_silently_adopted() {
+        let mut runtime = Runtime {
+            image: String::new(),
+            quota_bytes: 10 * GIB,
+            used_bytes: 0,
+            committed_bytes: 0,
+            max_blob_bytes: GIB,
+            settings_revision: None,
+            checkout_started: false,
+            checkout_profile: None,
+        };
+        let mut record = Record::default();
+        assert!(!external_configuration(&record, &runtime, false));
+        assert!(external_configuration(&record, &runtime, true));
+        record.active = Some(Active {
+            revision: 4,
+            origin: "https://node.example:3742".into(),
+            checkout_started: true,
+            settings: Settings::defaults(10 * GIB),
+        });
+        runtime.settings_revision = Some(2);
+        runtime.checkout_profile = Some("/data/operator/dashboard-profile-2.json".into());
+        assert!(!external_configuration(&record, &runtime, true)); // Pending newer apply.
+        runtime.checkout_profile = Some("/data/operator/manual-profile.json".into());
+        assert!(external_configuration(&record, &runtime, true));
+    }
+    #[test]
+    fn app_ports_and_other_sites_cannot_manage_storage_with_shared_cookies() {
+        let mut headers = hyper::HeaderMap::new();
+        headers.insert("host", "node.example".parse().unwrap());
+        for origin in ["https://node.example:3743", "https://other.example", "null"] {
+            headers.insert("origin", origin.parse().unwrap());
+            assert!(!origin_allowed(&headers, false));
+        }
+        headers.insert("origin", "https://node.example".parse().unwrap());
+        assert!(origin_allowed(&headers, false));
+        headers.remove("origin");
+        assert!(origin_allowed(&headers, false)); // Authenticated CLI still needs CSRF.
+    }
+    #[test]
+    fn disk_probe_uses_available_blocks_not_total_minus_used() {
+        assert_eq!(disk_values("Filesystem 1024-blocks Used Available Capacity Mounted on\n/dev/a 100 20 70 22% /data\n").unwrap(), (70*1024,100*1024));
+        assert!(disk_values("unavailable").is_err());
+        assert!(disk_values("x 0 0 0 0% /").is_err());
+    }
+    #[test]
+    fn stale_tabs_cannot_replace_a_newer_draft() {
+        let record = Record {
+            revision: 2,
+            ..Default::default()
+        };
+        assert!(check_revision(&record, 1).is_err());
+        check_revision(&record, 2).unwrap();
+    }
+    #[test]
+    fn storage_controls_always_require_dashboard_authentication() {
+        for method in [
+            "wildbloom.storage.get",
+            "wildbloom.storage.save",
+            "wildbloom.storage.apply",
+            "wildbloom.storage.resolve-moneyer",
+        ] {
+            assert!(!super::super::middleware::UNAUTHENTICATED_METHODS.contains(&method));
+            assert!(!super::super::middleware::CACHEABLE_METHODS.contains(&method));
+            assert!(!crate::auth::UserRole::Viewer.can_access(method));
+            assert!(!crate::auth::UserRole::AppUser.can_access(method));
+            assert!(crate::auth::UserRole::Admin.can_access(method));
+            assert!(!super::super::csrf_exempt_method(method));
+        }
+    }
+}
