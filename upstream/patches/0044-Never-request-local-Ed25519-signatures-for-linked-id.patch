From 8e420b5d486d2e2a083728b6b0e481b668c3852f Mon Sep 17 00:00:00 2001
From: ForgeSworn <ci@invalid>
Date: Sun, 15 Nov 2026 11:29:14 +0000
Subject: [PATCH] Never request local Ed25519 signatures for linked identities

---
 .../src/components/AppLauncherOverlay.vue     | 15 +++--------
 .../__tests__/useAppIdentity.test.ts          | 26 ++++++++++++++++++-
 .../src/views/appSession/useAppIdentity.ts    | 11 ++++++--
 3 files changed, 37 insertions(+), 15 deletions(-)

diff --git a/neode-ui/src/components/AppLauncherOverlay.vue b/neode-ui/src/components/AppLauncherOverlay.vue
index b44c6ae..2f85c07 100644
--- a/neode-ui/src/components/AppLauncherOverlay.vue
+++ b/neode-ui/src/components/AppLauncherOverlay.vue
@@ -297,8 +297,6 @@ interface SelectedIdentity {
   origin?: 'local' | 'linked'
 }
 
-const NATIVE_NOSTR_IDENTITY_APPS = new Set(['wildbloom', 'wildbloom-node', 'spry', 'kithmoot-node'])
-
 /** Get the stored identity for an app, or null if first launch */
 function getStoredIdentity(appUrl: string): SelectedIdentity | null {
   try {
@@ -340,14 +338,7 @@ function cancelIdentitySelection() {
   iframeRef.value?.contentWindow?.postMessage({ type: 'archipelago:identity-cancelled' }, '*')
 }
 
-function isNativeNostrApp(): boolean {
-  if (store.panelAppId) return NATIVE_NOSTR_IDENTITY_APPS.has(store.panelAppId)
-  const title = store.title.toLowerCase()
-  return title.includes('wildbloom') || title.includes('spry') || title.includes('kithmoot')
-}
-
-async function usesNativeNostrIdentity(identity: SelectedIdentity): Promise<boolean> {
-  if (!isNativeNostrApp()) return false
+async function isLinkedIdentity(identity: SelectedIdentity): Promise<boolean> {
   if (!identity.origin) {
     const resolved = await rpcClient.call<{ origin?: 'local' | 'linked' }>({
       method: 'identity.get', params: { id: identity.id }
@@ -360,9 +351,9 @@ async function usesNativeNostrIdentity(identity: SelectedIdentity): Promise<bool
 /** Send a specific identity to the iframe */
 async function sendSelectedIdentity(identity: SelectedIdentity) {
   try {
-    const nativeNostr = await usesNativeNostrIdentity(identity)
+    const linked = await isLinkedIdentity(identity)
     const challenge = `archipelago-identity:${Date.now()}`
-    const sigRes = nativeNostr ? null : await rpcClient.call<{ signature: string }>({
+    const sigRes = linked ? null : await rpcClient.call<{ signature: string }>({
       method: 'identity.sign',
       params: { id: identity.id, message: challenge }
     })
diff --git a/neode-ui/src/views/appSession/__tests__/useAppIdentity.test.ts b/neode-ui/src/views/appSession/__tests__/useAppIdentity.test.ts
index 5ee03ac..cb82740 100644
--- a/neode-ui/src/views/appSession/__tests__/useAppIdentity.test.ts
+++ b/neode-ui/src/views/appSession/__tests__/useAppIdentity.test.ts
@@ -16,7 +16,9 @@ const alice: SelectedIdentity = {
 describe('useAppIdentity explicit identity selection', () => {
   beforeEach(() => {
     localStorage.clear()
-    vi.mocked(rpcClient.call).mockResolvedValue({ signature: 'proof' })
+    vi.clearAllMocks()
+    vi.mocked(rpcClient.call).mockImplementation(async request =>
+      request.method === 'identity.get' ? { origin: 'local' } : { signature: 'proof' })
   })
 
   it('reuses a stored identity normally but reopens the picker for login', async () => {
@@ -38,6 +40,28 @@ describe('useAppIdentity explicit identity selection', () => {
     expect(postMessage).not.toHaveBeenCalled()
   })
 
+  it('hands a linked identity to the app without an impossible Ed25519 signature', async () => {
+    const postMessage = vi.fn()
+    const frame = ref({ contentWindow: { postMessage } } as unknown as HTMLIFrameElement)
+    const identity = useAppIdentity(ref('archipelago-source'), frame, ref(false))
+    identity.onIdentitySelected({ ...alice, origin: 'linked' })
+    await vi.waitFor(() => expect(postMessage).toHaveBeenCalled())
+    expect(rpcClient.call).not.toHaveBeenCalled()
+    expect(postMessage.mock.calls[0]![0]).not.toHaveProperty('signature')
+  })
+
+  it('resolves a legacy linked identity without requesting a password', async () => {
+    vi.mocked(rpcClient.call).mockResolvedValue({ origin: 'linked' })
+    const postMessage = vi.fn()
+    const frame = ref({ contentWindow: { postMessage } } as unknown as HTMLIFrameElement)
+    const identity = useAppIdentity(ref('archipelago-source'), frame, ref(false))
+    identity.onIdentitySelected(alice)
+    await vi.waitFor(() => expect(postMessage).toHaveBeenCalled())
+    expect(rpcClient.call).toHaveBeenCalledOnce()
+    expect(rpcClient.call).toHaveBeenCalledWith({ method: 'identity.get', params: { id: alice.id } })
+    expect(postMessage.mock.calls[0]![0]).not.toHaveProperty('signature')
+  })
+
   it('notifies the requesting app when the chooser is cancelled', () => {
     const postMessage = vi.fn()
     const frame = ref({ contentWindow: { postMessage } } as unknown as HTMLIFrameElement)
diff --git a/neode-ui/src/views/appSession/useAppIdentity.ts b/neode-ui/src/views/appSession/useAppIdentity.ts
index 91495c1..098e901 100644
--- a/neode-ui/src/views/appSession/useAppIdentity.ts
+++ b/neode-ui/src/views/appSession/useAppIdentity.ts
@@ -46,12 +46,19 @@ export function useAppIdentity(
 
   async function sendIdentity(identity: SelectedIdentity) {
     try {
+      if (!identity.origin) {
+        const resolved = await rpcClient.call<{ origin?: 'local' | 'linked' }>({ method: 'identity.get', params: { id: identity.id } })
+        identity.origin = resolved.origin
+      }
+      const linked = identity.origin === 'linked'
       const challenge = `archipelago-identity:${Date.now()}`
-      const sigRes = await rpcClient.call<{ signature: string }>({ method: 'identity.sign', params: { id: identity.id, message: challenge } })
+      const sigRes = linked ? null : await rpcClient.call<{ signature: string }>({ method: 'identity.sign', params: { id: identity.id, message: challenge } })
+      storeIdentity(identity)
       iframeRef.value?.contentWindow?.postMessage({
         type: 'archipelago:identity', did: identity.did, name: identity.name,
         pubkey: identity.pubkey, nostr_pubkey: identity.nostr_pubkey || null,
-        nostr_npub: identity.nostr_npub || null, challenge, signature: sigRes.signature
+        nostr_npub: identity.nostr_npub || null,
+        ...(sigRes ? { challenge, signature: sigRes.signature } : {})
       }, '*')
     } catch {}
   }
