+/// TLS terminates with the host's renewing certificate. The app receives no
+/// host private key. The only destination is this host's native Spry socket;
+/// no request, manifest URL or peer address can select another destination.
+async fn relay_turn<IO>(mut client: IO, port: u16)
+where
+    IO: tokio::io::AsyncRead + tokio::io::AsyncWrite + Unpin,
+{
+    if port != 3478 {
+        return;
+    }
+    for address in host_addresses()
+        .await
+        .into_iter()
+        .filter(|ip| ip.is_ipv4())
+        .take(8)
+    {
+        if let Ok(Ok(mut upstream)) = tokio::time::timeout(
+            std::time::Duration::from_millis(300),
+            tokio::net::TcpStream::connect(SocketAddr::new(address, port)),
+        )
+        .await
+        {
+            // Tokio's two fixed 8 KiB buffers and the global connection cap
+            // bound memory. TURN performs its own auth, quotas and expiry.
+            let _ = tokio::time::timeout(
+                std::time::Duration::from_secs(86400),
+                tokio::io::copy_bidirectional(&mut client, &mut upstream),
+            )
+            .await;
+            return;
+        }
+    }
+}
