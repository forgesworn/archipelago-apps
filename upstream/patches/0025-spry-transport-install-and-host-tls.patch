+//! Fixed transport firewall lifecycle for an owner-requested Spry install.
+//! Never enables a firewall, changes its policy or opens the dashboard.
+use anyhow::{anyhow, Result};
+use std::time::Duration;
+use tokio::process::Command;
+
+const MARK: &str = "archipelago-spry";
+const RULES: [&str; 5] = [
+    "3744/tcp",
+    "3478/tcp",
+    "3478/udp",
+    "5349/tcp",
+    "49160:49191/udp",
+];
+
+async fn ufw(args: &[&str]) -> Result<String> {
+    let output = tokio::time::timeout(
+        Duration::from_secs(15),
+        Command::new("sudo")
+            .args(["-n", "/usr/sbin/ufw"])
+            .args(args)
+            .env("LC_ALL", "C")
+            .kill_on_drop(true)
+            .output(),
+    )
+    .await
+    .map_err(|_| anyhow!("Spry firewall operation timed out"))??;
+    if !output.status.success() || output.stdout.len() > 65536 {
+        return Err(anyhow!(
+            "Spry could not configure its transport firewall rules"
+        ));
+    }
+    Ok(String::from_utf8_lossy(&output.stdout).into_owned())
+}
+
+fn owned(added: &str, rule: &str) -> bool {
+    RULES.contains(&rule)
+        && added
+            .lines()
+            .any(|line| line.trim() == format!("ufw allow {rule} comment '{MARK}'"))
+}
+
+pub async fn install() -> Result<()> {
+    if !std::path::Path::new("/usr/sbin/ufw").exists() {
+        return Ok(());
+    }
+    if !ufw(&["status"])
+        .await?
+        .lines()
+        .any(|l| l == "Status: active")
+    {
+        return Ok(());
+    }
+    let before = ufw(&["show", "added"]).await?;
+    for rule in RULES {
+        if let Err(error) = ufw(&["insert", "1", "allow", rule, "comment", MARK]).await {
+            // Insert skips equivalent existing rules, including their comment.
+            // Plain allow would replace the comment and steal ownership.
+            if let Ok(after) = ufw(&["show", "added"]).await {
+                for added in RULES {
+                    if !owned(&before, added) && owned(&after, added) {
+                        let _ = ufw(&["--force", "delete", "allow", added, "comment", MARK]).await;
+                    }
+                }
+            }
+            return Err(error);
+        }
+    }
+    Ok(())
+}
+
+pub async fn remove() -> Result<()> {
+    if !std::path::Path::new("/usr/sbin/ufw").exists() {
+        return Ok(());
+    }
+    let added = ufw(&["show", "added"]).await?;
+    for rule in RULES {
+        if owned(&added, rule) {
+            ufw(&["--force", "delete", "allow", rule, "comment", MARK]).await?;
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn only_exact_owned_fixed_transport_rules_can_be_removed() {
+        let rules = "ufw allow 22/tcp\nufw allow 3744/tcp comment 'another-app'\nufw allow 3478/udp comment 'archipelago-spry'\nufw allow 443/tcp comment 'archipelago-spry'\n";
+        assert!(owned(rules, "3478/udp"));
+        for rule in [
+            "22/tcp",
+            "3744/tcp",
+            "443/tcp",
+            "1:65535/tcp",
+            "3478/udp; reboot",
+        ] {
+            assert!(!owned(rules, rule));
+        }
+        assert_eq!(RULES.len(), 5);
+    }
+}
