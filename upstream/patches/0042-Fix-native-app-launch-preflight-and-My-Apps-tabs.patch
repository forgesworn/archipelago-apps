 import { resolveAppUrl } from '@/views/appSession/appSessionConfig'
@@ -190,8 +190,10 @@ async function handleTap(id: string, pkg: PackageDataEntry) {
     return
   }
   if (canLaunch(pkg)) {
-    const shown = await maybeShowCredentialsBeforeLaunch(id, pkg)
-    if (shown) return
+    if (appNeedsCredentialPreflight(id)) {
+      const shown = await maybeShowCredentialsBeforeLaunch(id, pkg)
+      if (shown) return
+    }
     launchNow(id, pkg, true)
   } else {
     emit('goToApp', id)
