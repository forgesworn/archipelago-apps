diff --git a/neode-ui/src/stores/appLauncher.ts b/neode-ui/src/stores/appLauncher.ts
index 4578137..68f6a2d 100644
--- a/neode-ui/src/stores/appLauncher.ts
+++ b/neode-ui/src/stores/appLauncher.ts
@@ -99,6 +99,10 @@ export const CREDENTIAL_INTERSTITIAL_APPS = new Set([
   'portainer',
 ])
 
+export function appNeedsCredentialPreflight(appId: string): boolean {
+  return appId === 'qortal' || CREDENTIAL_INTERSTITIAL_APPS.has(appId)
+}
+
 interface LaunchOptions {
   /** Basic offline launch grants no optional media integration. */
   basicFrameOnly?: boolean
diff --git a/neode-ui/src/views/Apps.vue b/neode-ui/src/views/Apps.vue
index 866f76a..404546a 100644
--- a/neode-ui/src/views/Apps.vue
+++ b/neode-ui/src/views/Apps.vue
@@ -385,7 +385,7 @@ import { useRouter, useRoute, RouterLink } from 'vue-router'
 import { useI18n } from 'vue-i18n'
 import { useAppStore } from '@/stores/app'
 import { useServerStore } from '@/stores/server'
-import { useAppLauncherStore } from '@/stores/appLauncher'
+import { appNeedsCredentialPreflight, useAppLauncherStore } from '@/stores/appLauncher'
 import { rpcClient } from '@/api/rpc-client'
 import { fetchPackageCredentials } from '@/api/packageCredentials'
 import { type AppCredential, type AppCredentialsResponse, type PackageDataEntry, type PackageState } from '@/types/api'
@@ -658,8 +658,10 @@ function goToApp(id: string) {
 }
 
 async function launchApp(id: string) {
-  const shown = await maybeShowCredentialsBeforeLaunch(id)
-  if (shown) return
+  if (appNeedsCredentialPreflight(id)) {
+    const shown = await maybeShowCredentialsBeforeLaunch(id)
+    if (shown) return
+  }
   launchAppNow(id, true)
 }
 
@@ -690,9 +692,9 @@ function launchAppNow(id: string, credentialsChecked = false) {
   useAppLauncherStore().openSession(id, { skipCredentialPrompt: credentialsChecked })
 }
 
-// Per-app credentials memo: the pre-launch RPC could hold an Apps-tab launch
-// hostage for its full 5s timeout over the mesh (home-card launches skip this
-// gate entirely, which is why they always felt instant). First launch waits at
+// Per-app credentials memo for the managed interstitials and Qortal: their
+// pre-launch RPC could hold an Apps-tab launch hostage for its full 5s timeout
+// over the mesh. First launch waits at
 // most LAUNCH_CRED_BUDGET_MS; the RPC keeps running in the background and its
 // answer is memoized, so every later launch of that app resolves instantly.
 const LAUNCH_CRED_BUDGET_MS = 1200
