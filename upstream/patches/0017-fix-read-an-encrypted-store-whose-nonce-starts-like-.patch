-    let bytes = if crate::storage_crypto::is_plaintext_json(&raw) {
-        raw
-    } else {
-        match crate::storage_crypto::derive_key(
-            data_dir,
-            crate::storage_crypto::DOMAIN_MESH_CONTACTS,
-        )
-        .await
-        {
-            Ok(k) => match crate::storage_crypto::open(&raw, &k) {
-                Ok(p) => p,
-                Err(e) => {
-                    warn!("mesh contacts: decrypt failed ({e}); keeping in-memory state");
-                    return std::collections::HashMap::new();
-                }
-            },
-            Err(_) => return std::collections::HashMap::new(),
+    let key =
+        crate::storage_crypto::derive_key(data_dir, crate::storage_crypto::DOMAIN_MESH_CONTACTS)
+            .await
+            .ok();
+    let bytes = match crate::storage_crypto::open_stored(raw, key.as_ref()) {
+        Ok(
+            crate::storage_crypto::Stored::Sealed(p) | crate::storage_crypto::Stored::Plaintext(p),
+        ) => p,
+        Err(e) => {
+            warn!("mesh contacts: decrypt failed ({e}); keeping in-memory state");
+            return std::collections::HashMap::new();
         }
     };
     serde_json::from_slice(&bytes).unwrap_or_default()
