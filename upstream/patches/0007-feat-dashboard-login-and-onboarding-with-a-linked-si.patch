diff --git a/neode-ui/src/views/dashboard/SignerLoginNotice.vue b/neode-ui/src/views/dashboard/SignerLoginNotice.vue
new file mode 100644
index 0000000..288705b
--- /dev/null
+++ b/neode-ui/src/views/dashboard/SignerLoginNotice.vue
@@ -0,0 +1,72 @@
+<template>
+  <div
+    v-if="notice"
+    class="fixed top-4 left-1/2 -translate-x-1/2 z-40 w-[min(92vw,34rem)]"
+    role="alert"
+    data-testid="signer-login-notice"
+  >
+    <div
+      class="path-option-card px-5 py-3 border-l-4 flex items-start gap-3 shadow-2xl"
+      :class="notice.urgent ? 'border-red-500 text-red-100' : 'border-yellow-500 text-yellow-100'"
+    >
+      <div class="flex-1 space-y-2 text-sm">
+        <p
+          v-for="(line, i) in notice.lines"
+          :key="i"
+          :class="{ 'font-semibold': line.urgent }"
+          :data-testid="line.urgent ? 'signer-notice-urgent' : undefined"
+        >{{ line.text }}</p>
+      </div>
+      <button class="text-sm text-white/70 hover:text-white" data-testid="signer-login-notice-dismiss" @click="dismiss">{{ t('signer.notice.dismiss') }}</button>
+    </div>
+  </div>
+</template>
+
+<script setup lang="ts">
+import { onMounted, ref } from 'vue'
+import { useI18n } from 'vue-i18n'
+import { signerApi, summariseStatus, type SignerAttemptRecord } from '@/api/signer-login'
+import { readDismissed, readLoginContext, writeDismissed } from '@/composables/loginRecord'
+
+const { t } = useI18n()
+const notice = ref<{ lines: Array<{ text: string; urgent: boolean }>; urgent: boolean; key: string } | null>(null)
+
+function addresses(list: SignerAttemptRecord[]): string {
+  return [...new Set(list.map(a => a.ip ?? t('signer.outcome.unknownIp')))].join(', ')
+}
+
+onMounted(async () => {
+  try {
+    const status = await signerApi.status()
+    const now = Math.floor(Date.now() / 1000)
+    const sum = summariseStatus(status, { now, ...readLoginContext() })
+    const lines: Array<{ text: string; urgent: boolean }> = []
+    if (sum.foreignApprovals.length) {
+      lines.push({ text: t('signer.notice.approvedElsewhere', { ips: addresses(sum.foreignApprovals) }), urgent: true })
+    }
+    if (sum.pending.length) {
+      lines.push({ text: t('signer.notice.pending', { ip: addresses(sum.pending) }), urgent: true })
+    }
+    if (sum.notApproved.length) {
+      lines.push({ text: t('signer.notice.notApproved', { count: sum.notApproved.length, ips: addresses(sum.notApproved) }, sum.notApproved.length), urgent: false })
+    }
+    if (sum.pausedUntil != null) {
+      lines.push({ text: t('signer.notice.paused', { time: new Date(sum.pausedUntil * 1000).toLocaleTimeString() }), urgent: false })
+    }
+    if (!lines.length) return
+    const all = [...sum.foreignApprovals, ...sum.pending, ...sum.notApproved]
+    const key = `${sum.pausedUntil ?? ''}|${all.map(a => `${a.at}${a.outcome}`).join(',')}`
+    if (readDismissed() === key) return
+    notice.value = { lines, urgent: lines.some(l => l.urgent), key }
+  } catch {
+    // Older node without the method, or not signed in: no notice.
+  }
+})
+
+function dismiss() {
+  if (notice.value) {
+    writeDismissed(notice.value.key)
+  }
+  notice.value = null
+}
+</script>
