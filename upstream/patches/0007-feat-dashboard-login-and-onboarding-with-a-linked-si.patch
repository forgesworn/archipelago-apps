+import { flushPromises, mount } from '@vue/test-utils'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+vi.mock('@/api/rpc-client', () => ({ rpcClient: { call: vi.fn() } }))
+vi.mock('@/api/signer-login', async (orig) => ({
+  ...(await orig<typeof import('@/api/signer-login')>()),
+  signerApi: { status: vi.fn() },
+}))
+
+import i18n from '@/i18n'
+import { signerApi, type SignerAttemptRecord } from '@/api/signer-login'
+import { recordLogin } from '@/composables/loginRecord'
+import SignerLoginNotice from '../SignerLoginNotice.vue'
+
+const status = vi.mocked(signerApi.status)
+const now = () => Math.floor(Date.now() / 1000)
+const rec = (secondsAgo: number, outcome: SignerAttemptRecord['outcome'], ip: string | null = '10.0.0.9'): SignerAttemptRecord =>
+  ({ at: now() - secondsAgo, ip, outcome })
+
+async function mountNotice() {
+  const w = mount(SignerLoginNotice, { global: { plugins: [i18n] } })
+  await flushPromises()
+  return w
+}
+
+describe('SignerLoginNotice', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    sessionStorage.clear()
+    localStorage.clear()
+  })
+
+  it('says nothing when there is nothing to report', async () => {
+    status.mockResolvedValue({ paused_until: null, recent: [] })
+    expect((await mountNotice()).find('[data-testid="signer-login-notice"]').exists()).toBe(false)
+  })
+
+  it('counts every kind of attempt nobody approved and names the addresses', async () => {
+    status.mockResolvedValue({
+      paused_until: null,
+      recent: [rec(500, 'denied', '10.0.0.9'), rec(400, 'expired', '10.0.0.9'), rec(300, 'offline', null)],
+    })
+    const w = await mountNotice()
+    expect(w.text()).toContain('3 signer login attempts since your last login were not approved (from 10.0.0.9, unknown address).')
+  })
+
+  it('uses the singular for one attempt', async () => {
+    status.mockResolvedValue({ paused_until: null, recent: [rec(300, 'denied')] })
+    expect((await mountNotice()).text()).toContain('One signer login attempt since your last login was not approved (from 10.0.0.9).')
+  })
+
+  it('warns about a prompt waiting on the signer right now', async () => {
+    status.mockResolvedValue({ paused_until: null, recent: [rec(15, 'pending', '192.168.1.77')] })
+    const w = await mountNotice()
+    expect(w.find('[data-testid="signer-notice-urgent"]').text()).toBe(
+      'A login is waiting on your signer, started from 192.168.1.77. If your signer is asking, deny it.',
+    )
+  })
+
+  it('flags an approved login that did not lead to this one, prominently', async () => {
+    recordLogin(false)
+    status.mockResolvedValue({ paused_until: null, recent: [rec(30, 'approved', '203.0.113.9')] })
+    const w = await mountNotice()
+    const urgent = w.find('[data-testid="signer-notice-urgent"]')
+    expect(urgent.text()).toContain('Your signer approved a login from 203.0.113.9.')
+    expect(urgent.text()).toContain('someone else may have access')
+    expect(w.find('[data-testid="signer-login-notice"] .border-red-500').exists()).toBe(true)
+  })
+
+  it('does not flag the approval behind this very signer login', async () => {
+    recordLogin(true, now(), now() - 6)
+    status.mockResolvedValue({ paused_until: null, recent: [rec(6, 'approved', '10.0.0.1')] })
+    expect((await mountNotice()).find('[data-testid="signer-login-notice"]').exists()).toBe(false)
+  })
+
+  describe('a tab that did not do the login (a new tab)', () => {
+    it('does not show the owner\'s own signer login as someone else', async () => {
+      recordLogin(true, now() - 3000, now() - 3006)
+      sessionStorage.clear()
+      status.mockResolvedValue({ paused_until: null, recent: [rec(3006, 'approved', '10.0.0.1')] })
+      expect((await mountNotice()).find('[data-testid="signer-login-notice"]').exists()).toBe(false)
+    })
+
+    it('does not show an earlier signer login either', async () => {
+      recordLogin(true, now() - 9000, now() - 9005)
+      recordLogin(false, now() - 100)
+      sessionStorage.clear()
+      status.mockResolvedValue({ paused_until: null, recent: [rec(9005, 'approved', '10.0.0.1')] })
+      expect((await mountNotice()).find('[data-testid="signer-login-notice"]').exists()).toBe(false)
+    })
+
+    it('still flags another address approving after the last login', async () => {
+      recordLogin(true, now() - 3000, now() - 3006)
+      sessionStorage.clear()
+      status.mockResolvedValue({
+        paused_until: null,
+        recent: [rec(3006, 'approved', '10.0.0.1'), rec(120, 'approved', '203.0.113.9')],
+      })
+      const w = await mountNotice()
+      expect(w.find('[data-testid="signer-notice-urgent"]').text()).toContain('203.0.113.9')
+      expect(w.text()).not.toContain('10.0.0.1')
+    })
+
+    it('stays dismissed in another tab', async () => {
+      status.mockResolvedValue({ paused_until: null, recent: [rec(300, 'expired')] })
+      const w = await mountNotice()
+      await w.find('[data-testid="signer-login-notice-dismiss"]').trigger('click')
+      sessionStorage.clear()
+      expect((await mountNotice()).find('[data-testid="signer-login-notice"]').exists()).toBe(false)
+    })
+  })
+
+  it('only mentions a pause when one is set, and never claims it was reset', async () => {
+    status.mockResolvedValue({ paused_until: now() + 600, recent: [rec(300, 'refused-budget')] })
+    const w = await mountNotice()
+    expect(w.text()).toMatch(/Signer login is paused until .+\. Logging in with your password clears it\./)
+    expect(w.text()).not.toContain('has reset it')
+
+    sessionStorage.clear()
+    status.mockResolvedValue({ paused_until: null, recent: [rec(300, 'expired')] })
+    const unpaused = await mountNotice()
+    expect(unpaused.text()).not.toMatch(/paused|reset/i)
+    expect(unpaused.text()).toContain('not approved')
+  })
+
+  it('ignores attempts from before the last login on this browser', async () => {
+    recordLogin(false, now() - 1000)
+    recordLogin(false)
+    status.mockResolvedValue({ paused_until: null, recent: [rec(5000, 'expired'), rec(4000, 'approved')] })
+    expect((await mountNotice()).find('[data-testid="signer-login-notice"]').exists()).toBe(false)
+  })
+
+  it('stays dismissed for the session, and quiet when the node lacks the method', async () => {
+    status.mockResolvedValue({ paused_until: null, recent: [rec(300, 'expired')] })
+    const w = await mountNotice()
+    await w.find('[data-testid="signer-login-notice-dismiss"]').trigger('click')
+    expect(w.find('[data-testid="signer-login-notice"]').exists()).toBe(false)
+    expect((await mountNotice()).find('[data-testid="signer-login-notice"]').exists()).toBe(false)
+
+    sessionStorage.clear()
+    status.mockRejectedValue(new Error('Method not found'))
+    expect((await mountNotice()).find('[data-testid="signer-login-notice"]').exists()).toBe(false)
+  })
+})
