diff --git a/neode-ui/src/api/signer-login.ts b/neode-ui/src/api/signer-login.ts
new file mode 100644
index 0000000..092eae3
--- /dev/null
+++ b/neode-ui/src/api/signer-login.ts
@@ -0,0 +1,165 @@
+// RPC calls for logging in to the node with a linked signer. Kept in one place
+// so a backend rename is a one-line change here. Start and link calls are never
+// retried: a retry would put a second prompt on the owner's signer.
+
+import { rpcClient } from './rpc-client'
+
+export interface SignerAttempt {
+  attempt_id: string
+  code: string
+}
+
+export type LoginFinish = { status: 'pending' } | { status: 'approved' }
+
+export interface EnrolledSigner {
+  identity_id: string
+  pubkey: string
+  added_at: string
+  approval_ms: number
+  quick_approval: boolean
+}
+
+export type EnrolFinish = { status: 'pending' } | ({ status: 'enrolled' } & EnrolledSigner)
+
+export interface LoginSigner {
+  identity_id: string
+  pubkey: string
+  added_at: string
+  name: string
+}
+
+export interface LinkedIdentity {
+  id: string
+  name: string
+  [key: string]: unknown
+}
+
+/** How one recent signer attempt ended, as the node reports it. */
+export type AttemptOutcome =
+  | 'pending' | 'approved' | 'denied' | 'expired' | 'offline'
+  | 'refused' | 'failed' | 'refused-busy' | 'refused-budget'
+
+export interface SignerAttemptRecord {
+  /** Unix seconds (UTC). */
+  at: number
+  /** Address the attempt came from; null when the node could not tell. */
+  ip: string | null
+  outcome: AttemptOutcome
+}
+
+export interface SignerStatus {
+  /** Unix seconds (UTC) until which signer login is paused, or null. */
+  paused_until: number | null
+  /** Oldest first, at most 20. */
+  recent: SignerAttemptRecord[]
+}
+
+/** Signer prompts are only accepted from the dashboard on port 80 or 443 (and,
+ *  in development, a loopback host), so on any other port the signer options
+ *  are hidden. */
+export function signerLoginAllowedHere(
+  loc: Pick<Location, 'port' | 'hostname'> = window.location,
+  dev: boolean = import.meta.env.DEV,
+): boolean {
+  if (loc.port === '' || loc.port === '80' || loc.port === '443') return true
+  return dev && ['localhost', '127.0.0.1', '[::1]', '::1'].includes(loc.hostname)
+}
+
+const NOT_APPROVED: AttemptOutcome[] = ['denied', 'expired', 'offline', 'refused', 'failed', 'refused-busy', 'refused-budget']
+/** A pending attempt older than this has been given up on by the node. */
+const PENDING_FRESH_SECONDS = 130
+/** The node stamps an attempt when it starts; the browser notes when `start`
+ *  returned. Matching is one to one and nearest first, so this only bounds how
+ *  far apart the two clocks may be: it does not decide which approval is ours. */
+const OWN_START_TOLERANCE_SECONDS = 5 * 60
+const FALLBACK_WINDOW_SECONDS = 24 * 60 * 60
+
+export interface StatusSummary {
+  /** Approved logins that did not lead to this one: possibly someone else. */
+  foreignApprovals: SignerAttemptRecord[]
+  /** Prompts on the signer right now. */
+  pending: SignerAttemptRecord[]
+  /** Attempts nobody approved, since the owner's last login. */
+  notApproved: SignerAttemptRecord[]
+  pausedUntil: number | null
+}
+
+/** What the post-login notice should say. `sinceLogin` is where to start
+ *  counting (Unix seconds), `ownSignerStarts` the times `start` returned for the
+ *  signer logins this browser completed. */
+export function summariseStatus(
+  status: SignerStatus,
+  ctx: { now: number; sinceLogin: number | null; ownSignerStarts: number[] },
+): StatusSummary {
+  const cutoff = ctx.sinceLogin ?? ctx.now - FALLBACK_WINDOW_SECONDS
+  const relevant = (status.recent ?? []).filter(a => a.at >= cutoff)
+  // Each start this browser remembers accounts for at most one approval, the
+  // nearest in time. Anything left over was approved for someone else's attempt.
+  const approved = relevant.filter(a => a.outcome === 'approved')
+  const pairs: Array<{ dist: number; start: number; rec: SignerAttemptRecord }> = []
+  ctx.ownSignerStarts.forEach((start, si) => {
+    for (const rec of approved) {
+      const dist = Math.abs(rec.at - start)
+      if (dist <= OWN_START_TOLERANCE_SECONDS) pairs.push({ dist, start: si, rec })
+    }
+  })
+  pairs.sort((x, y) => x.dist - y.dist)
+  const usedStarts = new Set<number>()
+  const own = new Set<SignerAttemptRecord>()
+  for (const p of pairs) {
+    if (usedStarts.has(p.start) || own.has(p.rec)) continue
+    usedStarts.add(p.start)
+    own.add(p.rec)
+  }
+  return {
+    foreignApprovals: approved.filter(a => !own.has(a)),
+    pending: relevant.filter(a => a.outcome === 'pending' && a.at >= ctx.now - PENDING_FRESH_SECONDS),
+    notApproved: relevant.filter(a => NOT_APPROVED.includes(a.outcome)),
+    pausedUntil: status.paused_until ?? null,
+  }
+}
+
+/** One poll waits up to 10 s on the server; leave headroom. */
+const POLL_TIMEOUT_MS = 20000
+/** Linking asks the signer to approve twice, so the call can run for minutes. */
+const LINK_TIMEOUT_MS = 180000
+
+export const signerApi = {
+  loginAvailable(): Promise<boolean> {
+    return rpcClient.call<boolean>({ method: 'auth.login.signer.available', params: {}, timeout: 8000, maxRetries: 1 })
+  },
+  loginStart(): Promise<SignerAttempt> {
+    return rpcClient.call<SignerAttempt>({ method: 'auth.login.signer.start', params: {}, maxRetries: 1 })
+  },
+  loginFinish(attemptId: string, signal?: AbortSignal): Promise<LoginFinish> {
+    return rpcClient.call<LoginFinish>({
+      method: 'auth.login.signer.finish', params: { attempt_id: attemptId }, timeout: POLL_TIMEOUT_MS, maxRetries: 1, signal,
+    })
+  },
+  enrolStart(identityId: string, password: string): Promise<SignerAttempt> {
+    return rpcClient.call<SignerAttempt>({
+      method: 'auth.signer.enrol.start', params: { identity_id: identityId, password }, maxRetries: 1,
+    })
+  },
+  enrolFinish(attemptId: string, signal?: AbortSignal): Promise<EnrolFinish> {
+    return rpcClient.call<EnrolFinish>({
+      method: 'auth.signer.enrol.finish', params: { attempt_id: attemptId }, timeout: POLL_TIMEOUT_MS, maxRetries: 1, signal,
+    })
+  },
+  list(): Promise<LoginSigner[]> {
+    return rpcClient.call<LoginSigner[]>({ method: 'auth.signer.list', params: {}, maxRetries: 1 })
+  },
+  remove(identityId: string, password: string): Promise<{ removed: boolean }> {
+    return rpcClient.call<{ removed: boolean }>({
+      method: 'auth.signer.remove', params: { identity_id: identityId, password }, maxRetries: 1,
+    })
+  },
+  status(): Promise<SignerStatus> {
+    return rpcClient.call<SignerStatus>({ method: 'auth.signer.status', params: {}, maxRetries: 1 })
+  },
+  linkBunker(bunkerUri: string, name: string): Promise<LinkedIdentity> {
+    return rpcClient.call<LinkedIdentity>({
+      method: 'identity.link-nip46', params: { bunker_uri: bunkerUri, name }, timeout: LINK_TIMEOUT_MS, maxRetries: 1,
+    })
+  },
+}
