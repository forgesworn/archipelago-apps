+import { flushPromises, mount } from '@vue/test-utils'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+vi.mock('@/api/rpc-client', () => ({ rpcClient: { call: vi.fn() } }))
+vi.mock('@/api/signer-login', async (orig) => ({
+  ...(await orig<typeof import('@/api/signer-login')>()),
+  signerApi: { list: vi.fn(), status: vi.fn(), remove: vi.fn(), enrolStart: vi.fn(), enrolFinish: vi.fn() },
+}))
+
+import { rpcClient } from '@/api/rpc-client'
+import { signerApi } from '@/api/signer-login'
+import i18n from '@/i18n'
+import LoginSignersSection from '../LoginSignersSection.vue'
+
+const api = vi.mocked(signerApi)
+const rpc = vi.mocked(rpcClient)
+
+const enrolled = { identity_id: 'linked-1', pubkey: 'ab'.repeat(32), added_at: '2026-10-04T00:00:00Z', name: 'Heartwood' }
+const linked = { id: 'linked-1', name: 'Heartwood', origin: 'linked' }
+const local = { id: 'id-primary', name: 'Primary', origin: 'local' }
+
+function mountSection() {
+  return mount(LoginSignersSection, { global: { plugins: [i18n], stubs: { Teleport: true } } })
+}
+
+describe('LoginSignersSection', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    api.list.mockResolvedValue([])
+    api.status.mockResolvedValue({ paused_until: null, recent: [] })
+    rpc.call.mockResolvedValue({ identities: [local, linked] })
+  })
+
+  it('lists the enrolled signer with a remove button and no add button', async () => {
+    api.list.mockResolvedValue([enrolled])
+    const w = mountSection()
+    await flushPromises()
+    expect(w.findAll('[data-testid="login-signer-row"]')).toHaveLength(1)
+    expect(w.text()).toContain('Heartwood')
+    expect(w.find('[data-testid="add-login-signer"]').exists()).toBe(false)
+  })
+
+  it('offers only linked identities when adding', async () => {
+    const w = mountSection()
+    await flushPromises()
+    await w.find('[data-testid="add-login-signer"]').trigger('click')
+    await flushPromises()
+    const options = w.findAll('#add-signer-identity option').map(o => o.text())
+    expect(options).toEqual(['Heartwood'])
+  })
+
+  it('points to the Identities page when nothing is linked yet', async () => {
+    rpc.call.mockResolvedValue({ identities: [local] })
+    const w = mountSection()
+    await flushPromises()
+    await w.find('[data-testid="add-login-signer"]').trigger('click')
+    await flushPromises()
+    expect(w.find('[data-testid="no-linked-identities"]').text()).toContain('Identities page')
+  })
+
+  it('enrols with the password, shows the code, then lists the signer', async () => {
+    api.enrolStart.mockResolvedValue({ attempt_id: 'e1', code: '0042' })
+    let finish!: (v: unknown) => void
+    api.enrolFinish.mockReturnValue(new Promise(r => { finish = r }) as never)
+    const w = mountSection()
+    await flushPromises()
+    await w.find('[data-testid="add-login-signer"]').trigger('click')
+    await flushPromises()
+    await w.find('#add-signer-password').setValue('my password')
+    await w.find('form').trigger('submit')
+    await flushPromises()
+
+    expect(api.enrolStart).toHaveBeenCalledWith('linked-1', 'my password')
+    expect(w.find('[data-testid="signer-code"]').text()).toBe('0042')
+    expect(w.text()).toContain('deny it')
+
+    api.list.mockResolvedValue([enrolled])
+    finish({ status: 'enrolled', ...enrolled, approval_ms: 4000, quick_approval: true })
+    await flushPromises()
+    expect(w.find('[data-testid="signer-enrolled"]').exists()).toBe(true)
+    expect(w.find('[data-testid="quick-approval-warning"]').exists()).toBe(true)
+    expect(w.findAll('[data-testid="login-signer-row"]')).toHaveLength(1)
+  })
+
+  it('shows a wrong-password refusal from the node', async () => {
+    api.enrolStart.mockRejectedValue(new Error('Password Incorrect'))
+    const w = mountSection()
+    await flushPromises()
+    await w.find('[data-testid="add-login-signer"]').trigger('click')
+    await flushPromises()
+    await w.find('#add-signer-password').setValue('nope')
+    await w.find('form').trigger('submit')
+    await flushPromises()
+    expect(w.text()).toContain('Password Incorrect')
+  })
+
+  it('removes a signer only with the password', async () => {
+    api.list.mockResolvedValue([enrolled])
+    api.remove.mockResolvedValue({ removed: true })
+    const w = mountSection()
+    await flushPromises()
+    await w.find('[data-testid="login-signer-row"] button').trigger('click')
+    const submit = w.find('#remove-login-signer-title').element.parentElement!.querySelector('button[type="submit"]') as HTMLButtonElement
+    expect(submit.disabled).toBe(true)
+
+    api.list.mockResolvedValue([])
+    await w.find('input[aria-label="Password"]').setValue('my password')
+    await w.findAll('form')[w.findAll('form').length - 1]!.trigger('submit')
+    await flushPromises()
+
+    expect(api.remove).toHaveBeenCalledWith('linked-1', 'my password')
+    expect(w.findAll('[data-testid="login-signer-row"]')).toHaveLength(0)
+  })
+
+  it('keeps the signer and shows the error when removal is refused', async () => {
+    api.list.mockResolvedValue([enrolled])
+    api.remove.mockRejectedValue(new Error('Password Incorrect'))
+    const w = mountSection()
+    await flushPromises()
+    await w.find('[data-testid="login-signer-row"] button').trigger('click')
+    await w.find('input[aria-label="Password"]').setValue('wrong')
+    await w.findAll('form')[w.findAll('form').length - 1]!.trigger('submit')
+    await flushPromises()
+    expect(w.text()).toContain('Password Incorrect')
+    expect(w.findAll('[data-testid="login-signer-row"]')).toHaveLength(1)
+  })
+
+  it('lists recent attempts newest first, in words, and says when signer login is paused', async () => {
+    api.list.mockResolvedValue([enrolled])
+    api.status.mockResolvedValue({
+      paused_until: 1790000000,
+      recent: [
+        { at: 1789999000, ip: '192.168.1.40', outcome: 'expired' },
+        { at: 1789999100, ip: null, outcome: 'refused-budget' },
+        { at: 1789999200, ip: '192.168.1.41', outcome: 'pending' },
+        { at: 1789999300, ip: '192.168.1.42', outcome: 'refused' },
+      ],
+    })
+    const w = mountSection()
+    await flushPromises()
+    const rows = w.findAll('[data-testid="signer-attempt-row"]').map(r => r.text())
+    expect(rows).toHaveLength(4)
+    expect(rows[0]).toContain('Reply refused')
+    expect(rows[0]).toContain('192.168.1.42')
+    expect(rows[1]).toContain('Waiting for approval')
+    expect(rows[2]).toContain('Refused: too many attempts')
+    expect(rows[2]).toContain('unknown address')
+    expect(rows[3]).toContain('Not answered')
+    expect(w.find('[data-testid="signer-paused"]').text()).toMatch(/^Signer login is paused until .+\. Logging in with your password clears it\.$/)
+    expect(w.text()).not.toContain('unanswered')
+  })
+
+  it('goes back to the form when the node refuses before asking the signer (wrong password)', async () => {
+    api.enrolStart.mockRejectedValue(new Error('Password Incorrect'))
+    const w = mountSection()
+    await flushPromises()
+    await w.find('[data-testid="add-login-signer"]').trigger('click')
+    await flushPromises()
+    await w.find('#add-signer-password').setValue('nope')
+    await w.find('form').trigger('submit')
+    await flushPromises()
+    expect(w.find('#add-signer-password').exists()).toBe(true)
+    expect((w.find('#add-signer-password').element as HTMLInputElement).value).toBe('nope')
+    expect(w.find('[role="alert"]').text()).toBe('Password Incorrect')
+  })
+
+  it('words an enrolment that is already waiting as its own problem', async () => {
+    api.enrolStart.mockRejectedValue(new Error('linked signer is already waiting to approve an enrolment; approve or deny it on the signer first'))
+    const w = mountSection()
+    await flushPromises()
+    await w.find('[data-testid="add-login-signer"]').trigger('click')
+    await flushPromises()
+    await w.find('#add-signer-password').setValue('my password')
+    await w.find('form').trigger('submit')
+    await flushPromises()
+    expect(w.text()).toContain('Your signer is already handling a login or enrolment. Finish or deny that first.')
+    expect(w.text()).not.toContain("didn't come from this page")
+  })
+
+  describe('cancelling while the signer is being asked', () => {
+    async function cancelled() {
+      api.enrolStart.mockResolvedValue({ attempt_id: 'e1', code: '0042' })
+      const polls: Array<(v: unknown) => void> = []
+      api.enrolFinish.mockImplementation(() => new Promise((resolve) => { polls.push(resolve) }) as never)
+      const w = mountSection()
+      await flushPromises()
+      await w.find('[data-testid="add-login-signer"]').trigger('click')
+      await flushPromises()
+      await w.find('#add-signer-password').setValue('my password')
+      await w.find('form').trigger('submit')
+      await flushPromises()
+      await w.find('[data-testid="add-login-signer-close"]').trigger('click')
+      await flushPromises()
+      return { w, polls }
+    }
+
+    it('says the signer may still be asking and keeps the dialog open', async () => {
+      const { w } = await cancelled()
+      expect(w.find('[data-testid="signer-still-asking"]').text()).toContain('Your signer may still be asking. Deny it there.')
+      expect(w.find('[data-testid="signer-code"]').exists()).toBe(false)
+      expect(w.find('[data-testid="add-login-signer-close"]').text()).toBe('Close')
+    })
+
+    it('shows a late enrolment, with the quick-approval warning, and refreshes the list', async () => {
+      const { w, polls } = await cancelled()
+      api.list.mockResolvedValue([enrolled])
+      polls[0]!({ status: 'enrolled', ...enrolled, approval_ms: 200, quick_approval: true })
+      await flushPromises()
+      expect(w.find('[data-testid="signer-enrolled"]').exists()).toBe(true)
+      expect(w.find('[data-testid="quick-approval-warning"]').exists()).toBe(true)
+      expect(w.findAll('[data-testid="login-signer-row"]')).toHaveLength(1)
+      expect(w.find('[data-testid="add-login-signer-close"]').text()).toBe('Done')
+    })
+  })
+
+  it('hides the section for someone who may not manage signers', async () => {
+    api.list.mockRejectedValue(new Error('Forbidden: insufficient permissions'))
+    const w = mountSection()
+    await flushPromises()
+    expect(w.find('[data-testid="login-signers"]').exists()).toBe(false)
+  })
+
+  it('explains the address to use when the dashboard is on another port', async () => {
+    const orig = window.location
+    Object.defineProperty(window, 'location', { value: { ...orig, port: '8080', hostname: '192.0.2.10' }, writable: true, configurable: true })
+    try {
+      const w = mountSection()
+      await flushPromises()
+      expect(w.find('[data-testid="add-login-signer"]').exists()).toBe(false)
+      expect(w.find('[data-testid="signer-wrong-port"]').text()).toContain('usual address')
+    } finally {
+      Object.defineProperty(window, 'location', { value: orig, writable: true, configurable: true })
+    }
+  })
+
+  it('still lists signers when the status call is unavailable', async () => {
+    api.list.mockResolvedValue([enrolled])
+    api.status.mockRejectedValue(new Error('Method not found'))
+    const w = mountSection()
+    await flushPromises()
+    expect(w.findAll('[data-testid="login-signer-row"]')).toHaveLength(1)
+    expect(w.find('[data-testid="signer-attempts"]').exists()).toBe(false)
+  })
+})
