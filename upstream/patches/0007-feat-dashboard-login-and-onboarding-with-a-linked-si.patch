@@ -6115,6 +6235,63 @@ function sessionBucketProxy(bucket) {
 const mockData = sessionBucketProxy('mockData')
 const walletState = sessionBucketProxy('walletState')
 const userState = sessionBucketProxy('userState')
+
+// ── Linked-signer dev stand-in (see the auth.login.signer.* cases) ──────────
+const MOCK_SIGNER_TEXT = {
+  notEnabled: 'linked signer login is not enabled on this node',
+  busy: 'linked signer login is busy: another login is waiting for approval. If your signer is asking right now, that request did not come from this page: deny it',
+  paused: 'linked signer login is paused after recent attempts; log in with the password or try again in a few minutes',
+  expired: 'linked signer did not approve the login in time',
+  gone: 'Invalid signer login attempt: it is unknown, used or expired',
+  offline: 'linked signer is offline',
+  denied: 'linked signer denied the login',
+  refused: 'linked signer login was refused: the signed reply did not check out',
+  failed: 'linked signer login failed',
+  enrolBusy: 'linked signer is already waiting to approve an enrolment; approve or deny it on the signer first',
+}
+const mockSigner = {
+  linked: [],
+  enrolled: null,
+  attempts: new Map(),
+  linkedIdentities() {
+    return this.linked.map(i => ({
+      ...i, origin: 'linked',
+      signer: { remote_signer_pubkey: i.nostr_pubkey, relays: ['wss://relay.example'] },
+    }))
+  },
+  link(name) {
+    const n = this.linked.length + 1
+    const hex = (n.toString(16).padStart(2, '0')).repeat(32)
+    const rec = {
+      id: `linked-${n}`, name, purpose: 'personal', pubkey: hex,
+      did: `did:key:z6MkLinked${n}`, created_at: new Date().toISOString(), is_default: false,
+      nostr_pubkey: hex, nostr_npub: `npub1linked${n}`, profile: {},
+    }
+    this.linked.push(rec)
+    return { ...rec, origin: 'linked' }
+  },
+  begin(purpose, identityId) {
+    const attempt_id = Math.random().toString(16).slice(2).padEnd(32, '0').slice(0, 32)
+    const code = String(Math.floor(Math.random() * 10000)).padStart(4, '0')
+    this.attempts.set(attempt_id, { purpose, identityId, code, startedAt: Date.now() })
+    return { attempt_id, code }
+  },
+  async poll(attemptId, purpose) {
+    const a = this.attempts.get(attemptId)
+    if (!a || a.purpose !== purpose) return { error: MOCK_SIGNER_TEXT.gone }
+    const outcome = process.env.MOCK_SIGNER_OUTCOME
+    await new Promise(r => setTimeout(r, 1500))
+    if (Date.now() - a.startedAt < 4000) return { status: 'pending' }
+    this.attempts.delete(attemptId)
+    if (['denied', 'offline', 'expired', 'refused', 'failed'].includes(outcome)) return { error: MOCK_SIGNER_TEXT[outcome] }
+    return { status: 'approved', identityId: a.identityId }
+  },
+}
+if (process.env.MOCK_SIGNER_ENROLLED === '1') {
+  const r = mockSigner.link('Heartwood')
+  mockSigner.enrolled = { identity_id: r.id, pubkey: r.nostr_pubkey, added_at: new Date().toISOString() }
+}
+
 const mockState = sessionBucketProxy('mockState')
 
 // ── Lightning macaroon rotation (mock) ──────────────────────────────────────
