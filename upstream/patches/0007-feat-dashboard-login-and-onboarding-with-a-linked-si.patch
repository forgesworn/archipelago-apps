diff --git a/neode-ui/src/components/signer/ConnectSignerStep.vue b/neode-ui/src/components/signer/ConnectSignerStep.vue
new file mode 100644
index 0000000..2e42cb4
--- /dev/null
+++ b/neode-ui/src/components/signer/ConnectSignerStep.vue
@@ -0,0 +1,68 @@
+<template>
+  <div data-testid="connect-signer-step">
+    <div class="mb-6 text-center">
+      <h2 class="text-lg font-semibold text-white mb-1">{{ t('signer.connect.title') }}</h2>
+      <p class="text-sm text-white/65">{{ t('signer.connect.intro') }}</p>
+    </div>
+
+    <LinkSignerForm v-if="step === 'link'" @linked="onLinked" />
+    <SignerEnrolProgress v-else :approval="approval" />
+
+    <button
+      type="button"
+      class="w-full mt-4 px-4 py-2 rounded-lg font-medium transition-colors"
+      :class="enrolledNow ? 'glass-button glass-button-warning' : 'text-white/70 hover:text-white text-sm'"
+      data-testid="connect-signer-continue"
+      @click="leave"
+    >{{ continueLabel }}</button>
+  </div>
+</template>
+
+<script setup lang="ts">
+import { computed, ref } from 'vue'
+import { useI18n } from 'vue-i18n'
+import LinkSignerForm from '@/components/signer/LinkSignerForm.vue'
+import SignerEnrolProgress from '@/components/signer/SignerEnrolProgress.vue'
+import { signerApi, type EnrolFinish, type LinkedIdentity } from '@/api/signer-login'
+import { useSignerApproval } from '@/composables/useSignerApproval'
+
+/** `password` is the one just chosen. It is held in memory for this step only
+ *  and is never written anywhere; the parent clears it when `done` fires. */
+const props = defineProps<{ password: string }>()
+const emit = defineEmits<{ done: [] }>()
+const { t } = useI18n()
+
+const step = ref<'link' | 'enrol'>('link')
+const identityId = ref('')
+
+const approval = useSignerApproval<EnrolFinish>(
+  () => signerApi.enrolStart(identityId.value, props.password),
+  (attemptId, signal) => signerApi.enrolFinish(attemptId, signal),
+  'enrolled',
+  { enrol: true },
+)
+
+const enrolledNow = computed(() => approval.phase.value === 'approved' || approval.late.value?.ok === true)
+const continueLabel = computed(() => {
+  if (enrolledNow.value) return t('signer.enrol.continue')
+  if (approval.waitingInBackground.value) return t('signer.enrol.continueAnyway')
+  return t('signer.enrol.skip')
+})
+
+function onLinked(identity: LinkedIdentity) {
+  identityId.value = identity.id
+  step.value = 'enrol'
+  void approval.run()
+}
+
+/** Skipping while the signer is being asked first says so, and keeps watching;
+ *  the next press leaves. */
+function leave() {
+  if (approval.phase.value === 'waiting' || approval.phase.value === 'starting') {
+    approval.cancel()
+    return
+  }
+  approval.stop()
+  emit('done')
+}
+</script>
diff --git a/neode-ui/src/components/signer/LinkSignerForm.vue b/neode-ui/src/components/signer/LinkSignerForm.vue
new file mode 100644
index 0000000..54e2605
