@@ -0,0 +1,162 @@
+import { afterEach, describe, expect, it } from 'vitest'
+import { signerLoginAllowedHere, summariseStatus, type SignerAttemptRecord } from '../signer-login'
+import { readDismissed, readLoginContext, recordLogin, writeDismissed } from '@/composables/loginRecord'
+
+const NOW = 1_790_000_000
+const at = (secondsAgo: number, outcome: SignerAttemptRecord['outcome'], ip: string | null = '10.0.0.9'): SignerAttemptRecord =>
+  ({ at: NOW - secondsAgo, ip, outcome })
+const none = { now: NOW, sinceLogin: null, ownSignerStarts: [] as number[] }
+
+describe('signerLoginAllowedHere', () => {
+  it('allows the dashboard on the default ports only', () => {
+    expect(signerLoginAllowedHere({ port: '', hostname: 'node.local' }, false)).toBe(true)
+    expect(signerLoginAllowedHere({ port: '443', hostname: 'node.local' }, false)).toBe(true)
+    expect(signerLoginAllowedHere({ port: '80', hostname: 'node.local' }, false)).toBe(true)
+    expect(signerLoginAllowedHere({ port: '8080', hostname: 'node.local' }, false)).toBe(false)
+  })
+
+  it('allows loopback on another port only in development', () => {
+    expect(signerLoginAllowedHere({ port: '8100', hostname: 'localhost' }, true)).toBe(true)
+    expect(signerLoginAllowedHere({ port: '8100', hostname: 'localhost' }, false)).toBe(false)
+    expect(signerLoginAllowedHere({ port: '8100', hostname: '192.0.2.10' }, true)).toBe(false)
+  })
+})
+
+describe('summariseStatus', () => {
+  it('counts every outcome nobody approved, not only unanswered ones', () => {
+    const s = summariseStatus({
+      paused_until: null,
+      recent: [at(900, 'denied'), at(800, 'expired'), at(700, 'offline'), at(600, 'refused'), at(500, 'failed'), at(400, 'refused-busy'), at(300, 'refused-budget')],
+    }, none)
+    expect(s.notApproved).toHaveLength(7)
+    expect(s.foreignApprovals).toHaveLength(0)
+    expect(s.pending).toHaveLength(0)
+  })
+
+  it('treats a fresh pending attempt as a prompt on the signer now, and ignores a stale one', () => {
+    const s = summariseStatus({ paused_until: null, recent: [at(20, 'pending', '192.168.1.77'), at(600, 'pending')] }, none)
+    expect(s.pending.map(a => a.ip)).toEqual(['192.168.1.77'])
+  })
+
+  it('flags an approval that did not lead to this login', () => {
+    const s = summariseStatus({ paused_until: null, recent: [at(60, 'approved', '203.0.113.9')] }, none)
+    expect(s.foreignApprovals.map(a => a.ip)).toEqual(['203.0.113.9'])
+  })
+
+  it('does not flag an approval this browser started, whenever it was approved', () => {
+    // `start` returned at NOW - 400; the owner approved a minute later and clicked Continue much later.
+    const s = summariseStatus(
+      { paused_until: null, recent: [at(401, 'approved', '10.0.0.1')] },
+      { now: NOW, sinceLogin: null, ownSignerStarts: [NOW - 400] },
+    )
+    expect(s.foreignApprovals).toHaveLength(0)
+  })
+
+  it('still flags another address approving, even next to our own', () => {
+    const s = summariseStatus(
+      { paused_until: null, recent: [at(900, 'approved', '203.0.113.9'), at(401, 'approved', '10.0.0.1')] },
+      { now: NOW, sinceLogin: null, ownSignerStarts: [NOW - 400] },
+    )
+    expect(s.foreignApprovals.map(a => a.ip)).toEqual(['203.0.113.9'])
+  })
+
+  it('flags an intruder\'s approval when the owner mistakenly approved it and then logged in within a minute', () => {
+    // Someone else starts a login (A), the owner gets busy, approves that prompt by
+    // mistake, then retries and logs in 20 s after A. `start` returned for the retry at NOW - 79.
+    const s = summariseStatus(
+      { paused_until: null, recent: [at(100, 'approved', '203.0.113.9'), at(80, 'approved', '10.0.0.1')] },
+      { now: NOW, sinceLogin: null, ownSignerStarts: [NOW - 79] },
+    )
+    expect(s.foreignApprovals.map(a => a.ip)).toEqual(['203.0.113.9'])
+  })
+
+  it('matches each remembered start to one approval only, nearest first', () => {
+    const s = summariseStatus(
+      { paused_until: null, recent: [at(100, 'approved', '203.0.113.9'), at(98, 'approved', '203.0.113.10'), at(97, 'approved', '10.0.0.1')] },
+      { now: NOW, sinceLogin: null, ownSignerStarts: [NOW - 97] },
+    )
+    expect(s.foreignApprovals.map(a => a.ip)).toEqual(['203.0.113.9', '203.0.113.10'])
+  })
+
+  it('does not flag the owner\'s own login when the browser clock is a few minutes off', () => {
+    // The node stamped the attempt 3 minutes before the browser thinks `start` returned.
+    const s = summariseStatus(
+      { paused_until: null, recent: [at(401, 'approved', '10.0.0.1')] },
+      { now: NOW, sinceLogin: null, ownSignerStarts: [NOW - 221] },
+    )
+    expect(s.foreignApprovals).toHaveLength(0)
+    const late = summariseStatus(
+      { paused_until: null, recent: [at(401, 'approved', '10.0.0.1')] },
+      { now: NOW, sinceLogin: null, ownSignerStarts: [NOW - 401 + 360] },
+    )
+    expect(late.foreignApprovals).toHaveLength(1)
+  })
+
+  it('recognises every signer login this browser remembers, not only the latest', () => {
+    const s = summariseStatus(
+      { paused_until: null, recent: [at(5000, 'approved'), at(300, 'approved')] },
+      { now: NOW, sinceLogin: null, ownSignerStarts: [NOW - 5001, NOW - 299] },
+    )
+    expect(s.foreignApprovals).toHaveLength(0)
+  })
+
+  it('ignores attempts from before the last login on this browser', () => {
+    const s = summariseStatus(
+      { paused_until: null, recent: [at(5000, 'expired'), at(4000, 'approved'), at(100, 'denied')] },
+      { now: NOW, sinceLogin: NOW - 1000, ownSignerStarts: [] },
+    )
+    expect(s.notApproved).toHaveLength(1)
+    expect(s.foreignApprovals).toHaveLength(0)
+  })
+
+  it('falls back to the last day when there is no earlier login to compare with', () => {
+    const s = summariseStatus({ paused_until: null, recent: [at(90_000, 'expired'), at(60, 'expired')] }, none)
+    expect(s.notApproved).toHaveLength(1)
+  })
+
+  it('passes on the pause and a null address', () => {
+    const s = summariseStatus({ paused_until: NOW + 600, recent: [at(10, 'refused-budget', null)] }, none)
+    expect(s.pausedUntil).toBe(NOW + 600)
+    expect(s.notApproved[0]!.ip).toBeNull()
+  })
+})
+
+describe('loginRecord', () => {
+  afterEach(() => { localStorage.clear(); sessionStorage.clear() })
+
+  it('uses the login before this one in the tab that just logged in', () => {
+    expect(readLoginContext()).toEqual({ sinceLogin: null, ownSignerStarts: [] })
+    recordLogin(false, 1000)
+    expect(readLoginContext().sinceLogin).toBeNull()
+    recordLogin(true, 2000, 1990)
+    expect(readLoginContext()).toEqual({ sinceLogin: 1000, ownSignerStarts: [1990] })
+  })
+
+  it('uses this browser\'s last login in a new tab', () => {
+    recordLogin(false, 1000)
+    recordLogin(true, 2000, 1990)
+    sessionStorage.clear()
+    expect(readLoginContext()).toEqual({ sinceLogin: 2000, ownSignerStarts: [1990] })
+  })
+
