diff --git a/neode-ui/src/composables/__tests__/useSignerApproval.test.ts b/neode-ui/src/composables/__tests__/useSignerApproval.test.ts
new file mode 100644
index 0000000..395ca33
--- /dev/null
+++ b/neode-ui/src/composables/__tests__/useSignerApproval.test.ts
@@ -0,0 +1,245 @@
+import { describe, expect, it, vi } from 'vitest'
+import { defineComponent, h } from 'vue'
+import { mount } from '@vue/test-utils'
+import i18n from '@/i18n'
+import { describeSignerError, signerErrorKey, useSignerApproval } from '../useSignerApproval'
+
+type Finish = { status: 'pending' } | { status: 'approved' }
+const t = (key: string) => i18n.global.t(key)
+
+function setup(
+  start: () => Promise<{ attempt_id: string; code: string }>,
+  finish: (id: string, s: AbortSignal) => Promise<Finish>,
+  opts: { totp?: () => boolean } = {},
+) {
+  let api!: ReturnType<typeof useSignerApproval<Finish>>
+  const wrapper = mount(defineComponent({
+    setup() {
+      api = useSignerApproval<Finish>(start, finish, 'approved', opts)
+      return () => h('div')
+    },
+  }), { global: { plugins: [i18n] } })
+  return { api, wrapper }
+}
+
+const attempt = () => Promise.resolve({ attempt_id: 'a1', code: '4821' })
+
+describe('useSignerApproval', () => {
+  it('shows the code, polls while pending, then reports approval', async () => {
+    const seen: Array<{ phase: string; code: string }> = []
+    let api!: ReturnType<typeof useSignerApproval<Finish>>
+    const finish = vi.fn(async (): Promise<Finish> => {
+      seen.push({ phase: api.phase.value, code: api.code.value })
+      return seen.length < 3 ? { status: 'pending' } : { status: 'approved' }
+    })
+    api = setup(attempt, finish).api
+
+    const res = await api.run()
+
+    // The code is on screen from the first poll onwards.
+    expect(seen.every(s => s.phase === 'waiting' && s.code === '4821')).toBe(true)
+    expect(res).toEqual({ status: 'approved' })
+    expect(api.phase.value).toBe('approved')
+    expect(finish).toHaveBeenCalledTimes(3)
+  })
+
+  it('fails with friendly copy when the signer denies', async () => {
+    const { api } = setup(attempt, () => Promise.reject(new Error('linked signer denied the login')))
+    expect(await api.run()).toBeNull()
+    expect(api.phase.value).toBe('failed')
+    expect(api.error.value).toBe('Your signer denied the login.')
+    expect(api.rawError.value).toBe('linked signer denied the login')
+    expect(api.code.value).toBe('')
+  })
+
+  it('fails when the attempt cannot start (offline signer)', async () => {
+    const { api } = setup(() => Promise.reject(new Error('linked signer is offline')), vi.fn())
+    await api.run()
+    expect(api.phase.value).toBe('failed')
+    expect(api.error.value).toBe("Your signer is offline. Check it's connected, or use your password.")
+  })
+
+  it('refuses an unexpected status rather than polling forever', async () => {
+    const finish = vi.fn().mockResolvedValue({ status: 'weird' })
+    const { api } = setup(attempt, finish)
+    await api.run()
+    expect(api.phase.value).toBe('failed')
+    expect(finish).toHaveBeenCalledTimes(1)
+  })
+
+  it('stops polling when stopped or unmounted', async () => {
+    let calls = 0
+    const finish = (_id: string, signal: AbortSignal) => new Promise<Finish>((resolve) => {
+      calls += 1
+      signal.addEventListener('abort', () => resolve({ status: 'pending' }))
+    })
+    const { api, wrapper } = setup(attempt, finish)
+    const run = api.run()
+    await vi.waitFor(() => expect(calls).toBe(1))
+    wrapper.unmount()
+    expect(await run).toBeNull()
+    expect(calls).toBe(1)
+  })
+
+  describe('cancelling while the signer is being asked', () => {
+    function gated() {
+      const polls: Array<(v: Finish | Error) => void> = []
+      const finish = (_id: string, signal: AbortSignal) => new Promise<Finish>((resolve, reject) => {
+        polls.push(v => (v instanceof Error ? reject(v) : resolve(v)))
+        signal.addEventListener('abort', () => resolve({ status: 'pending' }))
+      })
+      return { polls, finish }
+    }
+
+    it('hides the prompt but keeps watching, and reports a late approval', async () => {
+      const { polls, finish } = gated()
+      const { api } = setup(attempt, finish)
+      const run = api.run()
+      await vi.waitFor(() => expect(polls).toHaveLength(1))
+
+      api.cancel()
+      expect(api.phase.value).toBe('idle')
+      expect(api.code.value).toBe('')
+      expect(api.waitingInBackground.value).toBe(true)
+
+      polls[0]!({ status: 'pending' })
+      await vi.waitFor(() => expect(polls).toHaveLength(2))
+      expect(api.waitingInBackground.value).toBe(true)
+
+      polls[1]!({ status: 'approved' })
+      expect(await run).toBeNull()
+      expect(api.waitingInBackground.value).toBe(false)
+      expect(api.late.value).toEqual({ ok: true, result: { status: 'approved' } })
+      expect(api.phase.value).toBe('idle')
+    })
+
+    it('reports how a cancelled attempt ended when it failed', async () => {
+      const { polls, finish } = gated()
+      const { api } = setup(attempt, finish)
+      const run = api.run()
+      await vi.waitFor(() => expect(polls).toHaveLength(1))
+      api.cancel()
+      polls[0]!(new Error('linked signer did not approve the login in time'))
+      await run
+      expect(api.late.value).toEqual({ ok: false, message: "Your signer didn't approve in time." })
+      expect(api.error.value).toBe('')
+      expect(api.waitingInBackground.value).toBe(false)
+    })
+
+    it('stop() really ends the watching', async () => {
+      const { polls, finish } = gated()
+      const { api } = setup(attempt, finish)
+      const run = api.run()
+      await vi.waitFor(() => expect(polls).toHaveLength(1))
+      api.cancel()
+      api.stop()
+      expect(await run).toBeNull()
+      expect(api.waitingInBackground.value).toBe(false)
+      expect(api.late.value).toBeNull()
+    })
+
+    it('still watches when cancelled before the node has answered the start', async () => {
+      const polls: Array<(v: Finish) => void> = []
+      let release!: () => void
+      const start = () => new Promise<{ attempt_id: string; code: string }>((r) => { release = () => r({ attempt_id: 'a1', code: '1111' }) })
+      const finish = () => new Promise<Finish>((resolve) => { polls.push(resolve) })
+      const { api } = setup(start, finish)
+      const run = api.run()
+      api.cancel()
+      release()
+      await vi.waitFor(() => expect(polls).toHaveLength(1))
+      expect(api.code.value).toBe('')
+      polls[0]!({ status: 'approved' })
+      await run
+      expect(api.late.value?.ok).toBe(true)
+    })
+  })
+})
+
+describe('signer error wording', () => {
+  // The node's own fixed texts (signer_login.rs), each with the copy it must show.
+  const cases: Array<[string, string, string]> = [
+    ['NOT_ENABLED', 'linked signer login is not enabled on this node', 'notEnabled'],
+    ['ALREADY_WAITING', 'linked signer login is busy: another login is waiting for approval. If your signer is asking right now, that request did not come from this page: deny it', 'busyLogin'],
+    ['PAUSED', 'linked signer login is paused after recent attempts; log in with the password or try again in a few minutes', 'paused'],
+    ['EXPIRED', 'linked signer did not approve the login in time', 'timeout'],
+    ['GONE', 'Invalid signer login attempt: it is unknown, used or expired', 'gone'],
+    ['OTHER_BROWSER', 'Invalid signer login attempt: it was started in another browser', 'otherBrowser'],
+    ['PUBLIC_OFFLINE', 'linked signer is offline', 'offline'],
+    ['PUBLIC_DENIED', 'linked signer denied the login', 'denied'],
+    ['PUBLIC_TIMEOUT', 'linked signer did not answer in time', 'timeout'],
+    ['PUBLIC_REFUSED', 'linked signer login was refused: the signed reply did not check out', 'refused'],
+    ['PUBLIC_FAILED', 'linked signer login failed', 'failed'],
+    ['ENROL_BUSY_LOGIN', 'linked signer is busy: a login is waiting for approval on it. If you did not start one, deny it on the signer, then try again', 'enrolBusyLogin'],
+    ['ENROL_BUSY', 'linked signer is already waiting to approve an enrolment; approve or deny it on the signer first', 'enrolBusy'],
+    ['ENROL_EXPIRED', 'linked signer did not approve the enrolment in time', 'enrolTimeout'],
+  ]
+
+  it.each(cases)('%s gets its own sentence-case copy', (_name, text, key) => {
+    expect(signerErrorKey(text)).toBe(key)
+    const shown = describeSignerError(new Error(text), t)
+    expect(shown).toBe(t(`signer.errors.${key}`))
+    expect(shown).not.toBe(text)
+    expect(shown.charAt(0)).toBe(shown.charAt(0).toUpperCase())
+  })
+
+  it('keeps the enrolment-busy copy away from the login-busy warning', () => {
+    const enrol = describeSignerError(new Error(cases.find(c => c[0] === 'ENROL_BUSY')![1]), t)
+    const enrolLogin = describeSignerError(new Error(cases.find(c => c[0] === 'ENROL_BUSY_LOGIN')![1]), t)
+    expect(enrol).toBe('Your signer is already handling a login or enrolment. Finish or deny that first.')
+    expect(enrol).not.toContain("didn't come from this page")
+    expect(enrolLogin).not.toContain("didn't come from this page")
+    expect(describeSignerError(new Error(cases[1]![1]), t)).toBe(
+      "A login is already waiting on your signer, and it didn't come from this page. If your signer is asking right now, deny it.",
+    )
+  })
+
+  it('points a paused 2FA login to the authenticator code, not the password', () => {
+    const paused = cases[2]![1]
+    expect(describeSignerError(new Error(paused), t, { totp: true })).toMatch(/authenticator code/)
+    expect(describeSignerError(new Error(paused), t)).toMatch(/Use your password/)
+  })
+
+  it('maps transport failures, and passes unknown text through', () => {
+    expect(describeSignerError(new Error('HTTP 429: Too Many Requests'), t)).toMatch(/Too many attempts/)
+    expect(describeSignerError(new Error('Request timeout'), t)).toMatch(/could not be reached/)
+    expect(describeSignerError(new Error('Password Incorrect'), t)).toBe('Password Incorrect')
+    expect(describeSignerError(new Error(''), t)).toBe(t('signer.errors.fallback'))
+  })
+})
+
+describe('enrolment error wording', () => {
+  const enrol = (text: string) => describeSignerError(new Error(text), t, { enrol: true })
+
+  it('maps the signer\'s own error texts to enrolment copy', () => {
+    expect(enrol('linked signer denied the request')).toBe('Your signer denied the enrolment.')
+    expect(enrol('linked signer did not answer within 60 s')).toBe("Your signer didn't approve the enrolment in time.")
+    expect(enrol('linked signer sent a bad response: nonsense')).toBe("Your signer's reply didn't check out. Check the signer, then try again.")
+  })
+
+  it('does not tell the owner to use their password when enrolling', () => {
+    const offline = enrol('linked signer is offline (no reply from wss://relay.example)')
+    expect(offline).toBe("Your signer is offline. Check it's connected, then try again.")
+    expect(offline).not.toMatch(/password/i)
+    expect(describeSignerError(new Error('linked signer is offline'), t)).toMatch(/use your password/)
+  })
+
+  it('never leaks the relay list', () => {
+    expect(enrol('linked signer is offline (no reply from wss://private.example)')).not.toContain('wss://')
+  })
+
+  it('is used by the enrolment approval', async () => {
+    let api!: ReturnType<typeof useSignerApproval<Finish>>
+    mount(defineComponent({
+      setup() {
+        api = useSignerApproval<Finish>(
+          () => Promise.reject(new Error('linked signer is offline (no reply from wss://x)')),
+          vi.fn(), 'approved', { enrol: true },
+        )
+        return () => h('div')
+      },
+    }), { global: { plugins: [i18n] } })
+    await api.run()
+    expect(api.error.value).toBe("Your signer is offline. Check it's connected, then try again.")
+  })
+})
diff --git a/neode-ui/src/composables/loginRecord.ts b/neode-ui/src/composables/loginRecord.ts
new file mode 100644
index 0000000..c7aab38
--- /dev/null
+++ b/neode-ui/src/composables/loginRecord.ts
@@ -0,0 +1,81 @@
+// What this browser remembers about its own logins, so the post-login notice can
+// tell the owner's own signer login from someone else's. Timestamps and a
+// dismissal marker only: no secrets. Kept in localStorage (not per tab), so a
+// new tab reads the same record.
+
+const KEY = 'archipelago:signer-login:v1'
+const FRESH_KEY = 'archipelago:signer-login:fresh'
+/** How many of this browser's own signer logins to remember. */
+const MAX_STARTS = 20
+
+interface Record {
+  /** Unix seconds of this browser's latest login, and of the one before it. */
+  last: number | null
+  prev: number | null
+  /** When `start` returned for each signer login this browser completed (Unix seconds). */
+  starts: number[]
+  dismissed: string | null
+}
+
+const EMPTY: Record = { last: null, prev: null, starts: [], dismissed: null }
+
+function isNum(v: unknown): v is number {
+  return typeof v === 'number' && Number.isFinite(v)
+}
+
+function read(): Record {
+  try {
+    const raw = localStorage.getItem(KEY)
+    if (!raw) return { ...EMPTY, starts: [] }
+    const p = JSON.parse(raw) as Partial<Record>
+    return {
+      last: isNum(p.last) ? p.last : null,
+      prev: isNum(p.prev) ? p.prev : null,
+      starts: Array.isArray(p.starts) ? p.starts.filter(isNum).slice(-MAX_STARTS) : [],
+      dismissed: typeof p.dismissed === 'string' ? p.dismissed : null,
+    }
+  } catch {
+    return { ...EMPTY, starts: [] }
+  }
+}
+
+function write(rec: Record): void {
+  try { localStorage.setItem(KEY, JSON.stringify(rec)) } catch { /* storage unavailable: the notice falls back to the last day */ }
+}
+
+/** Call when a login completes. For a signer login, `startedAt` is when `start`
+ *  returned (the node stamps the attempt when it starts, not when it is approved
+ *  or the owner clicks Continue). */
+export function recordLogin(
+  viaSigner: boolean,
+  nowSeconds: number = Math.floor(Date.now() / 1000),
+  startedAt?: number,
+): void {
+  const rec = read()
+  rec.prev = rec.last
+  rec.last = nowSeconds
+  if (viaSigner && startedAt !== undefined) rec.starts = [...rec.starts, startedAt].slice(-MAX_STARTS)
+  write(rec)
+  try { sessionStorage.setItem(FRESH_KEY, String(nowSeconds)) } catch { /* ignore */ }
+}
+
+/** `sinceLogin` is where to start counting attempts. In the tab that just logged
+ *  in it is the login before this one; in any other tab it is this
+ *  browser's last login. */
+export function readLoginContext(): { sinceLogin: number | null; ownSignerStarts: number[] } {
+  const rec = read()
+  let fresh: string | null = null
+  try { fresh = sessionStorage.getItem(FRESH_KEY) } catch { /* ignore */ }
+  const justLoggedIn = rec.last !== null && fresh === String(rec.last)
+  return { sinceLogin: justLoggedIn ? rec.prev : rec.last, ownSignerStarts: rec.starts }
+}
+
+export function readDismissed(): string | null {
+  return read().dismissed
+}
+
+export function writeDismissed(key: string): void {
+  const rec = read()
+  rec.dismissed = key
+  write(rec)
+}
diff --git a/neode-ui/src/composables/useSignerApproval.ts b/neode-ui/src/composables/useSignerApproval.ts
new file mode 100644
index 0000000..7109bcb
--- /dev/null
+++ b/neode-ui/src/composables/useSignerApproval.ts
@@ -0,0 +1,181 @@
+// Drives one "approve on your signer" attempt: start it, show the code, poll
+// until the signer answers. The same flow serves login and enrolment.
+//
+// Cancelling while the signer is being asked does not end the attempt on the
+// node: the prompt may still be on the device, and an enrolment is saved the
+// moment the owner presses approve. So `cancel` hides the prompt but keeps
+// polling quietly until the attempt settles; the outcome lands in `late`.
+
+import { onBeforeUnmount, ref } from 'vue'
+import { useI18n } from 'vue-i18n'
+import type { SignerAttempt } from '@/api/signer-login'
+
+export type ApprovalPhase = 'idle' | 'starting' | 'waiting' | 'approved' | 'failed'
+
+export type LateOutcome<F> = { ok: true; result: F } | { ok: false; message: string }
+
+/** The node gives up on an attempt after two minutes. */
+const BACKGROUND_LIMIT_MS = 130_000
+
+/** i18n key (under `signer.errors`) for each fixed message the node sends,
+ *  or null for text we don't recognise, which is shown as it is. */
+export function signerErrorKey(raw: string, opts: { totp?: boolean; enrol?: boolean } = {}): string | null {
+  const m = raw.toLowerCase()
+  if (m.includes('linked signer login is busy')) return 'busyLogin'
+  if (m.includes('already waiting to approve an enrolment')) return 'enrolBusy'
+  if (m.includes('linked signer is busy: a login is waiting')) return 'enrolBusyLogin'
+  if (m.includes('did not approve the enrolment in time')) return 'enrolTimeout'
+  if (m.includes('did not approve the login in time') || m.includes('did not answer in time')) return 'timeout'
+  // The enrolment path passes the signer's own error texts through (RemoteSignerError).
+  if (m.includes('linked signer did not answer within')) return 'enrolTimeout'
+  if (m.includes('linked signer denied the request')) return 'enrolDenied'
+  if (m.includes('linked signer sent a bad response')) return 'enrolRefused'
+  if (m.includes('linked signer is offline')) return opts.enrol ? 'enrolOffline' : 'offline'
+  if (m.includes('denied the login')) return 'denied'
+  if (m.includes('login was refused')) return 'refused'
+  if (m.includes('login is paused')) return opts.totp ? 'pausedTotp' : 'paused'
+  if (m.includes('login is not enabled')) return 'notEnabled'
+  if (m.includes('unknown, used or expired')) return 'gone'
+  if (m.includes('started in another browser')) return 'otherBrowser'
+  if (m === 'linked signer login failed') return 'failed'
+  if (/429|too many/.test(m)) return 'rateLimited'
+  if (/502|503|bad gateway|timeout|fetch|network/.test(m)) return 'network'
+  return null
+}
+
+export function describeSignerError(
+  err: unknown,
+  t: (key: string) => string,
+  opts: { totp?: boolean; enrol?: boolean } = {},
+): string {
+  const msg = err instanceof Error ? err.message : ''
+  const key = signerErrorKey(msg, opts)
+  if (key) return t(`signer.errors.${key}`)
+  return msg || t('signer.errors.fallback')
+}
+
+export function useSignerApproval<F extends { status: string }>(
+  start: () => Promise<SignerAttempt>,
+  finish: (attemptId: string, signal: AbortSignal) => Promise<F>,
+  doneStatus: F['status'],
+  /** `totp` says whether the node is asking for a 2FA code, which changes the pause advice. */
+  opts: {
+    totp?: () => boolean
+    /** An enrolment, whose errors carry the signer's own texts. */
+    enrol?: boolean
+    /** Called as soon as the node has started the attempt. */
+    onStarted?: () => void
+  } = {},
+) {
+  const { t } = useI18n()
+  const phase = ref<ApprovalPhase>('idle')
+  const code = ref('')
+  const error = ref('')
+  /** The node's own text for the failure, for logic that must not depend on wording. */
+  const rawError = ref('')
+  const result = ref<F | null>(null)
+  /** True once the code has been on screen. */
+  const reachedWaiting = ref(false)
+  /** Cancelled, but the node may still be asking the signer. */
+  const waitingInBackground = ref(false)
+  /** How an attempt that was cancelled in the end settled. */
+  const late = ref<LateOutcome<F> | null>(null)
+  let controller: AbortController | null = null
+  let silent = false
+
+  /** Leave for good: stop polling. Nothing more will be reported. */
+  function stop() {
+    controller?.abort()
+    controller = null
+    silent = false
+    waitingInBackground.value = false
+  }
+
+  /** Hide the prompt but keep watching until the attempt settles. */
+  function cancel() {
+    if (phase.value !== 'waiting' && phase.value !== 'starting') return
+    silent = true
+    waitingInBackground.value = true
+    phase.value = 'idle'
+    code.value = ''
+  }
+
+  async function run(): Promise<F | null> {
+    stop()
+    const mine = new AbortController()
+    controller = mine
+    phase.value = 'starting'
+    code.value = ''
+    error.value = ''
+    rawError.value = ''
+    result.value = null
+    late.value = null
+    reachedWaiting.value = false
+    const deadline = Date.now() + BACKGROUND_LIMIT_MS
+    const settle = (outcome: LateOutcome<F>) => {
+      late.value = outcome
+      waitingInBackground.value = false
+      silent = false
+    }
+    try {
+      const attempt = await start()
+      if (mine.signal.aborted) return null
+      opts.onStarted?.()
+      if (!silent) {
+        code.value = attempt.code
+        phase.value = 'waiting'
+        reachedWaiting.value = true
+      }
+      while (!mine.signal.aborted) {
+        if (silent && Date.now() > deadline) {
+          waitingInBackground.value = false
+          silent = false
+          return null
+        }
+        const res = await finish(attempt.attempt_id, mine.signal)
+        if (mine.signal.aborted) return null
+        if (res.status === doneStatus) {
+          if (silent) {
+            settle({ ok: true, result: res })
+            return null
+          }
+          result.value = res
+          phase.value = 'approved'
+          return res
+        }
+        if (res.status !== 'pending') throw new Error(t('signer.errors.unexpected'))
+      }
+      return null
+    } catch (err) {
+      if (mine.signal.aborted) return null
+      const message = describeSignerError(err, t, { totp: opts.totp?.(), enrol: opts.enrol })
+      if (silent) {
+        settle({ ok: false, message })
+        return null
+      }
+      rawError.value = err instanceof Error ? err.message : ''
+      error.value = message
+      phase.value = 'failed'
+      code.value = ''
+      return null
+    } finally {
+      if (controller === mine) controller = null
+    }
+  }
+
+  /** Forget everything, including any attempt still being watched. */
+  function reset() {
+    stop()
+    phase.value = 'idle'
+    code.value = ''
+    error.value = ''
+    rawError.value = ''
+    result.value = null
+    late.value = null
+    reachedWaiting.value = false
+  }
+
+  onBeforeUnmount(stop)
+
+  return { phase, code, error, rawError, result, reachedWaiting, waitingInBackground, late, run, cancel, stop, reset }
+}
