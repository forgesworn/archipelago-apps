diff --git a/neode-ui/src/views/settings/LoginSignersSection.vue b/neode-ui/src/views/settings/LoginSignersSection.vue
new file mode 100644
index 0000000..140c4fd
--- /dev/null
+++ b/neode-ui/src/views/settings/LoginSignersSection.vue
@@ -0,0 +1,312 @@
+<script setup lang="ts">
+import { computed, ref, watch } from 'vue'
+import { useI18n } from 'vue-i18n'
+import { signerApi, signerLoginAllowedHere, type EnrolFinish, type LoginSigner, type SignerStatus } from '@/api/signer-login'
+import { rpcClient } from '@/api/rpc-client'
+import { useSignerApproval } from '@/composables/useSignerApproval'
+import SignerEnrolProgress from '@/components/signer/SignerEnrolProgress.vue'
+import type { ManagedIdentity } from '@/views/web5/types'
+
+const { t } = useI18n()
+
+const signers = ref<LoginSigner[]>([])
+const linkedIdentities = ref<ManagedIdentity[]>([])
+const loadError = ref('')
+/** The signer methods are admin-only: anyone else just doesn't see the section. */
+const forbidden = ref(false)
+const status = ref<SignerStatus | null>(null)
+const portOk = signerLoginAllowedHere()
+
+const showAdd = ref(false)
+const addIdentityId = ref('')
+const addPassword = ref('')
+const addError = ref('')
+const addStarted = ref(false)
+
+const removeTarget = ref<LoginSigner | null>(null)
+const removePassword = ref('')
+const removeError = ref('')
+const removing = ref(false)
+
+const approval = useSignerApproval<EnrolFinish>(
+  () => signerApi.enrolStart(addIdentityId.value, addPassword.value),
+  (attemptId, signal) => signerApi.enrolFinish(attemptId, signal),
+  'enrolled',
+  { enrol: true },
+)
+
+// The node takes one login signer; adding another means removing this one first.
+const canAdd = computed(() => signers.value.length === 0)
+const recentNewestFirst = computed(() => [...(status.value?.recent ?? [])].reverse())
+const pausedUntil = computed(() => status.value?.paused_until != null
+  ? new Date(status.value.paused_until * 1000).toLocaleTimeString()
+  : '')
+
+function outcomeLabel(outcome: string): string {
+  const key = `signer.outcome.${outcome}`
+  const label = t(key)
+  return label === key ? outcome : label
+}
+
+function formatAt(at: number): string {
+  return new Date(at * 1000).toLocaleString()
+}
+
+async function load() {
+  try {
+    signers.value = await signerApi.list()
+    loadError.value = ''
+    status.value = await signerApi.status().catch(() => null)
+  } catch (e) {
+    const msg = e instanceof Error ? e.message : ''
+    if (/forbidden|insufficient/i.test(msg)) forbidden.value = true
+    else loadError.value = msg || t('signer.settings.loadFailed')
+  }
+}
+
+async function loadLinked() {
+  try {
+    const res = await rpcClient.call<{ identities: ManagedIdentity[] }>({ method: 'identity.list' })
+    linkedIdentities.value = (res.identities || []).filter(i => i.origin === 'linked')
+    if (!addIdentityId.value) addIdentityId.value = linkedIdentities.value[0]?.id ?? ''
+  } catch {
+    linkedIdentities.value = []
+  }
+}
+
+function openAdd() {
+  showAdd.value = true
+  addStarted.value = false
+  addPassword.value = ''
+  addError.value = ''
+  addIdentityId.value = ''
+  approval.reset()
+  void loadLinked()
+}
+
+async function startAdd() {
+  if (!addIdentityId.value || !addPassword.value) return
+  addStarted.value = true
+  addError.value = ''
+  const res = await approval.run()
+  if (res) {
+    addPassword.value = ''
+    await load()
+  } else if (approval.phase.value === 'failed' && !approval.reachedWaiting.value) {
+    // Refused before the signer was asked (wrong password, busy): back to the form.
+    addStarted.value = false
+    addError.value = approval.error.value
+  }
+}
+
+// An enrolment that went through after the owner cancelled still has to show up.
+watch(() => approval.late.value, (late) => { if (late?.ok) void load() })
+
+/** Cancel while the signer is being asked only hides the prompt; close ends it. */
+function cancelOrClose() {
+  if (approval.phase.value === 'waiting' || approval.phase.value === 'starting') {
+    approval.cancel()
+    return
+  }
+  closeAdd()
+}
+
+function closeAdd() {
+  approval.reset()
+  showAdd.value = false
+  addPassword.value = ''
+  addStarted.value = false
+  void load()
+}
+
+function openRemove(signer: LoginSigner) {
+  removeTarget.value = signer
+  removePassword.value = ''
+  removeError.value = ''
+}
+
+function closeRemove() {
+  removeTarget.value = null
+  removePassword.value = ''
+  removeError.value = ''
+}
+
+async function confirmRemove() {
+  if (!removeTarget.value || !removePassword.value || removing.value) return
+  removing.value = true
+  removeError.value = ''
+  try {
+    await signerApi.remove(removeTarget.value.identity_id, removePassword.value)
+    closeRemove()
+    await load()
+  } catch (e) {
+    removeError.value = e instanceof Error ? e.message : t('signer.settings.removeFailed')
+  } finally {
+    removing.value = false
+  }
+}
+
+function shortKey(pubkey: string): string {
+  return pubkey.length > 16 ? `${pubkey.slice(0, 8)}…${pubkey.slice(-6)}` : pubkey
+}
+
+defineExpose({ load })
+load()
+</script>
+
+<template>
+  <div v-if="!forbidden" class="mb-6" data-testid="login-signers">
