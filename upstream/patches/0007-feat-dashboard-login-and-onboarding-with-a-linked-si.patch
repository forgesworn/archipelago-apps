+<template>
+  <div data-testid="signer-enrol-progress">
+    <div v-if="approval.phase.value === 'starting'" class="text-center text-sm text-white/70" role="status">
+      {{ t('signer.enrol.asking') }}
+    </div>
+    <SignerCodePrompt v-else-if="approval.phase.value === 'waiting'" :code="approval.code.value" />
+
+    <!-- Cancelled, but the node may still be asking the signer -->
+    <div v-if="approval.waitingInBackground.value" class="text-center space-y-1" role="status" data-testid="signer-still-asking">
+      <p class="text-sm font-medium text-orange-200">{{ t('signer.enrol.cancelled') }}</p>
+      <p class="text-sm text-white/70">{{ t('signer.enrol.cancelledWatching') }}</p>
+    </div>
+
+    <div v-else-if="enrolled" class="space-y-3 text-center">
+      <p class="text-sm text-green-300" role="status" data-testid="signer-enrolled">{{ t('signer.enrol.done') }}</p>
+      <p
+        v-if="enrolled.quick_approval"
+        class="text-sm text-orange-200 bg-orange-500/10 border border-orange-400/30 rounded-lg p-3 text-left"
+        role="alert"
+        data-testid="quick-approval-warning"
+      >{{ t('signer.enrol.quick') }}</p>
+    </div>
+    <div v-else-if="approval.phase.value === 'failed'" class="space-y-3 text-center">
+      <p class="text-sm text-red-400" role="alert">{{ approval.error.value }}</p>
+      <button type="button" class="px-4 py-2 rounded-lg glass-button font-medium" @click="approval.run()">{{ t('signer.enrol.tryAgain') }}</button>
+    </div>
+    <p v-else-if="lateError" class="text-sm text-red-400 text-center" role="alert" data-testid="signer-late-error">{{ lateError }}</p>
+  </div>
+</template>
+
+<script setup lang="ts">
+import { computed } from 'vue'
+import { useI18n } from 'vue-i18n'
+import SignerCodePrompt from '@/components/signer/SignerCodePrompt.vue'
+import type { useSignerApproval } from '@/composables/useSignerApproval'
+import type { EnrolFinish, EnrolledSigner } from '@/api/signer-login'
+
+const props = defineProps<{ approval: ReturnType<typeof useSignerApproval<EnrolFinish>> }>()
+const { t } = useI18n()
+
+/** The enrolment, whether it finished in front of the owner or after a cancel. */
+const enrolled = computed<EnrolledSigner | null>(() => {
+  const r = props.approval.result.value ?? (props.approval.late.value?.ok ? props.approval.late.value.result : null)
+  return r && r.status === 'enrolled' ? r : null
+})
+const lateError = computed(() => {
+  const l = props.approval.late.value
+  return l && !l.ok ? l.message : ''
+})
+</script>
