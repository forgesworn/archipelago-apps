+import { describe, expect, it, vi } from 'vitest'
+
+vi.mock('@/api/rpc-client', () => ({ rpcClient: { call: vi.fn() } }))
+
+import { useNostrBridge } from '../useNostrBridge'
+import type { SelectedIdentity } from '../useAppIdentity'
+
+function bridgeFor(identity: SelectedIdentity | null) {
+  const frame = { postMessage: vi.fn() } as unknown as Window
+  const bridge = useNostrBridge(() => identity, {
+    appId: () => 'app',
+    appName: () => 'App',
+    appUrl: () => 'http://localhost:5173/app',
+    frameWindow: () => frame,
+  })
+  const send = (method: string) => {
+    void bridge.handleNostrRequest({
+      data: { type: 'nostr-request', id: 1, method, params: { event: { kind: 1, content: 'hi' } } },
+      source: frame,
+      origin: 'http://localhost:5173',
+    } as unknown as MessageEvent)
+  }
+  return { bridge, send }
+}
+
+const base = { id: 'i1', name: 'Heartwood', did: 'did:key:z', pubkey: 'aa', nostr_pubkey: 'bb' }
+
+describe('consent request for linked identities', () => {
+  it('carries origin and the signer name for a linked identity', () => {
+    const { bridge, send } = bridgeFor({ ...base, origin: 'linked' })
+    send('signEvent')
+    expect(bridge.consentRequest.value).toMatchObject({ origin: 'linked', signerLabel: 'Heartwood', identityLabel: 'Heartwood' })
+  })
+
+  it('leaves a local identity without origin, so the local copy shows', () => {
+    const { bridge, send } = bridgeFor({ ...base, origin: 'local' })
+    send('signEvent')
+    expect(bridge.consentRequest.value?.origin).toBeUndefined()
+  })
+
+  it('treats an identity stored before this field existed as local', () => {
+    const { bridge, send } = bridgeFor({ ...base })
+    send('signEvent')
+    expect(bridge.consentRequest.value?.origin).toBeUndefined()
+  })
+
+  it('treats the node default identity as local', () => {
+    const { bridge, send } = bridgeFor(null)
+    send('signEvent')
+    expect(bridge.consentRequest.value?.origin).toBeUndefined()
+    expect(bridge.consentRequest.value?.identityLabel).toBe('Node default identity')
+  })
+})
