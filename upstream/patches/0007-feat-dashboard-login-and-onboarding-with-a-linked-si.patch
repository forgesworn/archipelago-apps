@@ -0,0 +1,101 @@
+<template>
+  <form class="space-y-4" data-testid="link-signer-form" @submit.prevent="link">
+    <p class="text-sm text-white/70">{{ t('signer.link.intro') }}</p>
+    <div>
+      <label for="link-signer-uri" class="block text-sm font-medium text-white/80 mb-2">{{ t('signer.link.uriLabel') }}</label>
+      <div class="relative">
+        <input
+          id="link-signer-uri"
+          v-model="bunkerUri"
+          :type="reveal ? 'text' : 'password'"
+          name="signer-link"
+          autocomplete="off"
+          autocapitalize="off"
+          spellcheck="false"
+          data-lpignore="true"
+          data-1p-ignore
+          data-form-type="other"
+          placeholder="bunker://…"
+          data-controller-no-submit
+          :disabled="busy"
+          class="w-full pl-3 pr-16 py-2 rounded-lg bg-white/10 text-white font-mono text-sm border border-white/20 focus:border-orange-500 focus:ring-1 focus:ring-orange-500"
+        />
+        <button
+          type="button"
+          class="absolute inset-y-0 right-0 px-3 text-xs text-white/70 hover:text-white"
+          data-testid="link-signer-reveal"
+          :aria-pressed="reveal"
+          :aria-label="reveal ? t('signer.link.hide') : t('signer.link.show')"
+          @click="reveal = !reveal"
+        >{{ reveal ? t('signer.link.hide') : t('signer.link.show') }}</button>
+      </div>
+    </div>
+    <div>
+      <label for="link-signer-name" class="block text-sm font-medium text-white/80 mb-2">{{ t('signer.link.nameLabel') }}</label>
+      <input
+        id="link-signer-name"
+        v-model="name"
+        type="text"
+        maxlength="100"
+        autocomplete="off"
+        data-controller-no-submit
+        :disabled="busy"
+        class="w-full px-3 py-2 rounded-lg bg-white/10 text-white border border-white/20 focus:border-orange-500 focus:ring-1 focus:ring-orange-500"
+      />
+    </div>
+    <p v-if="busy" class="text-sm text-orange-200" role="status" data-testid="link-signer-waiting">{{ t('signer.link.waiting') }}</p>
+    <p v-if="error" class="text-sm text-red-400" role="alert">{{ error }}</p>
+    <div class="flex gap-3">
+      <button
+        type="submit"
+        :disabled="busy || !canSubmit"
+        class="flex-1 px-4 py-2 rounded-lg glass-button glass-button-warning font-medium disabled:opacity-50 disabled:cursor-not-allowed"
+      >{{ busy ? t('signer.link.linking') : (submitLabel || t('signer.link.submit')) }}</button>
+      <button
+        v-if="cancelLabel"
+        type="button"
+        :disabled="busy"
+        class="px-4 py-2 rounded-lg glass-button font-medium disabled:opacity-50"
+        @click="emit('cancel')"
+      >{{ cancelLabel }}</button>
+    </div>
+  </form>
+</template>
+
+<script setup lang="ts">
+import { computed, ref } from 'vue'
+import { useI18n } from 'vue-i18n'
+import { signerApi, type LinkedIdentity } from '@/api/signer-login'
+
+withDefaults(defineProps<{ submitLabel?: string; cancelLabel?: string }>(), {
+  submitLabel: '',
+  cancelLabel: '',
+})
+const emit = defineEmits<{ linked: [identity: LinkedIdentity]; cancel: [] }>()
+const { t } = useI18n()
+
+const bunkerUri = ref('')
+const name = ref(t('signer.link.defaultName'))
+const reveal = ref(false)
+const busy = ref(false)
+const error = ref('')
+
+const canSubmit = computed(() => bunkerUri.value.trim().startsWith('bunker://') && name.value.trim().length > 0)
+
+async function link() {
+  if (busy.value || !canSubmit.value) return
+  busy.value = true
+  error.value = ''
+  try {
+    const identity = await signerApi.linkBunker(bunkerUri.value.trim(), name.value.trim())
+    bunkerUri.value = ''
+    reveal.value = false
+    emit('linked', identity)
+  } catch (err) {
+    const msg = err instanceof Error ? err.message : ''
+    error.value = /timeout/i.test(msg) ? t('signer.link.timeout') : msg || t('signer.link.failed')
+  } finally {
+    busy.value = false
+  }
+}
+</script>
