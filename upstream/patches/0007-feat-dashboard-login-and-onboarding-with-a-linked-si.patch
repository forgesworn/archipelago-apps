+      // Linked-signer login (dev stand-in). Approval takes ~4 s. Toggles:
+      //   MOCK_SIGNER_ENROLLED=1   a signer is already enrolled at boot
+      //   MOCK_SIGNER_2FA=1        the account has TOTP (code 123456); the signer
+      //                            is offered at the code step instead
+      //   MOCK_SIGNER_OUTCOME=     denied | offline | expired | refused | failed
+      //                            (login fails that way), busy (start and enrol
+      //                            are refused as busy), paused (start refused)
+      //   MOCK_SIGNER_QUICK=1      "approved too fast" enrolment warning
+      //   MOCK_SIGNER_STATUS=      paused | foreign | pending | denied
+      // Texts are the node's own fixed constants.
+      case 'auth.login.signer.available': {
+        return res.json({ result: mockSigner.enrolled !== null && process.env.MOCK_SIGNER_2FA !== '1' })
+      }
+
+      case 'auth.login.signer.start': {
+        const refuse = (message) => res.json({ error: { code: -32603, message } })
+        if (!mockSigner.enrolled || (process.env.MOCK_SIGNER_2FA === '1' && !req.cookies?.pending)) {
+          return refuse(MOCK_SIGNER_TEXT.notEnabled)
+        }
+        if (process.env.MOCK_SIGNER_OUTCOME === 'busy') return refuse(MOCK_SIGNER_TEXT.busy)
+        if (process.env.MOCK_SIGNER_OUTCOME === 'paused') return refuse(MOCK_SIGNER_TEXT.paused)
+        return res.json({ result: mockSigner.begin('login') })
+      }
+
+      case 'auth.login.signer.finish': {
+        const out = await mockSigner.poll(params?.attempt_id, 'login')
+        if (out.error) return res.json({ error: { code: -32603, message: out.error } })
+        if (out.status === 'approved') {
+          const sessionId = `session-${Date.now()}`
+          sessions.set(sessionId, { createdAt: new Date() })
+          res.cookie('session', sessionId, { httpOnly: true, maxAge: 24 * 60 * 60 * 1000 })
+          res.clearCookie('pending')
+          return res.json({ result: { status: 'approved' } })
+        }
+        return res.json({ result: { status: 'pending' } })
+      }
+
+      case 'auth.signer.enrol.start': {
+        const { identity_id, password } = params || {}
+        if (password !== userState.passwordHash && password !== MOCK_PASSWORD) {
+          return res.json({ error: { code: -32603, message: 'Password Incorrect' } })
+        }
+        if (!mockSigner.linked.some(i => i.id === identity_id)) {
+          return res.json({ error: { code: -32603, message: 'Invalid identity: only an identity linked to a signer can log in' } })
+        }
+        if (mockSigner.enrolled) {
+          return res.json({ error: { code: -32603, message: 'Already exists: a login signer is enrolled; remove it first' } })
+        }
+        if (process.env.MOCK_SIGNER_OUTCOME === 'busy') {
+          return res.json({ error: { code: -32603, message: MOCK_SIGNER_TEXT.enrolBusy } })
+        }
+        return res.json({ result: mockSigner.begin('enrol', identity_id) })
+      }
+
+      case 'auth.signer.enrol.finish': {
+        const out = await mockSigner.poll(params?.attempt_id, 'enrol')
+        if (out.error) return res.json({ error: { code: -32603, message: out.error } })
+        if (out.status === 'approved') {
+          const id = mockSigner.linked.find(i => i.id === out.identityId)
+          mockSigner.enrolled = { identity_id: id.id, pubkey: id.nostr_pubkey, added_at: new Date().toISOString() }
+          const quick = process.env.MOCK_SIGNER_QUICK === '1'
+          return res.json({ result: { status: 'enrolled', ...mockSigner.enrolled, approval_ms: quick ? 300 : 4000, quick_approval: quick } })
+        }
+        return res.json({ result: { status: 'pending' } })
+      }
+
+      case 'auth.signer.list': {
+        const e = mockSigner.enrolled
+        const name = e ? mockSigner.linked.find(i => i.id === e.identity_id)?.name : ''
+        return res.json({ result: e ? [{ ...e, name }] : [] })
+      }
+
+      case 'auth.signer.status': {
+        const now = Math.floor(Date.now() / 1000)
+        const mode = process.env.MOCK_SIGNER_STATUS
+        const approved = { at: now - 3600, ip: '192.168.1.10', outcome: 'approved' }
+        const recent = {
+          paused: [
+            { at: now - 400, ip: '192.168.1.40', outcome: 'expired' },
+            { at: now - 300, ip: '192.168.1.40', outcome: 'expired' },
+            { at: now - 100, ip: null, outcome: 'refused-budget' },
+          ],
+          foreign: [{ at: now - 90, ip: '203.0.113.9', outcome: 'approved' }, { at: now - 200, ip: '203.0.113.9', outcome: 'denied' }],
+          pending: [{ at: now - 20, ip: '192.168.1.77', outcome: 'pending' }],
+          denied: [{ at: now - 500, ip: '192.168.1.40', outcome: 'denied' }, { at: now - 450, ip: '192.168.1.40', outcome: 'offline' }],
+        }[mode] ?? (mockSigner.enrolled ? [approved] : [])
+        return res.json({ result: { paused_until: mode === 'paused' ? now + 600 : null, recent } })
+      }
+
+      case 'auth.signer.remove': {
+        if (params?.password !== userState.passwordHash && params?.password !== MOCK_PASSWORD) {
+          return res.json({ error: { code: -32603, message: 'Password Incorrect' } })
+        }
+        const had = mockSigner.enrolled?.identity_id === params?.identity_id
+        if (had) mockSigner.enrolled = null
+        return res.json({ result: { removed: had } })
+      }
+
+      case 'identity.link-nip46': {
+        const { bunker_uri, name } = params || {}
+        if (typeof bunker_uri !== 'string' || !bunker_uri.startsWith('bunker://')) {
+          return res.json({ error: { code: -32603, message: 'Invalid bunker link: it must start with bunker://' } })
+        }
+        await new Promise(r => setTimeout(r, 2000))
+        return res.json({ result: mockSigner.link(String(name || 'My signer')) })
+      }
+
       case 'auth.totp.status': {
         return res.json({ result: { enabled: false } })
       }
@@ -2248,6 +2360,13 @@ app.post('/rpc/v1', (req, res) => {
 
