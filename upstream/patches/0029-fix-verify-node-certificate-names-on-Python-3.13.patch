From 047eda0620b92651933871dca038d0fc3b1425ea Mon Sep 17 00:00:00 2001
From: TheCryptoDonkey <TheCryptoDonkey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 09:13:43 +0000
Subject: [PATCH 29/32] fix: verify node certificate names on Python 3.13

---
 scripts/kithmoot-node-ingress.py            | 12 ++++---
 scripts/tests/test_kithmoot_node_ingress.py | 39 +++++++++++++++++++++
 2 files changed, 46 insertions(+), 5 deletions(-)

diff --git a/scripts/kithmoot-node-ingress.py b/scripts/kithmoot-node-ingress.py
index a4ad8c9..2722baa 100644
--- a/scripts/kithmoot-node-ingress.py
+++ b/scripts/kithmoot-node-ingress.py
@@ -218,7 +218,6 @@ def run(args, timeout=15):
 
 
 def validate_certificates(certificate, key, host):
-    import warnings
     read_protected(Path(certificate), 262144)
     info = Path(key).lstat()
     if info.st_mode & 0o007:
@@ -227,10 +226,13 @@ def validate_certificates(certificate, key, host):
     decoded = ssl._ssl._test_decode_cert(certificate)
     if not decoded.get('subjectAltName'):
         raise ValueError('Host certificate requires DNS subject alternative names')
-    with warnings.catch_warnings():
-        warnings.simplefilter('ignore', DeprecationWarning)
-        for name in (host, 'turn.' + host):
-            ssl.match_hostname(decoded, name)
+    # Python 3.13 removed ssl.match_hostname. OpenSSL is already a host
+    # prerequisite; verify both DNS names against the exact configured leaf.
+    # Trusting that leaf here does not assert a public CA: the operator supplies
+    # the host certificate, while clients retain normal public-CA verification.
+    for name in (host, 'turn.' + host):
+        run(['openssl', 'verify', '-no-CAfile', '-no-CApath',
+             '-trusted', certificate, '-partial_chain', '-verify_hostname', name, certificate])
     now = time.time()
     if ssl.cert_time_to_seconds(decoded['notBefore']) > now or ssl.cert_time_to_seconds(decoded['notAfter']) <= now:
         raise ValueError('Host certificate is not current')
diff --git a/scripts/tests/test_kithmoot_node_ingress.py b/scripts/tests/test_kithmoot_node_ingress.py
index 80ec286..98625ef 100644
--- a/scripts/tests/test_kithmoot_node_ingress.py
+++ b/scripts/tests/test_kithmoot_node_ingress.py
@@ -1,6 +1,10 @@
 import importlib.util
 from pathlib import Path
 import unittest
+import subprocess
+import tempfile
+import sys
+from unittest.mock import patch
 
 ROOT = Path(__file__).resolve().parents[2]
 SPEC = importlib.util.spec_from_file_location('node_ingress', ROOT / 'scripts/kithmoot-node-ingress.py')
@@ -67,5 +71,40 @@ class HostIngress(unittest.TestCase):
         self.assertNotIn(b'1000', result['tmpfiles'])
 
 
+@unittest.skipUnless(sys.platform == 'linux', 'Host OpenSSL checks require the supported Linux Archy platform')
+class CertificateNames(unittest.TestCase):
+    def certificate(self, names):
+        temporary = tempfile.TemporaryDirectory(prefix='node-ingress-cert-')
+        self.addCleanup(temporary.cleanup)
+        root = Path(temporary.name)
+        cert, key = root / 'cert.pem', root / 'key.pem'
+        subprocess.run(['openssl', 'req', '-x509', '-newkey', 'ec', '-pkeyopt',
+                        'ec_paramgen_curve:P-256', '-nodes', '-keyout', str(key),
+                        '-out', str(cert), '-days', '1', '-subj', '/CN=node.example',
+                        '-addext', 'subjectAltName=' + ','.join('DNS:' + name for name in names)],
+                       check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        key.chmod(0o600)
+        return cert, key
+
+    def validate(self, cert, key):
+        # The fixtures are owned by the test runner rather than root. Keep all
+        # real certificate, SAN, expiry and key-pair validation in production.
+        with patch.object(INGRESS, 'read_protected', side_effect=lambda path, *args: Path(path).read_bytes()):
+            INGRESS.validate_certificates(str(cert), str(key), 'node.example')
+
+    def test_current_host_and_turn_certificate_works_on_current_python(self):
+        self.validate(*self.certificate(['node.example', 'turn.node.example']))
+
+    def test_certificate_missing_turn_name_is_rejected(self):
+        cert, key = self.certificate(['node.example'])
+        with self.assertRaises(ValueError):
+            self.validate(cert, key)
+
+    def test_common_name_cannot_override_nonmatching_san(self):
+        cert, key = self.certificate(['other.example', 'turn.node.example'])
+        with self.assertRaises(ValueError):
+            self.validate(cert, key)
+
+
 if __name__ == '__main__':
     unittest.main()
