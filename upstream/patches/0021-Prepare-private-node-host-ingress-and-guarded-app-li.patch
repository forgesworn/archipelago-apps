+//! Host lifecycle guard. A room keeper must close rooms before data deletion.
+use anyhow::{anyhow, ensure, Result};
+use std::os::unix::fs::MetadataExt;
+use std::path::Path;
+use std::time::Duration;
+use tokio::io::AsyncWriteExt;
+
+const HELPER: &str = "/usr/lib/archipelago/kithmoot-node-ingress.py";
+const SCRIPT: &str = include_str!("../../../../scripts/kithmoot-node-ingress.py");
+
+async fn ensure_helper() -> Result<()> {
+    ensure!(
+        cfg!(target_os = "linux"),
+        "Node hosting requires Linux Archy"
+    );
+    for parent in ["/usr", "/usr/lib", "/usr/lib/archipelago"] {
+        match tokio::fs::symlink_metadata(parent).await {
+            Ok(info) => ensure!(
+                info.is_dir() && info.uid() == 0 && info.mode() & 0o022 == 0,
+                "The node host helper directory needs platform review"
+            ),
+            Err(error)
+                if error.kind() == std::io::ErrorKind::NotFound
+                    && parent == "/usr/lib/archipelago" => {}
+            Err(error) => return Err(error.into()),
+        }
+    }
+    match tokio::fs::symlink_metadata(HELPER).await {
+        Ok(info) => {
+            ensure!(
+                info.is_file()
+                    && info.uid() == 0
+                    && info.mode() & 0o022 == 0
+                    && tokio::fs::read(HELPER).await? == SCRIPT.as_bytes(),
+                "The existing node host helper needs platform review before replacement"
+            );
+            return Ok(());
+        }
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+        Err(error) => return Err(error.into()),
+    }
+    let stage = std::env::temp_dir().join(format!("archy-node-host-{}.py", uuid::Uuid::new_v4()));
+    let mut file = tokio::fs::OpenOptions::new()
+        .create_new(true)
+        .write(true)
+        .mode(0o600)
+        .open(&stage)
+        .await?;
+    let result = async {
+        file.write_all(SCRIPT.as_bytes()).await?;
+        file.sync_all().await?;
+        let output = tokio::time::timeout(
+            Duration::from_secs(15),
+            tokio::process::Command::new("sudo")
+                .args([
+                    "-n",
+                    "install",
+                    "-D",
+                    "-m",
+                    "0755",
+                    "--",
+                    stage
+                        .to_str()
+                        .ok_or_else(|| anyhow!("Invalid host stage path"))?,
+                    HELPER,
+                ])
+                .kill_on_drop(true)
+                .output(),
+        )
+        .await??;
+        ensure!(
+            output.status.success(),
+            "Node host helper installation failed"
+        );
+        Ok(())
+    }
+    .await;
+    let _ = tokio::fs::remove_file(stage).await;
+    result
+}
+
+fn configuration(config: &crate::config::Config) -> Result<[String; 6]> {
+    let ip: std::net::Ipv4Addr = config.host_ip.parse().map_err(|_| {
+        anyhow!(
+            "The node requires an assigned public IPv4 address on a rented server or remote Archy"
+        )
+    })?;
+    let octets = ip.octets();
+    ensure!(
+        !ip.is_private()
+            && !ip.is_loopback()
+            && !ip.is_link_local()
+            && !ip.is_documentation()
+            && !ip.is_unspecified()
+            && !ip.is_multicast()
+            && !ip.is_broadcast()
+            && octets[0] != 0
+            && octets[0] < 224
+            && !(octets[0] == 100 && (64..=127).contains(&octets[1]))
+            && !(octets[0] == 198 && (octets[1] == 18 || octets[1] == 19)),
+        "Install the node on a rented server or remote Archy with an assigned public IPv4 address"
+    );
+    let host = config
+        .public_host
+        .clone()
+        .ok_or_else(|| anyhow!("Configure the node public hostname and TLS certificate first"))?;
+    let certificate = config
+        .public_cert
+        .as_deref()
+        .and_then(Path::to_str)
+        .ok_or_else(|| anyhow!("Configure the host public certificate first"))?;
+    let key = config
+        .public_key
+        .as_deref()
+        .and_then(Path::to_str)
+        .ok_or_else(|| anyhow!("Configure the host public certificate key first"))?;
+    Ok([
+        "--host".into(),
+        host,
+        "--certificate".into(),
+        certificate.into(),
+        "--key".into(),
+        key.into(),
+    ])
+}
+
+async fn helper(command: &str, args: &[String]) -> Result<()> {
+    let output = tokio::time::timeout(
+        Duration::from_secs(60),
+        tokio::process::Command::new("sudo")
+            .args(["-n", "python3", HELPER, command])
+            .args(args)
+            .kill_on_drop(true)
+            .output(),
+    )
+    .await
+    .map_err(|_| anyhow!("Node host ingress timed out; preserve its recovery journal"))??;
+    let reply: serde_json::Value = serde_json::from_slice(&output.stdout).unwrap_or_default();
+    ensure!(
+        output.status.success()
+            && output.stdout.len() <= 4096
+            && reply.get("v").and_then(|v| v.as_u64()) == Some(1)
+            && reply.get("ready").and_then(|v| v.as_bool()) == Some(true)
+            && reply.get("operation").and_then(|v| v.as_str()) == Some(command),
+        "Node host ingress is not ready; preserve its configuration and recovery journal"
+    );
+    Ok(())
+}
+
+pub async fn preflight(config: &crate::config::Config) -> Result<()> {
+    let args = configuration(config)?;
+    ensure_helper().await?;
+    helper("check", &args).await
+}
+
+pub async fn install(config: &crate::config::Config) -> Result<()> {
+    let args = configuration(config)?;
+    ensure_helper().await?;
+    helper("install", &args).await
+}
+
+pub async fn remove() -> Result<()> {
+    if !Path::new("/var/lib/archipelago-kithmoot-node-ingress").exists() {
+        return Ok(());
+    }
+    ensure_helper().await?;
+    helper("remove", &[]).await
+}
+
+pub fn spawn_certificate_refresh() {
+    tokio::spawn(async {
+        let mut interval = tokio::time::interval(Duration::from_secs(30));
+        interval.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+        let mut pending = false;
+        loop {
+            interval.tick().await;
+            if !Path::new("/var/lib/archipelago-kithmoot-node-ingress").exists() {
+                pending = false;
+                continue;
+            }
+            let known = match tokio::fs::symlink_metadata(HELPER).await {
+                Ok(info) if info.is_file() && info.uid() == 0 && info.mode() & 0o022 == 0 => {
+                    tokio::fs::read(HELPER)
+                        .await
+                        .is_ok_and(|bytes| bytes == SCRIPT.as_bytes())
+                }
+                _ => false,
+            };
+            let ready = known && helper("sync", &[]).await.is_ok();
+            if !ready && !pending {
+                tracing::warn!("Node public certificate refresh is pending; preserve its host configuration and recovery journal");
+            }
+            pending = !ready;
+        }
+    });
+}
+
+pub async fn prepare_delete(runtime: &crate::config::ContainerRuntime) -> Result<()> {
+    use archipelago_container::runtime::ContainerRuntime as RuntimeTrait;
+    let runtime = match runtime {
+        crate::config::ContainerRuntime::Docker => "docker",
+        crate::config::ContainerRuntime::Podman => "podman",
+        crate::config::ContainerRuntime::Auto => archipelago_container::AutoRuntime::new(
+            std::env::var("USER").unwrap_or_else(|_| "archipelago".into()),
+        )
+        .await?
+        .cli_name(),
+    };
+    let output = tokio::time::timeout(
+        Duration::from_secs(10),
+        tokio::process::Command::new(runtime)
+            .args([
+                "exec",
+                "--user",
+                "1000:1000",
+                "archy-kithmoot-node",
+                "/opt/kithmoot-node/current/kithmoot-node",
+                "prepare-delete",
+                "--state",
+                "/var/lib/kithmoot-node",
+            ])
+            .kill_on_drop(true)
+            .output(),
+    )
+    .await
+    .map_err(|_| anyhow!("Node deletion preparation timed out; data was preserved"))??;
+    ensure!(output.status.success() && archipelago_container::node_host::deletion_prepared(&output.stdout),
+        "Start the KithMoot node, close its rooms in the keeper's app and wait for completion before deleting everything");
+    Ok(())
+}
