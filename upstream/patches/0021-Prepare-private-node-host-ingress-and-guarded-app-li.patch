+//! Explicit disposable-fixture bridge using production TLS and native relay.
+use archipelago_container::node_host::{
+    consume_turn_proxy_header, relay_turn, trusted_turn_ingress,
+};
+use archipelago_node_ingress_tests::tls::{GateTls, PublicSite};
+use std::{net::IpAddr, path::Path, sync::Arc, time::Duration};
+
+#[tokio::main]
+async fn main() -> Result<(), Box<dyn std::error::Error>> {
+    if std::env::var("E2E_ARCHY_NODE_INGRESS").as_deref() != Ok("disposable-offline-nginx")
+        || !Path::new("/fixture/disposable-archy-node-ingress").is_file()
+    {
+        return Err("Only the owned disposable host fixture may run this bridge".into());
+    }
+    let tls = Arc::new(GateTls::new().with_public_site(Some(PublicSite {
+        host: "node.example".into(),
+        cert: "/etc/archipelago/ssl/public/cert.pem".into(),
+        key: "/etc/archipelago/ssl/public/key.pem".into(),
+    })));
+    // The daemon normally binds each assigned address and its Tor loopback.
+    // This fixture has one synthetic public address and the same fixed loopback.
+    let slots = Arc::new(tokio::sync::Semaphore::new(64));
+    for (address, target) in [
+        ("1.2.3.4:53499", 34790),
+        ("127.0.0.2:53499", 34790),
+        ("1.2.3.4:5349", 3478),
+    ] {
+        let listener = tokio::net::TcpListener::bind(address).await?;
+        let tls = tls.clone();
+        let slots = slots.clone();
+        tokio::spawn(async move {
+            while let Ok((mut stream, peer)) = listener.accept().await {
+                let Ok(permit) = slots.clone().try_acquire_owned() else {
+                    continue;
+                };
+                let tls = tls.clone();
+                tokio::spawn(async move {
+                    let _permit = permit;
+                    let mut first = [0];
+                    if !matches!(
+                        tokio::time::timeout(Duration::from_secs(15), stream.peek(&mut first))
+                            .await,
+                        Ok(Ok(1))
+                    ) {
+                        return;
+                    }
+                    if first[0] == b'P'
+                        && (!stream.local_addr().is_ok_and(|local| {
+                            trusted_turn_ingress("kithmoot-node", Some(target), local, peer)
+                        }) || !consume_turn_proxy_header(&mut stream).await)
+                    {
+                        return;
+                    }
+                    let Some(acceptor) = tls.acceptor().await else {
+                        return;
+                    };
+                    if let Ok(Ok(stream)) =
+                        tokio::time::timeout(Duration::from_secs(10), acceptor.accept(stream)).await
+                    {
+                        relay_turn(stream, target, vec![IpAddr::from([1, 2, 3, 4])]).await;
+                    }
+                });
+            }
+        });
+    }
+    tokio::signal::ctrl_c().await?;
+    Ok(())
+}
