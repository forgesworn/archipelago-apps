index 0000000..768a66e
--- /dev/null
+++ b/core/container/src/node_host.rs
@@ -0,0 +1,204 @@
+//! Fixed host-owned support for the KithMoot node. No room or host TLS keys.
+use std::net::{IpAddr, SocketAddr};
+use tokio::io::{AsyncRead, AsyncReadExt};
+
+/// Only nginx's private loopback hop may prepend connection metadata. Public
+/// TLS sockets and other apps never interpret a PROXY header.
+pub fn trusted_turn_ingress(
+    app: &str,
+    target: Option<u16>,
+    local: SocketAddr,
+    peer: SocketAddr,
+) -> bool {
+    app == "kithmoot-node"
+        && target == Some(34790)
+        && local.ip() == IpAddr::from([127, 0, 0, 2])
+        && local.port() == 53499
+        && peer.ip() == IpAddr::from([127, 0, 0, 1])
+}
+
+fn valid_proxy_header(bytes: &[u8]) -> bool {
+    let Ok(text) = std::str::from_utf8(bytes) else {
+        return false;
+    };
+    let Some(text) = text.strip_suffix("\r\n") else {
+        return false;
+    };
+    let parts: Vec<_> = text.split(' ').collect();
+    if parts.len() != 6 || parts[0] != "PROXY" || parts[5] != "443" {
+        return false;
+    }
+    let (Ok(source), Ok(destination), Ok(port)) = (
+        parts[2].parse::<IpAddr>(),
+        parts[3].parse::<IpAddr>(),
+        parts[4].parse::<u16>(),
+    ) else {
+        return false;
+    };
+    port != 0
+        && match parts[1] {
+            "TCP4" => source.is_ipv4() && destination.is_ipv4(),
+            "TCP6" => source.is_ipv6() && destination.is_ipv6(),
+            _ => false,
+        }
+}
+
+/// Bounded PROXY v1 input; the caller must first establish trusted_turn_ingress.
+/// Addresses are validated and discarded, never used as authority or logged.
+/// Consumes exactly the header, leaving the TLS ClientHello untouched.
+pub async fn consume_turn_proxy_header<R: AsyncRead + Unpin>(stream: &mut R) -> bool {
+    tokio::time::timeout(std::time::Duration::from_secs(2), async {
+        let mut header = Vec::with_capacity(108);
+        while header.len() < 108 {
+            let Ok(byte) = stream.read_u8().await else {
+                return false;
+            };
+            header.push(byte);
+            if byte == b'\n' {
+                return valid_proxy_header(&header);
+            }
+        }
+        false
+    })
+    .await
+    .unwrap_or(false)
+}
+
+/// A successful CLI exit alone is insufficient for destructive teardown.
+pub fn deletion_prepared(reply: &[u8]) -> bool {
+    #[derive(serde::Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Reply {
+        ok: bool,
+        result: Proof,
+    }
+    #[derive(serde::Deserialize)]
+    #[serde(deny_unknown_fields, rename_all = "camelCase")]
+    struct Proof {
+        delete_ready: bool,
+    }
+    reply.len() <= 4096
+        && serde_json::from_slice::<Reply>(reply)
+            .is_ok_and(|value| value.ok && value.result.delete_ready)
+}
+
+/// Fixed native TURN destinations only; no peer or URL can select an upstream.
+pub async fn relay_turn<IO>(mut client: IO, port: u16, addresses: Vec<IpAddr>)
+where
+    IO: tokio::io::AsyncRead + tokio::io::AsyncWrite + Unpin,
+{
+    if ![3478, 34790].contains(&port) {
+        return;
+    }
+    for address in addresses.into_iter().filter(|ip| ip.is_ipv4()).take(8) {
+        if let Ok(Ok(mut upstream)) = tokio::time::timeout(
+            std::time::Duration::from_millis(300),
+            tokio::net::TcpStream::connect(SocketAddr::new(address, port)),
+        )
+        .await
+        {
+            let _ = tokio::time::timeout(
+                std::time::Duration::from_secs(86400),
+                tokio::io::copy_bidirectional(&mut client, &mut upstream),
+            )
+            .await;
+            return;
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use tokio::io::AsyncWriteExt;
+
+    #[test]
+    fn only_the_fixed_node_loopback_hop_is_trusted() {
+        let local = "127.0.0.2:53499".parse().unwrap();
+        let peer = "127.0.0.1:45678".parse().unwrap();
+        assert!(trusted_turn_ingress(
+            "kithmoot-node",
+            Some(34790),
+            local,
+            peer
+        ));
+        assert!(!trusted_turn_ingress("spry", Some(34790), local, peer));
+        assert!(!trusted_turn_ingress(
+            "kithmoot-node",
+            Some(22),
+            local,
+            peer
+        ));
+        assert!(!trusted_turn_ingress(
+            "kithmoot-node",
+            Some(34790),
+            "1.2.3.4:53499".parse().unwrap(),
+            peer
+        ));
+        assert!(!trusted_turn_ingress(
+            "kithmoot-node",
+            Some(34790),
+            local,
+            "127.0.0.2:45678".parse().unwrap()
+        ));
+    }
+
+    #[test]
+    fn proxy_headers_require_typed_addresses_and_the_exact_ingress_destination() {
+        assert!(valid_proxy_header(
+            b"PROXY TCP4 1.2.3.4 5.6.7.8 1234 443\r\n"
+        ));
+        assert!(valid_proxy_header(
+            b"PROXY TCP6 2001:db8::1 2001:db8::2 1234 443\r\n"
+        ));
+        for invalid in [
+            b"PROXY UNKNOWN\r\n".as_slice(),
+            b"PROXY TCP4 ::1 ::2 1234 443\r\n",
+            b"PROXY TCP4 1.2.3.4 5.6.7.8 0 443\r\n",
+            b"PROXY TCP4 1.2.3.4 5.6.7.8 1234 22\r\n",
+            b"PROXY TCP4 1.2.3.4 5.6.7.8 1234 443\n",
+        ] {
+            assert!(!valid_proxy_header(invalid));
+        }
+    }
+
+    #[tokio::test]
+    async fn split_header_preserves_the_following_tls_bytes_and_bounds_input() {
+        let (mut writer, mut reader) = tokio::io::duplex(256);
+        let writing = tokio::spawn(async move {
+            writer.write_all(b"PROXY TCP4 1.2.3.4 ").await.unwrap();
+            tokio::task::yield_now().await;
+            writer
+                .write_all(b"5.6.7.8 1234 443\r\n\x16\x03\x03")
+                .await
+                .unwrap();
+        });
+        assert!(consume_turn_proxy_header(&mut reader).await);
+        let mut tls = [0; 3];
+        reader.read_exact(&mut tls).await.unwrap();
+        assert_eq!(tls, [0x16, 3, 3]);
+        writing.await.unwrap();
+        let bytes = [b'P'; 109];
+        let mut overlong = bytes.as_slice();
+        assert!(!consume_turn_proxy_header(&mut overlong).await);
+        let mut truncated = b"PROXY TCP4 1.2.3.4".as_slice();
+        assert!(!consume_turn_proxy_header(&mut truncated).await);
+    }
+
+    #[test]
+    fn destructive_removal_needs_the_exact_positive_local_acknowledgement() {
+        assert!(deletion_prepared(
+            br#"{"ok":true,"result":{"deleteReady":true}}"#
+        ));
+        for invalid in [
+            br#"{"ok":false,"result":{"deleteReady":true}}"#.as_slice(),
+            br#"{"ok":true,"result":{"deleteReady":false}}"#,
+            br#"{"ok":true,"result":{"ready":true,"rooms":0}}"#,
+            br#"{"ok":true,"result":{"deleteReady":true,"extra":true}}"#,
+            b"success",
+            b"",
+        ] {
+            assert!(!deletion_prepared(invalid));
+        }
+    }
+}
