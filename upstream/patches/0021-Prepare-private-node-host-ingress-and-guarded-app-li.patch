diff --git a/scripts/tests/test_kithmoot_node_ingress.py b/scripts/tests/test_kithmoot_node_ingress.py
new file mode 100644
index 0000000..f5b3588
--- /dev/null
+++ b/scripts/tests/test_kithmoot_node_ingress.py
@@ -0,0 +1,68 @@
+import importlib.util
+from pathlib import Path
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+SPEC = importlib.util.spec_from_file_location('node_ingress', ROOT / 'scripts/kithmoot-node-ingress.py')
+INGRESS = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(INGRESS)
+
+
+def site():
+    # Exercise the shipped HTTP/HTTPS servers after the listener boot repair.
+    text = (ROOT / 'image-recipe/configs/nginx-archipelago.conf').read_text()
+    return text.replace('    listen 443 ssl default_server;', '    listen 1.2.3.4:443 ssl;').replace('    listen [::]:443 ssl default_server;', '')
+
+
+class HostIngress(unittest.TestCase):
+    def render(self, text=None):
+        return INGRESS.plan(text or site(), 'node.example', '/etc/archipelago/ssl/public/cert.pem', '/etc/archipelago/ssl/public/key.pem')
+
+    def test_actual_managed_site_preserves_http_and_dashboard_guards(self):
+        before = site(); result = self.render(before)
+        self.assertIn('    listen 80 default_server;', result['site'].decode())
+        self.assertIn('    listen [::]:80 default_server;', result['site'].decode())
+        self.assertNotIn('listen 1.2.3.4:443 ssl;', result['site'].decode())
+        self.assertEqual(result['addresses'], ['1.2.3.4:443'])
+        self.assertIn('geo $archy_node_socket_source $archy_management_private_source', result['site'].decode())
+        self.assertEqual(result['site'].decode().count('if ($archy_management_denied) { return 404; }'), 2)
+        self.assertIn('set_real_ip_from unix:', result['site'].decode())
+        self.assertIn('real_ip_header proxy_protocol;', result['site'].decode())
+        self.assertIn('proxy_protocol on;', result['stream'].decode())
+        self.assertIn('turn.node.example 127.0.0.2:53499;', result['stream'].decode())
+
+    def test_public_vhost_exposes_only_node_routes_without_browser_cookies(self):
+        public = self.render()['public'].decode()
+        self.assertEqual(public.count('location = '), 10)
+        self.assertIn('location / { return 404; }', public)
+        self.assertEqual(public.count('proxy_set_header Cookie "";'), 10)
+        self.assertEqual(public.count('proxy_hide_header Set-Cookie;'), 10)
+        self.assertEqual(public.count('proxy_set_header X-Forwarded-For $remote_addr;'), 10)
+        self.assertNotIn('proxy_add_x_forwarded_for', public)
+        self.assertIn('proxy_set_header Upgrade $http_upgrade;', public)
+        self.assertIn('access_log off;', public)
+        self.assertNotIn('root /opt/archipelago/web-ui;', public)
+
+    def test_custom_listener_and_other_vhosts_are_refused(self):
+        for text in [site().replace('1.2.3.4:443 ssl;', '1.2.3.4:443 ssl http2;'),
+                     site() + '\nserver {\n    listen 443 ssl;\n    server_name other.example;\n}\n',
+                     site().replace('/etc/archipelago/ssl/archipelago.key;', '/operator/custom.key;')]:
+            with self.assertRaises(ValueError):
+                self.render(text)
+
+    def test_hosts_and_certificate_paths_cannot_inject_nginx(self):
+        for host in ['node.example;', 'node.example\nserver', '127.0.0.1', 'node.local', '*.example', 'Node.example']:
+            with self.assertRaises(ValueError):
+                INGRESS.plan(site(), host, '/cert.pem', '/key.pem')
+        for path in ['/cert.pem;server', '/etc/../cert.pem', 'cert.pem', '/cert\n.pem']:
+            with self.assertRaises(ValueError):
+                INGRESS.plan(site(), 'node.example', path, '/key.pem')
+
+    def test_private_runtime_directory_is_recreated_before_nginx_after_boot(self):
+        result = self.render()
+        self.assertIn(b'd /run/archipelago-kithmoot-node 0750 root www-data -\n', result['tmpfiles'])
+        self.assertNotIn(b'1000', result['tmpfiles'])
+
+
+if __name__ == '__main__':
+    unittest.main()
