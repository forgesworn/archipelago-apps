+        if package_id == "kithmoot-node" && !preserve_data {
+            // The local acknowledgement freezes enrolment durably. Checking
+            // counts alone would race a new room between this check and stop.
+            crate::container::kithmoot_node::prepare_delete(&self.config.container_runtime).await?;
