+#!/usr/bin/env python3
+# Archipelago host-owned KithMoot node ingress helper v1
+"""Host-owned, transactional ingress for the private KithMoot node candidate.
+
+No app receives the host key. Only the exact node API and TURN alias are public;
+the existing dashboard keeps its source guard and original client addresses.
+"""
+import argparse
+import fcntl
+import hashlib
+import ipaddress
+import json
+import os
+from pathlib import Path
+import re
+import socket
+import ssl
+import stat
+import subprocess
+import tempfile
+import time
+
+STATE = Path('/var/lib/archipelago-kithmoot-node-ingress')
+STREAM = Path('/etc/nginx/modules-enabled/90-archipelago-kithmoot-node.conf')
+PUBLIC = Path('/etc/nginx/conf.d/archipelago-kithmoot-node.conf')
+TMPFILES = Path('/etc/tmpfiles.d/archipelago-kithmoot-node.conf')
+RUNTIME = Path('/run/archipelago-kithmoot-node')
+SOCKET = str(RUNTIME / 'https.sock')
+SITES = [Path('/etc/nginx/sites-enabled/archipelago-http'), Path('/etc/nginx/sites-enabled/archipelago')]
+MARK = '# Host-owned Archipelago KithMoot node ingress.\n'
+SOURCE = 'geo $realip_remote_addr $archy_management_private_source {'
+PROXY_SOURCE = ('map $proxy_protocol_addr $archy_node_socket_source {\n'
+                '    default $proxy_protocol_addr;\n    "" $realip_remote_addr;\n}\n'
+                'geo $archy_node_socket_source $archy_management_private_source {')
+LISTEN = re.compile(r'^\s+listen\s+(\S+)\s+ssl(?:\s+default_server)?;\s*$', re.M)
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def hostname(value):
+    if not isinstance(value, str) or len(value) > 220 or value != value.lower() or '.' not in value:
+        raise ValueError('A public DNS hostname is required')
+    if any(not re.fullmatch(r'[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?', label) for label in value.split('.')):
+        raise ValueError('Invalid public hostname')
+    if value.endswith(('.local', '.localhost', '.onion')):
+        raise ValueError('A public DNS hostname is required')
+    try:
+        ipaddress.ip_address(value)
+    except ValueError:
+        return value
+    raise ValueError('A DNS hostname, rather than an address, is required')
+
+
+def certificate_path(value):
+    if not isinstance(value, str) or not re.fullmatch(r'/[A-Za-z0-9_./-]+', value) or '..' in Path(value).parts:
+        raise ValueError('Invalid host certificate path')
+    return value
+
+
+def plan(text, host, certificate, key):
+    """Own only the recognised shipped HTTPS server; leave HTTP and guards intact."""
+    host = hostname(host)
+    certificate, key = certificate_path(certificate), certificate_path(key)
+    if text.count(SOURCE) != 1 or PROXY_SOURCE in text or MARK in text:
+        raise ValueError('Expected the current managed dashboard source guard')
+    blocks = []
+    for opening in re.finditer(r'^server \{\s*$', text, re.M):
+        ending = re.search(r'^}\s*$', text[opening.end():], re.M)
+        if ending:
+            blocks.append((opening.start(), opening.end() + ending.end()))
+    candidates = []
+    for start, end in blocks:
+        block = text[start:end]
+        if all(value in block.splitlines() for value in [
+            '    server_name _;', '    root /opt/archipelago/web-ui;',
+            '    ssl_certificate /etc/archipelago/ssl/archipelago.crt;',
+            '    ssl_certificate_key /etc/archipelago/ssl/archipelago.key;']):
+            candidates.append((start, end, block))
+    if len(candidates) != 1:
+        raise ValueError('Expected one recognised node-CA dashboard HTTPS server')
+    start, end, block = candidates[0]
+    listeners = LISTEN.findall(block)
+    if not listeners or any('listen ' in line and line.rstrip().endswith(';') and not LISTEN.fullmatch(line)
+                            for line in block.splitlines() if re.match(r'^\s+listen ', line)):
+        raise ValueError('Custom dashboard listeners need operator review')
+    addresses = []
+    for address in listeners:
+        if address == '443':
+            address = '0.0.0.0:443'
+        if address == '[::]:443':
+            pass
+        elif address.endswith(':443'):
+            ipaddress.ip_address(address[:-4].strip('[]'))
+        else:
+            raise ValueError('Only the existing HTTPS443 listeners may be moved')
+        if address in addresses:
+            raise ValueError('Duplicate HTTPS listeners')
+        addresses.append(address)
+    # Other TLS443 servers cannot remain bound outside the shared host router.
+    if LISTEN.search(text[:start] + text[end:]):
+        raise ValueError('Custom TLS servers must be preserved; ingress was not changed')
+    replacement = ('\n    # BEGIN ARCHIPELAGO KITHMOOT NODE TLS\n'
+                   f'    listen unix:{SOCKET} ssl proxy_protocol default_server;\n'
+                   '    set_real_ip_from unix:;\n    real_ip_header proxy_protocol;\n'
+                   '    # END ARCHIPELAGO KITHMOOT NODE TLS\n')
+    changed = False
+    def replace_listener(match):
+        nonlocal changed
+        if changed:
+            return ''
+        changed = True
+        return replacement
+    updated = text[:start] + LISTEN.sub(replace_listener, block) + text[end:]
+    updated = updated.replace(SOURCE, PROXY_SOURCE, 1)
+    stream = MARK + 'stream {\n    map $ssl_preread_server_name $archy_node_upstream {\n'
+    stream += f'        hostnames;\n        turn.{host} 127.0.0.2:53499;\n'
+    stream += f'        default unix:{SOCKET};\n    }}\n    server {{\n'
+    stream += ''.join(f'        listen {address};\n' for address in addresses)
+    stream += ('        ssl_preread on;\n        proxy_protocol on;\n'
+               '        proxy_connect_timeout 5s;\n        proxy_timeout 10m;\n'
+               '        preread_timeout 10s;\n        access_log off;\n        error_log /dev/null crit;\n'
+               '        proxy_pass $archy_node_upstream;\n    }\n}\n')
+    public = MARK + ('map $http_upgrade $archy_node_upgrade { default upgrade; "" close; }\n'
+                     'map $http_authorization $archy_node_authorization {\n'
+                     '    default "";\n    "~^Nostr [A-Za-z0-9+/]+={0,2}$" $http_authorization;\n}\n')
+    public += f'map $ssl_server_name $archy_node_sni {{ hostnames; default 0; {host} 1; }}\nserver {{\n'
+    public += (f'    listen unix:{SOCKET} ssl proxy_protocol;\n    server_name {host};\n'
+               f'    ssl_certificate {certificate};\n    ssl_certificate_key {key};\n'
+               '    ssl_protocols TLSv1.2 TLSv1.3;\n    set_real_ip_from unix:;\n'
+               '    real_ip_header proxy_protocol;\n    access_log off;\n    error_log /dev/null crit;\n'
+               '    client_max_body_size 64k;\n    client_body_timeout 10s;\n'
+               '    client_header_timeout 10s;\n    keepalive_timeout 15s;\n'
+               '    if ($archy_node_sni = 0) { return 421; }\n'
+               f'    if ($host != {host}) {{ return 421; }}\n'
+               '    add_header Referrer-Policy no-referrer always;\n')
+    common = ('        if ($args != "") { return 404; }\n'
+              '        proxy_http_version 1.1;\n        proxy_connect_timeout 5s;\n'
+              '        proxy_read_timeout 75s;\n        proxy_send_timeout 15s;\n'
+              '        proxy_buffering off;\n        proxy_request_buffering on;\n'
+              '        proxy_pass_request_headers off;\n'
+              '        proxy_set_header Host $host;\n        proxy_set_header Cookie "";\n'
+              '        proxy_set_header Content-Type $http_content_type;\n'
+              '        proxy_set_header Origin $http_origin;\n'
+              '        proxy_set_header Authorization $archy_node_authorization;\n'
+              '        proxy_set_header Proxy-Authorization "";\n'
+              '        proxy_set_header X-Forwarded-For $remote_addr;\n'
+              '        proxy_set_header X-Forwarded-Proto https;\n'
+              '        proxy_hide_header Set-Cookie;\n        proxy_hide_header Proxy-Authenticate;\n')
+    paths = {'/node/v1/info': 3750, '/node/v1/status': 3750, '/node/v1/claim': 3750,
+             '/node/v1/enrol': 3750, '/node/v1/access': 3750, '/node/v1/close': 3750,
+             '/node/v1/operation': 3750, '/groups/v1/events': 3750, '/v1/credentials': 3751, '/events': 3752}
+    for path, port in paths.items():
+        public += f'    location = {path} {{\n' + (common.replace('proxy_read_timeout 75s;', 'proxy_read_timeout 1h;') if path == '/events' else common)
+        if path == '/events':
+            public += ('        proxy_set_header Upgrade $http_upgrade;\n'
+                       '        proxy_set_header Connection $archy_node_upgrade;\n'
+                       '        proxy_set_header Sec-WebSocket-Key $http_sec_websocket_key;\n'
+                       '        proxy_set_header Sec-WebSocket-Version $http_sec_websocket_version;\n')
+        else:
+            public += '        proxy_set_header Connection "";\n'
+        public += f'        proxy_pass http://127.0.0.1:{port};\n    }}\n'
+    public += '    location / { return 404; }\n}\n'
+    return {'site': updated.encode(), 'stream': stream.encode(), 'public': public.encode(), 'addresses': addresses,
+            'tmpfiles': (MARK + f'd {RUNTIME} 0750 root www-data -\n').encode()}
+
+
+def read_protected(path, limit=1048576):
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
+    try:
+        info = os.fstat(fd)
+        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022 or info.st_size > limit:
+            raise ValueError('Unsafe host ingress input')
+        return os.read(fd, limit + 1)
+    finally:
+        os.close(fd)
+
+
+def atomic(path, data, mode=0o644):
+    fd, temporary = tempfile.mkstemp(prefix='.node-ingress-', dir=path.parent)
+    try:
+        os.fchmod(fd, mode)
+        with os.fdopen(fd, 'wb') as file:
+            file.write(data); file.flush(); os.fsync(file.fileno())
+        os.replace(temporary, path)
+        parent = os.open(path.parent, os.O_RDONLY)
+        try:
+            os.fsync(parent)
+        finally:
+            os.close(parent)
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
+
+def run(args, timeout=15):
+    result = subprocess.run(args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                            timeout=timeout, env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C'})
+    if result.returncode or len(result.stdout) > 1048576:
+        raise ValueError('Host ingress command failed: ' + args[0])
+    return result.stdout
+
+
+def validate_certificates(certificate, key, host):
+    import warnings
+    read_protected(Path(certificate), 262144)
+    info = Path(key).lstat()
+    if info.st_mode & 0o007:
+        raise ValueError('Host private key must not be public')
+    read_protected(Path(key), 262144)
+    decoded = ssl._ssl._test_decode_cert(certificate)
+    if not decoded.get('subjectAltName'):
+        raise ValueError('Host certificate requires DNS subject alternative names')
+    with warnings.catch_warnings():
+        warnings.simplefilter('ignore', DeprecationWarning)
+        for name in (host, 'turn.' + host):
+            ssl.match_hostname(decoded, name)
+    now = time.time()
+    if ssl.cert_time_to_seconds(decoded['notBefore']) > now or ssl.cert_time_to_seconds(decoded['notAfter']) <= now:
+        raise ValueError('Host certificate is not current')
+    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+    context.load_cert_chain(certificate, key)  # checks the private-key match
+
+
+def nginx_master():
+    value = read_protected(Path('/run/nginx.pid'), 32).decode().strip()
+    if not value.isdecimal() or int(value) <= 1 or os.path.realpath('/proc/' + value + '/exe') != '/usr/sbin/nginx':
+        raise ValueError('Expected the running host nginx master')
+    return int(value)
+
+
+def workers(master):
+    values = Path(f'/proc/{master}/task/{master}/children').read_text().split()
+    found = set()
+    for value in values:
+        try:
+            command = Path(f'/proc/{value}/cmdline').read_bytes()
+            if command.startswith(b'nginx: worker process') and b'is shutting down' not in command:
+                found.add(int(value))
+        except FileNotFoundError:
+            pass
+    return found
+
+
+def dashboard_accepting():
+    """Verify the configured node leaf and private dashboard after a reload.
+
+    A new worker can exist before the old stream/HTTP acceptors have released
+    their sockets. Keep the journal until a real private HTTPS request succeeds.
+    """
+    try:
+        original = STATE / 'original.conf'
+        text = read_protected(original if original.exists() else source_site()).decode()
+        address = LISTEN.findall(text)[0]
+        target = '127.0.0.1' if address == '443' else address[:-4].strip('[]')
+        if target in ('0.0.0.0', '::'):
+            target = '::1' if target == '::' else '127.0.0.1'
+        leaf = '/etc/archipelago/ssl/archipelago.crt'
+        decoded = ssl._ssl._test_decode_cert(leaf)
+        names = [value for kind, value in decoded.get('subjectAltName', ()) if kind == 'IP Address']
+        public_host = journal_read()['host'] if (STATE / 'installation.json').exists() else None
+        names += [value for kind, value in decoded.get('subjectAltName', ()) if kind == 'DNS' and value != public_host and '*' not in value]
+        if not names:
+            return False
+        context = ssl.create_default_context(cafile=leaf)
+        context.verify_flags |= ssl.VERIFY_X509_PARTIAL_CHAIN
+        family = socket.AF_INET6 if ':' in target else socket.AF_INET
+        with socket.socket(family) as raw:
+            raw.settimeout(0.5); raw.bind(('::1' if family == socket.AF_INET6 else '127.0.0.1', 0)); raw.connect((target, 443))
+            with context.wrap_socket(raw, server_hostname=names[0]) as stream:
+                pem = read_protected(Path(leaf), 262144).decode().split('-----END CERTIFICATE-----')[0] + '-----END CERTIFICATE-----\n'
+                if stream.getpeercert(binary_form=True) != ssl.PEM_cert_to_DER_cert(pem):
+                    return False
+                stream.sendall(('GET / HTTP/1.1\r\nHost: ' + names[0] + '\r\nConnection: close\r\n\r\n').encode())
+                return stream.recv(256).startswith((b'HTTP/1.1 200 ', b'HTTP/1.1 301 ', b'HTTP/1.1 302 '))
+    except (OSError, ValueError, IndexError, ssl.SSLError):
+        return False
+
+
+def reload_checked():
+    master = nginx_master(); before = workers(master)
+    if not before:
+        raise ValueError('Expected running nginx workers')
+    run(['nginx', '-t']); run(['nginx', '-s', 'reload'])
+    for _ in range(100):
+        if workers(master) - before and dashboard_accepting():
+            return
+        time.sleep(0.1)
+    raise ValueError('Nginx did not accept a new worker generation')
+
+
+def source_site():
+    found = set()
+    for link in SITES:
+        if link.exists():
+            target = link.resolve()
+            if target.parent != Path('/etc/nginx/sites-available'):
+                raise ValueError('Custom dashboard site links must be preserved')
+            text = read_protected(target).decode()
+            if 'ssl_certificate /etc/archipelago/ssl/archipelago.crt;' in text:
+                found.add(target)
+    if len(found) != 1:
+        raise ValueError('Expected one enabled managed dashboard site')
+    return found.pop()
+
+
+def journal_read():
+    info = STATE.lstat()
+    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o077:
+        raise ValueError('Unsafe host ingress state directory')
+    value = json.loads(read_protected(STATE / 'installation.json'))
+    if (not isinstance(value, dict) or set(value) != {'v', 'phase', 'source', 'host', 'certificate', 'certificateDigest', 'key', 'hashes', 'original'}
+            or value['v'] != 1 or value['phase'] not in ('prepared', 'ready', 'restoring')
+            or Path(value['source']).parent != Path('/etc/nginx/sites-available')
+            or not re.fullmatch(r'[A-Za-z0-9_-]+', Path(value['source']).name)):
+        raise ValueError('Invalid host ingress recovery journal')
+    hostname(value['host']); certificate_path(value['certificate']); certificate_path(value['key'])
+    if not isinstance(value['hashes'], dict) or set(value['hashes']) != {'site', 'stream', 'public', 'tmpfiles'} or any(not isinstance(item, str) or not re.fullmatch(r'[a-f0-9]{64}', item) for item in [value['original'], value['certificateDigest'], *value['hashes'].values()]):
+        raise ValueError('Invalid host ingress recovery hashes')
+    return value
+
+
+def save(value):
+    atomic(STATE / 'installation.json', (json.dumps(value, sort_keys=True) + '\n').encode(), 0o600)
+
+
+def owned_files(value, allow_original=False):
+    files = {'site': Path(value['source']), 'stream': STREAM, 'public': PUBLIC, 'tmpfiles': TMPFILES}
+    for name, path in files.items():
+        if name != 'site' and not os.path.lexists(path) and allow_original:
+            continue
+        accepted = {value['hashes'][name]}
+        if name == 'site' and allow_original:
+            accepted.add(value['original'])
+        if digest(read_protected(path)) not in accepted:
+            raise ValueError('Modified host ingress configuration needs operator review')
+    return files
+
+
+def restore(value):
+    files = owned_files(value, allow_original=True)
+    original = read_protected(STATE / 'original.conf')
+    if digest(original) != value['original']:
+        raise ValueError('Invalid dashboard recovery copy')
+    save({**value, 'phase': 'restoring'})
+    atomic(files['site'], original)
+    for name in ('stream', 'public', 'tmpfiles'):
+        if os.path.lexists(files[name]):
+            files[name].unlink()
+    reload_checked()
+    (STATE / 'installation.json').unlink(); (STATE / 'original.conf').unlink(); STATE.rmdir()
+    # The private runtime socket belongs to nginx. In-flight workers may still
+    # hold it; keep that directory until their normal exit rather than guessing.
+
+
+def install(host, certificate, key):
+    host = hostname(host); certificate = certificate_path(certificate); key = certificate_path(key)
+    validate_certificates(certificate, key, host)
+    if os.path.lexists(STATE):
+        info = STATE.lstat()
+        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o077:
+            raise ValueError('Unsafe host ingress state directory')
+    if os.path.lexists(STATE / 'installation.json'):
+        previous = journal_read()
+        if previous['phase'] == 'ready':
+            owned_files(previous)
+            if (previous['host'], previous['certificate'], previous['key']) != (host, certificate, key):
+                raise ValueError('Remove the existing ingress before changing its hostname or certificate paths')
+            reload_checked()  # also activates an operator-renewed certificate
+            save({**previous, 'certificateDigest': digest(read_protected(Path(certificate), 262144))})
+            return
+        restore(previous)
+    if any(os.path.lexists(path) for path in (STATE, STREAM, PUBLIC, TMPFILES)):
+        raise ValueError('Existing host ingress files must be preserved')
+    source = source_site(); original = read_protected(source)
+    rendered = plan(original.decode(), host, certificate, key)
+    live = run(['nginx', '-T']).decode()
+    # Refuse unrelated/custom443 vhosts, including included files outside the
+    # recognised site. Never claim nginx-proxy-manager or another service.
+    if len(LISTEN.findall(live)) != len(LISTEN.findall(original.decode())):
+        raise ValueError('Additional TLS listeners need operator review')
+    if 'load_module modules/ngx_stream_module.so;' not in live and 'load_module /usr/lib/nginx/modules/ngx_stream_module.so;' not in live:
+        raise ValueError('Host nginx requires its stream module before node installation')
+    if not os.path.lexists(RUNTIME):
+        import grp
+        RUNTIME.mkdir(mode=0o750); os.chown(RUNTIME, 0, grp.getgrnam('www-data').gr_gid)
+    info = RUNTIME.lstat()
+    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o007:
+        raise ValueError('Unsafe private nginx ingress directory')
+    if not os.path.lexists(TMPFILES.parent):
+        TMPFILES.parent.mkdir(mode=0o755)
+    info = TMPFILES.parent.lstat()
+    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
+        raise ValueError('Unsafe host runtime configuration directory')
+    value = {'v': 1, 'phase': 'prepared', 'source': str(source), 'host': host, 'certificate': certificate, 'key': key,
+             'certificateDigest': digest(read_protected(Path(certificate), 262144)),
+             'hashes': {name: digest(rendered[name]) for name in ('site', 'stream', 'public', 'tmpfiles')}, 'original': digest(original)}
+    stage = Path(tempfile.mkdtemp(prefix='.archipelago-node-ingress-', dir=STATE.parent))
+    try:
+        atomic(stage / 'original.conf', original, 0o600)
+        atomic(stage / 'installation.json', (json.dumps(value, sort_keys=True) + '\n').encode(), 0o600)
+        os.rename(stage, STATE)
+        parent = os.open(STATE.parent, os.O_RDONLY)
