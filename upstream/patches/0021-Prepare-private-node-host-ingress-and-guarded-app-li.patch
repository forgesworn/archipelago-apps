+                reply = subprocess.run([BASE + '/kithmoot-node', 'prepare-delete', '--state', str(directory)], user=1000, group=1000, extra_groups=(),
+                    stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=10)
+                assert reply.returncode == 1 and json.loads(reply.stdout)['error'] == 'close-rooms-before-delete'
+                assert local_status()['rooms'] > 0 and not local_status().get('deleting')
+                refused = True
+                progress('active room refused destructive host deletion')
+            finally:
+                os.kill(journey.pid, signal.SIGCONT)
+            break
+        time.sleep(0.1)
+    stdout, stderr = journey.communicate(timeout=120)
+    assert journey.returncode == 0, stderr.decode()[-4096:]
+    assert refused
+    proof = json.loads(stdout); assert proof['result'] == 'passed' and proof['deletionFreeze']
+    assert log.read_bytes() == before_log
+    assert listening(3744) and listening(3745)
+    binding(5349, 'node.example')
+    progress('complete SDK journey passed through actual nginx and Rust TLS')
+
+    prepared = json.loads(run([BASE + '/kithmoot-node', 'prepare-delete', '--state', str(directory)], user=1000, group=1000, extra_groups=()))
+    assert prepared == {'ok': True, 'result': {'deleteReady': True}}
+    ingress.restore(ingress.journal_read())
+    assert source.read_bytes() == original and not ingress.STREAM.exists() and not ingress.PUBLIC.exists()
+    assert request('archy.local')[0] == 200 and request('archy.local', source='1.2.3.5')[0] == 404
+    print(json.dumps({'schema': 'archy-node-ingress/1', 'result': 'passed', 'offline': True,
+        'actualNginx': True, 'actualGateTlsSource': True, 'actualNativeRelaySource': True,
+        'normalCertificateAndHostnameVerification': True, 'privateDashboardBeforeAfter': True,
+        'externalDashboardRefusedBeforeAfter': True, 'forgedForwardedSourceRefused': True,
+        'httpAndWebsocketHostCredentialsStripped': True, 'unknownRoutesRefused': True,
+        'failedApplyRestored': True, 'killedApplyRecovered': True, 'operatorChangesPreserved': True,
+        'incompleteRenewalPreservesLastGoodPair': True, 'renewedHttpsAndTurnCertificatesReadBack': True,
+        'bootRuntimeRuleInstalled': True, 'actualSystemReboot': False,
+        'hostKeyDeniedToApplication': True, 'activeDeleteRefused': True, 'nodeActivityAccessLogUnchanged': True,
+        'existingSpryHttpAndTurnPreserved': True, 'privatePeerPortReserved': True,
+        'internalNodePorts': [3750, 3751, 3752], 'journey': proof,
+        'actualFullArchyDaemon': False, 'actualFipsPeer': False, 'publicNetwork': False, 'physicalGrapheneOS': False}))
+finally:
+    if peer is not None:
+        peer.close()
+    for server in servers:
+        server.shutdown(); server.server_close()
+    for value in children:
+        try:
+            os.killpg(value.pid, signal.SIGCONT); os.killpg(value.pid, signal.SIGTERM)
+        except ProcessLookupError:
+            pass
+    time.sleep(0.5)
+    for value in children:
+        try:
+            os.killpg(value.pid, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+    if Path('/run/nginx.pid').exists():
+        subprocess.run(['nginx', '-s', 'quit'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
