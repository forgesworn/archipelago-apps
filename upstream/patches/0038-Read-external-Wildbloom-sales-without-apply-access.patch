+    async fn wildbloom_read_root(&self) -> Result<PathBuf> {
+        match self.wildbloom_settings_root().await {
+            Ok(root) => Ok(root),
+            Err(error) if error.to_string().contains("unknown app_id: wildbloom-node") => {
+                external_wildbloom_read_root().await
+            }
+            Err(error) => Err(error),
+        }
+    }
