+pub(crate) fn external_wildbloom_settings_root(row: &serde_json::Value) -> Result<PathBuf> {
+    anyhow::ensure!(
+        row.get("Name")
+            .and_then(|v| v.as_str())
+            .map(|name| name.trim_start_matches('/'))
+            == Some("wildbloom-node"),
+        "Wildbloom read-only settings require the existing node container"
+    );
+    let image = row
+        .get("ImageName")
+        .and_then(|v| v.as_str())
+        .context("Wildbloom image is unavailable")?;
+    anyhow::ensure!(
+        crate::settings::wildbloom_storage::compatible_node_image(image),
+        "Wildbloom read-only settings require a compatible node package"
+    );
+    let root = PathBuf::from("/var/lib/archipelago/wildbloom-node");
+    let mounted = row
+        .get("Mounts")
+        .and_then(|v| v.as_array())
+        .into_iter()
+        .flatten()
+        .any(|mount| {
+            mount.get("Type").and_then(|v| v.as_str()) == Some("bind")
+                && mount.get("Source").and_then(|v| v.as_str()) == root.to_str()
+                && mount.get("Destination").and_then(|v| v.as_str()) == Some("/data")
+                && mount.get("RW").and_then(|v| v.as_bool()) == Some(true)
+        });
+    anyhow::ensure!(
+        mounted,
+        "Wildbloom read-only settings require the packaged data mount"
+    );
+    Ok(root)
+}
+
+async fn external_wildbloom_read_root() -> Result<PathBuf> {
+    let mut command = tokio::process::Command::new("podman");
+    command
+        .args(["inspect", "wildbloom-node"])
+        .kill_on_drop(true);
+    let output =
+        tokio::time::timeout(std::time::Duration::from_secs(5), command.output()).await??;
+    anyhow::ensure!(
+        output.status.success(),
+        "Wildbloom node cannot be inspected"
+    );
+    let rows: Vec<serde_json::Value> = serde_json::from_slice(&output.stdout)?;
+    let row = rows.first().context("Wildbloom inspection is empty")?;
+    let root = external_wildbloom_settings_root(row)?;
+    anyhow::ensure!(
+        tokio::fs::symlink_metadata(&root).await?.is_dir(),
+        "Wildbloom data directory is unavailable"
+    );
+    Ok(root)
+}
+
