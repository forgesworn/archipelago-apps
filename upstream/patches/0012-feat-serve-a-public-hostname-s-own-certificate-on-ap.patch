 /// against, one step earlier in the handshake.
 const FIRST_BYTE_TIMEOUT: std::time::Duration = std::time::Duration::from_secs(15);
 
+/// How long a client that has started a TLS handshake has to finish it. The
+/// first-byte timeout above only covers the first byte: without this a caller
+/// could send a fragment of a ClientHello and hold the task open for good.
+const TLS_HANDSHAKE_TIMEOUT: std::time::Duration = std::time::Duration::from_secs(10);
+
+/// Complete a TLS handshake within `limit`, or give up. `None` covers both a
+/// failed and a timed-out handshake; neither is operator-actionable.
+async fn accept_tls<IO>(
+    acceptor: tokio_rustls::TlsAcceptor,
+    stream: IO,
+    peer: SocketAddr,
+    limit: std::time::Duration,
+) -> Option<tokio_rustls::server::TlsStream<IO>>
+where
+    IO: tokio::io::AsyncRead + tokio::io::AsyncWrite + Unpin,
+{
+    match tokio::time::timeout(limit, acceptor.accept(stream)).await {
+        Ok(Ok(tls_stream)) => Some(tls_stream),
+        Ok(Err(e)) => {
+            // Routine: a browser probing a cert it does not trust, or a
+            // scanner. Not operator-actionable, so debug.
+            debug!(%peer, error = %e, "app gate TLS handshake failed");
+            None
+        }
+        Err(_) => {
+            debug!(%peer, "app gate TLS handshake timed out");
+            None
+        }
+    }
+}
