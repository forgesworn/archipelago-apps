+    #[tokio::test]
+    async fn a_stalled_tls_handshake_is_abandoned() {
+        // A client that sends the first byte of a ClientHello and then nothing
+        // must not hold the connection beyond the handshake limit.
+        use tokio::io::AsyncWriteExt;
+        let dir = tempfile::tempdir().unwrap();
+        let cert = dir.path().join("c.crt");
+        let key = dir.path().join("c.key");
+        tokio::fs::write(&cert, include_bytes!("testdata/leaf.crt"))
+            .await
+            .unwrap();
+        tokio::fs::write(&key, include_bytes!("testdata/leaf.key"))
+            .await
+            .unwrap();
+        let acceptor = super::super::tls::GateTls::with_paths(&cert, &key)
+            .acceptor()
+            .await
+            .unwrap();
+
+        let (mut client, server) = tokio::io::duplex(1024);
+        client.write_all(&[0x16]).await.unwrap();
+        let peer: SocketAddr = "127.0.0.1:1".parse().unwrap();
+        let limit = std::time::Duration::from_millis(100);
+        let started = std::time::Instant::now();
+        let accepted = tokio::time::timeout(
+            std::time::Duration::from_secs(5),
+            accept_tls(acceptor, server, peer, limit),
+        )
+        .await
+        .expect("handshake was not abandoned");
+        assert!(accepted.is_none());
+        assert!(started.elapsed() >= limit);
+        drop(client);
+    }
