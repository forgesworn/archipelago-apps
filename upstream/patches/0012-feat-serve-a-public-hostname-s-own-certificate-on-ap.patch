+    fn apply_public_site(
+        &mut self,
+        host: Option<String>,
+        cert: Option<String>,
+        key: Option<String>,
+    ) {
+        if let Some(v) = host {
+            self.public_host = Some(v);
+        }
+        if let Some(v) = cert {
