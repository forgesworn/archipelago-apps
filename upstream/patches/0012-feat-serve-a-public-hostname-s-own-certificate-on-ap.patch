+/// How long a public pair that failed to load is left before it is read again
+/// (unless its files change first, which triggers a reload straight away).
+const PUBLIC_RETRY: Duration = Duration::from_secs(5);
+
 /// Does this look like the start of a TLS connection rather than plain HTTP?
 pub fn looks_like_tls(first: u8) -> bool {
     first == TLS_HANDSHAKE_FIRST_BYTE
 }
 
+/// The operator's public hostname and the certificate pair that covers it.
+/// See the module docs.
+#[derive(Clone, Debug)]
+pub struct PublicSite {
+    /// Lowercase DNS hostname, already validated by `Config::load`.
+    pub host: String,
+    pub cert: PathBuf,
+    pub key: PathBuf,
+}
+
+impl PublicSite {
+    /// The public site the operator configured, if it is complete. A hostname
+    /// without both PEM paths cannot be served, so say so once at startup and
+    /// carry on with the node leaf for every name.
+    pub fn from_config(config: &crate::config::Config) -> Option<Self> {
+        let host = config.public_host.clone()?;
+        match (&config.public_cert, &config.public_key) {
+            (Some(cert), Some(key)) => Some(Self {
+                host,
+                cert: cert.clone(),
+                key: key.clone(),
+            }),
+            _ => {
+                warn!(
+                    public_host = %host,
+                    "public_host is set but public_cert and public_key are not both set — \
+                     app ports serve the node certificate for every name"
+                );
+                None
+            }
+        }
+    }
+}
