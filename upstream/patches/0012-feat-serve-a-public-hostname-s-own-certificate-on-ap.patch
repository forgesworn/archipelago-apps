+
+/// A public hostname as the gate and manifests use it: ASCII lowercase (DNS
+/// names are case-insensitive, so `Node.Example.org` is folded rather than
+/// refused) with one trailing dot dropped (`node.example.org.` is the same
+/// name, written fully qualified), letters, digits and hyphens in dot-separated labels of 1 to 63
+/// characters, no label starting or ending with a hyphen, at least two
+/// labels, at most 253 characters. A final label of only digits is refused so
+/// an IPv4 literal cannot pass; `:` and `/` are outside the alphabet, which
+/// rules out IPv6, a scheme, a port and a path. `None` when any of that fails.
+pub(crate) fn normalise_public_host(raw: &str) -> Option<String> {
+    let host = raw.trim().to_ascii_lowercase();
+    let host = host.strip_suffix('.').unwrap_or(&host).to_string();
+    if host.is_empty() || host.len() > 253 {
+        return None;
+    }
+    let labels: Vec<&str> = host.split('.').collect();
+    if labels.len() < 2 {
+        return None;
+    }
+    let label_ok = |l: &str| {
+        (1..=63).contains(&l.len())
+            && l.bytes()
+                .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-')
+            && !l.starts_with('-')
+            && !l.ends_with('-')
+    };
+    if !labels.iter().all(|l| label_ok(l)) {
+        return None;
+    }
+    if labels
+        .last()
+        .is_some_and(|tld| tld.bytes().all(|b| b.is_ascii_digit()))
+    {
+        return None;
+    }
+    Some(host)
 }
 
