+    fn schema_two_projects_bounded_automatic_refund_status_without_assets() {
+        let f = Fixture::new();
+        f.order("automatic", "refund_required", false, None);
+        let quote: String = f
+            .ledger
+            .query_row("SELECT quote FROM orders WHERE id='automatic'", [], |r| {
+                r.get(0)
+            })
+            .unwrap();
+        let mut quote: Value = serde_json::from_str(&quote).unwrap();
+        quote["refund_to"] = json!("customer@example.com");
+        f.ledger
+            .execute(
+                "UPDATE orders SET quote=?1 WHERE id='automatic'",
+                [quote.to_string()],
+            )
+            .unwrap();
+        f.ledger
+            .execute_batch("ALTER TABLE orders ADD COLUMN refund TEXT; PRAGMA user_version=2")
+            .unwrap();
+        f.ledger
+            .execute(
+                "UPDATE orders SET refund=?1 WHERE id='automatic'",
+                [json!({
+                    "status":"pending","amount_msat":500000,"payment_hash":"cd".repeat(32),
+                    "refunded_at":null,"private_invoice":"never-project-this"
+                })
+                .to_string()],
+            )
+            .unwrap();
+        let pending = f.read(PageRequest::default(), 100);
+        assert_eq!(pending["orders"][0]["refund"]["status"], "pending");
+        assert_eq!(pending["orders"][0]["automatic_refund_available"], true);
+        assert_eq!(pending["summary"]["needs_attention"], 1);
+        assert!(!pending.to_string().contains("private_invoice"));
+        f.ledger
+            .execute(
+                "UPDATE orders SET state='refunded',refund=?1 WHERE id='automatic'",
+                [json!({
+                    "status":"completed","amount_msat":500000,"payment_hash":"cd".repeat(32),
+                    "refunded_at":150,"private_invoice":"never-project-this"
+                })
+                .to_string()],
+            )
+            .unwrap();
+        let completed = f.read(PageRequest::default(), 200);
+        assert_eq!(completed["orders"][0]["state"], "refunded");
+        assert_eq!(completed["orders"][0]["refund"]["source"], "automatic");
+        assert_eq!(completed["orders"][0]["refund"]["recorded_at"], 150);
+        assert_eq!(completed["summary"]["needs_attention"], 0);
+        assert_eq!(completed["summary"]["paid_orders"], 0);
+    }
