+    /// Create an identity whose Nostr key lives in a remote NIP-46 signer.
+    ///
+    /// `signer` must already be connected as `client_keys` (see
+    /// `NostrConnectSigner::connect`); `uri` names the signer, its relays and
+    /// the connection secret to keep for later sessions (`None` if there was
+    /// none). The key is checked with [`Self::prove_link_candidate`]. The
+    /// identity gets its own fresh Ed25519 key, so its DID works as for any
+    /// other identity; only the Nostr key is remote.
+    pub async fn create_linked(
+        &self,
+        name: String,
+        purpose: IdentityPurpose,
+        uri: &BunkerUri,
+        client_keys: &nostr_sdk::Keys,
+        signer: &dyn RemoteSigner,
+        node_nostr_pubkey: Option<&str>,
+    ) -> Result<IdentityRecord> {
+        let user_pubkey = self.prove_link_candidate(signer, node_nostr_pubkey).await?;
+        // The proof can take a minute (a person approving on the device), so
+        // check again under the lock before writing.
+        let _link_write = LINK_WRITE.lock().await;
+        self.ensure_new_nostr_key(&user_pubkey.to_hex(), node_nostr_pubkey)
+            .await?;
+
+        let signing_key = SigningKey::generate(&mut OsRng);
+        let pubkey_hex = hex::encode(signing_key.verifying_key().as_bytes());
+        let did = did_key_from_pubkey_hex(&pubkey_hex)?;
+        let id = uuid::Uuid::new_v4().to_string();
+        let created_at = chrono::Utc::now().to_rfc3339();
+        let default_profile = IdentityProfile {
+            picture: Some(crate::avatar::identicon(&pubkey_hex)),
+            ..Default::default()
+        };
+
+        let identity_file = IdentityFile {
+            id: id.clone(),
+            name: name.clone(),
+            purpose: purpose.clone(),
+            secret_key: signing_key.to_bytes().to_vec(),
+            pubkey_hex,
+            did,
+            created_at: created_at.clone(),
+            nostr_secret_hex: None,
+            nostr_pubkey_hex: Some(user_pubkey.to_hex()),
+            profile: Some(default_profile),
+            derivation_index: None,
+            linked_signer: Some(LinkedSigner {
+                remote_signer_pubkey: uri.remote_signer_pubkey.to_hex(),
+                user_pubkey: user_pubkey.to_hex(),
+                relays: uri.relays.iter().map(|r| r.to_string()).collect(),
+                client_secret_hex: client_keys.secret_key().to_secret_hex(),
+                bunker_secret: uri.secret.clone(),
+                linked_at: created_at,
+            }),
+        };
+
+        let file_path = self.identities_dir.join(format!("{}.json", id));
+        let json =
+            serde_json::to_string_pretty(&identity_file).context("Failed to serialize identity")?;
+        fs::write(&file_path, json.as_bytes())
+            .await
+            .context("Failed to write identity file")?;
+
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            fs::set_permissions(&file_path, std::fs::Permissions::from_mode(0o600))
+                .await
+                .context("Failed to set identity file permissions")?;
+        }
+
+        // If this is the first identity, make it the default
+        let (existing, _) = self.list().await?;
+        if existing.len() <= 1 {
+            self.set_default(&id).await?;
+        }
+
+        tracing::info!(
+            "Linked identity '{}' ({}) to a remote signer",
+            name,
+            purpose
+        );
+
+        self.get(&id).await
+    }
+
+    /// Refuse `user_pubkey_hex` if the node already has it: the node discovery
+    /// key `node_nostr_pubkey` or any identity's Nostr key.
+    async fn ensure_new_nostr_key(
+        &self,
+        user_pubkey_hex: &str,
+        node_nostr_pubkey: Option<&str>,
+    ) -> Result<()> {
+        if node_nostr_pubkey.is_some_and(|pk| pk.eq_ignore_ascii_case(user_pubkey_hex)) {
+            anyhow::bail!("linked signer's key is this node's own Nostr key");
+        }
+        let (existing, _) = self.list().await?;
+        if let Some(other) = existing.iter().find(|r| {
+            r.nostr_pubkey
+                .as_deref()
+                .is_some_and(|pk| pk.eq_ignore_ascii_case(user_pubkey_hex))
+        }) {
+            anyhow::bail!(
+                "linked signer's key already belongs to identity '{}'",
+                other.name
+            );
+        }
+        Ok(())
+    }
+
+    /// Ask a connected remote signer for the user's key, refuse a key the
+    /// node already has (any identity's, or the node discovery key
+    /// `node_nostr_pubkey`), then have it sign a throwaway challenge to prove
+    /// it holds that key. Returns the proven key. Shared by every way of
+    /// linking a signer.
+    pub async fn prove_link_candidate(
+        &self,
+        signer: &dyn RemoteSigner,
+        node_nostr_pubkey: Option<&str>,
+    ) -> Result<nostr_sdk::PublicKey> {
+        let user_pubkey = signer.get_public_key().await?;
+        // Check before the challenge, so a refused link costs no prompt.
+        self.ensure_new_nostr_key(&user_pubkey.to_hex(), node_nostr_pubkey)
+            .await?;
+
+        let mut nonce = [0u8; 16];
+        rand::RngCore::fill_bytes(&mut OsRng, &mut nonce);
+        let nonce = hex::encode(nonce);
+        let challenge = nostr_sdk::UnsignedEvent::new(
+            user_pubkey,
+            nostr_sdk::Timestamp::now(),
+            nostr_sdk::Kind::from(LINK_CHALLENGE_KIND),
+            [nostr_sdk::Tag::parse(["challenge", nonce.as_str()])?],
+            format!("archipelago link {}", nonce),
+        );
+        let signed = signer.sign_event(challenge.clone()).await?;
+        verify_remote_event(&user_pubkey, &challenge, &signed)?;
+        Ok(user_pubkey)
+    }
