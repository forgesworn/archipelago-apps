+/// Where an identity's Nostr key comes from.
+#[derive(Debug, Clone, Copy, Default, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "lowercase")]
+pub enum IdentityOrigin {
+    /// Derived from the node's BIP-39 seed.
+    Seed,
+    /// Generated at random on this node.
+    #[default]
+    Generated,
+    /// Held by a remote NIP-46 signer; the node has no Nostr secret.
+    Linked,
+}
+
+/// The public half of a linked signer, safe to show to clients.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct LinkedSignerInfo {
+    pub remote_signer_pubkey: String,
+    pub relays: Vec<String>,
+}
+
+/// A remote NIP-46 signer that holds an identity's Nostr key. Stored in the
+/// identity file; `client_secret_hex` is the node's key for talking to the
+/// signer and never leaves the file.
+#[derive(Clone, Serialize, Deserialize)]
+pub struct LinkedSigner {
+    /// The key requests are addressed to (from the bunker URI).
+    pub remote_signer_pubkey: String,
+    /// The identity's Nostr key, from `get_public_key`. NIP-46 lets it differ
+    /// from `remote_signer_pubkey`.
+    pub user_pubkey: String,
+    pub relays: Vec<String>,
+    pub client_secret_hex: String,
+    /// The bunker URI's connection secret, re-sent with `connect` when a new
+    /// session opens. `None` when the URI had none. Never leaves the file.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub bunker_secret: Option<String>,
+    pub linked_at: String,
+}
+
+impl std::fmt::Debug for LinkedSigner {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("LinkedSigner")
+            .field("remote_signer_pubkey", &self.remote_signer_pubkey)
+            .field("user_pubkey", &self.user_pubkey)
+            .field("relays", &self.relays)
+            .field("client_secret_hex", &"<redacted>")
+            .field(
+                "bunker_secret",
+                &self.bunker_secret.as_ref().map(|_| "<redacted>"),
+            )
+            .field("linked_at", &self.linked_at)
+            .finish()
+    }
+}
