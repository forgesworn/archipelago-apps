+//! Remote Nostr signers (NIP-46 "bunkers") for linked identities.
+//!
+//! A linked identity keeps its Nostr secret key on a separate device. The node
+//! holds only a per-identity client keypair, which the signer authorises when
+//! the identity is linked. Requests are kind-24133 events from that client
+//! key, NIP-44 encrypted and p-tagged to the signer. Each new session (after
+//! a restart, for example) first sends `connect` from the stored client key,
+//! with the bunker URI's secret if it had one, and goes ahead whether or not
+//! the signer answers it: the client key is what the signer authorised.
+//!
+//! Nothing a remote signer returns is trusted: signed events are checked
+//! against the request with [`verify_remote_event`] before anyone sees them.
+
+use anyhow::Result;
+use async_trait::async_trait;
+use nostr_sdk::nips::nip46::{NostrConnectMessage, NostrConnectMethod, NostrConnectRequest};
+use nostr_sdk::{
+    Client, Event, EventBuilder, Filter, JsonUtil, Keys, Kind, PublicKey, RelayPoolNotification,
+    RelayUrl, Timestamp, UnsignedEvent,
+};
+use rand::rngs::OsRng;
+use rand::RngCore;
+use std::time::Duration;
+use tokio::sync::broadcast::error::RecvError;
+
+/// How long to wait for the signer's relays to accept a connection.
+pub const CONNECT_TIMEOUT: Duration = Duration::from_secs(10);
+/// How long to wait for the signer to answer one message, `connect`
+/// included. Long enough for a person to read a prompt on the device and
+/// press a button.
+pub const REQUEST_TIMEOUT: Duration = Duration::from_secs(60);
+/// The most relays a linked signer may use. Each is a connection per session.
+pub const MAX_RELAYS: usize = 8;
+/// How long a new session waits for the reply to its `connect` before
+/// sending the request anyway. Some bunkers ignore a repeated `connect`.
+const SESSION_CONNECT_WAIT: Duration = Duration::from_secs(5);
+/// How far back to look for a reply missed while the notification channel
+/// lagged.
+const LAG_LOOKBACK: Duration = Duration::from_secs(10);
+
+/// A parsed `bunker://` URI.
+#[derive(Clone, PartialEq, Eq)]
+pub struct BunkerUri {
+    pub remote_signer_pubkey: PublicKey,
+    pub relays: Vec<RelayUrl>,
+    /// One-time connection secret. Never logged.
+    pub secret: Option<String>,
+}
+
+impl std::fmt::Debug for BunkerUri {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("BunkerUri")
+            .field("remote_signer_pubkey", &self.remote_signer_pubkey.to_hex())
+            .field("relays", &self.relays)
+            .field("secret", &self.secret.as_ref().map(|_| "<redacted>"))
+            .finish()
+    }
+}
+
+/// Parse `bunker://<hex pubkey>?relay=<ws(s) url>[&relay=…][&secret=…]`.
+///
+/// `nostrconnect://` links are rejected: they start from a link the node
+/// makes for the signer, not one pasted into the node.
+pub fn parse_bunker_uri(uri: &str) -> Result<BunkerUri> {
+    let uri = uri.trim();
+    if uri.starts_with("nostrconnect://") {
+        anyhow::bail!(
+            "Invalid bunker URI: this is a nostrconnect:// link; paste the bunker:// link from your signer"
+        );
+    }
+    if !uri.starts_with("bunker://") {
+        anyhow::bail!("Invalid bunker URI: it must start with bunker://");
+    }
+    let url = reqwest::Url::parse(uri).map_err(|_| anyhow::anyhow!("Invalid bunker URI"))?;
+
+    let pubkey_hex = url.host_str().unwrap_or_default();
+    if pubkey_hex.len() != 64 || !pubkey_hex.bytes().all(|b| b.is_ascii_hexdigit()) {
+        anyhow::bail!("Invalid bunker URI: the signer key must be 64 hex characters");
+    }
+    let remote_signer_pubkey = PublicKey::from_hex(pubkey_hex).map_err(|_| {
+        anyhow::anyhow!("Invalid bunker URI: the signer key is not a valid public key")
+    })?;
+    if !matches!(url.path(), "" | "/") {
+        anyhow::bail!("Invalid bunker URI: unexpected path after the signer key");
+    }
+
+    let mut relays: Vec<RelayUrl> = Vec::new();
+    let mut secret = None;
+    for (name, value) in url.query_pairs() {
+        match name.as_ref() {
+            "relay" => {
+                let relay = RelayUrl::parse(&value).map_err(|_| {
+                    anyhow::anyhow!(
+                        "Invalid bunker URI: relay {} is not a ws:// or wss:// URL",
+                        value
+                    )
+                })?;
+                if !relays.contains(&relay) {
+                    relays.push(relay);
+                }
+            }
+            "secret" if !value.is_empty() => secret = Some(value.into_owned()),
+            _ => {}
+        }
+    }
+    if relays.is_empty() {
+        anyhow::bail!("Invalid bunker URI: it names no relay");
+    }
+    if relays.len() > MAX_RELAYS {
+        anyhow::bail!("Invalid bunker URI: too many relays (at most {MAX_RELAYS})");
+    }
+
+    Ok(BunkerUri {
+        remote_signer_pubkey,
+        relays,
+        secret,
+    })
+}
+
+/// Why a remote signer request failed. `Clone`, so one failure can be handed
+/// to every caller waiting on the same request.
+#[derive(Debug, Clone, PartialEq, Eq, thiserror::Error)]
+pub enum RemoteSignerError {
+    /// None of the signer's relays could be reached. Carries the relay list
+    /// for the message.
+    #[error("linked signer is offline (no reply from {0})")]
+    Offline(String),
+    #[error("linked signer denied the request")]
+    Denied,
+    /// The signer does not implement this NIP-46 method.
+    #[error("the linked signer refused {0}")]
+    Unsupported(String),
+    #[error("linked signer did not answer within {} s", REQUEST_TIMEOUT.as_secs())]
+    Timeout,
+    #[error("linked signer sent a bad response: {0}")]
+    BadResponse(String),
+    /// The signer answered with a NIP-46 `auth_url` challenge.
+    #[error(
+        "linked signer asked for browser authorisation, which Archipelago does not support yet"
+    )]
+    BrowserAuthorisation,
+}
+
+/// A Nostr signer that holds the key somewhere else.
+#[async_trait]
+pub trait RemoteSigner: Send + Sync {
+    /// The user's public key, which NIP-46 allows to differ from the
+    /// remote-signer key the requests are addressed to.
+    async fn get_public_key(&self) -> Result<PublicKey, RemoteSignerError>;
+    /// Sign `unsigned`. The result is untrusted until checked with
+    /// [`verify_remote_event`].
+    async fn sign_event(&self, unsigned: UnsignedEvent) -> Result<Event, RemoteSignerError>;
+}
+
+/// Check that `signed` is exactly `requested`, signed by `expected_pubkey`:
+/// same pubkey, kind, tags, content and created_at, an id that recomputes and
+/// a valid BIP-340 signature.
+pub fn verify_remote_event(
+    expected_pubkey: &PublicKey,
+    requested: &UnsignedEvent,
+    signed: &Event,
+) -> Result<(), RemoteSignerError> {
+    let mismatch = |what: &str| {
+        Err(RemoteSignerError::BadResponse(format!(
+            "the signed event's {what} differs from the request"
+        )))
+    };
+    if signed.pubkey != *expected_pubkey || requested.pubkey != *expected_pubkey {
+        return mismatch("pubkey");
+    }
+    if signed.kind != requested.kind {
+        return mismatch("kind");
+    }
+    if signed.created_at != requested.created_at {
+        return mismatch("created_at");
+    }
+    if signed.tags != requested.tags {
+        return mismatch("tags");
+    }
+    if signed.content != requested.content {
+        return mismatch("content");
+    }
+    if !signed.verify_id() {
+        return Err(RemoteSignerError::BadResponse(
+            "the signed event's id does not match its contents".to_string(),
+        ));
+    }
+    if !signed.verify_signature() {
+        return Err(RemoteSignerError::BadResponse(
+            "the signed event's signature is invalid".to_string(),
+        ));
+    }
+    Ok(())
+}
+
+/// Map a NIP-46 error string to a typed error. Signers word these freely, so
+/// match on the usual phrases and keep anything else as a bad response.
+fn classify_signer_error(method: &NostrConnectMethod, error: &str) -> RemoteSignerError {
+    let lower = error.to_ascii_lowercase();
+    let unsupported = [
+        "unknown method",
+        "unsupported",
+        "not supported",
+        "not implemented",
+        "no such method",
+    ];
+    let refused = [
+        "denied",
+        "not authorized",
+        "not authorised",
+        "unauthorized",
+        "unauthorised",
+        "rejected",
+        "refused",
+        "forbidden",
+        "permission",
+    ];
+    if unsupported.iter().any(|p| lower.contains(p)) {
+        RemoteSignerError::Unsupported(method.to_string())
+    } else if refused.iter().any(|p| lower.contains(p)) {
+        RemoteSignerError::Denied
+    } else {
+        let mut reason: String = error.chars().take(120).collect();
+        if reason.len() < error.len() {
+            reason.push('…');
+        }
+        RemoteSignerError::BadResponse(format!("{method} failed: {reason}"))
+    }
+}
+
+/// NIP-46 client for one linked identity.
+///
+/// Opens its relay connections on the first request and closes them when
+/// dropped. Responses are accepted only from the remote-signer key and only
+/// for the request id just sent.
+pub struct NostrConnectSigner {
+    client_keys: Keys,
+    remote_signer_pubkey: PublicKey,
+    relays: Vec<RelayUrl>,
+    /// The bunker URI's connection secret, if it had one. Never logged.
+    secret: Option<String>,
+    client: tokio::sync::OnceCell<Client>,
+    /// Set once `connect` has been answered on this signer's relays.
+    session: tokio::sync::OnceCell<()>,
+}
+
+impl NostrConnectSigner {
+    /// Introduce `client_keys` to the bunker with `connect` (carrying the
+    /// URI's one-time secret). Fails with `Offline` if no relay accepts a
+    /// connection within [`CONNECT_TIMEOUT`], and with `Timeout` if the signer
+    /// does not answer within [`REQUEST_TIMEOUT`]: a person may have to
+    /// approve the new client on the device first.
+    pub async fn connect(uri: &BunkerUri, client_keys: Keys) -> Result<Self, RemoteSignerError> {
+        let signer = Self::new(
+            client_keys,
+            uri.remote_signer_pubkey,
+            uri.relays.clone(),
+            uri.secret.clone(),
+        );
+        match signer.send_connect(REQUEST_TIMEOUT).await? {
+            // Bunkers answer "ack"; some echo the secret instead.
+            result if result == "ack" || Some(&result) == uri.secret.as_ref() => {
+                let _ = signer.session.set(());
+                Ok(signer)
+            }
+            _ => Err(RemoteSignerError::BadResponse(
+                "unexpected reply to connect".to_string(),
+            )),
+        }
+    }
+
+    fn new(
+        client_keys: Keys,
+        remote_signer_pubkey: PublicKey,
+        relays: Vec<RelayUrl>,
+        secret: Option<String>,
+    ) -> Self {
+        Self {
+            client_keys,
+            remote_signer_pubkey,
+            relays,
+            secret,
+            client: tokio::sync::OnceCell::new(),
+            session: tokio::sync::OnceCell::new(),
+        }
+    }
+
+    /// Send `connect` and wait up to `wait` for the reply.
+    async fn send_connect(&self, wait: Duration) -> Result<String, RemoteSignerError> {
+        let request = NostrConnectRequest::Connect {
+            remote_signer_public_key: self.remote_signer_pubkey,
+            secret: self.secret.clone(),
+        };
+        self.round_trip(request, wait).await
+    }
+
+    /// Open the session once per signer, as Cambium does with Heartwood:
+    /// `connect` from the stored client key (and secret, if any) before the
+    /// first request. Only unreachable relays fail the session. A refusal,
+    /// or no reply within [`SESSION_CONNECT_WAIT`], does not: a bunker may
+    /// refuse or ignore a second use of its one-time secret and still serve
+    /// the client key it authorised, and the request itself says whether it
+    /// does.
+    async fn session(&self) -> Result<(), RemoteSignerError> {
+        self.session
+            .get_or_try_init(|| async {
+                match self.send_connect(SESSION_CONNECT_WAIT).await {
+                    Ok(_) => Ok(()),
+                    Err(e @ RemoteSignerError::Offline(_)) => Err(e),
+                    Err(e) => {
+                        tracing::debug!(error = %e, "Linked signer did not accept connect; trying the request anyway");
+                        Ok(())
+                    }
+                }
+            })
+            .await
+            .map(|_| ())
+    }
+
+    /// One request within an open session, waiting [`REQUEST_TIMEOUT`].
+    async fn request(&self, request: NostrConnectRequest) -> Result<String, RemoteSignerError> {
+        self.session().await?;
+        self.round_trip(request, REQUEST_TIMEOUT).await
+    }
+
+    fn offline(&self) -> RemoteSignerError {
+        let relays: Vec<String> = self.relays.iter().map(|r| r.to_string()).collect();
+        RemoteSignerError::Offline(relays.join(", "))
+    }
+
+    /// Connected relay client, subscribed to replies addressed to our key.
+    async fn client(&self) -> Result<&Client, RemoteSignerError> {
+        self.client
+            .get_or_try_init(|| async {
+                // Signed by the client key, so it can answer a relay's NIP-42
+                // AUTH as the key the bunker already knows. Guarded until it
+                // is stored, so a failed or abandoned start shuts it down.
+                let guard = ShutdownGuard::new(Client::new(self.client_keys.clone()));
+                let client = guard.client();
+                for relay in &self.relays {
+                    client
+                        .add_relay(relay.clone())
+                        .await
+                        .map_err(|_| self.offline())?;
+                }
+                let connected = client.try_connect(CONNECT_TIMEOUT).await;
+                // `limit(0)`: only replies that arrive from now on.
+                let filter = Filter::new()
+                    .kind(Kind::NostrConnect)
+                    .author(self.remote_signer_pubkey)
+                    .pubkey(self.client_keys.public_key())
+                    .limit(0);
+                let subscribed = if connected.success.is_empty() {
+                    false
+                } else {
+                    client
+                        .subscribe(filter, None)
+                        .await
+                        .is_ok_and(|out| !out.success.is_empty())
+                };
+                if !subscribed {
+                    return Err(self.offline());
+                }
+                Ok(guard.keep())
+            })
+            .await
+    }
+
+    /// Send one request and wait up to `wait` for its reply. Returns the raw
+    /// `result` string; an `error` reply becomes a typed error.
+    async fn round_trip(
+        &self,
+        request: NostrConnectRequest,
+        wait: Duration,
+    ) -> Result<String, RemoteSignerError> {
+        let client = self.client().await?;
+        let method = request.method();
+        // The library's own ids are 32-bit; a 128-bit id is not guessable.
+        let mut id_bytes = [0u8; 16];
+        OsRng.fill_bytes(&mut id_bytes);
+        let request_id = hex::encode(id_bytes);
+        let message = NostrConnectMessage::Request {
+            id: request_id.clone(),
+            method,
+            params: request.params(),
+        };
+        let event =
+            EventBuilder::nostr_connect(&self.client_keys, self.remote_signer_pubkey, message)
+                .and_then(|builder| builder.sign_with_keys(&self.client_keys))
+                .map_err(|e| {
+                    RemoteSignerError::BadResponse(format!(
+                        "could not build the {method} request: {e}"
+                    ))
+                })?;
+
+        // Listen before sending, so a fast reply cannot slip past.
+        let mut notifications = client.notifications();
+        let sent_at = Timestamp::now();
+        let sent = client
+            .send_event(&event)
+            .await
+            .map_err(|_| self.offline())?;
+        if sent.success.is_empty() {
+            return Err(self.offline());
+        }
+
+        let reply = async {
+            loop {
+                match notifications.recv().await {
+                    Ok(RelayPoolNotification::Event { event, .. }) => {
+                        if let Some(reply) = self.reply_to(&event, &request_id, &method) {
+                            return reply;
+                        }
+                    }
+                    Ok(_) => {}
+                    // The channel dropped notifications, possibly our reply:
+                    // ask the relays for what the signer sent since then.
+                    Err(RecvError::Lagged(_)) => {
+                        let since = sent_at - LAG_LOOKBACK;
+                        let filter = Filter::new()
+                            .kind(Kind::NostrConnect)
+                            .author(self.remote_signer_pubkey)
+                            .pubkey(self.client_keys.public_key())
+                            .since(since);
+                        if let Ok(events) = client.fetch_events(filter, CONNECT_TIMEOUT).await {
+                            for event in events {
+                                if let Some(reply) = self.reply_to(&event, &request_id, &method) {
+                                    return reply;
+                                }
+                            }
+                        }
+                    }
+                    Err(RecvError::Closed) => return Err(self.offline()),
+                }
+            }
+        };
+        tokio::time::timeout(wait, reply)
+            .await
+            .map_err(|_| RemoteSignerError::Timeout)?
+    }
+
+    /// The outcome carried by `event` if it is the signer's reply to
+    /// `request_id`; `None` for anything else.
+    fn reply_to(
+        &self,
+        event: &Event,
+        request_id: &str,
+        method: &NostrConnectMethod,
+    ) -> Option<Result<String, RemoteSignerError>> {
+        if event.kind != Kind::NostrConnect || event.pubkey != self.remote_signer_pubkey {
+            return None;
+        }
+        // Check the id and signature ourselves before any decryption: a NIP-04
+        // reply carries no MAC, so the signature is its only tamper check.
+        if event.verify().is_err() {
+            return None;
+        }
+        let json = self.decrypt(&event.content)?;
+        let Ok(NostrConnectMessage::Response { id, result, error }) =
+            NostrConnectMessage::from_json(json)
+        else {
+            return None;
+        };
+        if id != request_id {
+            return None;
+        }
+        // NIP-46 `auth_url`: the signer wants the person to approve in a
+        // browser. The URL is neither shown nor logged.
+        if result.as_deref() == Some("auth_url") {
+            return Some(Err(RemoteSignerError::BrowserAuthorisation));
+        }
+        if let Some(error) = error.filter(|e| !e.is_empty()) {
+            return Some(Err(classify_signer_error(method, &error)));
+        }
+        Some(
+            result
+                .ok_or_else(|| RemoteSignerError::BadResponse(format!("empty reply to {method}"))),
+        )
+    }
+
+    /// Decrypt a reply. NIP-46 now uses NIP-44; some bunkers still send NIP-04.
+    fn decrypt(&self, content: &str) -> Option<String> {
+        let secret_key = self.client_keys.secret_key();
+        nostr_sdk::nips::nip44::decrypt(secret_key, &self.remote_signer_pubkey, content)
+            .ok()
+            .or_else(|| {
+                nostr_sdk::nips::nip04::decrypt(secret_key, &self.remote_signer_pubkey, content)
+                    .ok()
+            })
+    }
+}
+
+/// Shuts a relay client down when dropped, however the code holding it ends,
+/// unless [`ShutdownGuard::keep`] hands the client on.
+pub(crate) struct ShutdownGuard(Option<Client>);
+
+impl ShutdownGuard {
+    pub(crate) fn new(client: Client) -> Self {
+        Self(Some(client))
+    }
+
+    pub(crate) fn client(&self) -> &Client {
+        self.0
+            .as_ref()
+            .expect("a guard holds its client until kept")
+    }
+
+    pub(crate) fn keep(mut self) -> Client {
+        self.0.take().expect("a guard holds its client until kept")
+    }
+}
+
+impl Drop for ShutdownGuard {
+    fn drop(&mut self) {
+        if let Some(client) = self.0.take() {
+            if let Ok(runtime) = tokio::runtime::Handle::try_current() {
+                runtime.spawn(async move { client.shutdown().await });
+            }
+        }
+    }
+}
+
+impl Drop for NostrConnectSigner {
+    /// The relay pool keeps reconnecting until it is shut down, so never let
+    /// one outlive the signer that opened it.
+    fn drop(&mut self) {
+        if let Some(client) = self.client.take() {
+            if let Ok(runtime) = tokio::runtime::Handle::try_current() {
+                runtime.spawn(async move { client.shutdown().await });
+            }
+        }
+    }
+}
+
+#[async_trait]
+impl RemoteSigner for NostrConnectSigner {
+    async fn get_public_key(&self) -> Result<PublicKey, RemoteSignerError> {
+        let result = self.request(NostrConnectRequest::GetPublicKey).await?;
+        PublicKey::from_hex(&result).map_err(|_| {
+            RemoteSignerError::BadResponse("get_public_key returned an invalid key".to_string())
+        })
+    }
+
+    async fn sign_event(&self, unsigned: UnsignedEvent) -> Result<Event, RemoteSignerError> {
+        let result = self
+            .request(NostrConnectRequest::SignEvent(unsigned))
+            .await?;
+        Event::from_json(result).map_err(|_| {
+            RemoteSignerError::BadResponse("sign_event returned an invalid event".to_string())
+        })
+    }
+}
