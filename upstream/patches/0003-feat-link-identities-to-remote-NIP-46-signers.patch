+    /// Link an identity to a remote NIP-46 signer (`bunker://` URI).
+    ///
+    /// The Nostr key stays on the signer; the node stores a client key the
+    /// signer authorises once, with the URI's one-time secret. Dashboard
+    /// only: `api::rpc` refuses this method from app origins.
+    pub(in crate::api::rpc) async fn handle_identity_link_nip46(
+        &self,
+        params: Option<serde_json::Value>,
+    ) -> Result<serde_json::Value> {
+        let params = params.unwrap_or_default();
+        let bunker_uri = params
+            .get("bunker_uri")
+            .and_then(|v| v.as_str())
+            .ok_or_else(|| anyhow::anyhow!("Missing required parameter: bunker_uri"))?;
+        let name = params
+            .get("name")
+            .and_then(|v| v.as_str())
+            .map(str::trim)
+            .filter(|n| !n.is_empty())
+            .ok_or_else(|| anyhow::anyhow!("Missing required parameter: name"))?;
+        if name.len() > 100 {
+            anyhow::bail!("Identity name must be 100 characters or fewer");
+        }
+        let name = name.to_string();
+        let purpose = match params.get("purpose").and_then(|v| v.as_str()) {
+            Some("business") => IdentityPurpose::Business,
+            Some("anonymous") => IdentityPurpose::Anonymous,
+            _ => IdentityPurpose::Personal,
+        };
+        let uri = parse_bunker_uri(bunker_uri)?;
+
+        let data_dir = self.config.data_dir.clone();
+        let identity_dir = data_dir.join("identity");
+        let node_nostr_pubkey =
+            crate::nostr_discovery::existing_nostr_pubkey(&identity_dir).await?;
+        // Run to completion even if the HTTP request is dropped: the `connect`
+        // spends the URI's one-time secret, and an abandoned link would leave
+        // the signer authorised with no identity file to show for it.
+        let record = tokio::spawn(async move {
+            let manager = IdentityManager::new(&data_dir).await?;
+            let client_keys = nostr_sdk::Keys::generate();
+            let signer = NostrConnectSigner::connect(&uri, client_keys.clone()).await?;
+            manager
+                .create_linked(
+                    name,
+                    purpose,
+                    &uri,
+                    &client_keys,
+                    &signer,
+                    node_nostr_pubkey.as_deref(),
+                )
+                .await
+        })
+        .await
+        .context("Link task failed")??;
+
+        Ok(serde_json::json!({
+            "id": record.id,
+            "name": record.name,
+            "purpose": record.purpose,
+            "pubkey": record.pubkey_hex,
+            "did": record.did,
+            "created_at": record.created_at,
+            "nostr_pubkey": record.nostr_pubkey,
+            "nostr_npub": record.nostr_npub,
+            "profile": record.profile,
+            "origin": record.origin,
+            "signer": record.signer,
         }))
     }
 
