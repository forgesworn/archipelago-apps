+    #[test]
+    fn verify_remote_event_rejects_every_kind_of_tampering() {
+        let keys = Keys::generate();
+        let requested = sample_request(&keys);
+        let pk = keys.public_key();
+        let sign = |mut e: UnsignedEvent, k: &Keys| {
+            e.id = None;
+            e.sign_with_keys(k).unwrap()
+        };
+
+        // Signed properly, but by another key.
+        let other = Keys::generate();
+        let mut by_other = requested.clone();
+        by_other.pubkey = other.public_key();
+        let by_other = sign(by_other, &other);
+
+        let mut changed_content = requested.clone();
+        changed_content.content = "goodbye".to_string();
+        let mut changed_tags = requested.clone();
+        changed_tags.tags = nostr_sdk::Tags::from_list(vec![Tag::parse(["t", "other"]).unwrap()]);
+        let mut changed_kind = requested.clone();
+        changed_kind.kind = Kind::Metadata;
+        let mut changed_time = requested.clone();
+        changed_time.created_at = Timestamp::from(1_700_000_001);
+
+        // Right fields, but the id is not theirs.
+        let mut bad_id = sign(requested.clone(), &keys);
+        bad_id.id = sign(changed_content.clone(), &keys).id;
+        // Right fields and id, but a signature over something else.
+        let mut bad_sig = sign(requested.clone(), &keys);
+        bad_sig.sig = sign(changed_content.clone(), &keys).sig;
+
+        let cases = [
+            ("wrong pubkey", by_other),
+            ("changed content", sign(changed_content, &keys)),
+            ("changed tags", sign(changed_tags, &keys)),
+            ("changed kind", sign(changed_kind, &keys)),
+            ("changed created_at", sign(changed_time, &keys)),
+            ("bad id", bad_id),
+            ("bad signature", bad_sig),
+        ];
+        for (name, signed) in cases {
+            assert!(
+                matches!(
+                    verify_remote_event(&pk, &requested, &signed),
+                    Err(RemoteSignerError::BadResponse(_))
+                ),
+                "{name} was accepted"
+            );
+        }
+    }
