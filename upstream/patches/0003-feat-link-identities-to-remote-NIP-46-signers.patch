+    /// What a [`FakeSigner`] does when asked to sign.
+    #[derive(Clone, Copy, PartialEq, Eq, Debug)]
+    pub(crate) enum FakeMode {
+        Honest,
+        /// Signs a different event from the one requested.
+        Tamper,
+        /// Claims one key in `get_public_key` but signs with another.
+        WrongKey,
+    }
+
+    /// In-memory [`RemoteSigner`] that counts the requests it serves. A
+    /// gated one holds each request until [`FakeSigner::release`].
+    pub(crate) struct FakeSigner {
+        pub keys: Keys,
+        pub calls: AtomicUsize,
+        pub mode: Mutex<FakeMode>,
+        pub gate: Option<tokio::sync::Semaphore>,
+    }
+
+    impl FakeSigner {
+        pub fn new(keys: Keys, mode: FakeMode) -> Self {
+            Self {
+                keys,
+                calls: AtomicUsize::new(0),
+                mode: Mutex::new(mode),
+                gate: None,
+            }
+        }
+
+        pub fn gated(keys: Keys, mode: FakeMode) -> Self {
+            Self {
+                gate: Some(tokio::sync::Semaphore::new(0)),
+                ..Self::new(keys, mode)
+            }
+        }
+
+        pub fn calls(&self) -> usize {
+            self.calls.load(Ordering::SeqCst)
+        }
+
+        /// Let one held request answer.
+        pub fn release(&self) {
+            if let Some(gate) = &self.gate {
+                gate.add_permits(1);
+            }
+        }
+
+        async fn enter(&self) -> FakeMode {
+            self.calls.fetch_add(1, Ordering::SeqCst);
+            if let Some(gate) = &self.gate {
+                gate.acquire().await.unwrap().forget();
+            }
+            *self.mode.lock().unwrap()
+        }
+    }
+
+    #[async_trait]
+    impl RemoteSigner for FakeSigner {
+        async fn get_public_key(&self) -> Result<PublicKey, RemoteSignerError> {
+            Ok(self.keys.public_key())
+        }
+
+        async fn sign_event(
+            &self,
+            mut unsigned: UnsignedEvent,
+        ) -> Result<Event, RemoteSignerError> {
+            let mode = self.enter().await;
+            unsigned.id = None;
+            let keys = match mode {
+                FakeMode::Tamper => {
+                    unsigned.content.push_str(" (edited)");
+                    self.keys.clone()
+                }
+                FakeMode::WrongKey => {
+                    let other = Keys::generate();
+                    unsigned.pubkey = other.public_key();
+                    other
+                }
+                _ => self.keys.clone(),
+            };
+            Ok(unsigned.sign_with_keys(&keys).unwrap())
+        }
+    }
+}
