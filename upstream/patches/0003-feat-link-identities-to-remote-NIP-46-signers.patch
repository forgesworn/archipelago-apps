+    #[test]
+    fn replies_are_verified_before_they_are_read() {
+        let client = Keys::generate();
+        let remote = Keys::generate();
+        let signer = NostrConnectSigner::new(
+            client.clone(),
+            remote.public_key(),
+            vec![RelayUrl::parse("wss://relay.example.com").unwrap()],
+            None,
+        );
+        let reply = |result: &str| {
+            let message = NostrConnectMessage::Response {
+                id: "req-1".to_string(),
+                result: Some(result.to_string()),
+                error: None,
+            };
+            EventBuilder::nostr_connect(&remote, client.public_key(), message)
+                .unwrap()
+                .sign_with_keys(&remote)
+                .unwrap()
+        };
+        let method = NostrConnectMethod::Nip44Decrypt;
+        let genuine = reply("the real plaintext");
+        assert_eq!(
+            signer.reply_to(&genuine, "req-1", &method),
+            Some(Ok("the real plaintext".to_string()))
+        );
+
+        // Content altered after signing (here even validly encrypted by the
+        // signer's key).
+        let mut replayed = genuine.clone();
+        replayed.content = reply("forged plaintext").content;
+        assert_eq!(signer.reply_to(&replayed, "req-1", &method), None);
+
+        // The genuine content under a signature from another event.
+        let mut resigned = genuine.clone();
+        resigned.sig = reply("other").sig;
+        assert_eq!(signer.reply_to(&resigned, "req-1", &method), None);
+    }
