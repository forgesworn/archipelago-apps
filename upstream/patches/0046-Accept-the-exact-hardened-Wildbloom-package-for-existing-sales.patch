From 0c6201aea958d9598992136de49399ffac9a3b4b Mon Sep 17 00:00:00 2001
From: TheCryptoDonkey <TheCryptoDonkey@users.noreply.github.com>
Date: Tue, 17 Nov 2026 11:54:36 +0000
Subject: [PATCH] Accept the exact hardened Wildbloom package for existing
 sales

---
 core/archipelago/src/settings/wildbloom_storage.rs | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/core/archipelago/src/settings/wildbloom_storage.rs b/core/archipelago/src/settings/wildbloom_storage.rs
index 6638729..8cfffb9 100644
--- a/core/archipelago/src/settings/wildbloom_storage.rs
+++ b/core/archipelago/src/settings/wildbloom_storage.rs
@@ -19,6 +19,7 @@ pub fn compatible_node_image(image: &str) -> bool {
         "ghcr.io/forgesworn/wildbloom-node:0.3.5-4474ce1-2"
             | "ghcr.io/forgesworn/wildbloom-node:0.3.5-b9a7cf4-2"
             | "ghcr.io/forgesworn/wildbloom-node:0.3.5-b9a7cf4-3"
+            | "ghcr.io/forgesworn/wildbloom-node:0.3.15-165798d-1"
     )
 }
 
@@ -604,8 +605,12 @@ mod tests {
         assert!(compatible_node_image(
             "ghcr.io/forgesworn/wildbloom-node:0.3.5-b9a7cf4-3"
         ));
+        assert!(compatible_node_image(
+            "ghcr.io/forgesworn/wildbloom-node:0.3.15-165798d-1"
+        ));
         for image in [
             "ghcr.io/forgesworn/wildbloom-node:latest",
+            "ghcr.io/forgesworn/wildbloom-node:0.3.15-165798d-2",
             "ghcr.io/forgesworn/wildbloom-node:0.3.5-b9a7cf4-4",
             "unrelated:0.3.5-b9a7cf4-2",
         ] {
