From f6e7cb4a25b8099babe5375ae48ecb37e0c87fb0 Mon Sep 17 00:00:00 2001
From: archipelago-apps <ci@invalid>
Date: Mon, 12 Oct 2026 11:39:40 +0100
Subject: [PATCH] fix: accept exact Wildbloom discovery package in sales
 controls

---
 core/archipelago/src/api/rpc/wildbloom.rs     |  4 +--
 .../src/container/prod_orchestrator.rs        |  8 ++++--
 .../src/settings/wildbloom_storage.rs         | 25 +++++++++++++++++++
 3 files changed, 33 insertions(+), 4 deletions(-)

diff --git a/core/archipelago/src/api/rpc/wildbloom.rs b/core/archipelago/src/api/rpc/wildbloom.rs
index 6ab2f50..1258741 100644
--- a/core/archipelago/src/api/rpc/wildbloom.rs
+++ b/core/archipelago/src/api/rpc/wildbloom.rs
@@ -261,7 +261,7 @@ impl RpcHandler {
             json!({"revision": record.revision, "settings": settings, "active": record.active,
             "has_draft": record.draft.is_some(), "applied": applied, "runtime": runtime, "external_configuration": external,
             "can_apply": root.is_some() && disk.is_some() && !external && self.config.public_host.is_some()
-                && runtime.as_ref().is_some_and(|r| r.image == "ghcr.io/forgesworn/wildbloom-node:0.3.5-4474ce1-2"),
+                && runtime.as_ref().is_some_and(|r| storage::compatible_node_image(&r.image)),
             "issuer_choices": storage::issuer_choices(),
             "origin": self.config.public_host.as_ref().map(|h| format!("https://{h}:3742")),
             "disk": disk.map(|(free,total)| json!({"free_bytes":free,"total_bytes":total,"headroom_bytes":(5*GIB).max(total/20)}))}),
@@ -349,7 +349,7 @@ impl RpcHandler {
             .await
             .context("Wildbloom start the node and wait for healthy storage before applying")?;
         ensure!(
-            current.image == "ghcr.io/forgesworn/wildbloom-node:0.3.5-4474ce1-2",
+            storage::compatible_node_image(&current.image),
             "Wildbloom installed image is not compatible with dashboard settings"
         );
         ensure!(!external_configuration(&record, &current, root.join("operator/checkout").exists()),
diff --git a/core/archipelago/src/container/prod_orchestrator.rs b/core/archipelago/src/container/prod_orchestrator.rs
index 18eed9b..0285f2e 100644
--- a/core/archipelago/src/container/prod_orchestrator.rs
+++ b/core/archipelago/src/container/prod_orchestrator.rs
@@ -5437,8 +5437,12 @@ impl ContainerOrchestrator for ProdContainerOrchestrator {
             "Wildbloom dashboard settings require the packaged Quadlet node"
         );
         anyhow::ensure!(
-            lm.manifest.app.container.image.as_deref()
-                == Some("ghcr.io/forgesworn/wildbloom-node:0.3.5-4474ce1-2"),
+            lm.manifest
+                .app
+                .container
+                .image
+                .as_deref()
+                .is_some_and(crate::settings::wildbloom_storage::compatible_node_image),
             "Wildbloom dashboard settings require a compatible node package"
         );
         let volume = lm
diff --git a/core/archipelago/src/settings/wildbloom_storage.rs b/core/archipelago/src/settings/wildbloom_storage.rs
index 2150ff8..69fc7d6 100644
--- a/core/archipelago/src/settings/wildbloom_storage.rs
+++ b/core/archipelago/src/settings/wildbloom_storage.rs
@@ -12,6 +12,15 @@ pub const REFERENCE_KEY: &str =
     "027f06257d0e9af2dbef2c1c64d03962a9240a65a987eb90b36000c64de34baa6d";
 pub static LOCK: tokio::sync::Mutex<()> = tokio::sync::Mutex::const_new(());
 
+/// Exact packaged images whose checkout profile, ceiling and recovery contract we validate.
+pub fn compatible_node_image(image: &str) -> bool {
+    matches!(
+        image,
+        "ghcr.io/forgesworn/wildbloom-node:0.3.5-4474ce1-2"
+            | "ghcr.io/forgesworn/wildbloom-node:0.3.5-b9a7cf4-2"
+    )
+}
+
 #[derive(Clone, Copy, Debug)]
 pub struct Issuer {
     pub id: &'static str,
@@ -583,4 +592,20 @@ mod tests {
         prepare_profile(dir.path(), &a).unwrap();
         assert!(!dir.path().join("operator/checkout").exists());
     }
+    #[test]
+    fn discovery_package_keeps_exact_sales_image_compatibility() {
+        assert!(compatible_node_image(
+            "ghcr.io/forgesworn/wildbloom-node:0.3.5-4474ce1-2"
+        ));
+        assert!(compatible_node_image(
+            "ghcr.io/forgesworn/wildbloom-node:0.3.5-b9a7cf4-2"
+        ));
+        for image in [
+            "ghcr.io/forgesworn/wildbloom-node:latest",
+            "ghcr.io/forgesworn/wildbloom-node:0.3.5-b9a7cf4-3",
+            "unrelated:0.3.5-b9a7cf4-2",
+        ] {
+            assert!(!compatible_node_image(image));
+        }
+    }
 }
-- 
