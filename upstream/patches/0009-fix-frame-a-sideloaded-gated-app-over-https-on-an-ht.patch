+// A sideloaded app is not in the signed catalogue, so the daemon reports the
+// auth its installed manifest declares for the launch port (`lan-port-auth`).
+describe('daemon-reported port auth', () => {
+  const RUNTIME = 'http://localhost:8095'
+
+  it('treats a reported gated or open port as gate-fronted', () => {
+    expect(appPortIsGateFronted('sideloaded', 8095, 'gated')).toBe(true)
