+    expect(appPortIsGateFronted('sideloaded', 8095, 'none')).toBe(false)
+    expect(appPortIsGateFronted('sideloaded', 8095, 'local')).toBe(false)
+    expect(appPortIsGateFronted('sideloaded', 8095, 'session')).toBe(false)
+  })
+
+  it('frames a sideloaded gated app over https on an https dashboard', () => {
+    setLocation('https:', 'test-node.local')
+    expect(resolveAppUrl('sideloaded', undefined, RUNTIME, 'gated')).toBe('https://test-node.local:8095')
+  })
+
+  it('leaves the frame on http on an http dashboard', () => {
+    setLocation('http:', 'test-node.local')
+    expect(resolveAppUrl('sideloaded', undefined, RUNTIME, 'gated')).toBe('http://test-node.local:8095')
+  })
+
+  it('leaves an app without a gated report on http over an https dashboard', () => {
+    setLocation('https:', 'test-node.local')
+    expect(resolveAppUrl('sideloaded', undefined, RUNTIME)).toBe('http://test-node.local:8095')
+    expect(resolveAppUrl('sideloaded', undefined, RUNTIME, 'none')).toBe('http://test-node.local:8095')
+  })
+
+  it('lets the signed catalogue win over the report', () => {
+    __setSignedCatalogForTests({
+      apps: {
+        listed: {
+          version: '1.0.0',
+          manifest: { app: { id: 'listed', ports: [{ host: 8095, container: 80, auth: 'none' }] } },
+        },
+      },
+    })
+    setLocation('https:', 'test-node.local')
+    expect(resolveAppUrl('listed', undefined, RUNTIME, 'gated')).toBe('http://test-node.local:8095')
+  })
+})
