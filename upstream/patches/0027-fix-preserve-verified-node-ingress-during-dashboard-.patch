 scripts/tests/test_dashboard_public_guard.py | 41 ++++++++++++++++++++
 2 files changed, 59 insertions(+)

diff --git a/scripts/dashboard-public-guard.py b/scripts/dashboard-public-guard.py
index 32da514..4691da9 100644
--- a/scripts/dashboard-public-guard.py
+++ b/scripts/dashboard-public-guard.py
@@ -8,6 +8,7 @@ as evidence that a request came from a private network.
 from pathlib import Path
 import argparse
 import fcntl
+import json
 import os
 import re
 import subprocess
@@ -16,6 +17,8 @@ import time
 
 BEGIN = '# BEGIN ARCHIPELAGO MANAGEMENT SOURCE GUARD'
 END = '# END ARCHIPELAGO MANAGEMENT SOURCE GUARD'
+NODE_STATE = Path('/var/lib/archipelago-kithmoot-node-ingress')
+NODE_HELPER = '/usr/lib/archipelago/kithmoot-node-ingress.py'
 GUARD = '''# BEGIN ARCHIPELAGO MANAGEMENT SOURCE GUARD
 # Use the original socket peer, before any real_ip / forwarded-header rewrite.
 geo $realip_remote_addr $archy_management_private_source {
@@ -184,6 +187,21 @@ def apply(path, command=subprocess.run, lock_path=Path('/run/lock/archy-nginx-co
 
 
 def apply_locked(path, command, source=None):
+    # The host ingress transaction owns this site's exact bytes while active.
+    # Replacing its PROXY-aware guard or promoting an older OTA template would
+    # break private-source checks and the helper's recovery hashes. Validate
+    # with the root-owned helper rather than trusting a marker in nginx text.
+    if NODE_STATE.exists() or NODE_STATE.is_symlink():
+        result = command(['python3', NODE_HELPER, 'status'], capture_output=True, timeout=30)
+        try:
+            reply = json.loads(result.stdout) if len(result.stdout) <= 4096 else None
+            owned = json.loads((NODE_STATE / 'installation.json').read_bytes())
+        except (ValueError, TypeError, OSError) as error:
+            raise ValueError('Node ingress must be verified before dashboard maintenance') from error
+        if (result.returncode or reply != {'v': 1, 'ready': True, 'operation': 'status'}
+                or Path(owned.get('source', '')).resolve() != path):
+            raise ValueError('Node ingress must be verified before dashboard maintenance')
+        return False
     old = path.read_bytes() if path.exists() else None
     if old is None and source is None:
         raise ValueError('Missing active configuration and managed source')
