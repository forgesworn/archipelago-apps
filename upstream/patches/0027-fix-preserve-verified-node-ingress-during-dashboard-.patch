 import importlib.util
+import json
+from unittest.mock import patch
 from pathlib import Path
 import subprocess
 import tempfile
@@ -15,6 +17,45 @@ server { listen 80; server_name public.example; location / { return 200 "app"; }
 
 
 class GuardTests(unittest.TestCase):
+    def test_verified_node_ingress_survives_timer_and_old_runtime_promotion(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            path = root / 'archipelago'
+            source = root / 'legacy-template'
+            state = root / 'node-state'
+            state.mkdir()
+            active = SOURCE.replace('listen 443 ssl default_server;',
+                                    'listen unix:/run/archipelago-kithmoot-node/https.sock ssl proxy_protocol default_server;')
+            path.write_text(active)
+            source.write_text(SOURCE)
+            (state / 'installation.json').write_text(json.dumps({'source': str(path)}))
+            calls = []
+            def command(args, **kwargs):
+                calls.append(args)
+                return subprocess.CompletedProcess(args, 0, b'{"v":1,"ready":true,"operation":"status"}', b'')
+            with patch.object(guard, 'NODE_STATE', state):
+                self.assertFalse(guard.apply(path, command, root / 'lock'))
+                self.assertFalse(guard.apply(path, command, root / 'lock', source))
+            self.assertEqual(path.read_text(), active)
+            self.assertEqual(len(calls), 2)
+            self.assertTrue(all(args[-1] == 'status' for args in calls))
+
+    def test_unverified_node_ingress_never_replaces_site(self):
+        for reply in [subprocess.CompletedProcess([], 1, b'', b''),
+                      subprocess.CompletedProcess([], 0, b'{"ready":true}', b'')]:
+            with self.subTest(reply=reply), tempfile.TemporaryDirectory() as tmp:
+                root = Path(tmp)
+                path = root / 'archipelago'
+                state = root / 'node-state'
+                state.mkdir()
+                (state / 'installation.json').write_text(json.dumps({'source': str(path)}))
+                path.write_text(SOURCE)
+                def command(*args, **kwargs):
+                    return reply
+                with patch.object(guard, 'NODE_STATE', state), self.assertRaises(ValueError):
+                    guard.apply(path, command, root / 'lock')
+                self.assertEqual(path.read_text(), SOURCE)
+
     def test_active_site_copy_and_symlink_target_are_resolved(self):
         for symlink in [False, True]:
             with self.subTest(symlink=symlink), tempfile.TemporaryDirectory() as tmp:
