diff --git a/core/archipelago/src/fips/service.rs b/core/archipelago/src/fips/service.rs
index c88a051..c2f2871 100644
--- a/core/archipelago/src/fips/service.rs
+++ b/core/archipelago/src/fips/service.rs
@@ -285,23 +285,55 @@ pub async fn read_upstream_npub() -> Result<Option<String>> {
         Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(None),
         Err(e) => return Err(e).context("read /etc/fips/fips.pub"),
     };
-    if let Ok(s) = std::str::from_utf8(&bytes) {
-        let trimmed = s.trim();
-        if trimmed.starts_with("npub1") {
-            if let Ok(pk) = nostr_sdk::PublicKey::parse(trimmed) {
-                return Ok(pk.to_bech32().ok());
-            }
+    Ok(Some(public_npub(&bytes)?))
+}
+
+fn public_npub(bytes: &[u8]) -> Result<String> {
+    if bytes.len() > 256 {
+        anyhow::bail!("Invalid public mesh identity");
+    }
+    if let Ok(text) = std::str::from_utf8(bytes) {
+        if let Ok(key) = nostr_sdk::PublicKey::parse(text.trim()) {
+            return Ok(key.to_bech32()?);
         }
     }
-    let pk = nostr_sdk::PublicKey::from_slice(&bytes)
-        .context("parse /etc/fips/fips.pub as secp256k1 public key")?;
-    Ok(pk.to_bech32().ok())
+    Ok(nostr_sdk::PublicKey::from_slice(bytes)?.to_bech32()?)
+}
+
+/// Public host fact from the seed identity, available before daemon startup.
+/// Reads no secret material and does not replace the host's resolver.
+pub async fn mesh_host(data_dir: &std::path::Path) -> Result<String> {
+    let path = super::identity_dir_from(data_dir).join("fips_key.pub");
+    let bytes = tokio::fs::read(path)
+        .await
+        .context("read public mesh identity")?;
+    Ok(format!("{}.fips", public_npub(&bytes)?))
 }
 
 #[cfg(test)]
 mod tests {
     use super::*;
 
+    #[tokio::test]
+    async fn mesh_host_uses_only_the_existing_public_seed_identity() {
+        let directory = tempfile::tempdir().unwrap();
+        let identity = super::super::identity_dir_from(directory.path());
+        tokio::fs::create_dir(&identity).await.unwrap();
+        let key = nostr_sdk::Keys::generate().public_key();
+        tokio::fs::write(identity.join("fips_key.pub"), key.to_bytes())
+            .await
+            .unwrap();
+        assert_eq!(
+            mesh_host(directory.path()).await.unwrap(),
+            format!("{}.fips", key.to_bech32().unwrap())
+        );
+        assert!(!identity.join("fips_key").exists());
+        tokio::fs::write(identity.join("fips_key.pub"), b"invalid")
+            .await
+            .unwrap();
+        assert!(mesh_host(directory.path()).await.is_err());
+    }
