 2 files changed, 43 insertions(+), 1 deletion(-)

diff --git a/core/archipelago/src/container/kithmoot_node.rs b/core/archipelago/src/container/kithmoot_node.rs
index d2afa02..a5c2d14 100644
--- a/core/archipelago/src/container/kithmoot_node.rs
+++ b/core/archipelago/src/container/kithmoot_node.rs
@@ -222,7 +222,7 @@ pub async fn prepare_delete(runtime: &crate::config::ContainerRuntime) -> Result
                 "exec",
