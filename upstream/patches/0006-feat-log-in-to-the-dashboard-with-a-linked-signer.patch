+        assert!(!available(&node.auth).await.unwrap());
+        assert!(node.auth.verify_password(PASSWORD).await.unwrap());
+        assert!(!remove(&node.auth, &node.record.id, PASSWORD).await.unwrap());
+    }
+
+    #[tokio::test]
+    async fn a_login_is_signed_by_the_enrolled_signer() {
+        let node = enrolled().await;
+        let finished = login_through(&node, None).await.unwrap().unwrap();
+        assert_eq!(finished.bound, Bound::Cookie);
+        assert_eq!(finished.approval.signer.identity_id, node.record.id);
+        assert_eq!(node.signer.calls(), 1);
+    }
+
+    #[tokio::test]
+    async fn a_refused_or_unreachable_signer_fails_the_login_with_a_fixed_text() {
+        for (mode, expected) in [
+            (FakeMode::Deny, PUBLIC_DENIED),
+            (FakeMode::Offline, PUBLIC_OFFLINE),
+            (FakeMode::WrongKey, PUBLIC_REFUSED),
+            (FakeMode::Unsupported, PUBLIC_FAILED),
+        ] {
+            let node = enrolled().await;
+            node.signer.set_mode(mode);
+            let error = login_through(&node, None).await.unwrap_err();
+            assert_eq!(error.to_string(), expected, "{mode:?}");
+        }
+    }
+
+    #[test]
+    fn login_failures_never_carry_relays_or_signer_text() {
+        let offline: anyhow::Error =
+            RemoteSignerError::Offline("wss://private.example".to_string()).into();
+        assert_eq!(public_login_error(&offline), PUBLIC_OFFLINE);
+        let bad: anyhow::Error =
+            RemoteSignerError::BadResponse("sign_event failed: secret detail".to_string()).into();
+        assert_eq!(public_login_error(&bad), PUBLIC_REFUSED);
+        assert_eq!(
+            public_login_error(&anyhow::anyhow!("anything else")),
+            PUBLIC_FAILED
+        );
+    }
+
+    #[tokio::test]
+    async fn start_needs_an_enrolment() {
+        let node = node().await;
+        let error = login_through(&node, None).await.unwrap_err();
+        assert_eq!(error.to_string(), NOT_ENABLED);
+        assert_eq!(node.signer.calls(), 0);
+    }
+
+    #[tokio::test]
+    async fn start_refuses_an_enrolment_whose_identity_is_gone() {
+        let node = enrolled().await;
+        node.manager.delete(&node.record.id).await.unwrap();
+        let error = login_through(&node, None).await.unwrap_err();
+        // The same text as no enrolment: nothing about the identity.
+        assert_eq!(error.to_string(), NOT_ENABLED);
+        assert_eq!(node.signer.calls(), 0);
+    }
+
+    async fn enable_totp(auth: &AuthManager) {
+        let setup = crate::totp::setup(PASSWORD).unwrap();
+        auth.save_totp(setup.totp_data).await.unwrap();
+    }
+
+    #[tokio::test]
+    async fn on_a_2fa_node_the_signer_stands_in_for_the_totp_code() {
+        let node = enrolled().await;
+        enable_totp(&node.auth).await;
+        // Not offered before the password.
+        assert!(!available(&node.auth).await.unwrap());
+        // Without a pending session (no password given), refused with the
+        // same text as no enrolment, and the signer is not asked.
+        let error = login_through(&node, None).await.unwrap_err();
+        assert_eq!(error.to_string(), NOT_ENABLED);
+        assert_eq!(node.signer.calls(), 0);
+        // After the password, bound to the pending session.
+        let finished = login_through(&node, Some("pending-session"))
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(finished.bound, Bound::Session);
+        assert_eq!(node.signer.calls(), 1);
+    }
+
+    #[tokio::test]
+    async fn without_2fa_a_pending_session_is_not_needed_or_used() {
+        let node = enrolled().await;
+        let finished = login_through(&node, Some("stale-pending"))
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(finished.bound, Bound::Cookie);
+    }
+
+    #[tokio::test]
+    async fn start_leaks_no_identity_or_signer_name() {
+        let node = enrolled().await;
+        let attempts = attempts();
+        let (started, code) = start(
+            &attempts,
+            &node.auth,
+            node.manager.clone(),
+            RELAY,
+            "my node",
+            None,
+            None,
+        )
+        .await
+        .unwrap();
+        let visible = format!(
+            "{} {} {}",
+            started.attempt_id,
+            started.binding.unwrap_or_default(),
+            code
+        );
+        for secret in [
+            node.record.id.as_str(),
+            node.record.name.as_str(),
+            &node.signer.keys.public_key().to_hex(),
+        ] {
+            assert!(!visible.contains(secret), "{secret}");
+        }
+        for message in [
+            NOT_ENABLED,
+            ALREADY_WAITING,
+            PAUSED,
+            EXPIRED,
+            GONE,
+            OTHER_BROWSER,
+            PUBLIC_OFFLINE,
+            PUBLIC_DENIED,
+            PUBLIC_TIMEOUT,
+            PUBLIC_REFUSED,
+            PUBLIC_FAILED,
+        ] {
+            assert!(!message.contains(&node.record.name));
+            assert!(!message.contains("wss://"));
+        }
+    }
