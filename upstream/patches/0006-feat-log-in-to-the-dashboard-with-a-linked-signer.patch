+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::identity_manager::{IdentityPurpose, IdentityRecord};
+    use crate::remote_signer::tests::{FakeMode, FakeSigner, FakeSource};
+    use crate::remote_signer::RemoteRequests;
+    use nostr_sdk::Keys;
+
+    const RELAY: &str = "https://node.local";
+    const PASSWORD: &str = "password123";
+
+    fn challenge() -> LoginChallenge {
+        LoginChallenge::new(RELAY, "my node").unwrap()
+    }
+
+    fn signed(keys: &Keys, kind: u16, tags: Vec<Tag>, created_at: Timestamp) -> Event {
+        UnsignedEvent::new(
+            keys.public_key(),
+            created_at,
+            Kind::from(kind),
+            tags,
+            "Log in to my node",
+        )
+        .sign_with_keys(keys)
+        .unwrap()
+    }
+
+    fn rejection(event: &Event, keys: &Keys, ch: &LoginChallenge) -> String {
+        verify_login_event(event, &keys.public_key(), ch, Timestamp::now())
+            .unwrap_err()
+            .to_string()
+    }
+
+    #[test]
+    fn challenges_are_fresh_and_shaped_as_specified() {
+        let a = challenge();
+        let b = challenge();
+        assert_eq!(a.challenge.len(), 64);
+        assert!(a.challenge.chars().all(|c| c.is_ascii_hexdigit()));
+        assert_ne!(a.challenge, b.challenge);
+        assert_eq!(a.code.len(), 4);
+        assert!(a.code.chars().all(|c| c.is_ascii_digit()));
+        assert_eq!(a.content, "Log in to my node");
+        let keys = Keys::generate();
+        let unsigned = a.unsigned(keys.public_key());
+        assert_eq!(unsigned.kind, Kind::from(22242));
+        let tags: Vec<Vec<String>> = unsigned
+            .tags
+            .iter()
+            .map(|t| t.as_slice().to_vec())
+            .collect();
+        assert_eq!(
+            tags,
+            vec![
+                vec!["challenge".to_string(), a.challenge.clone()],
+                vec!["relay".to_string(), RELAY.to_string()],
+                vec!["code".to_string(), a.code.clone()],
+            ]
+        );
+    }
+
+    #[test]
+    fn a_correct_login_event_verifies() {
+        let keys = Keys::generate();
+        let ch = challenge();
+        let event = ch
+            .unsigned(keys.public_key())
+            .sign_with_keys(&keys)
+            .unwrap();
+        verify_login_event(&event, &keys.public_key(), &ch, Timestamp::now()).unwrap();
+    }
+
+    #[test]
+    fn every_kind_of_wrong_login_event_is_refused() {
+        let keys = Keys::generate();
+        let ch = challenge();
+        let now = Timestamp::now();
+
+        let wrong_kind = signed(&keys, 1, ch.tags(), now);
+        assert!(rejection(&wrong_kind, &keys, &ch).contains("not a login event"));
+
+        let other = Keys::generate();
+        let wrong_key = ch
+            .unsigned(other.public_key())
+            .sign_with_keys(&other)
+            .unwrap();
+        assert!(rejection(&wrong_key, &keys, &ch).contains("not enrolled"));
+
+        let mut other_challenge = ch.clone();
+        other_challenge.challenge = "00".repeat(32);
+        let wrong_challenge = signed(&keys, LOGIN_KIND, other_challenge.tags(), now);
+        assert!(rejection(&wrong_challenge, &keys, &ch).contains("challenge"));
+
+        let mut other_code = ch.clone();
+        other_code.code = if ch.code == "0000" { "0001" } else { "0000" }.to_string();
+        let wrong_code = signed(&keys, LOGIN_KIND, other_code.tags(), now);
+        assert!(rejection(&wrong_code, &keys, &ch).contains("code"));
+
+        let mut other_relay = ch.clone();
+        other_relay.relay = "https://elsewhere.example".to_string();
+        let wrong_relay = signed(&keys, LOGIN_KIND, other_relay.tags(), now);
+        assert!(rejection(&wrong_relay, &keys, &ch).contains("origin"));
+
+        let mut doubled = ch.tags();
+        doubled.push(Tag::parse(["code", "9999"]).unwrap());
+        let repeated_code = signed(&keys, LOGIN_KIND, doubled, now);
+        assert!(rejection(&repeated_code, &keys, &ch).contains("code"));
+
+        let stale = signed(&keys, LOGIN_KIND, ch.tags(), now - 61);
+        assert!(rejection(&stale, &keys, &ch).contains("time"));
+        let future = signed(&keys, LOGIN_KIND, ch.tags(), now + 61);
+        assert!(rejection(&future, &keys, &ch).contains("time"));
+        let edge = signed(&keys, LOGIN_KIND, ch.tags(), now - 60);
+        verify_login_event(&edge, &keys.public_key(), &ch, now).unwrap();
+
+        // A real signature by the right key, but over another event.
+        let mut bad_sig = ch
+            .unsigned(keys.public_key())
+            .sign_with_keys(&keys)
+            .unwrap();
+        bad_sig.sig = wrong_kind.sig;
+        assert!(rejection(&bad_sig, &keys, &ch).contains("signature"));
+    }
+
+    #[test]
+    fn binding_cookies_are_named_per_attempt_and_only_for_our_ids() {
+        let id = "0123456789abcdef0123456789abcdef";
+        assert_eq!(
+            binding_cookie_name(id).as_deref(),
+            Some("signer_login_01234567")
+        );
+        for bad in [
+            "",
+            "short",
+            "0123456789abcdef0123456789abcdeg",
+            "a; Path=/x\r\n",
+        ] {
+            assert!(binding_cookie_name(bad).is_none(), "{bad:?}");
+        }
