+    #[tokio::test(start_paused = true)]
+    async fn finish_needs_the_starters_binding() {
+        let attempts = attempts();
+        let started = attempts
+            .start(Purpose::Login, "signer", None, approve())
+            .unwrap();
+        for binding in [None, Some("00".repeat(32))] {
+            let refused = attempts
+                .finish(
+                    &started.attempt_id,
+                    Purpose::Login,
+                    binding.as_deref(),
+                    // A session token is no substitute for the cookie.
+                    started.binding.as_deref(),
+                )
+                .await
+                .unwrap_err();
+            assert_eq!(refused.to_string(), OTHER_BROWSER);
+        }
+        // A refused finish does not use the attempt up.
+        assert!(finish_cookie(&attempts, &started).await.unwrap().is_some());
+
+        // An attempt bound to a session needs that session, not a cookie.
+        let started = attempts
+            .start(Purpose::Login, "signer", Some("pending"), approve())
+            .unwrap();
+        assert!(started.binding.is_none());
+        for (cookie, session) in [(Some("pending"), None), (None, Some("other"))] {
+            let refused = attempts
+                .finish(&started.attempt_id, Purpose::Login, cookie, session)
+                .await
+                .unwrap_err();
+            assert_eq!(refused.to_string(), OTHER_BROWSER);
+        }
+        let finished = attempts
+            .finish(&started.attempt_id, Purpose::Login, None, Some("pending"))
+            .await
+            .unwrap()
+            .unwrap();
