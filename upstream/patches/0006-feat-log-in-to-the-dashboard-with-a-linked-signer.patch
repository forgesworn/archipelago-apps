+#[cfg(test)]
+mod tests {
+    use super::*;
+    use hyper::header::HeaderValue;
+
+    fn headers(pairs: &[(&'static str, &str)]) -> hyper::HeaderMap {
+        let mut headers = hyper::HeaderMap::new();
+        for (name, value) in pairs {
+            headers.insert(*name, HeaderValue::from_str(value).unwrap());
+        }
+        headers
+    }
+
+    #[test]
+    fn the_node_origin_comes_from_origin_then_host() {
+        assert_eq!(
+            node_origin(&headers(&[
+                ("origin", "https://node.local"),
+                ("host", "node.local")
+            ]))
+            .unwrap(),
+            "https://node.local"
+        );
+        // An opaque origin falls back to the Host header.
+        assert_eq!(
+            node_origin(&headers(&[("origin", "null"), ("host", "node.local")])).unwrap(),
+            "http://node.local"
+        );
+        assert_eq!(
+            node_origin(&headers(&[
+                ("host", "node.local"),
+                ("x-forwarded-proto", "https")
+            ]))
+            .unwrap(),
+            "https://node.local"
+        );
+        assert!(node_origin(&headers(&[])).is_err());
+        assert!(node_origin(&headers(&[("host", "node.local/path")])).is_err());
+    }
+
+    #[test]
+    fn signer_prompts_come_only_from_the_dashboard_or_non_browser_clients() {
+        let allowed = |pairs: &[(&'static str, &str)], dev: bool| {
+            signer_prompt_origin_allowed(&headers(pairs), dev)
+        };
+        // No Origin: a non-browser client.
+        assert!(allowed(&[("host", "node.local")], false));
+        assert!(allowed(&[], false));
+        // The dashboard, on 80 or 443, with nginx's port-less Host.
+        assert!(allowed(
+            &[("origin", "https://node.local"), ("host", "node.local")],
+            false
+        ));
+        assert!(allowed(
+            &[("origin", "http://192.0.2.10"), ("host", "192.0.2.10")],
+            false
+        ));
+        assert!(allowed(
+            &[("origin", "https://Node.Local"), ("host", "node.local:443")],
+            false
+        ));
+        // An app port on the same host.
+        assert!(!allowed(
+            &[
+                ("origin", "https://node.local:8337"),
+                ("host", "node.local")
+            ],
+            false
+        ));
+        // Another site, even on 443.
+        assert!(!allowed(
+            &[("origin", "https://evil.example"), ("host", "node.local")],
+            false
+        ));
+        // Opaque or malformed origins, and an Origin with no Host to match.
+        assert!(!allowed(
+            &[("origin", "null"), ("host", "node.local")],
+            false
+        ));
+        assert!(!allowed(&[("origin", "https://node.local")], false));
+        // Development: the loopback dev server.
+        assert!(allowed(
+            &[
+                ("origin", "http://localhost:5173"),
+                ("host", "localhost:5173")
+            ],
+            true
+        ));
+        assert!(!allowed(
+            &[("origin", "http://localhost:5173"), ("host", "node.local")],
+            false
+        ));
+    }
+
+    #[test]
+    fn method_groups() {
+        for method in [
+            "auth.signer.enrol.start",
+            "auth.signer.enrol.finish",
+            "auth.signer.list",
+            "auth.signer.remove",
+            "auth.signer.status",
+        ] {
+            assert!(login_signer_method(method), "{method}");
+        }
+        for method in [
+            "auth.login.signer.available",
+            "auth.login.signer.start",
+            "auth.login.signer.finish",
+            "identity.link-nip46",
+        ] {
+            assert!(!login_signer_method(method), "{method}");
+        }
+        for method in [
+            "auth.signer.enrol.start",
+            "auth.signer.enrol.finish",
+            "auth.login.signer.start",
+            "auth.login.signer.finish",
+        ] {
+            assert!(signer_prompt_method(method), "{method}");
+        }
+        for method in [
+            "auth.login.signer.available",
+            "auth.signer.list",
+            "auth.signer.remove",
+            "auth.login",
+        ] {
+            assert!(!signer_prompt_method(method), "{method}");
+        }
+    }
+}
