+            .start(Purpose::Login, "signer", None, deny())
+            .unwrap();
+        tokio::time::sleep(Duration::from_millis(1)).await;
+        assert_eq!(
+            attempts
+                .start(Purpose::Login, "signer", None, deny())
+                .unwrap_err()
+                .to_string(),
+            PAUSED
+        );
+        assert!(finish_cookie(&attempts, &started).await.is_err());
+        tokio::time::sleep(BACKOFF[0]).await;
+        // The second failure in a row pauses for longer.
+        attempts
+            .start(Purpose::Login, "signer", None, deny())
+            .unwrap();
+        tokio::time::sleep(BACKOFF[0] + Duration::from_millis(1)).await;
+        assert!(attempts
+            .start(Purpose::Login, "signer", None, approve())
+            .is_err());
+        tokio::time::sleep(BACKOFF[1]).await;
+        // A success clears the backoff and the window.
+        let ok = attempts
+            .start(Purpose::Login, "signer", None, approve())
+            .unwrap();
+        assert!(finish_cookie(&attempts, &ok).await.unwrap().is_some());
+        for i in 0..START_BUDGET {
+            attempts
+                .start(Purpose::Login, &format!("fresh {i}"), None, never())
+                .unwrap();
+        }
+    }
