+//! RPC methods for logging in with a linked signer. The logic is in
+//! `crate::signer_login`; these wrappers read what it needs from the request
+//! (the node origin for the challenge, the session and binding cookies, and
+//! the client address for the log).
+
+use super::middleware::extract_cookie;
+use super::RpcHandler;
+use crate::identity_manager::IdentityManager;
+use crate::signer_login::{self, Bound, QUICK_APPROVAL};
+use anyhow::Result;
+use std::net::IpAddr;
+use std::sync::Arc;
+
+/// Text for a 2FA login whose pending session expired or was used during
+/// the signer's approval. Starts with "Session" so it reaches the page.
+const PENDING_GONE: &str = "Session expired. Please log in with your password again.";
+
+/// Methods that manage login signers. They follow the dashboard origin rule,
+/// like linking a signer.
+pub(super) fn login_signer_method(method: &str) -> bool {
+    matches!(
+        method,
+        "auth.signer.enrol.start"
+            | "auth.signer.enrol.finish"
+            | "auth.signer.list"
+            | "auth.signer.remove"
+            | "auth.signer.status"
+    )
+}
+
+/// Methods that put a prompt on the signer or collect its answer. They need
+/// the request headers, so `RpcHandler::handle` routes them here, and they
+/// follow [`signer_prompt_origin_allowed`].
+pub(super) fn signer_prompt_method(method: &str) -> bool {
+    matches!(
+        method,
+        "auth.signer.enrol.start"
+            | "auth.signer.enrol.finish"
+            | "auth.login.signer.start"
+            | "auth.login.signer.finish"
+    )
+}
+
+/// The origin rule for [`signer_prompt_method`]s: no `Origin` (a non-browser
+/// client), or an http(s) `Origin` on the same host as the `Host` header and
+/// on port 80 or 443, the dashboard. Loopback origins are allowed in
+/// development. App ports on the node's own host are refused, so an app page
+/// cannot start a login, read its code and show it to the owner; so are
+/// other sites.
+pub(super) fn signer_prompt_origin_allowed(headers: &hyper::HeaderMap, dev_mode: bool) -> bool {
+    let header = |name: &str| headers.get(name).and_then(|v| v.to_str().ok());
+    let Some(origin) = header("origin") else {
+        return true;
+    };
+    let Ok(origin) = reqwest::Url::parse(origin) else {
+        return false;
+    };
+    if !matches!(origin.scheme(), "http" | "https") {
+        return false;
+    }
+    let Some(origin_host) = origin.host_str() else {
+        return false;
+    };
+    if dev_mode && matches!(origin_host, "localhost" | "127.0.0.1" | "[::1]") {
+        return true;
+    }
+    let host = header("host")
+        .and_then(|host| reqwest::Url::parse(&format!("http://{host}")).ok())
+        .and_then(|url| url.host_str().map(str::to_ascii_lowercase));
+    host.as_deref() == Some(origin_host.to_ascii_lowercase().as_str())
+        && matches!(origin.port_or_known_default(), Some(80 | 443))
+}
+
+/// The node origin the browser used, for the challenge's `relay` tag: the
+/// `Origin` header when it is an http(s) origin (which
+/// [`signer_prompt_origin_allowed`] has pinned to the dashboard), else the
+/// scheme and `Host`.
+pub(super) fn node_origin(headers: &hyper::HeaderMap) -> Result<String> {
+    let header = |name: &str| headers.get(name).and_then(|v| v.to_str().ok());
+    if let Some(Ok(url)) = header("origin").map(reqwest::Url::parse) {
+        if matches!(url.scheme(), "http" | "https") && url.host_str().is_some() {
+            return Ok(url.origin().ascii_serialization());
+        }
+    }
+    let host = header("host").ok_or_else(|| anyhow::anyhow!("Missing Host header"))?;
+    let scheme = match header("x-forwarded-proto") {
+        Some("https") => "https",
+        _ => "http",
+    };
+    let url = reqwest::Url::parse(&format!("{scheme}://{host}"))
+        .ok()
+        .filter(|url| url.host_str().is_some() && url.path() == "/")
+        .ok_or_else(|| anyhow::anyhow!("Invalid Host header"))?;
+    Ok(url.origin().ascii_serialization())
+}
+
+fn identity_id_param(params: &serde_json::Value) -> Result<&str> {
+    let id = params
+        .get("identity_id")
+        .and_then(|v| v.as_str())
+        .ok_or_else(|| anyhow::anyhow!("Missing required parameter: identity_id"))?;
+    super::identity::validate_identity_id(id)?;
+    Ok(id)
+}
+
+fn password_param(params: &serde_json::Value) -> Result<&str> {
+    params
+        .get("password")
+        .and_then(|v| v.as_str())
+        .ok_or_else(|| anyhow::anyhow!("Missing password"))
+}
+
+fn attempt_id_param(params: &serde_json::Value) -> Result<&str> {
+    params
+        .get("attempt_id")
+        .and_then(|v| v.as_str())
+        .ok_or_else(|| anyhow::anyhow!("Missing required parameter: attempt_id"))
+}
+
+impl RpcHandler {
+    /// `session` is the caller's session token (the restored one if the
+    /// session was just restored from remember-me).
+    pub(super) async fn dispatch_signer_login(
+        &self,
+        method: &str,
+        params: Option<serde_json::Value>,
+        headers: &hyper::HeaderMap,
+        session: Option<&str>,
+        client_ip: IpAddr,
+    ) -> Result<serde_json::Value> {
+        let params = params.unwrap_or_default();
+        match method {
+            "auth.signer.enrol.start" => {
+                self.handle_signer_enrol_start(&params, headers, session)
+                    .await
+            }
+            "auth.signer.enrol.finish" => self.handle_signer_enrol_finish(&params, session).await,
+            "auth.login.signer.start" => {
+                self.handle_signer_login_start(headers, session, client_ip)
+                    .await
+            }
+            "auth.login.signer.finish" => {
+                self.handle_signer_login_finish(&params, headers, session, client_ip)
+                    .await
+            }
+            _ => Err(anyhow::anyhow!("Unknown method: {method}")),
+        }
+    }
+
+    /// The name the challenge says it is for: the node's name, else its
+    /// hostname.
+    async fn node_display_name(&self) -> String {
+        let (data, _) = self.state_manager.get_snapshot().await;
+        if let Some(name) = data.server_info.name.filter(|n| !n.trim().is_empty()) {
+            return name.trim().to_string();
+        }
+        tokio::fs::read_to_string("/etc/hostname")
+            .await
+            .map(|s| s.trim().to_string())
+            .ok()
+            .filter(|s| !s.is_empty())
+            .unwrap_or_else(|| "Archipelago".to_string())
+    }
+
+    /// `auth.signer.enrol.start { identity_id, password }` gives
+    /// `{ attempt_id, code }`: the signer is asked to sign a login challenge,
+    /// and the dashboard shows the code to check against the device.
+    async fn handle_signer_enrol_start(
+        &self,
+        params: &serde_json::Value,
+        headers: &hyper::HeaderMap,
+        session: Option<&str>,
+    ) -> Result<serde_json::Value> {
+        let session = session.ok_or_else(|| anyhow::anyhow!("Unauthorized"))?;
+        let identity_id = identity_id_param(params)?;
+        let password = password_param(params)?;
+        let relay = node_origin(headers)?;
+        let node_name = self.node_display_name().await;
+        let manager = Arc::new(IdentityManager::new(&self.config.data_dir).await?);
+        let (attempt_id, code) = signer_login::enrol_start(
+            &self.signer_logins,
+            &self.auth_manager,
+            manager,
+            identity_id,
+            password,
+            session,
+            &relay,
+            &node_name,
+        )
+        .await?;
+        Ok(serde_json::json!({ "attempt_id": attempt_id, "code": code }))
+    }
+
+    /// `auth.signer.enrol.finish { attempt_id }` gives `{ status: "pending" }`
+    /// within 10 s, or `{ status: "enrolled", … }` once saved. `approval_ms`
+    /// is how long the signer took; `quick_approval` means faster than a
+    /// person could press, so it probably signs without asking.
+    async fn handle_signer_enrol_finish(
+        &self,
+        params: &serde_json::Value,
+        session: Option<&str>,
+    ) -> Result<serde_json::Value> {
+        let session = session.ok_or_else(|| anyhow::anyhow!("Unauthorized"))?;
+        let attempt_id = attempt_id_param(params)?;
+        let Some(approval) =
+            signer_login::enrol_finish(&self.signer_logins, attempt_id, session).await?
+        else {
+            return Ok(serde_json::json!({ "status": "pending" }));
+        };
+        Ok(serde_json::json!({
+            "status": "enrolled",
+            "identity_id": approval.signer.identity_id,
+            "pubkey": approval.signer.pubkey,
+            "added_at": approval.signer.added_at,
+            "approval_ms": approval.approval.as_millis() as u64,
+            "quick_approval": approval.approval < QUICK_APPROVAL,
+        }))
+    }
+
+    /// `auth.signer.list`: the enrolled login signers.
+    pub(super) async fn handle_signer_list(&self) -> Result<serde_json::Value> {
+        let manager = IdentityManager::new(&self.config.data_dir).await?;
+        let mut signers = Vec::new();
+        for signer in self.auth_manager.login_signers().await? {
+            let name = manager.get(&signer.identity_id).await.ok().map(|r| r.name);
+            signers.push(serde_json::json!({
+                "identity_id": signer.identity_id,
+                "pubkey": signer.pubkey,
+                "added_at": signer.added_at,
+                "name": name,
+            }));
+        }
+        Ok(serde_json::json!(signers))
+    }
+
+    /// `auth.signer.remove { identity_id, password }`. Password login is
+    /// never affected.
+    pub(super) async fn handle_signer_remove(
+        &self,
+        params: Option<serde_json::Value>,
+    ) -> Result<serde_json::Value> {
+        let params = params.unwrap_or_default();
+        let identity_id = identity_id_param(&params)?;
+        let password = password_param(&params)?;
+        let removed = signer_login::remove(&self.auth_manager, identity_id, password).await?;
+        Ok(serde_json::json!({ "removed": removed }))
+    }
+
+    /// `auth.signer.status`: when signer login is paused until (Unix
+    /// seconds, or null) and the recent login starts, `{ at, ip, outcome }`,
+    /// so the dashboard can say who tripped a pause.
+    pub(super) async fn handle_signer_status(&self) -> Result<serde_json::Value> {
+        Ok(serde_json::to_value(self.signer_logins.status())?)
+    }
+
+    /// `auth.login.signer.available`: whether the login page should offer
+    /// the signer before the password. Public, so it says nothing more; on a
+    /// 2FA node it is false and `auth.login` says `signer: true` at the TOTP
+    /// step instead.
+    pub(super) async fn handle_signer_login_available(&self) -> Result<serde_json::Value> {
+        Ok(serde_json::json!(
+            signer_login::available(&self.auth_manager).await?
+        ))
+    }
+
+    /// `auth.login.signer.start {}` gives `{ attempt_id, code }`. Without
+    /// 2FA, the binding token also returned here is moved into an HttpOnly
+    /// cookie by `apply_auth_cookies`. With 2FA it needs the pending session
+    /// `auth.login` left, and is bound to it.
+    async fn handle_signer_login_start(
+        &self,
+        headers: &hyper::HeaderMap,
+        session: Option<&str>,
+        client_ip: IpAddr,
+    ) -> Result<serde_json::Value> {
+        let relay = node_origin(headers)?;
+        let node_name = self.node_display_name().await;
+        let manager = Arc::new(IdentityManager::new(&self.config.data_dir).await?);
+        // Checked without counting as a TOTP attempt.
+        let pending = match session {
+            Some(token) if self.session_store.is_pending(token).await => Some(token),
+            _ => None,
+        };
+        let started = signer_login::start(
+            &self.signer_logins,
+            &self.auth_manager,
+            manager,
+            &relay,
+            &node_name,
+            pending,
+            Some(client_ip),
+        )
+        .await;
+        let (started, code) = match started {
+            Ok(started) => started,
+            Err(e) => {
+                tracing::info!(client = %client_ip, "[login] signer login start refused: {e}");
+                return Err(e);
+            }
+        };
+        tracing::info!(client = %client_ip, "[login] signer login started");
+        Ok(serde_json::json!({
+            "attempt_id": started.attempt_id,
+            "code": code,
+            "binding": started.binding,
+        }))
+    }
+
+    /// `auth.login.signer.finish { attempt_id }` gives `{ status: "pending" }`
+    /// within 10 s, or `{ status: "approved" }`, which `apply_auth_cookies`
+    /// turns into a session. On a 2FA login the pending session is upgraded
+    /// here and its new token handed over (and stripped) the same way
+    /// `auth.login.totp` does it.
+    async fn handle_signer_login_finish(
+        &self,
+        params: &serde_json::Value,
+        headers: &hyper::HeaderMap,
+        session: Option<&str>,
+        client_ip: IpAddr,
+    ) -> Result<serde_json::Value> {
+        let attempt_id = attempt_id_param(params)?;
+        let cookie = signer_login::binding_cookie_name(attempt_id)
+            .and_then(|name| extract_cookie(headers, &name));
+        let finished =
+            match signer_login::finish(&self.signer_logins, attempt_id, cookie.as_deref(), session)
+                .await
+            {
+                Ok(Some(finished)) => finished,
+                Ok(None) => return Ok(serde_json::json!({ "status": "pending" })),
+                Err(e) => {
+                    tracing::warn!(client = %client_ip, "[login] signer login failed: {e}");
+                    return Err(e);
+                }
+            };
+        if finished.bound == Bound::Session {
+            // The pending session may have expired, or been used by the TOTP
+            // code, while the signer was asking.
+            let pending = match session {
+                Some(token) if self.session_store.is_pending(token).await => token,
+                _ => anyhow::bail!(PENDING_GONE),
+            };
+            let new_token = self
+                .session_store
+                .upgrade_to_full(pending)
+                .await
+                .ok_or_else(|| anyhow::anyhow!(PENDING_GONE))?;
+            tracing::info!(client = %client_ip, "[login] signer login approved (in place of the TOTP code)");
+            return Ok(serde_json::json!({
+                "status": "approved",
+                "new_session_token": new_token,
+            }));
+        }
+        // Started without a password, so only good while the node has no
+        // 2FA: if it was switched on during the press, the password (and
+        // the TOTP code or the signer) is needed after all.
+        if self.auth_manager.is_totp_enabled().await? {
+            tracing::warn!(client = %client_ip, "[login] signer login refused: 2FA was switched on during it");
+            anyhow::bail!(PENDING_GONE);
+        }
+        tracing::info!(client = %client_ip, "[login] signer login approved");
+        Ok(serde_json::json!({ "status": "approved" }))
+    }
+}
