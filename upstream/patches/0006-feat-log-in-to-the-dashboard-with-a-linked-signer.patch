+        assert!(status.recent.iter().all(|r| r.ip == Some(lan)));
+        assert!(status.paused_until.is_some());
+        // The unanswered one expires.
+        tokio::time::sleep(ATTEMPT_TTL).await;
+        assert_eq!(attempts.status().recent[2].outcome, "expired");
+        // The approved one was never finished in time, so it is gone and
+        // cleared nothing; a password login clears the pause.
+        assert!(finish_cookie(&attempts, &approved).await.is_err());
+        assert!(attempts.status().paused_until.is_some());
+        attempts.password_login();
+        assert!(attempts.status().paused_until.is_none());
+        // Serialised for the dashboard, without the attempt ids.
+        let json = serde_json::to_value(attempts.status()).unwrap();
+        assert_eq!(json["recent"][0]["ip"], "192.0.2.7");
+        assert!(json["recent"][0].get("attempt_id").is_none());
+    }
