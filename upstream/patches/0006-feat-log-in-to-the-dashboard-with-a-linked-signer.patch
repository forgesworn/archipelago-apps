+        })
+    }
+
+    async fn body(response: Response<hyper::Body>) -> serde_json::Value {
+        let bytes = hyper::body::to_bytes(response.into_body()).await.unwrap();
+        serde_json::from_slice(&bytes).unwrap()
+    }
+
+    async fn call_with(
+        handler: &Arc<RpcHandler>,
+        method: &str,
+        params: serde_json::Value,
+        headers: &[(&str, &str)],
+    ) -> Response<hyper::Body> {
+        let mut request = Request::builder().method("POST").uri("/rpc/v1");
+        for (name, value) in headers {
+            request = request.header(*name, *value);
+        }
+        let request = request
+            .body(hyper::Body::from(
+                serde_json::json!({ "method": method, "params": params }).to_string(),
+            ))
+            .unwrap();
+        Arc::clone(handler).handle(request).await.unwrap()
+    }
+
+    async fn call(
+        handler: &Arc<RpcHandler>,
+        method: &str,
+        headers: &[(&str, &str)],
+    ) -> Response<hyper::Body> {
+        call_with(handler, method, serde_json::json!({}), headers).await
+    }
