diff --git a/core/archipelago/src/signer_login.rs b/core/archipelago/src/signer_login.rs
new file mode 100644
index 0000000..725e2b3
--- /dev/null
+++ b/core/archipelago/src/signer_login.rs
@@ -0,0 +1,1739 @@
+//! Logging in to the dashboard with a linked signer.
+//!
+//! A linked identity can be enrolled for login (`auth.signer.enrol.start`
+//! and `.finish`). A login then sends its signer a kind 22242 event carrying
+//! a random challenge, the node origin the browser used and a 4-digit code
+//! the page shows, so the owner can tell their own request from someone
+//! else's before pressing. The password always works as well; enrolment
+//! never replaces it.
+//!
+//! Without 2FA the signer's approval alone logs in. With 2FA it stands in
+//! for the TOTP code: the owner gives the password first (`auth.login`
+//! leaves a pending session), and the approval upgrades that session.
+//!
+//! An attempt is single use and belongs to whoever started it: a binding
+//! token (an HttpOnly cookie for a login without 2FA, the session or pending
+//! session token otherwise) that `finish` must present. The signer has
+//! about a minute to answer (the NIP-46 request timeout); [`ATTEMPT_TTL`]
+//! bounds the attempt as a whole, including the wait for `finish`. While an
+//! attempt (login or enrolment) waits on a signer, a second start for that
+//! signer is refused rather than replacing it, so nobody can keep cancelling
+//! the owner's request, and the device never shows both kinds at once.
+//! Logins also have a node-wide budget with backoff after failures. On a
+//! node without 2FA anyone who can reach the login page can trip it, and by
+//! retrying keep signer login paused; the password always works, a password
+//! login clears the pause, and the owner can see who tripped it
+//! ([`LoginAttempts::status`]).
+
+use anyhow::{Context, Result};
+use nostr_sdk::{Event, Kind, PublicKey, Tag, Timestamp, UnsignedEvent};
+use rand::rngs::OsRng;
+use rand::Rng;
+use sha2::{Digest, Sha256};
+use std::collections::{HashMap, VecDeque};
+use std::future::Future;
+use std::net::IpAddr;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+use tokio::time::Instant;
+
+use crate::auth::{AuthManager, LoginSigner};
+use crate::identity_manager::IdentityManager;
+use crate::remote_signer::{RemoteSignerError, FINISH_WAIT};
+
+/// NIP-42-style authentication event, as upstream's login research proposes.
+pub const LOGIN_KIND: u16 = 22242;
+/// How long an attempt lasts in all: the signer's answer (which the NIP-46
+/// request timeout limits to about a minute) and then the wait for `finish`.
+pub const ATTEMPT_TTL: Duration = Duration::from_secs(120);
+/// How far a login event's `created_at` may be from the node's clock.
+pub const MAX_CLOCK_SKEW_SECS: u64 = 60;
+/// Prefix of the cookie binding a login attempt to its browser; the cookie
+/// is named per attempt (see [`binding_cookie_name`]).
+pub const BINDING_COOKIE: &str = "signer_login";
+/// An enrolment challenge answered faster than this was probably signed
+/// without anyone pressing a button.
+pub const QUICK_APPROVAL: Duration = Duration::from_secs(1);
+/// Node-wide: at most this many login starts per [`START_WINDOW`].
+pub const START_BUDGET: usize = 3;
+pub const START_WINDOW: Duration = Duration::from_secs(10 * 60);
+/// Pause before the next login start after one, two and three or more
+/// failed, denied or expired logins in a row.
+pub const BACKOFF: [Duration; 3] = [
+    Duration::from_secs(30),
+    Duration::from_secs(2 * 60),
+    Duration::from_secs(10 * 60),
+];
+
+/// How many recent login starts [`LoginAttempts::status`] reports.
+pub const RECENT_STARTS: usize = 20;
+
+// Texts an unauthenticated caller can see. Fixed: nothing from the signer,
+// its relays or the enrolled identity.
+pub(crate) const NOT_ENABLED: &str = "linked signer login is not enabled on this node";
+pub(crate) const ALREADY_WAITING: &str = "linked signer login is busy: another login is waiting for approval. If your signer is asking right now, that request did not come from this page: deny it";
+pub(crate) const PAUSED: &str = "linked signer login is paused after recent attempts; log in with the password or try again in a few minutes";
+pub(crate) const EXPIRED: &str = "linked signer did not approve the login in time";
+pub(crate) const GONE: &str = "Invalid signer login attempt: it is unknown, used or expired";
+pub(crate) const OTHER_BROWSER: &str =
+    "Invalid signer login attempt: it was started in another browser";
+pub(crate) const PUBLIC_OFFLINE: &str = "linked signer is offline";
+pub(crate) const PUBLIC_DENIED: &str = "linked signer denied the login";
+pub(crate) const PUBLIC_TIMEOUT: &str = "linked signer did not answer in time";
+pub(crate) const PUBLIC_REFUSED: &str =
+    "linked signer login was refused: the signed reply did not check out";
+pub(crate) const PUBLIC_FAILED: &str = "linked signer login failed";
+// Texts for the owner enrolling a signer, who is logged in.
+pub(crate) const ENROL_BUSY_LOGIN: &str = "linked signer is busy: a login is waiting for approval on it. If you did not start one, deny it on the signer, then try again";
+pub(crate) const ENROL_BUSY: &str =
+    "linked signer is already waiting to approve an enrolment; approve or deny it on the signer first";
+pub(crate) const ENROL_EXPIRED: &str = "linked signer did not approve the enrolment in time";
+
+/// The cookie name for a login attempt's binding token, or `None` if
+/// `attempt_id` is not an id this module issues (so it is safe in a header).
+pub fn binding_cookie_name(attempt_id: &str) -> Option<String> {
+    let well_formed = attempt_id.len() == 32 && attempt_id.bytes().all(|b| b.is_ascii_hexdigit());
+    well_formed.then(|| format!("{BINDING_COOKIE}_{}", &attempt_id[..8]))
+}
+
+/// Hex of `len` random bytes, drawn through the KEY-05 entropy guard.
+fn random_hex(len: usize) -> Result<String> {
+    let mut bytes = vec![0u8; len];
+    crate::entropy::draw_key_bytes(&mut OsRng, &mut bytes)
+        .map_err(|e| anyhow::anyhow!("refusing a login challenge from degenerate entropy: {e}"))?;
+    Ok(hex::encode(bytes))
+}
+
+/// What one login (or enrolment) asks the signer to sign.
+#[derive(Debug, Clone)]
+pub struct LoginChallenge {
+    /// 32 random bytes, hex.
+    pub challenge: String,
+    /// The node origin the browser used.
+    pub relay: String,
+    /// Four digits the login page shows and the signer should too.
+    pub code: String,
+    pub content: String,
+}
+
+impl LoginChallenge {
+    pub fn new(relay: &str, node_name: &str) -> Result<Self> {
+        // Unguarded: four digits for a person to compare, not key material.
+        let code = format!("{:04}", OsRng.gen_range(0..10_000u16));
+        Ok(Self {
+            challenge: random_hex(32)?,
+            relay: relay.to_string(),
+            code,
+            content: format!("Log in to {node_name}"),
+        })
+    }
+
+    pub fn tags(&self) -> Vec<Tag> {
+        vec![
+            Tag::parse(["challenge", self.challenge.as_str()]).expect("two-element tag"),
+            Tag::parse(["relay", self.relay.as_str()]).expect("two-element tag"),
+            Tag::parse(["code", self.code.as_str()]).expect("two-element tag"),
+        ]
+    }
+
+    /// The event for `pubkey` to sign, timestamped now.
+    pub fn unsigned(&self, pubkey: PublicKey) -> UnsignedEvent {
+        UnsignedEvent::new(
+            pubkey,
+            Timestamp::now(),
+            Kind::from(LOGIN_KIND),
+            self.tags(),
+            self.content.clone(),
+        )
+    }
+}
+
+/// The value of the one tag named `name`; `None` if it is missing or
+/// repeated.
+fn single_tag<'a>(event: &'a Event, name: &str) -> Option<&'a str> {
+    let mut values = event
+        .tags
+        .iter()
+        .map(|t| t.as_slice())
+        .filter(|t| t.first().map(String::as_str) == Some(name));
+    let value = values.next()?.get(1)?;
+    match values.next() {
+        Some(_) => None,
+        None => Some(value.as_str()),
+    }
+}
+
+/// Check a signed login event: kind 22242, signed by `expected` with a valid
+/// signature, carrying this attempt's challenge, relay and code, and dated
+/// within [`MAX_CLOCK_SKEW_SECS`] of `now`.
+pub fn verify_login_event(
+    event: &Event,
+    expected: &PublicKey,
+    challenge: &LoginChallenge,
+    now: Timestamp,
+) -> Result<()> {
+    if event.kind != Kind::from(LOGIN_KIND) {
+        anyhow::bail!("Invalid signer login: the event is not a login event");
+    }
+    if event.pubkey != *expected {
+        anyhow::bail!("Invalid signer login: signed by a key that is not enrolled");
+    }
+    if event.verify().is_err() {
+        anyhow::bail!("Invalid signer login: the signature does not verify");
+    }
+    if single_tag(event, "challenge") != Some(challenge.challenge.as_str()) {
+        anyhow::bail!("Invalid signer login: the challenge does not match");
+    }
+    if single_tag(event, "relay") != Some(challenge.relay.as_str()) {
+        anyhow::bail!("Invalid signer login: the node origin does not match");
+    }
+    if single_tag(event, "code") != Some(challenge.code.as_str()) {
+        anyhow::bail!("Invalid signer login: the code does not match");
+    }
+    let skew = event.created_at.as_secs().abs_diff(now.as_secs());
+    if skew > MAX_CLOCK_SKEW_SECS {
+        anyhow::bail!("Invalid signer login: the event's time is more than a minute off");
+    }
+    Ok(())
+}
+
+/// What an attempt is for. Both kinds share the per-signer slot.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Purpose {
+    Login,
+    Enrol,
+}
+
+/// What the starter must present to `finish`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Bound {
+    /// A token minted here, kept in an HttpOnly cookie.
+    Cookie,
+    /// The caller's session or pending 2FA session token.
+    Session,
+}
+
+/// An approved attempt: who signed, and how long the signer took.
+#[derive(Debug, Clone)]
+pub struct Approval {
+    pub signer: LoginSigner,
+    pub approval: Duration,
+}
+
+/// Where an attempt has got to.
+#[derive(Debug, Clone)]
+enum AttemptState {
+    Waiting,
+    Approved(Box<Approval>),
+    Failed(String),
+}
+
+fn settled(state: &AttemptState) -> bool {
+    !matches!(state, AttemptState::Waiting)
+}
+
+struct Attempt {
+    purpose: Purpose,
+    signer: String,
+    bound: Bound,
+    binding: [u8; 32],
+    expires: Instant,
+    state: tokio::sync::watch::Receiver<AttemptState>,
+}
+
+/// A started attempt: the id for `finish`, and the binding token to put in
+/// the starter's cookie when it is [`Bound::Cookie`].
+#[derive(Debug)]
+pub struct Started {
+    pub attempt_id: String,
+    pub binding: Option<String>,
+}
+
+/// A finished, approved attempt. `bound` says whether a login was tied to a
+/// pending 2FA session, which the caller then upgrades.
+#[derive(Debug)]
+pub struct Finished {
+    pub approval: Approval,
+    pub bound: Bound,
+}
+
+fn hash_binding(binding: &str) -> [u8; 32] {
+    Sha256::digest(binding.as_bytes()).into()
+}
+
+fn lock<T>(mutex: &Mutex<T>) -> std::sync::MutexGuard<'_, T> {
+    mutex.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+/// The node-wide login start budget: [`START_BUDGET`] per [`START_WINDOW`],
+/// and a growing pause after each failed login in a row. A successful login
+/// clears both.
+struct Budget {
+    limited: bool,
+    starts: VecDeque<Instant>,
+    failures: usize,
+    paused_until: Option<Instant>,
+}
+
+impl Budget {
+    fn new(limited: bool) -> Self {
+        Self {
+            limited,
+            starts: VecDeque::new(),
+            failures: 0,
+            paused_until: None,
+        }
+    }
+
+    fn allows(&mut self, now: Instant) -> bool {
+        if !self.limited {
+            return true;
+        }
+        while self
+            .starts
+            .front()
+            .is_some_and(|at| now.duration_since(*at) >= START_WINDOW)
+        {
+            self.starts.pop_front();
+        }
+        self.paused_until.is_none_or(|until| now >= until) && self.starts.len() < START_BUDGET
+    }
+
+    fn started(&mut self, now: Instant) {
+        self.starts.push_back(now);
+    }
+
+    fn failed(&mut self, now: Instant) {
+        self.failures += 1;
+        let pause = BACKOFF[(self.failures - 1).min(BACKOFF.len() - 1)];
+        self.paused_until = Some(now + pause);
+    }
+
+    fn succeeded(&mut self) {
+        self.starts.clear();
+        self.failures = 0;
+        self.paused_until = None;
+    }
+
+    /// When the next login start will be allowed, if not now.
+    fn paused_until(&self, now: Instant) -> Option<Instant> {
+        if !self.limited {
+            return None;
+        }
+        let backoff = self.paused_until.filter(|until| *until > now);
+        let window = (self.starts.len() >= START_BUDGET)
+            .then(|| self.starts.front().map(|at| *at + START_WINDOW))
+            .flatten()
+            .filter(|until| *until > now);
+        backoff.max(window)
+    }
+}
+
+/// A login start and what became of it, for the owner.
+#[derive(Debug, Clone, serde::Serialize)]
+pub struct RecentStart {
+    /// Unix seconds.
+    pub at: i64,
+    pub ip: Option<IpAddr>,
+    /// `pending`, `approved`, `denied`, `expired`, `offline`, `refused`,
+    /// `failed`, `refused-busy` or `refused-budget`.
+    pub outcome: &'static str,
+    #[serde(skip)]
+    attempt_id: Option<String>,
+}
+
+/// The owner's view of signer login: when it is paused until (Unix
+/// seconds), and the recent starts.
+#[derive(Debug, Clone, serde::Serialize)]
+pub struct SignerLoginStatus {
+    pub paused_until: Option<i64>,
+    pub recent: Vec<RecentStart>,
+}
+
+/// What a failed login's public text says happened.
+fn failure_outcome(message: &str) -> &'static str {
+    match message {
+        PUBLIC_DENIED => "denied",
+        PUBLIC_OFFLINE => "offline",
+        EXPIRED | PUBLIC_TIMEOUT => "expired",
+        PUBLIC_REFUSED => "refused",
+        _ => "failed",
+    }
+}
+
+/// Login and enrolment attempts waiting on a signer or on `finish`.
+/// One per node: `RpcHandler` holds it.
+pub struct LoginAttempts {
+    pending: Mutex<HashMap<String, Attempt>>,
+    budget: Mutex<Budget>,
+    recent: Mutex<VecDeque<RecentStart>>,
+}
+
+impl Default for LoginAttempts {
+    fn default() -> Self {
+        Self::with_budget(true)
+    }
+}
+
+impl LoginAttempts {
+    fn with_budget(limited: bool) -> Self {
+        Self {
+            pending: Mutex::default(),
+            budget: Mutex::new(Budget::new(limited)),
+            recent: Mutex::default(),
+        }
+    }
+
+    /// Attempts with no login budget, for tests of everything else.
+    #[cfg(test)]
+    pub fn unbudgeted() -> Self {
+        Self::with_budget(false)
+    }
+
+    fn record(&self, ip: Option<IpAddr>, outcome: &'static str, attempt_id: Option<String>) {
+        let mut recent = lock(&self.recent);
+        if recent.len() >= RECENT_STARTS {
+            recent.pop_front();
+        }
+        recent.push_back(RecentStart {
+            at: chrono::Utc::now().timestamp(),
+            ip,
+            outcome,
+            attempt_id,
+        });
+    }
+
+    fn settle_record(&self, attempt_id: &str, outcome: &'static str) {
+        let mut recent = lock(&self.recent);
+        if let Some(entry) = recent
+            .iter_mut()
+            .find(|r| r.attempt_id.as_deref() == Some(attempt_id))
+        {
+            entry.outcome = outcome;
+        }
+    }
+
+    /// A password login succeeded: the owner is here, so clear the login
+    /// budget and backoff that others may have tripped.
+    pub fn password_login(&self) {
+        lock(&self.budget).succeeded();
+    }
+
+    /// When signer login is paused until, and the last [`RECENT_STARTS`]
+    /// login starts with their outcomes, newest last.
+    pub fn status(&self) -> SignerLoginStatus {
+        let now = Instant::now();
+        let paused_until = lock(&self.budget).paused_until(now).map(|until| {
+            chrono::Utc::now().timestamp() + until.duration_since(now).as_secs_f64().ceil() as i64
+        });
+        SignerLoginStatus {
+            paused_until,
+            recent: lock(&self.recent).iter().cloned().collect(),
+        }
+    }
+
+    /// [`Self::start_from`] with no client address.
+    pub fn start<F>(
+        self: &Arc<Self>,
+        purpose: Purpose,
+        signer: &str,
+        session: Option<&str>,
+        work: F,
+    ) -> Result<Started>
+    where
+        F: Future<Output = Result<Approval>> + Send + 'static,
+    {
+        self.start_from(purpose, signer, session, None, work)
+    }
+
+    /// Start an attempt for `signer` (its key, hex) that runs `work`, the
+    /// signing and verification, for at most [`ATTEMPT_TTL`]. `session` is
+    /// the token to bind to; with none, a cookie token is minted. Refused
+    /// while another attempt for the signer is unexpired and has not failed,
+    /// and, for a login, when the node-wide budget is spent. A login start
+    /// from `ip` is recorded for [`Self::status`], refused or not.
+    pub fn start_from<F>(
+        self: &Arc<Self>,
+        purpose: Purpose,
+        signer: &str,
+        session: Option<&str>,
+        ip: Option<IpAddr>,
+        work: F,
+    ) -> Result<Started>
+    where
+        F: Future<Output = Result<Approval>> + Send + 'static,
+    {
+        let mut pending = lock(&self.pending);
+        let now = Instant::now();
+        pending.retain(|_, a| a.expires > now);
+        let busy = pending
+            .values()
+            .find(|a| a.signer == signer && !matches!(*a.state.borrow(), AttemptState::Failed(_)))
+            .map(|a| a.purpose);
+        match (purpose, busy) {
+            (_, None) => {}
+            (Purpose::Login, Some(_)) => {
+                self.record(ip, "refused-busy", None);
+                anyhow::bail!(ALREADY_WAITING);
+            }
+            (Purpose::Enrol, Some(Purpose::Login)) => anyhow::bail!(ENROL_BUSY_LOGIN),
+            (Purpose::Enrol, Some(Purpose::Enrol)) => anyhow::bail!(ENROL_BUSY),
+        }
+        if purpose == Purpose::Login {
+            let mut budget = lock(&self.budget);
+            if !budget.allows(now) {
+                drop(budget);
+                self.record(ip, "refused-budget", None);
+                anyhow::bail!(PAUSED);
+            }
+            budget.started(now);
+        }
+        let attempt_id = random_hex(16)?;
+        let (bound, binding, cookie) = match session {
+            Some(token) => (Bound::Session, hash_binding(token), None),
+            None => {
+                let token = random_hex(32)?;
+                (Bound::Cookie, hash_binding(&token), Some(token))
+            }
+        };
+        if purpose == Purpose::Login {
+            self.record(ip, "pending", Some(attempt_id.clone()));
+        }
+        let expires = now + ATTEMPT_TTL;
+        let (state_tx, state_rx) = tokio::sync::watch::channel(AttemptState::Waiting);
+        let attempts = Arc::clone(self);
+        let task_id = attempt_id.clone();
+        tokio::spawn(async move {
+            let state = match tokio::time::timeout_at(expires, work).await {
+                Ok(Ok(approval)) => AttemptState::Approved(Box::new(approval)),
+                Ok(Err(e)) => AttemptState::Failed(e.to_string()),
+                Err(_) => AttemptState::Failed(
+                    match purpose {
+                        Purpose::Login => EXPIRED,
+                        Purpose::Enrol => ENROL_EXPIRED,
+                    }
+                    .to_string(),
+                ),
+            };
+            if purpose == Purpose::Login {
+                match &state {
+                    AttemptState::Approved(_) => attempts.settle_record(&task_id, "approved"),
+                    AttemptState::Failed(message) => {
+                        lock(&attempts.budget).failed(Instant::now());
+                        attempts.settle_record(&task_id, failure_outcome(message));
+                    }
+                    AttemptState::Waiting => {}
+                }
+            }
+            let _ = state_tx.send(state);
+            tokio::time::sleep_until(expires).await;
+            lock(&attempts.pending).remove(&task_id);
+        });
+        pending.insert(
+            attempt_id.clone(),
+            Attempt {
+                purpose,
+                signer: signer.to_string(),
+                bound,
+                binding,
+                expires,
+                state: state_rx,
+            },
+        );
+        Ok(Started {
+            attempt_id,
+            binding: cookie,
+        })
+    }
+
+    /// Wait up to [`FINISH_WAIT`] for the attempt to settle: `Ok(None)`
+    /// while the signer has not answered, the approval once it has, and an
+    /// error if it failed or expired. The attempt must be for `purpose`, and
+    /// the caller must present its binding: `cookie` for one bound to a
+    /// cookie, `session` for one bound to a session. A settled attempt is
+    /// used up by the first `finish` that sees it; a refused `finish` leaves
+    /// it alone.
+    pub async fn finish(
+        &self,
+        attempt_id: &str,
+        purpose: Purpose,
+        cookie: Option<&str>,
+        session: Option<&str>,
+    ) -> Result<Option<Finished>> {
+        let (mut state, expires, bound) = {
+            let mut pending = lock(&self.pending);
+            let attempt = pending
+                .get(attempt_id)
+                .filter(|a| a.purpose == purpose)
+                .ok_or_else(|| anyhow::anyhow!(GONE))?;
+            if attempt.expires <= Instant::now() {
+                pending.remove(attempt_id);
+                anyhow::bail!(GONE);
+            }
+            let presented = match attempt.bound {
+                Bound::Cookie => cookie,
+                Bound::Session => session,
+            };
+            if presented.map(hash_binding) != Some(attempt.binding) {
+                anyhow::bail!(OTHER_BROWSER);
+            }
+            (attempt.state.clone(), attempt.expires, attempt.bound)
+        };
+        let until = expires.min(Instant::now() + FINISH_WAIT);
+        let outcome = match tokio::time::timeout_at(until, state.wait_for(settled)).await {
+            Ok(Ok(outcome)) => outcome.clone(),
+            Err(_) if Instant::now() < expires => return Ok(None),
+            // Expired, or the attempt's task ended without an outcome.
+            _ => {
+                lock(&self.pending).remove(attempt_id);
+                anyhow::bail!(GONE);
+            }
+        };
+        // Single use: only the `finish` that removes the attempt reports it.
+        if lock(&self.pending).remove(attempt_id).is_none() {
+            anyhow::bail!(GONE);
+        }
+        match outcome {
+            AttemptState::Approved(approval) => {
+                if purpose == Purpose::Login {
+                    lock(&self.budget).succeeded();
+                }
+                Ok(Some(Finished {
+                    approval: *approval,
+                    bound,
+                }))
+            }
+            AttemptState::Failed(message) => Err(anyhow::anyhow!(message)),
+            AttemptState::Waiting => Err(anyhow::anyhow!(GONE)),
+        }
+    }
+
+    #[cfg(test)]
+    pub fn len(&self) -> usize {
+        lock(&self.pending).len()
+    }
+}
+
+/// The fixed text an unauthenticated caller sees for a failed login. The
+/// detail (relays, the signer's own words) is logged for the owner instead.
+fn public_login_error(error: &anyhow::Error) -> &'static str {
+    match error.downcast_ref::<RemoteSignerError>() {
+        Some(RemoteSignerError::Offline(_)) => PUBLIC_OFFLINE,
+        Some(RemoteSignerError::Denied | RemoteSignerError::Unauthorised) => PUBLIC_DENIED,
+        Some(RemoteSignerError::Timeout) => PUBLIC_TIMEOUT,
+        Some(RemoteSignerError::BadResponse(_)) => PUBLIC_REFUSED,
+        Some(_) | None => PUBLIC_FAILED,
+    }
+}
+
+/// Whether the login page should offer the signer before the password:
+/// a signer is enrolled and the node has no 2FA. On a 2FA node the signer is
+/// offered at the TOTP step instead, after the password.
+pub async fn available(auth: &AuthManager) -> Result<bool> {
+    Ok(!auth.login_signers().await?.is_empty() && !auth.is_totp_enabled().await?)
+}
+
+/// Start a login through the enrolled signer (the first enrolled; there is
+/// one for now). On a 2FA node `pending_session` must be the caller's valid
+/// pending 2FA session, which the login is bound to; otherwise it is
+/// ignored and the login is bound to a fresh cookie. Returns the attempt and
+/// the code for the page. The caller may be unauthenticated, so every
+/// refusal is a fixed text that names nothing.
+pub async fn start(
+    attempts: &Arc<LoginAttempts>,
+    auth: &AuthManager,
+    manager: Arc<IdentityManager>,
+    relay: &str,
+    node_name: &str,
+    pending_session: Option<&str>,
+    ip: Option<IpAddr>,
+) -> Result<(Started, String)> {
+    let Some(enrolled) = auth.login_signers().await?.into_iter().next() else {
+        anyhow::bail!(NOT_ENABLED);
+    };
+    let session = if auth.is_totp_enabled().await? {
+        // The same answer as no enrolment: before the password, nobody
+        // learns whether 2FA is on.
+        Some(pending_session.ok_or_else(|| anyhow::anyhow!(NOT_ENABLED))?)
+    } else {
+        None
+    };
+    // The identity must still be linked to the enrolled key.
+    let still_linked = manager
+        .linked_signer(&enrolled.identity_id)
+        .await
+        .ok()
+        .flatten()
+        .is_some_and(|linked| linked.user_pubkey == enrolled.pubkey);
+    if !still_linked {
+        tracing::warn!(
+            identity = %enrolled.identity_id,
+            "[login] signer login refused: the enrolled identity is no longer linked"
+        );
+        anyhow::bail!(NOT_ENABLED);
+    }
+    let pubkey = PublicKey::from_hex(&enrolled.pubkey).context("Invalid enrolled signer key")?;
+    let challenge = LoginChallenge::new(relay, node_name)?;
+    let code = challenge.code.clone();
+    let signer_key = enrolled.pubkey.clone();
+    let started = attempts.start_from(Purpose::Login, &signer_key, session, ip, async move {
+        let asked = Instant::now();
+        let event = match manager
+            .sign_linked_event(&enrolled.identity_id, challenge.unsigned(pubkey))
+            .await
+        {
+            Ok(event) => event,
+            Err(e) => {
+                tracing::warn!("[login] signer login failed: {e:#}");
+                anyhow::bail!(public_login_error(&e));
+            }
+        };
+        let approval = asked.elapsed();
+        // Checked when the reply arrives, not when the browser next polls.
+        if let Err(e) = verify_login_event(&event, &pubkey, &challenge, Timestamp::now()) {
+            tracing::warn!("[login] signer login reply refused: {e:#}");
+            anyhow::bail!(PUBLIC_REFUSED);
+        }
+        Ok(Approval {
+            signer: enrolled,
+            approval,
+        })
+    })?;
+    Ok((started, code))
+}
+
+/// Poll a login. `cookie` is the attempt's binding cookie, `session` the
+/// caller's session cookie (a pending 2FA session for a 2FA login).
+pub async fn finish(
+    attempts: &LoginAttempts,
+    attempt_id: &str,
+    cookie: Option<&str>,
+    session: Option<&str>,
+) -> Result<Option<Finished>> {
+    attempts
+        .finish(attempt_id, Purpose::Login, cookie, session)
+        .await
+}
+
+/// Start enrolling a linked identity for login: check the password again,
+/// then have its signer sign a login challenge, bound to the owner's
+/// session. Returns the attempt id and the code for the dashboard to show.
+/// The enrolment is saved when the signer approves.
+#[allow(clippy::too_many_arguments)]
+pub async fn enrol_start(
+    attempts: &Arc<LoginAttempts>,
+    auth: &AuthManager,
+    manager: Arc<IdentityManager>,
+    identity_id: &str,
+    password: &str,
+    session: &str,
+    relay: &str,
+    node_name: &str,
+) -> Result<(String, String)> {
+    if !auth.verify_password(password).await? {
+        anyhow::bail!("Password Incorrect");
+    }
+    let enrolled = auth.login_signers().await?;
+    if enrolled.iter().any(|s| s.identity_id == identity_id) {
+        anyhow::bail!("Already exists: this identity is already enrolled for login");
+    }
+    if !enrolled.is_empty() {
+        anyhow::bail!("Already exists: a signer is already enrolled for login; remove it first");
+    }
+    let linked = manager.linked_signer(identity_id).await?.ok_or_else(|| {
+        anyhow::anyhow!("Invalid identity: only an identity linked to a signer can log in")
+    })?;
+    let pubkey =
+        PublicKey::from_hex(&linked.user_pubkey).context("Invalid linked signer user key")?;
+    let challenge = LoginChallenge::new(relay, node_name)?;
+    let code = challenge.code.clone();
+    let auth = auth.clone();
+    let identity = identity_id.to_string();
+    let user_pubkey = linked.user_pubkey;
+    let slot = user_pubkey.clone();
+    let started = attempts.start(Purpose::Enrol, &slot, Some(session), async move {
+        let asked = Instant::now();
+        let event = manager
+            .sign_linked_event(&identity, challenge.unsigned(pubkey))
+            .await?;
+        let approval = asked.elapsed();
+        verify_login_event(&event, &pubkey, &challenge, Timestamp::now())?;
+        // The identity may have been re-linked or deleted during the press.
+        let still_linked = manager
+            .linked_signer(&identity)
+            .await
+            .ok()
+            .flatten()
+            .is_some_and(|linked| linked.user_pubkey == user_pubkey);
+        if !still_linked {
+            anyhow::bail!("Invalid identity: it is no longer linked to this signer");
+        }
+        let signer = LoginSigner {
+            identity_id: identity.clone(),
+            pubkey: user_pubkey,
+            added_at: chrono::Utc::now().to_rfc3339(),
+        };
+        auth.add_login_signer(signer.clone()).await?;
+        tracing::info!(identity = %identity, "Enrolled a linked signer for login");
+        Ok(Approval { signer, approval })
+    })?;
+    Ok((started.attempt_id, code))
+}
+
+/// Poll an enrolment started from `session`: the saved enrolment once the
+/// signer approves.
+pub async fn enrol_finish(
+    attempts: &LoginAttempts,
+    attempt_id: &str,
+    session: &str,
+) -> Result<Option<Approval>> {
+    Ok(attempts
+        .finish(attempt_id, Purpose::Enrol, None, Some(session))
+        .await?
+        .map(|finished| finished.approval))
+}
+
+/// Remove an identity's login enrolment after re-checking the password. The
+/// password itself always keeps working.
+pub async fn remove(auth: &AuthManager, identity_id: &str, password: &str) -> Result<bool> {
+    if !auth.verify_password(password).await? {
+        anyhow::bail!("Password Incorrect");
+    }
+    let removed = auth.remove_login_signer(identity_id).await?;
+    if removed {
+        tracing::info!(identity = %identity_id, "Removed a login signer");
+    }
+    Ok(removed)
+}
