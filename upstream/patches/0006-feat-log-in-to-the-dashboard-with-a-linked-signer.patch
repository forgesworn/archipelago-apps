+        let response = apply(&handler, "auth.login.signer.start", &mut resp, None).await;
+        let set = cookies(&response);
+        let binding = set
+            .iter()
+            .find(|c| c.starts_with(&format!("{ATTEMPT_COOKIE}=")))
+            .expect("binding cookie");
+        assert!(binding.starts_with(&format!("{ATTEMPT_COOKIE}=secret-binding;")));
+        for attribute in ["HttpOnly", "SameSite=Strict", "Path=/rpc/", "Max-Age=120"] {
+            assert!(binding.contains(attribute), "{binding}");
+        }
+        // No session yet, and the token is not in the body.
+        assert!(cookie_value(&set, "session").is_none());
+        let body = body(response).await;
+        assert_eq!(body["result"]["code"], "0421");
