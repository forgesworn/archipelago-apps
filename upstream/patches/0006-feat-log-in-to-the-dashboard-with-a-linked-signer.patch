+        let attempts = attempts();
+        let (attempt_id, _) = enrol_start(
+            &attempts,
+            &node.auth,
+            node.manager.clone(),
+            &node.record.id,
+            PASSWORD,
+            "owner-session",
+            RELAY,
+            "my node",
+        )
+        .await
+        .unwrap();
+        tokio::time::sleep(Duration::from_millis(50)).await;
+        assert!(node.auth.login_signers().await.unwrap().is_empty());
+        // Another session cannot finish it.
+        let refused = enrol_finish(&attempts, &attempt_id, "someone-else")
+            .await
+            .unwrap_err();
+        assert_eq!(refused.to_string(), OTHER_BROWSER);
+        node.signer.release();
+        let approval = loop {
+            if let Some(a) = enrol_finish(&attempts, &attempt_id, "owner-session")
+                .await
+                .unwrap()
+            {
+                break a;
+            }
+        };
+        assert_eq!(
+            node.auth.login_signers().await.unwrap(),
+            vec![approval.signer]
+        );
+    }
