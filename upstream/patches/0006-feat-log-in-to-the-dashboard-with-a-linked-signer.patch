+    #[tokio::test(start_paused = true)]
+    async fn login_starts_have_a_node_wide_budget() {
+        let attempts = Arc::new(LoginAttempts::default());
+        // Different signers, so the one-pending rule is not what refuses.
+        for i in 0..START_BUDGET {
+            attempts
+                .start(Purpose::Login, &format!("signer {i}"), None, never())
+                .unwrap();
+        }
+        let refused = attempts
+            .start(Purpose::Login, "another", None, never())
+            .unwrap_err();
+        assert_eq!(refused.to_string(), PAUSED);
+        // Enrolments, which need the owner's session, are not budgeted.
+        attempts
+            .start(Purpose::Enrol, "enrolling", Some("session"), never())
+            .unwrap();
+        tokio::time::sleep(START_WINDOW).await;
+        // The window has passed, but the three unanswered logins expired at
+        // two minutes, and each counts as a failure: still backing off.
+        assert_eq!(
+            attempts
+                .start(Purpose::Login, "another", None, never())
+                .unwrap_err()
+                .to_string(),
+            PAUSED
+        );
+        tokio::time::sleep(ATTEMPT_TTL).await;
+        attempts
+            .start(Purpose::Login, "another", None, never())
+            .unwrap();
+    }
