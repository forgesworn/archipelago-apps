+    #[tokio::test(start_paused = true)]
+    async fn the_owner_can_see_who_started_logins_and_what_became_of_them() {
+        let attempts = Arc::new(LoginAttempts::default());
+        let lan: IpAddr = "192.0.2.7".parse().unwrap();
+        let approved = attempts
+            .start_from(Purpose::Login, "a", None, Some(lan), approve())
+            .unwrap();
+        attempts
+            .start_from(Purpose::Login, "b", None, Some(lan), deny())
+            .unwrap();
+        attempts
+            .start_from(Purpose::Login, "c", None, Some(lan), never())
+            .unwrap();
+        tokio::time::sleep(Duration::from_millis(1)).await;
+        // Busy, then out of budget (and backing off after the denial).
+        assert!(attempts
+            .start_from(Purpose::Login, "c", None, Some(lan), never())
+            .is_err());
+        assert!(attempts
+            .start_from(Purpose::Login, "d", None, Some(lan), never())
+            .is_err());
+        // Enrolments are not login starts.
