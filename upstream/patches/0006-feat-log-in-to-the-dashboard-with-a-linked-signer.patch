+    #[tokio::test(start_paused = true)]
+    async fn an_attempt_expires_after_two_minutes() {
+        let attempts = attempts();
+        let started = attempts
+            .start(Purpose::Login, "signer", None, never())
+            .unwrap();
+        let mut polls = 0;
+        let error = loop {
+            match finish_cookie(&attempts, &started).await {
+                Ok(None) => polls += 1,
+                Ok(Some(_)) => panic!("approved without a signer"),
+                Err(e) => break e,
+            }
+        };
+        // The poll that reaches the deadline reports the expiry (or, if its
+        // own timer fires first, that the attempt is gone).
+        assert!(
+            [EXPIRED, GONE].contains(&error.to_string().as_str()),
+            "{error}"
+        );
+        assert_eq!(polls, 11);
+        let gone = finish_cookie(&attempts, &started).await.unwrap_err();
+        assert_eq!(gone.to_string(), GONE);
+    }
