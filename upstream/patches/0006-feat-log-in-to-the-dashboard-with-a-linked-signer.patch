+    // ── Through a linked identity ───────────────────────────────────────
+
+    struct Node {
+        _dir: tempfile::TempDir,
+        auth: AuthManager,
+        manager: Arc<IdentityManager>,
+        signer: Arc<FakeSigner>,
+        record: IdentityRecord,
+    }
+
+    /// A node with a password and one identity linked to `signer`.
+    async fn node_with(signer: FakeSigner) -> Node {
+        let dir = tempfile::tempdir().unwrap();
+        let auth = AuthManager::new(dir.path().to_path_buf());
+        auth.setup_user(PASSWORD).await.unwrap();
+        let signer = Arc::new(signer);
+        let manager = IdentityManager::with_remote_signers(
+            dir.path(),
+            Arc::new(FakeSource(signer.clone())),
+            Arc::new(RemoteRequests::default()),
+        )
+        .await
+        .unwrap();
+        let uri = crate::remote_signer::parse_bunker_uri(&format!(
+            "bunker://{}?relay=wss://relay.example.com",
+            Keys::generate().public_key().to_hex()
+        ))
+        .unwrap();
+        // A gated signer lets the linking proof through.
+        signer.release();
+        let record = manager
+            .create_linked(
+                "Signer".to_string(),
+                IdentityPurpose::Personal,
+                &uri,
+                &Keys::generate(),
+                signer.as_ref(),
+                None,
+            )
+            .await
+            .unwrap();
+        signer.calls.store(0, std::sync::atomic::Ordering::SeqCst);
+        Node {
+            _dir: dir,
+            auth,
+            manager: Arc::new(manager),
+            signer,
+            record,
+        }
+    }
+
+    async fn node() -> Node {
+        node_with(FakeSigner::new(Keys::generate(), FakeMode::Honest)).await
+    }
+
+    async fn enrol_through(
+        node: &Node,
+        attempts: &Arc<LoginAttempts>,
+        password: &str,
+    ) -> Result<Approval> {
+        let (attempt_id, code) = enrol_start(
+            attempts,
+            &node.auth,
+            node.manager.clone(),
+            &node.record.id,
+            password,
+            "owner-session",
+            RELAY,
+            "my node",
+        )
+        .await?;
+        assert_eq!(code.len(), 4);
+        loop {
+            if let Some(approval) = enrol_finish(attempts, &attempt_id, "owner-session").await? {
+                return Ok(approval);
+            }
+        }
+    }
+
+    async fn enrolled() -> Node {
+        let node = node().await;
+        enrol_through(&node, &attempts(), PASSWORD).await.unwrap();
+        node.signer
+            .calls
+            .store(0, std::sync::atomic::Ordering::SeqCst);
+        node
+    }
+
+    async fn login_through(node: &Node, pending: Option<&str>) -> Result<Option<Finished>> {
+        let attempts = attempts();
+        let (started, code) = start(
+            &attempts,
+            &node.auth,
+            node.manager.clone(),
+            RELAY,
+            "my node",
+            pending,
+            None,
+        )
+        .await?;
+        assert_eq!(code.len(), 4);
+        finish(
+            &attempts,
+            &started.attempt_id,
+            started.binding.as_deref(),
+            pending,
+        )
+        .await
+    }
+
+    #[tokio::test]
+    async fn enrolment_runs_a_live_challenge_and_is_saved() {
+        let node = node().await;
+        assert!(!available(&node.auth).await.unwrap());
+        let approval = enrol_through(&node, &attempts(), PASSWORD).await.unwrap();
+        assert_eq!(node.signer.calls(), 1);
+        assert_eq!(approval.signer.identity_id, node.record.id);
+        assert_eq!(
+            approval.signer.pubkey,
+            node.signer.keys.public_key().to_hex()
+        );
+        // The fake answers at once: just what the warning is for.
+        assert!(approval.approval < QUICK_APPROVAL);
+        assert_eq!(
+            node.auth.login_signers().await.unwrap(),
+            vec![approval.signer]
+        );
+        assert!(available(&node.auth).await.unwrap());
+    }
