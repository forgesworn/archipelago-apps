From f389e68b904e21dbd54343d4b71a61bac78efd11 Mon Sep 17 00:00:00 2001
From: TheCryptoDonkey <TheCryptoDonkey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 10:06:54 +0000
Subject: [PATCH] Preserve private node tmpfs in generated Quadlet units

---
 core/archipelago/src/container/quadlet.rs | 33 ++++++++++++++++++++++-
 1 file changed, 32 insertions(+), 1 deletion(-)

diff --git a/core/archipelago/src/container/quadlet.rs b/core/archipelago/src/container/quadlet.rs
index fad5b9c..c8e4d96 100644
--- a/core/archipelago/src/container/quadlet.rs
+++ b/core/archipelago/src/container/quadlet.rs
@@ -520,7 +520,26 @@ impl QuadletUnit {
             cap_drop_all: true,
             cap_add: app.security.capabilities.clone(),
             bind_mounts,
-            extra_podman_args: vec![],
+            // The private node relies on a small writable /tmp while its root
+            // remains read-only. Preserve its validated tmpfs declaration on
+            // the Quadlet path just as the direct runtime already does.
+            extra_podman_args: if app.id == "kithmoot-node" {
+                app.volumes
+                    .iter()
+                    .filter(|v| v.volume_type == "tmpfs")
+                    .map(|v| {
+                        format!(
+                            "--tmpfs={}:{}",
+                            v.target,
+                            v.tmpfs_options
+                                .as_deref()
+                                .unwrap_or("rw,nosuid,nodev,noexec,size=16m")
+                        )
+                    })
+                    .collect()
+            } else {
+                vec![]
+            },
             depends_on: vec![],
             health: app.health_check.as_ref().and_then(translate_health_check),
             ports: app
@@ -1905,6 +1924,18 @@ app:
         );
     }
 
+    #[test]
+    fn private_node_quadlet_keeps_memory_and_bounded_tmpfs() {
+        let yaml = "app:\n  id: kithmoot-node\n  name: Node\n  version: 1.0.0\n  container:\n    image: localhost/node:test\n  resources:\n    memory_limit: 256m\n  volumes:\n    - type: tmpfs\n      target: /tmp\n      tmpfs_options: rw,nosuid,nodev,noexec,size=16m,mode=1777\n";
+        let manifest = AppManifest::parse(yaml).unwrap();
+        let unit = QuadletUnit::from_manifest(&manifest, "kithmoot-node");
+        let rendered = unit.render();
+        assert!(rendered.contains("PodmanArgs=--memory=256m"));
+        assert!(
+            rendered.contains("PodmanArgs=--tmpfs=/tmp:rw,nosuid,nodev,noexec,size=16m,mode=1777")
+        );
+    }
+
     #[test]
     fn render_emits_health_directives_when_set() {
         let mut u = QuadletUnit::default();
-- 
