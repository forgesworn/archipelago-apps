Subject: [PATCH 36/36] Restore reviewed ingress for external Wildbloom apps

---
 core/archipelago/src/appgate/identity.rs | 173 +++++++++++++++++++++++
 1 file changed, 173 insertions(+)

diff --git a/core/archipelago/src/appgate/identity.rs b/core/archipelago/src/appgate/identity.rs
index ef1ef03..00e4e81 100644
--- a/core/archipelago/src/appgate/identity.rs
+++ b/core/archipelago/src/appgate/identity.rs
@@ -218,6 +218,24 @@ pub fn build_port_map() -> PortMap {
         }
     }
 
+    let data_dir = std::env::var_os("ARCHIPELAGO_DATA_DIR")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| PathBuf::from("/var/lib/archipelago"));
+    for (app_id, app_name, port, auth_enabled) in [
+        ("wildbloom", "Wildbloom", 3743, true),
+        ("wildbloom-node", "Wildbloom Node", 3742, false),
