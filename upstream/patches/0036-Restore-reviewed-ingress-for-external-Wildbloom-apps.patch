+    }
+
     // The operator's runtime override wins over the manifest default, in
     // both directions: un-gate an app that fronts its own login, or force
     // the challenge back onto an `auth: open` port. Overrides only toggle
@@ -234,6 +252,67 @@ pub fn build_port_map() -> PortMap {
     map
 }
 
+fn classify_retained_external(
+    data_dir: &std::path::Path,
+    app_id: &str,
+    app_name: &str,
+    port: u16,
+    auth_enabled: bool,
+    seen_apps: &std::collections::HashSet<String>,
+    map: &mut PortMap,
+) {
+    if seen_apps.contains(app_id) {
+        return;
+    }
+    let result = (|| -> anyhow::Result<()> {
+        let Some((body, _)) =
+            crate::container::supervised_update::installed_unit(data_dir, app_id)?
+        else {
+            return Ok(());
+        };
+        anyhow::ensure!(
+            body.lines()
+                .any(|line| line.trim() == format!("ContainerName={app_id}")),
+            "Preserved unit has a different container name"
+        );
+        let expected = format!("127.0.0.1:{port}:{port}/tcp");
+        let publishes: Vec<_> = body
+            .lines()
+            .filter_map(|line| line.trim().strip_prefix("PublishPort="))
+            .collect();
+        anyhow::ensure!(
+            publishes.len() == 1 && publishes[0] == expected,
+            "Preserved unit does not have the reviewed loopback-only UI publish"
+        );
+        map.declared_auth.insert(
+            (app_id.to_string(), port),
+            if auth_enabled {
+                PortAuth::Gated
+            } else {
+                PortAuth::Open
+            },
+        );
+        map.gated.insert(
+            port,
+            GatedPort {
+                guest_access: false,
+                port,
+                app_id: app_id.to_string(),
+                app_name: app_name.to_string(),
+                icon: None,
+                declared: true,
+                session_passthrough: false,
+                auth_enabled,
+                turn_upstream: None,
+            },
+        );
+        Ok(())
+    })();
+    if let Err(error) = result {
+        tracing::warn!(app_id, error = %error, "Cannot restore reviewed external app ingress");
+    }
+}
+
 #[cfg(test)]
 pub(super) fn test_port_map(port: GatedPort) -> PortMap {
     let mut map = PortMap::default();
@@ -473,6 +552,89 @@ mod tests {
         assert_eq!(map.declared_auth("otherapp", 8090), None);
     }
 
+    fn retained_record(root: &std::path::Path, app_id: &str, publish: &str) {
+        let directory = root.join("update-transactions/installed-units");
+        std::fs::create_dir_all(&directory).unwrap();
+        let body = format!("[Container]\nContainerName={app_id}\n{publish}\n");
+        std::fs::write(
+            directory.join(format!("{app_id}.json")),
+            serde_json::to_vec(&serde_json::json!({
+                "schema": 1,
+                "operation": "00000000-0000-0000-0000-000000000000",
+                "name": app_id,
+                "body": body,
+                "mode": 0o600,
+            }))
+            .unwrap(),
+        )
+        .unwrap();
+    }
+
+    #[test]
+    fn retained_external_apps_restore_only_their_reviewed_ingress() {
+        let root = tempfile::tempdir().unwrap();
+        retained_record(
+            root.path(),
+            "wildbloom",
+            "PublishPort=127.0.0.1:3743:3743/tcp",
+        );
+        retained_record(
+            root.path(),
+            "wildbloom-node",
+            "PublishPort=127.0.0.1:3742:3742/tcp",
+        );
+        let mut map = PortMap::default();
+        let seen = std::collections::HashSet::new();
+        classify_retained_external(
+            root.path(),
+            "wildbloom",
+            "Wildbloom",
+            3743,
+            true,
+            &seen,
+            &mut map,
+        );
+        classify_retained_external(
+            root.path(),
+            "wildbloom-node",
+            "Wildbloom Node",
+            3742,
+            false,
+            &seen,
+            &mut map,
+        );
+        let ui = map.gated(3743).unwrap();
+        assert!(ui.declared && ui.auth_enabled);
+        assert_eq!(map.declared_auth("wildbloom", 3743), Some("gated"));
+        let api = map.gated(3742).unwrap();
+        assert!(api.declared && !api.auth_enabled);
+        assert_eq!(map.declared_auth("wildbloom-node", 3742), Some("open"));
+    }
+
+    #[test]
+    fn retained_external_apps_refuse_changed_or_ambiguous_publishes() {
+        for publish in [
+            "PublishPort=0.0.0.0:3743:3743/tcp",
+            "PublishPort=127.0.0.1:3743:80/tcp",
+            "PublishPort=127.0.0.1:3743:3743/tcp\nPublishPort=127.0.0.1:8080:8080/tcp",
+        ] {
+            let root = tempfile::tempdir().unwrap();
+            retained_record(root.path(), "wildbloom", publish);
+            let mut map = PortMap::default();
+            classify_retained_external(
+                root.path(),
+                "wildbloom",
+                "Wildbloom",
+                3743,
+                true,
+                &std::collections::HashSet::new(),
+                &mut map,
+            );
+            assert!(map.gated(3743).is_none());
+            assert_eq!(map.declared_auth("wildbloom", 3743), None);
+        }
+    }
+
     fn manifest(yaml: &str) -> AppManifest {
         AppManifest::parse(yaml).expect("test manifest must parse")
     }
