From 49d4a0ed769777a3a1938ef31c3fc4a1148308e5 Mon Sep 17 00:00:00 2001
From: TheCryptoDonkey <TheCryptoDonkey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 15:54:54 +0000
Subject: [PATCH 32/32] Adapt compatibility tests and routing to beta APIs and
 catalogue policy

---
 core/Cargo.lock                                            | 7 +++----
 core/archipelago/src/api/rpc/dispatcher.rs                 | 2 +-
 core/node-ingress-tests/Cargo.toml                         | 6 ++----
 .../src/views/discover/__tests__/bundleCatalogue.test.ts   | 6 ++----
 neode-ui/src/views/discover/curatedApps.ts                 | 4 ++--
 5 files changed, 10 insertions(+), 15 deletions(-)

diff --git a/core/Cargo.lock b/core/Cargo.lock
index 998b3e8..20f521b 100644
--- a/core/Cargo.lock
+++ b/core/Cargo.lock
@@ -146,8 +146,8 @@ dependencies = [
  "reed-solomon-erasure",
  "regex",
  "reqwest 0.12.28",
- "rustls-pki-types",
  "rusqlite",
+ "rustls-pki-types",
  "sd-notify",
  "serde",
  "serde_bytes",
@@ -205,11 +205,10 @@ name = "archipelago-node-ingress-tests"
 version = "0.1.0"
 dependencies = [
  "archipelago-container",
- "rustls-pemfile",
- "rustls-webpki 0.101.7",
+ "rustls-pki-types",
  "tempfile",
  "tokio",
- "tokio-rustls 0.24.1",
+ "tokio-rustls",
  "tracing",
 ]
 
diff --git a/core/archipelago/src/api/rpc/dispatcher.rs b/core/archipelago/src/api/rpc/dispatcher.rs
index ceb16dc..eda7f87 100644
--- a/core/archipelago/src/api/rpc/dispatcher.rs
+++ b/core/archipelago/src/api/rpc/dispatcher.rs
@@ -165,7 +165,7 @@ impl RpcHandler {
                     "issuer_id": "moneyer-dev"
                 })))
                 .await
-            }
+            },
             "package.credentials" => self.handle_package_credentials(params).await,
             "app.filebrowser-token" => self.handle_filebrowser_token().await,
             "cloud.sources.list"
diff --git a/core/node-ingress-tests/Cargo.toml b/core/node-ingress-tests/Cargo.toml
index 348cc0f..e6c4c24 100644
--- a/core/node-ingress-tests/Cargo.toml
+++ b/core/node-ingress-tests/Cargo.toml
@@ -8,14 +8,12 @@ license.workspace = true
 [dependencies]
 archipelago-container = { path = "../container" }
 tokio = { version = "1", features = ["full"] }
-tokio-rustls = "0.24"
-rustls-pemfile = "1.0"
-webpki = { package = "rustls-webpki", version = "0.101" }
+tokio-rustls = { version = "0.26", default-features = false, features = ["ring", "tls12", "logging"] }
+rustls-pki-types = { version = "1", features = ["std"] }
 tracing = "0.1"
 
 [dev-dependencies]
 tempfile = "3.10"
-tokio-rustls = { version = "0.24", features = ["dangerous_configuration"] }
 
 [[bin]]
 name = "node-ingress-fixture"
diff --git a/neode-ui/src/views/discover/__tests__/bundleCatalogue.test.ts b/neode-ui/src/views/discover/__tests__/bundleCatalogue.test.ts
index 81fe542..e9c5e95 100644
--- a/neode-ui/src/views/discover/__tests__/bundleCatalogue.test.ts
+++ b/neode-ui/src/views/discover/__tests__/bundleCatalogue.test.ts
@@ -2,7 +2,7 @@ import { afterEach, expect, it, vi } from 'vitest'
 
 afterEach(() => { vi.unstubAllGlobals(); vi.unstubAllEnvs(); vi.resetModules() })
 
-it('loads a bundled relay beside signed apps without replacing signed image pins', async () => {
+it('keeps unsigned bundle additions out of the beta store and preserves signed image pins', async () => {
   vi.resetModules()
   vi.stubEnv('VITE_CATALOGUE_REVISION', 'new-bundle')
   vi.stubGlobal('fetch', vi.fn(async (url: string) => {
@@ -19,9 +19,7 @@ it('loads a bundled relay beside signed apps without replacing signed image pins
   const { APP_CATALOG_CACHE_KEY, fetchAppCatalog } = await import('../curatedApps')
   expect(APP_CATALOG_CACHE_KEY).not.toBe('app-catalog')
   const catalogue = await fetchAppCatalog()
-  expect(catalogue?.apps.find(app => app.id === 'spry')).toMatchObject({
-    title: 'Spry', dockerImage: 'ghcr.io/forgesworn/spry:0.1.0-2efb051-2', source: 'forgesworn-bundle',
-  })
+  expect(catalogue?.apps.find(app => app.id === 'spry')).toBeUndefined()
   expect(catalogue?.apps.find(app => app.id === 'fixture-app')).toMatchObject({
     title: 'Fixture', version: '2', dockerImage: 'fixture/app@sha256:verified',
   })
diff --git a/neode-ui/src/views/discover/curatedApps.ts b/neode-ui/src/views/discover/curatedApps.ts
index 8987fd2..9957691 100644
--- a/neode-ui/src/views/discover/curatedApps.ts
+++ b/neode-ui/src/views/discover/curatedApps.ts
@@ -7,8 +7,8 @@ const R = 'source.archipelago-foundation.org/lfg2025'
 // A newly installed bundle must not reuse a previous catalogue's persisted
 // session entry. Leave unrelated session data and owner credentials intact.
 export const APP_CATALOG_CACHE_KEY = import.meta.env.VITE_CATALOGUE_REVISION
-  ? `app-catalog:${import.meta.env.VITE_CATALOGUE_REVISION}`
-  : 'app-catalog'
+  ? `authenticated-app-catalog:${import.meta.env.VITE_CATALOGUE_REVISION}`
+  : 'authenticated-app-catalog'
 
 // ---------- Dynamic catalog from registry ----------
 export interface CatalogFeatured {
