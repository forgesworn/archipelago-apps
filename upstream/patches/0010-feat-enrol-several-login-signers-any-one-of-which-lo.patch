+    #[tokio::test]
+    async fn up_to_five_login_signers_are_kept_in_order() {
+        let dir = tempfile::tempdir().unwrap();
+        let auth = AuthManager::new(dir.path().to_path_buf());
+        auth.setup_user("password123").await.unwrap();
+        let ids = ["a", "b", "c", "d", "e"];
+        for id in ids {
+            auth.add_login_signer(login_signer(id)).await.unwrap();
+        }
+        let kept: Vec<LoginSigner> = ids.iter().map(|id| login_signer(id)).collect();
+        assert_eq!(auth.login_signers().await.unwrap(), kept);
+        let sixth = auth.add_login_signer(login_signer("f")).await.unwrap_err();
+        assert_eq!(sixth.to_string(), LOGIN_SIGNERS_FULL);
+        assert_eq!(auth.login_signers().await.unwrap(), kept);
+        // Removing one makes room again; the others stay.
+        assert!(auth.remove_login_signer("c").await.unwrap());
+        auth.add_login_signer(login_signer("f")).await.unwrap();
+        let ids: Vec<String> = auth
+            .login_signers()
+            .await
+            .unwrap()
+            .into_iter()
+            .map(|s| s.identity_id)
+            .collect();
+        assert_eq!(ids, ["a", "b", "d", "e", "f"]);
+    }
+
+    #[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+    async fn concurrent_login_signer_changes_are_not_lost() {
+        let dir = tempfile::tempdir().unwrap();
+        let auth = AuthManager::new(dir.path().to_path_buf());
+        auth.setup_user("password123").await.unwrap();
+        for round in 0..20 {
+            // Different handles for the same data dir, as the node has.
+            let other = AuthManager::new(dir.path().to_path_buf());
+            let (a, b) = (format!("a{round}"), format!("b{round}"));
+            let add_a = tokio::spawn({
+                let auth = auth.clone();
+                let a = a.clone();
+                async move { auth.add_login_signer(login_signer(&a)).await }
+            });
+            let add_b = tokio::spawn({
+                let b = b.clone();
+                async move { other.add_login_signer(login_signer(&b)).await }
+            });
+            add_a.await.unwrap().unwrap();
+            add_b.await.unwrap().unwrap();
+            let ids: Vec<String> = auth
+                .login_signers()
+                .await
+                .unwrap()
+                .into_iter()
+                .map(|s| s.identity_id)
+                .collect();
+            assert!(
+                ids.contains(&a) && ids.contains(&b),
+                "round {round}: {ids:?}"
+            );
+
+            // A removal racing an add: the removed one stays gone.
+            let remove_a = tokio::spawn({
+                let auth = auth.clone();
+                async move { auth.remove_login_signer(&a).await }
+            });
+            let add_c = tokio::spawn({
+                let auth = auth.clone();
+                let c = format!("c{round}");
+                async move { auth.add_login_signer(login_signer(&c)).await }
+            });
+            assert!(remove_a.await.unwrap().unwrap());
+            add_c.await.unwrap().unwrap();
+            let ids: Vec<String> = auth
+                .login_signers()
+                .await
+                .unwrap()
+                .into_iter()
+                .map(|s| s.identity_id)
+                .collect();
+            assert_eq!(ids, [b.clone(), format!("c{round}")], "round {round}");
+            assert!(auth.remove_login_signer(&b).await.unwrap());
+            assert!(auth
+                .remove_login_signer(&format!("c{round}"))
+                .await
+                .unwrap());
+        }
+        assert!(auth.verify_password("password123").await.unwrap());
+    }
