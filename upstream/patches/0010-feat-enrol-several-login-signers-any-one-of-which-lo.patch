+    #[tokio::test]
+    async fn a_login_still_waiting_on_a_signer_at_its_deadline_expires() {
+        let node = node_with_several(vec![honest(), gated()]).await;
+        node.set_modes(&[FakeMode::Deny]);
+        node.enrol_all().await;
+        let attempts = Arc::new(LoginAttempts::default());
+        let started = node.start(&attempts).await.unwrap();
+        until_asked(&node).await;
+        tokio::time::sleep(Duration::from_millis(50)).await;
+        // The denial is in; the second signer never answers.
+        assert_eq!(attempts.status().recent[0].outcome, "pending");
+        tokio::time::pause();
+        let error = loop {
+            match finish_cookie(&attempts, &started).await {
+                Ok(None) => {}
+                Ok(Some(_)) => panic!("approved without a signer"),
+                Err(e) => break e,
+            }
+        };
+        // As for one signer: the expiry, or that the attempt is gone if the
+        // poll's own timer fires first.
+        assert!(
+            [EXPIRED, GONE].contains(&error.to_string().as_str()),
+            "{error}"
+        );
+        // Let the attempt's own task, due at the same instant, settle.
+        tokio::time::sleep(Duration::from_secs(1)).await;
+        assert_eq!(attempts.status().recent[0].outcome, "expired");
+        assert_eq!(lock(&attempts.budget).failures, 1);
+    }
