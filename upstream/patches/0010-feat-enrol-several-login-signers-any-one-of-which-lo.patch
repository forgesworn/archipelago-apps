+    /// Hands each linked identity the fake holding its key.
+    #[derive(Default)]
+    struct ByKey(Mutex<Vec<Arc<FakeSigner>>>);
+
+    impl RemoteSignerSource for ByKey {
+        fn open(&self, _identity_id: &str, linked: &LinkedSigner) -> Result<Arc<dyn RemoteSigner>> {
+            let fake = lock(&self.0)
+                .iter()
+                .find(|f| f.keys.public_key().to_hex() == linked.user_pubkey)
+                .cloned()
+                .ok_or_else(|| anyhow::anyhow!("no fake signer for this key"))?;
+            Ok(fake)
+        }
+    }
