+    struct Several {
+        _dir: tempfile::TempDir,
+        auth: AuthManager,
+        manager: Arc<IdentityManager>,
+        linked: Vec<Linked>,
+    }
+
+    /// A node with a password and one linked identity per fake, none of
+    /// them enrolled yet.
+    async fn node_with_several(fakes: Vec<FakeSigner>) -> Several {
+        let dir = tempfile::tempdir().unwrap();
+        let auth = AuthManager::new(dir.path().to_path_buf());
+        auth.setup_user(PASSWORD).await.unwrap();
+        let source = Arc::new(ByKey::default());
+        let manager = IdentityManager::with_remote_signers(
+            dir.path(),
+            source.clone(),
+            Arc::new(RemoteRequests::default()),
+        )
+        .await
+        .unwrap();
+        let mut linked = Vec::new();
+        for (i, fake) in fakes.into_iter().enumerate() {
+            let signer = Arc::new(fake);
+            lock(&source.0).push(signer.clone());
+            let uri = crate::remote_signer::parse_bunker_uri(&format!(
+                "bunker://{}?relay=wss://relay.example.com",
+                Keys::generate().public_key().to_hex()
+            ))
+            .unwrap();
+            signer.release();
+            let record = manager
+                .create_linked(
+                    format!("Signer {i}"),
+                    IdentityPurpose::Personal,
+                    &uri,
+                    &Keys::generate(),
+                    signer.as_ref(),
+                    None,
+                )
+                .await
+                .unwrap();
+            signer.calls.store(0, std::sync::atomic::Ordering::SeqCst);
+            linked.push(Linked { signer, record });
+        }
+        Several {
+            _dir: dir,
+            auth,
+            manager: Arc::new(manager),
+            linked,
+        }
