+let gapTimer: ReturnType<typeof setTimeout> | undefined
+let wake: (() => void) | undefined
+let copiedTimer: ReturnType<typeof setTimeout> | undefined
+
+function stopPolling() {
+  session++
+  controller?.abort()
+  controller = null
+  clearTimeout(expiryTimer)
+  clearTimeout(gapTimer)
+  wake?.()
+  wake = undefined
+}
+
+function resetPairing() {
+  stopPolling()
+  pairPhase.value = 'idle'
+  starting.value = false
+  pairUri.value = ''
+  qr.value = ''
+  pairError.value = ''
+  reveal.value = false
+}
+
+function setMode(next: 'scan' | 'paste') {
+  if (busy.value || mode.value === next) return
+  resetPairing()
+  error.value = ''
+  reveal.value = false
+  mode.value = next
+}
+
+function failPairing(message: string) {
+  stopPolling()
+  pairError.value = message
+  pairPhase.value = 'failed'
+}
+
+function pause(ms: number): Promise<void> {
+  return new Promise(resolve => {
+    wake = resolve
+    gapTimer = setTimeout(resolve, ms)
+  })
+}
+
+async function startScan() {
+  if (starting.value || !name.value.trim()) return
+  resetPairing()
+  starting.value = true
+  const mine = session
+  try {
+    const pairing = await signerApi.linkNostrconnectStart(name.value.trim())
+    if (mine !== session) return
+    pairUri.value = pairing.uri
+    try {
+      qr.value = await QRCode.toDataURL(pairing.uri, { margin: 2, width: 240 })
+    } catch {
+      qr.value = '' // the link and Copy button still work
+    }
+    if (mine !== session) return
+    pairPhase.value = 'waiting'
+    expiryTimer = setTimeout(() => void expire(pairing.pairing_id, mine), PAIRING_LIFETIME_MS)
+    void poll(pairing.pairing_id, mine)
+  } catch (err) {
+    if (mine !== session) return
+    const msg = err instanceof Error ? err.message : ''
+    if (err instanceof NoPairingRelayError) {
+      // Nothing to scan without a relay: pasting a link still works.
+      mode.value = 'paste'
+      error.value = t('signer.link.noRelay')
+    } else {
+      pairError.value = msg || t('signer.link.failed')
+    }
+  } finally {
+    if (mine === session) starting.value = false
+  }
+}
+
+/** The code's time is up. The signer may have connected during the last
+ *  poll gap, so ask once more before saying it expired. */
+async function expire(pairingId: string, mine: number) {
+  if (mine !== session) return
+  stopPolling()
+  const last = ++session
+  try {
+    const res = await signerApi.linkNostrconnectFinish(pairingId)
+    if (last !== session) return
+    if (res.status === 'linked') {
+      resetPairing()
+      emit('linked', res.identity)
+      return
+    }
+  } catch {
+    if (last !== session) return
+  }
+  failPairing(t('signer.link.pairExpired'))
+}
+
+async function poll(pairingId: string, mine: number) {
+  controller = new AbortController()
+  let failures = 0
+  while (mine === session) {
+    try {
+      const res = await signerApi.linkNostrconnectFinish(pairingId, controller.signal)
+      if (mine !== session) return
+      failures = 0
+      if (res.status === 'linked') {
+        resetPairing()
+        emit('linked', res.identity)
+        return
+      }
+    } catch (err) {
+      if (mine !== session) return
+      const msg = err instanceof Error ? err.message : ''
+      // A slow poll is not a failed pairing: the expiry timer bounds the wait.
+      if (!/timeout/i.test(msg) && ++failures >= MAX_POLL_FAILURES) return failPairing(msg || t('signer.link.pairFailed'))
+    }
+    await pause(POLL_GAP_MS)
+  }
+}
+
+/** Abandons the pairing: the node's copy simply lapses. */
+function cancelPairing() {
+  resetPairing()
+}
+
+async function copyLink() {
+  await safeClipboardWrite(pairUri.value)
+  copied.value = true
+  clearTimeout(copiedTimer)
+  copiedTimer = setTimeout(() => { copied.value = false }, 2000)
+}
+
+onBeforeUnmount(() => {
+  stopPolling()
+  clearTimeout(copiedTimer)
+})
 </script>
diff --git a/neode-ui/src/components/signer/LinkedSignerLoginOffer.vue b/neode-ui/src/components/signer/LinkedSignerLoginOffer.vue
new file mode 100644
index 0000000..a325105
--- /dev/null
+++ b/neode-ui/src/components/signer/LinkedSignerLoginOffer.vue
@@ -0,0 +1,100 @@
+<template>
+  <div class="space-y-4" data-testid="linked-signer-offer">
+    <template v-if="!started">
+      <p class="text-sm text-green-300" role="status">{{ t('signer.link.linkedBody', { name: identity.name }) }}</p>
+      <form v-if="askPassword" class="space-y-4" @submit.prevent="enrol">
+        <div>
+          <label for="offer-signer-password" class="block text-sm font-medium text-white/80 mb-2">{{ t('signer.settings.password') }}</label>
+          <input
+            id="offer-signer-password"
+            v-model="password"
+            type="password"
+            required
+            autocomplete="current-password"
+            class="w-full px-3 py-2 rounded-lg bg-white/10 text-white border border-white/20 focus:border-orange-500 focus:ring-1 focus:ring-orange-500"
+          />
+        </div>
+        <p v-if="error" class="text-sm text-red-400" role="alert">{{ error }}</p>
+        <div class="flex gap-3">
+          <button
+            type="submit"
+            :disabled="!password"
+            class="flex-1 px-4 py-2 rounded-lg glass-button glass-button-warning font-medium disabled:opacity-50 disabled:cursor-not-allowed"
+          >{{ t('common.continue') }}</button>
+          <button type="button" class="px-4 py-2 rounded-lg glass-button font-medium" @click="emit('close')">{{ t('signer.link.notNow') }}</button>
+        </div>
+      </form>
+      <div v-else class="flex gap-3">
+        <button
+          type="button"
+          class="flex-1 px-4 py-2 rounded-lg glass-button glass-button-warning font-medium"
+          data-testid="use-signer-to-log-in"
+          @click="askPassword = true"
+        >{{ t('signer.link.useToLogin') }}</button>
+        <button type="button" class="px-4 py-2 rounded-lg glass-button font-medium" data-testid="linked-signer-not-now" @click="emit('close')">{{ t('signer.link.notNow') }}</button>
+      </div>
+    </template>
+    <template v-else>
+      <SignerEnrolProgress :approval="approval" />
+      <button
+        type="button"
+        class="w-full px-4 py-2 rounded-lg bg-white/10 text-white font-medium hover:bg-white/20 transition-colors"
+        data-testid="linked-signer-offer-close"
+        @click="cancelOrClose"
+      >{{ busy ? t('common.cancel') : (done ? t('signer.settings.done') : t('signer.settings.close')) }}</button>
+    </template>
+  </div>
+</template>
+
+<script setup lang="ts">
+import { computed, ref } from 'vue'
+import { useI18n } from 'vue-i18n'
+import { signerApi, type EnrolFinish, type LinkedIdentity } from '@/api/signer-login'
+import { useSignerApproval } from '@/composables/useSignerApproval'
+import SignerEnrolProgress from '@/components/signer/SignerEnrolProgress.vue'
+
+/** Offered right after a signer is linked: the same enrolment Settings uses,
+ *  for the identity that was just created. The password is held in memory only
+ *  and cleared once the enrolment has gone through (Try again needs it). */
+const props = defineProps<{ identity: LinkedIdentity }>()
+const emit = defineEmits<{ close: [] }>()
+const { t } = useI18n()
+
+const askPassword = ref(false)
+const password = ref('')
+const error = ref('')
+const started = ref(false)
+
+const approval = useSignerApproval<EnrolFinish>(
+  () => signerApi.enrolStart(props.identity.id, password.value),
+  (attemptId, signal) => signerApi.enrolFinish(attemptId, signal),
+  'enrolled',
+  { enrol: true },
+)
+
+const busy = computed(() => approval.phase.value === 'waiting' || approval.phase.value === 'starting')
+const done = computed(() => approval.phase.value === 'approved' || approval.late.value?.ok === true)
+
+async function enrol() {
+  if (!password.value) return
+  started.value = true
+  error.value = ''
+  const res = await approval.run()
+  if (res) password.value = ''
+  else if (approval.phase.value === 'failed' && !approval.reachedWaiting.value) {
+    // Refused before the signer was asked (wrong password, busy): back to the form.
+    started.value = false
+    error.value = approval.error.value
+  }
+}
+
+/** Cancel while the signer is being asked only hides the prompt; close ends it. */
+function cancelOrClose() {
+  if (busy.value) {
+    approval.cancel()
+    return
+  }
+  approval.reset()
+  emit('close')
+}
+</script>
