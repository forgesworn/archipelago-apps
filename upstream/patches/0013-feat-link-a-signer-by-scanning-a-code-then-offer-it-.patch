--- a/neode-ui/mock-backend.js
+++ b/neode-ui/mock-backend.js
@@ -2233,6 +2233,7 @@ app.post('/rpc/v1', async (req, res) => {
       //                            are refused as busy), paused (start refused)
       //   MOCK_SIGNER_QUICK=1      "approved too fast" enrolment warning
       //   MOCK_SIGNER_STATUS=      paused | foreign | pending | denied
+      //   MOCK_SIGNER_PAIR=expired a QR pairing fails instead of linking
       // Texts are the node's own fixed constants.
       case 'auth.login.signer.available': {
         return res.json({ result: mockSigner.enrolled.length > 0 && process.env.MOCK_SIGNER_2FA !== '1' })
@@ -2336,6 +2337,37 @@ app.post('/rpc/v1', async (req, res) => {
         return res.json({ result: mockSigner.link(String(name || 'My signer')) })
       }
 
+      // Pairing by QR: `start` hands back a link, `finish` answers pending for the
+      // first few polls and then links (MOCK_SIGNER_PAIR=expired makes it fail instead).
+      case 'identity.link-nostrconnect-start': {
+        const { name, relays } = params || {}
+        if (!name || !String(name).trim()) {
+          return res.json({ error: { code: -32603, message: 'Missing required parameter: name' } })
+        }
+        if (!Array.isArray(relays) || !relays.length || !relays.every(r => typeof r === 'string' && /^wss?:\/\//.test(r))) {
+          return res.json({ error: { code: -32603, message: 'Missing required parameter: relays' } })
+        }
+        const pairing_id = Math.random().toString(16).slice(2).padEnd(32, '0').slice(0, 32)
+        mockSigner.pairings.set(pairing_id, { name: String(name).trim(), polls: 0 })
+        const uri = `nostrconnect://${'ab'.repeat(32)}?${relays.map(r => `relay=${encodeURIComponent(r)}`).join('&')}&secret=mock${pairing_id.slice(0, 8)}&name=Archipelago`
+        return res.json({ result: { pairing_id, uri } })
+      }
+
+      case 'identity.link-nostrconnect-finish': {
+        const pairing = mockSigner.pairings.get(params?.pairing_id)
+        if (!pairing) {
+          return res.json({ error: { code: -32603, message: 'linked signer pairing is unknown or has expired' } })
+        }
+        await new Promise(r => setTimeout(r, 1000))
+        if (process.env.MOCK_SIGNER_PAIR === 'expired') {
+          mockSigner.pairings.delete(params.pairing_id)
+          return res.json({ error: { code: -32603, message: 'linked signer pairing is unknown or has expired' } })
+        }
+        if (++pairing.polls < 4) return res.json({ result: { status: 'pending' } })
+        mockSigner.pairings.delete(params.pairing_id)
+        return res.json({ result: { status: 'linked', identity: mockSigner.link(pairing.name) } })
+      }
+
       case 'auth.totp.status': {
         return res.json({ result: { enabled: false } })
       }
@@ -6261,6 +6293,8 @@ const mockSigner = {
   /** Login signers, first enrolled first; any one of them logs in. */
   enrolled: [],
   attempts: new Map(),
+  /** Open `nostrconnect://` pairings, by id. */
+  pairings: new Map(),
