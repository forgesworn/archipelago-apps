       ...i, origin: 'linked',
diff --git a/neode-ui/src/api/__tests__/signerLink.test.ts b/neode-ui/src/api/__tests__/signerLink.test.ts
new file mode 100644
index 0000000..1493873
--- /dev/null
+++ b/neode-ui/src/api/__tests__/signerLink.test.ts
@@ -0,0 +1,60 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+vi.mock('../rpc-client', () => ({ rpcClient: { call: vi.fn() } }))
+
+import { rpcClient } from '../rpc-client'
+import { NoPairingRelayError, signerApi } from '../signer-login'
+
+const call = vi.mocked(rpcClient.call)
+const relay = (url: string, connected = true, enabled = true) => ({ url, connected, enabled, added_at: 'x' })
+
+describe('signerApi.linkNostrconnectStart', () => {
+  beforeEach(() => call.mockReset())
+
+  it('pairs over the enabled wss:// relays, connected ones first', async () => {
+    call.mockResolvedValueOnce({
+      relays: [
+        relay('wss://down.example', false),
+        relay('ws://localhost:7777'),
+        relay('wss://off.example', true, false),
+        relay('wss://up.example'),
+      ],
+    })
+    call.mockResolvedValueOnce({ pairing_id: 'p1', uri: 'nostrconnect://x' })
+
+    await expect(signerApi.linkNostrconnectStart('Phone')).resolves.toEqual({ pairing_id: 'p1', uri: 'nostrconnect://x' })
+    expect(call).toHaveBeenLastCalledWith(expect.objectContaining({
+      method: 'identity.link-nostrconnect-start',
+      params: { name: 'Phone', relays: ['wss://up.example', 'wss://down.example'] },
+      maxRetries: 1,
+    }))
+  })
+
+  it('sends at most three relays, connected ones first', async () => {
+    call.mockResolvedValueOnce({ relays: [
+      relay('wss://a.example', false), relay('wss://b.example', false),
+      relay('wss://c.example'), relay('wss://d.example'), relay('wss://e.example', false),
+    ] })
+    call.mockResolvedValueOnce({ pairing_id: 'p1', uri: 'nostrconnect://x' })
+    await signerApi.linkNostrconnectStart('Phone')
+    const params = call.mock.calls[1]![0].params as { relays: string[] }
+    expect(params.relays).toEqual(['wss://c.example', 'wss://d.example', 'wss://a.example'])
+  })
+
+  it('refuses to start without a relay a signer could reach', async () => {
+    call.mockResolvedValueOnce({ relays: [relay('ws://localhost:7777')] })
+    await expect(signerApi.linkNostrconnectStart('Phone')).rejects.toBeInstanceOf(NoPairingRelayError)
+    expect(call).toHaveBeenCalledTimes(1)
+  })
+})
+
+describe('signerApi.linkNostrconnectFinish', () => {
+  it('polls the pairing with room for the node\'s ten second wait', async () => {
+    call.mockResolvedValueOnce({ status: 'pending' })
+    const signal = new AbortController().signal
+    await signerApi.linkNostrconnectFinish('p1', signal)
+    expect(call).toHaveBeenLastCalledWith({
+      method: 'identity.link-nostrconnect-finish', params: { pairing_id: 'p1' }, timeout: 20000, maxRetries: 1, signal,
+    })
+  })
+})
diff --git a/neode-ui/src/api/signer-login.ts b/neode-ui/src/api/signer-login.ts
index 1e9c043..079db2d 100644
--- a/neode-ui/src/api/signer-login.ts
+++ b/neode-ui/src/api/signer-login.ts
@@ -59,6 +59,28 @@ export interface SignerStatus {
   recent: SignerAttemptRecord[]
 }
 
+/** A `nostrconnect://` pairing: the signer scans `uri`, the node polls `pairing_id`. */
+export interface NostrconnectPairing {
+  pairing_id: string
+  uri: string
+}
+
+export type NostrconnectFinish = { status: 'pending' } | { status: 'linked'; identity: LinkedIdentity }
+
+/** The node gives up on a pairing after five minutes (`PAIRING_TTL`). */
+export const PAIRING_LIFETIME_MS = 5 * 60 * 1000
+/** The node takes up to eight, but each one lengthens the link and so the QR
+ *  code; three keeps it easy to scan. */
+const MAX_PAIRING_RELAYS = 3
+
+/** Thrown when the node has no relay a signer's device could reach. */
+export class NoPairingRelayError extends Error {
+  constructor() {
+    super('No public relay configured')
+    this.name = 'NoPairingRelayError'
+  }
+}
+
 /** Signer prompts are only accepted from the dashboard on port 80 or 443 (and,
  *  in development, a loopback host), so on any other port the signer options
  *  are hidden. */
@@ -162,6 +184,27 @@ export const signerApi = {
   status(): Promise<SignerStatus> {
     return rpcClient.call<SignerStatus>({ method: 'auth.signer.status', params: {}, maxRetries: 1 })
   },
+  /** Relays go in the link, so they must be ones the signer's device can reach:
+   *  the node's enabled `wss://` relays, connected ones first. */
+  async linkNostrconnectStart(name: string): Promise<NostrconnectPairing> {
+    const { relays } = await rpcClient.call<{ relays: Array<{ url: string; connected: boolean; enabled: boolean }> }>({
+      method: 'nostr.list-relays', params: {}, maxRetries: 1,
+    })
+    const urls = (relays ?? [])
+      .filter(r => r.enabled && r.url.startsWith('wss://'))
+      .sort((a, b) => Number(b.connected) - Number(a.connected))
+      .map(r => r.url)
+      .slice(0, MAX_PAIRING_RELAYS)
+    if (!urls.length) throw new NoPairingRelayError()
+    return rpcClient.call<NostrconnectPairing>({
+      method: 'identity.link-nostrconnect-start', params: { name, relays: urls }, maxRetries: 1,
+    })
+  },
+  linkNostrconnectFinish(pairingId: string, signal?: AbortSignal): Promise<NostrconnectFinish> {
+    return rpcClient.call<NostrconnectFinish>({
+      method: 'identity.link-nostrconnect-finish', params: { pairing_id: pairingId }, timeout: POLL_TIMEOUT_MS, maxRetries: 1, signal,
+    })
+  },
   linkBunker(bunkerUri: string, name: string): Promise<LinkedIdentity> {
     return rpcClient.call<LinkedIdentity>({
       method: 'identity.link-nip46', params: { bunker_uri: bunkerUri, name }, timeout: LINK_TIMEOUT_MS, maxRetries: 1,
