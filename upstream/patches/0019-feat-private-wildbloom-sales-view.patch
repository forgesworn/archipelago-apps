+        let before = std::fs::read(&db).unwrap();
+        let wal = db.with_file_name("checkout.sqlite3-wal");
+        let wal_before = std::fs::read(&wal).unwrap();
+        let value = f.read(PageRequest::default(), 100);
+        assert_eq!(value["orders"][0]["customer_pubkey"], "ab".repeat(32));
+        assert_eq!(value["orders"][0]["allowance"]["writes_until"], 200);
+        assert!(!value.to_string().contains("secret"));
+        assert!(!value.to_string().contains("invoice"));
