+        assert!(open(&db).is_err());
+        let link = f.root.path().join("link");
+        std::os::unix::fs::symlink(&db, &link).unwrap();
+        assert!(open(&link).is_err());
+        let dirlink = f.root.path().join("dirlink");
+        std::os::unix::fs::symlink(f.root.path(), &dirlink).unwrap();
+        assert!(read_at(&dirlink, false, &PageRequest::default(), 100).is_err());
+    }
+    #[test]
+    fn sales_reject_mismatched_allowances_and_oversized_records() {
+        let f = Fixture::new();
+        f.order("a", "active", true, None);
