+<script setup lang="ts">
+import { onBeforeUnmount, onMounted, ref } from 'vue'
+import { RouterLink } from 'vue-router'
+import { rpcClient } from '@/api/rpc-client'
+type Allowance = { capacity_bytes: number; starts_at: number; writes_until: number; retains_until: number; status: string }
+type Order = { order_id: string; state: string; customer_pubkey: string; rail: string; offer_id: string
+  price_msat: number; ordered_capacity_bytes: number; created_at: number; quote_expires_at: number; renews: string | null; allowance: Allowance | null }
+type Snapshot = { status: 'ready'; checked_at: number; summary: { orders: number; paid_orders: number; needs_attention: number; retained_customers: number; allocated_bytes: number }; orders: Order[]; next_after: string | null }
+type Result = Snapshot | { status: 'not_started' }
+const result = ref<Result | null>(null)
+const busy = ref(false), error = ref(''), filter = ref('')
+const cursors = ref(['']), page = ref(0)
+const controller = new AbortController()
+const size = (n: number) => n < 1024 ? `${n} B` : n < 2 ** 20 ? `${(n / 1024).toLocaleString(undefined, { maximumFractionDigits: 2 })} KiB`
+  : n < 2 ** 30 ? `${(n / 2 ** 20).toLocaleString(undefined, { maximumFractionDigits: 2 })} MiB` : `${(n / 2 ** 30).toLocaleString(undefined, { maximumFractionDigits: 2 })} GiB`
+const date = (seconds: number) => { const d = new Date(seconds * 1000); return Number.isFinite(d.getTime()) ? d.toLocaleString() : 'Unavailable' }
+const states: Record<string, string> = { reserving: 'Reservation pending', quoted: 'Unpaid quote', expired: 'Quote expired', invoice_pending: 'Invoice recovery needed', awaiting_payment: 'Awaiting payment', lnurl_pending: 'Payment outcome pending', settled: 'Paid · activation pending', active: 'Paid · allowance issued', refund_required: 'Refund review required' }
+const access: Record<string, string> = { scheduled: 'Term scheduled', active: 'Writes allowed', grace: 'Recovery grace', expired: 'Term expired' }
+function payment(order: Order) {
+  if (order.state === 'quoted' && result.value?.status === 'ready' && order.quote_expires_at <= result.value.checked_at) return 'Quote expired'
+  return states[order.state] || 'Unknown payment status'
+}
+async function load(target = 0, after = '') {
+  if (busy.value) return
+  busy.value = true; error.value = ''
+  try {
+    const response = await rpcClient.call<Result>({ method: 'wildbloom.storage.orders', params: { after, state: filter.value }, maxRetries: 1, signal: controller.signal })
+    if (controller.signal.aborted) return
+    result.value = response
+    if (target === 0) cursors.value = ['']
+    else cursors.value[target] = after
+    page.value = target
+  } catch {
+    if (!controller.signal.aborted) { result.value = null; error.value = 'Sales records are unavailable. Refresh to try again. No payments or storage settings were changed.' }
+  } finally { busy.value = false }
+}
+onMounted(() => load())
+onBeforeUnmount(() => controller.abort())
+</script>
+<template>
+  <div class="mx-auto max-w-4xl space-y-6 pb-8">
+    <RouterLink to="/dashboard/settings/storage" class="text-sm text-white/70 hover:text-white">← Storage &amp; selling</RouterLink>
+    <header class="flex flex-wrap items-start justify-between gap-4">
+      <div><h1 class="text-2xl font-semibold">Sales &amp; customers</h1><p class="mt-2 text-sm text-white/65">Your node’s private payment records and storage allowances.</p></div>
+      <button class="glass-button rounded-lg px-4 py-2 disabled:opacity-50" :disabled="busy" @click="load()">Refresh</button>
+    </header>
+    <p class="text-sm text-white/65">Viewing these records does not contact your payment issuer or change a payment. Refresh to read the latest local state.</p>
+    <p v-if="error" role="alert" class="rounded-lg border border-red-400/40 bg-red-500/10 p-4 text-red-200">{{ error }}</p>
+    <p v-if="busy" role="status">Loading sales records…</p>
+    <section v-if="result?.status === 'not_started'" class="glass-card p-6 space-y-3" aria-label="Selling not started">
+      <h2 class="text-lg font-semibold">No selling history yet</h2>
+      <p class="text-sm text-white/70">You can keep using your node for your own files. If you choose to sell, configure your offer in Storage &amp; selling.</p>
+    </section>
+    <template v-if="result?.status === 'ready'">
+      <section class="glass-card p-6 space-y-4" aria-label="Sales summary">
+        <dl class="grid grid-cols-2 gap-5 sm:grid-cols-4">
+          <div><dt class="text-sm text-white/60">Paid orders</dt><dd class="mt-1 text-xl">{{ result.summary.paid_orders.toLocaleString() }}</dd></div>
+          <div><dt class="text-sm text-white/60">Customers with retained space</dt><dd class="mt-1 text-xl">{{ result.summary.retained_customers.toLocaleString() }}</dd></div>
+          <div><dt class="text-sm text-white/60">Allocated storage</dt><dd class="mt-1 text-xl">{{ size(result.summary.allocated_bytes) }}</dd></div>
+          <div><dt class="text-sm text-white/60">Needs attention</dt><dd class="mt-1 text-xl">{{ result.summary.needs_attention.toLocaleString() }}</dd></div>
+        </dl>
+        <p class="text-xs text-white/60">Allocated storage includes recovery grace and counts each current allowance once. It is promised capacity, not bytes uploaded. Paid orders include renewals.</p>
+        <p class="text-xs text-white/60">Read {{ date(result.checked_at) }} · {{ result.summary.orders.toLocaleString() }} total orders</p>
+      </section>
+      <div class="flex flex-wrap items-center justify-between gap-3">
+        <div><label for="sales-filter" class="mr-3 text-sm">Payment status</label>
+          <select id="sales-filter" v-model="filter" :disabled="busy" class="rounded-lg border border-white/20 bg-[#181b23] p-2" @change="load()">
+            <option value="">All orders</option><option value="attention">Needs attention</option><option value="active">Paid · allowance issued</option><option value="awaiting_payment">Awaiting payment</option><option value="quoted">Unpaid quotes</option><option value="expired">Recorded expired quotes</option>
+          </select>
+        </div><p class="text-xs text-white/60">Page {{ page + 1 }} · up to 50 orders, sorted by order ID</p>
+      </div>
+      <p v-if="filter === 'attention'" class="rounded-lg bg-amber-400/10 p-4 text-sm text-amber-100">These records need operator review. A pending payment may already have been received. This view does not retry payments or issue refunds.</p>
+      <p v-if="!result.orders.length" role="status" class="glass-card p-6">{{ result.summary.orders ? 'No orders match this filter.' : 'No customer orders yet.' }}</p>
+      <section v-for="order in result.orders" :key="order.order_id" class="glass-card p-5 space-y-4" :aria-label="`Order ${order.order_id}`">
+        <div class="flex flex-wrap justify-between gap-3">
+          <div><h2 class="font-semibold">{{ order.renews ? 'Renewal' : 'Storage purchase' }} · {{ (order.price_msat / 1000).toLocaleString(undefined, { maximumFractionDigits: 3 }) }} sats</h2><p class="mt-1 text-sm text-white/65">{{ size(order.ordered_capacity_bytes) }} ordered · {{ order.rail === 'lnurlcash' ? 'LNURLcash' : 'Lightning' }}</p></div>
+          <strong class="text-sm">{{ payment(order) }}</strong>
+        </div>
+        <dl class="grid gap-4 text-sm sm:grid-cols-3">
+          <div><dt class="text-white/60">Order created</dt><dd class="mt-1">{{ date(order.created_at) }}</dd></div>
+          <template v-if="order.allowance"><div><dt class="text-white/60">Current write expiry</dt><dd class="mt-1">{{ date(order.allowance.writes_until) }}</dd></div><div><dt class="text-white/60">Current recovery deadline</dt><dd class="mt-1">{{ date(order.allowance.retains_until) }}</dd></div></template>
+          <div v-else><dt class="text-white/60">Quote expiry</dt><dd class="mt-1">{{ date(order.quote_expires_at) }}</dd></div>
+        </dl>
+        <p v-if="order.allowance" class="text-sm text-white/70">{{ access[order.allowance.status] || 'Allowance status unavailable' }} · {{ size(order.allowance.capacity_bytes) }} current allowance. Renewals share this allowance and its latest dates.</p>
+        <p v-else class="text-sm text-white/65">{{ order.state === 'active' ? 'The payment record shows activation, but its current allowance is unavailable.' : 'No activated allowance is recorded for this order.' }}</p>
+        <details class="border-t border-white/10 pt-3 text-sm"><summary class="cursor-pointer text-white/70">Order and customer references</summary>
+          <dl class="mt-3 space-y-3"><div><dt class="text-white/60">Order ID</dt><dd class="break-all font-mono text-xs mt-1">{{ order.order_id }}</dd></div><div><dt class="text-white/60">Customer public key</dt><dd class="break-all font-mono text-xs mt-1">{{ order.customer_pubkey }}</dd></div><div><dt class="text-white/60">Offer</dt><dd class="break-all mt-1">{{ order.offer_id }}</dd></div><div v-if="order.renews"><dt class="text-white/60">Renews</dt><dd class="break-all font-mono text-xs mt-1">{{ order.renews }}</dd></div></dl>
+        </details>
+      </section>
+      <nav class="flex justify-between gap-3" aria-label="Sales pages">
+        <button class="glass-button rounded-lg px-4 py-2 disabled:opacity-40" :disabled="busy || page === 0" @click="load(page - 1, cursors[page - 1])">Previous page</button>
+        <button class="glass-button rounded-lg px-4 py-2 disabled:opacity-40" :disabled="busy || !result.next_after" @click="load(page + 1, result.next_after || '')">Next page</button>
+      </nav>
+    </template>
+  </div>
+</template>
