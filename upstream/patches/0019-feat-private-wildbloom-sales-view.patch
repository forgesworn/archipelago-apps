+    }
+    #[test]
+    fn sales_pagination_and_attention_filter_are_bounded() {
+        let f = Fixture::new();
+        for n in 0..51 {
+            f.order(&format!("order-{n:03}"), "quoted", false, None);
+        }
+        f.order("pending", "lnurl_pending", false, None);
+        let first = f.read(PageRequest::default(), 100);
+        assert_eq!(first["orders"].as_array().unwrap().len(), 50);
+        assert_eq!(first["next_after"], "order-049");
+        let second = f.read(
+            PageRequest {
+                after: "order-049".into(),
+                ..Default::default()
+            },
+            100,
+        );
+        assert_eq!(second["orders"].as_array().unwrap().len(), 2);
+        assert!(second["next_after"].is_null());
+        let pending = f.read(
+            PageRequest {
+                state: "attention".into(),
+                ..Default::default()
+            },
+            100,
+        );
+        assert_eq!(pending["orders"].as_array().unwrap().len(), 1);
+        assert_eq!(pending["summary"]["needs_attention"], 1);
+        for bad in ["../path", "x' OR 1=1", "a/b"] {
+            assert!(PageRequest {
+                after: bad.into(),
+                ..Default::default()
+            }
+            .validate()
+            .is_err());
+        }
+        assert!(PageRequest {
+            state: "arbitrary".into(),
+            ..Default::default()
+        }
+        .validate()
+        .is_err());
+    }
+    #[test]
+    fn sales_missing_corrupt_or_future_state_is_not_zero_sales() {
+        let dir = tempfile::tempdir().unwrap();
+        assert_eq!(
+            read_at(dir.path(), false, &PageRequest::default(), 100).unwrap()["status"],
+            "not_started"
+        );
+        assert!(read_at(dir.path(), true, &PageRequest::default(), 100).is_err());
