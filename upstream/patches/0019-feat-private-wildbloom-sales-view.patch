+import { flushPromises, mount } from '@vue/test-utils'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+vi.mock('@/api/rpc-client', () => ({ rpcClient: { call: vi.fn() } }))
+import { rpcClient } from '@/api/rpc-client'
+import StorageSales from '../StorageSales.vue'
+const rpc = vi.mocked(rpcClient.call)
+const data = () => ({ status: 'ready', checked_at: 100, summary: { orders: 2, paid_orders: 2, needs_attention: 0, retained_customers: 1, allocated_bytes: 1024 }, orders: [{ order_id: 'order-a', state: 'active', customer_pubkey: 'ab'.repeat(32), rail: 'lnurlcash', offer_id: 'monthly', price_msat: 500000, ordered_capacity_bytes: 1024, created_at: 10, quote_expires_at: 20, renews: null, allowance: { capacity_bytes: 1024, starts_at: 10, writes_until: 200, retains_until: 300, status: 'active' } }], next_after: null as string | null })
+async function page() { const w = mount(StorageSales, { global: { stubs: { RouterLink: true } } }); await flushPromises(); return w }
+describe('Private storage sales', () => {
+  beforeEach(() => { rpc.mockReset(); rpc.mockResolvedValue(data()) })
+  it('only reads orders and distinguishes purchases from current allocation', async () => {
+    const w = await page()
+    expect(rpc.mock.calls.map(([o]) => o.method)).toEqual(['wildbloom.storage.orders'])
+    expect(w.text()).toContain('Paid · allowance issued'); expect(w.text()).toContain('Writes allowed')
+    expect(w.text()).toContain('Current write expiry'); expect(w.text()).toContain('counts each current allowance once')
+    expect(w.findAll('input').length).toBe(0)
+  })
+  it('shows never-enabled selling separately from empty order history', async () => {
+    rpc.mockResolvedValueOnce({ status: 'not_started' }); const w = await page()
+    expect(w.text()).toContain('No selling history yet'); expect(w.find('[aria-label="Sales summary"]').exists()).toBe(false)
+  })
+  it('does not present a failed read as zero customers or retain stale figures', async () => {
+    const w = await page(); rpc.mockRejectedValueOnce(new Error('private database path'))
+    await w.findAll('button').find(b => b.text() === 'Refresh')!.trigger('click'); await flushPromises()
+    expect(w.get('[role="alert"]').text()).toContain('Sales records are unavailable')
+    expect(w.text()).not.toContain('private database path'); expect(w.find('[aria-label="Sales summary"]').exists()).toBe(false)
+    expect(w.text()).not.toContain('No customer orders')
+  })
+  it('paginates by opaque cursor and resets on filter change', async () => {
+    rpc.mockResolvedValueOnce({ ...data(), next_after: 'order-a' }); const w = await page()
+    await w.findAll('button').find(b => b.text() === 'Next page')!.trigger('click'); await flushPromises()
+    expect(rpc).toHaveBeenLastCalledWith(expect.objectContaining({ params: { after: 'order-a', state: '' } }))
+    await w.get('#sales-filter').setValue('attention'); await flushPromises()
+    expect(rpc).toHaveBeenLastCalledWith(expect.objectContaining({ params: { after: '', state: 'attention' } }))
+    expect(w.text()).toContain('A pending payment may already have been received'); expect(w.text()).toContain('Page 1')
+  })
+  it('separates payment outcome from expired storage and renders text safely', async () => {
+    const value = data(); value.orders[0]!.allowance.status = 'expired'; value.orders[0]!.offer_id = '<img src=x onerror=alert(1)>'
+    rpc.mockResolvedValueOnce(value); const w = await page()
+    expect(w.text()).toContain('Paid · allowance issued'); expect(w.text()).toContain('Term expired')
+    expect(w.find('img').exists()).toBe(false); expect(w.text()).toContain('<img src=x onerror=alert(1)>')
+  })
+  it('aborts a pending read when the page unmounts', async () => {
+    const w = await page(); const signal = rpc.mock.calls[0]![0].signal!
+    w.unmount(); expect(signal.aborted).toBe(true)
+  })
+})
