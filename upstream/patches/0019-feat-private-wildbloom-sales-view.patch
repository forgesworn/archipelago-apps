--- /dev/null
+++ b/core/archipelago/src/settings/wildbloom_sales.rs
@@ -0,0 +1,493 @@
+//! Admin-only projection of the pinned checkout v1 and Shelter allowance schemas.
+//! Never opens Ledger/Store (which migrate and take writer locks), reads bearer
+//! columns, reconciles payments, or changes storage. WAL snapshots remain visible.
+use super::wildbloom_storage::MAX;
+use anyhow::{ensure, Context, Result};
+use rusqlite::{params, Connection, OpenFlags, OptionalExtension};
+use serde::Deserialize;
+use serde_json::{json, Value};
+use std::{
+    path::Path,
+    time::{Duration, SystemTime, UNIX_EPOCH},
+};
+
+const PAGE_SIZE: usize = 50;
+const STATES: &[&str] = &[
+    "reserving",
+    "quoted",
+    "expired",
+    "invoice_pending",
+    "awaiting_payment",
+    "lnurl_pending",
+    "settled",
+    "active",
+    "refund_required",
+];
+const ATTENTION: &[&str] = &[
+    "reserving",
+    "invoice_pending",
+    "lnurl_pending",
+    "settled",
+    "refund_required",
+];
+
+#[derive(Default, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct PageRequest {
+    pub after: String,
+    pub state: String,
+}
+impl PageRequest {
+    pub fn validate(&self) -> Result<()> {
+        ensure!(
+            self.after.is_empty() || id(&self.after),
+            "Invalid sales cursor"
+        );
+        ensure!(
+            self.state.is_empty()
+                || self.state == "attention"
+                || STATES.contains(&self.state.as_str()),
+            "Invalid sales filter"
+        );
+        Ok(())
+    }
+}
+fn id(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 128
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'_')
+}
+fn integer(row: &rusqlite::Row<'_>, index: usize) -> rusqlite::Result<u64> {
+    let n: i64 = row.get(index)?;
+    if n < 0 || n as u64 > MAX {
+        return Err(rusqlite::Error::IntegralValueOutOfRange(index, n));
+    }
+    Ok(n as u64)
+}
+fn safe(value: u64) -> Result<u64> {
+    ensure!(value <= MAX, "Invalid sales number");
+    Ok(value)
+}
+fn plain(value: &str, max: usize) -> Result<()> {
+    ensure!(
+        !value.is_empty() && value.len() <= max && !value.chars().any(char::is_control),
+        "Invalid sales text"
+    );
+    Ok(())
+}
+fn directory(path: &Path) -> Result<()> {
+    ensure!(
+        std::fs::symlink_metadata(path)?.is_dir(),
+        "Invalid sales directory"
+    );
+    Ok(())
+}
+fn open(path: &Path) -> Result<Connection> {
+    use std::os::unix::fs::PermissionsExt;
+    for suffix in ["", "-wal", "-shm"] {
+        let file = path.with_file_name(format!(
+            "{}{}",
+            path.file_name()
+                .context("Invalid database path")?
+                .to_str()
+                .context("Invalid database name")?,
+            suffix
+        ));
+        match std::fs::symlink_metadata(&file) {
+            Ok(meta) => ensure!(
+                meta.is_file() && meta.permissions().mode() & 0o077 == 0,
+                "Invalid private database"
+            ),
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound && !suffix.is_empty() => {}
+            Err(e) => return Err(e.into()),
+        }
+    }
+    // Resolve system directory aliases (e.g. macOS /var) after checking the
+    // private components; NOFOLLOW still protects the database itself.
+    let resolved = path
+        .parent()
+        .context("Invalid database directory")?
+        .canonicalize()?
+        .join(path.file_name().context("Invalid database name")?);
+    let db = Connection::open_with_flags(
+        resolved,
+        OpenFlags::SQLITE_OPEN_READ_ONLY
+            | OpenFlags::SQLITE_OPEN_NO_MUTEX
+            | OpenFlags::SQLITE_OPEN_NOFOLLOW,
+    )?;
+    db.busy_timeout(Duration::from_millis(500))?;
+    db.execute_batch("PRAGMA query_only=ON; PRAGMA trusted_schema=OFF; BEGIN DEFERRED;")?;
+    Ok(db)
+}
+#[derive(Deserialize)]
+struct Offer {
+    id: String,
+    capacity_bytes: u64,
+    price_msat: u64,
+}
+#[derive(Deserialize)]
+struct Quote {
+    order_id: String,
+    signer_pubkey: String,
+    rail: String,
+    offer: Offer,
+    created_at: u64,
+    expires_at: u64,
+    renews: Option<String>,
+}
+#[derive(Deserialize)]
+struct Receipt {
+    allowance_id: String,
+}
+
+pub fn read(root: &Path, expected: bool, request: &PageRequest) -> Result<Value> {
+    let now = SystemTime::now().duration_since(UNIX_EPOCH)?.as_secs();
+    read_at(root, expected, request, now)
+}
+fn read_at(root: &Path, expected: bool, request: &PageRequest, now: u64) -> Result<Value> {
+    request.validate()?;
+    directory(root)?;
+    let operator = root.join("operator");
+    let ledger = operator.join("checkout");
+    // Only a genuinely absent, never-enabled ledger is an empty state. Corrupt,
+    // unreadable or missing expected state must never look like zero sales.
+    match std::fs::symlink_metadata(&operator) {
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound && !expected => {
+            return Ok(json!({"status":"not_started"}))
+        }
+        _ => directory(&operator)?,
+    }
+    match std::fs::symlink_metadata(&ledger) {
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound && !expected => {
+            return Ok(json!({"status":"not_started"}))
+        }
+        _ => directory(&ledger)?,
+    }
+    let db = open(&ledger.join("checkout.sqlite3"))?;
+    let version: i64 = db.query_row("PRAGMA user_version", [], |r| r.get(0))?;
+    ensure!(version == 1, "Unsupported checkout schema");
+    let store = open(&root.join("wildbloom.sqlite3"))?;
+    let mut total = 0u64;
+    let mut attention = 0u64;
+    let mut paid = 0u64;
+    let mut counts = db.prepare("SELECT state,COUNT(*) FROM orders GROUP BY state")?;
+    for row in counts.query_map([], |r| Ok((r.get::<_, String>(0)?, integer(r, 1)?)))? {
+        let (state, count) = row?;
+        ensure!(STATES.contains(&state.as_str()), "Unknown payment state");
+        total = safe(total.checked_add(count).context("Invalid order count")?)?;
+        if ATTENTION.contains(&state.as_str()) {
+            attention += count;
+        }
+        if state == "active" {
+            paid += count;
+        }
+    }
+    ensure!(total <= 10000, "Checkout order bound exceeded");
+    // Current allowances, not a sum of purchase/renewal receipts. The store owns
+    // these dates and updates a stable allowance when a customer renews.
+    let (customers, capacity): (u64, u64) = store.query_row(
+        "SELECT COUNT(*),COALESCE(SUM(capacity),0) FROM paid_allowances WHERE retains>?1",
+        [safe(now)? as i64],
+        |r| Ok((integer(r, 0)?, integer(r, 1)?)),
+    )?;
+    safe(customers)?;
+    safe(capacity)?;
+    let mut query = db.prepare("SELECT id,state,CASE WHEN length(quote)<=65536 THEN quote END,
+        CASE WHEN receipt IS NULL OR length(receipt)<=4096 THEN receipt ELSE '' END
+        FROM orders WHERE id>?1 AND (?2='' OR state=?2 OR (?2='attention' AND state IN
+        ('reserving','invoice_pending','lnurl_pending','settled','refund_required'))) ORDER BY id LIMIT ?3")?;
+    let mut rows = query.query(params![
+        request.after,
+        request.state,
+        (PAGE_SIZE + 1) as i64
+    ])?;
+    let mut orders = Vec::new();
+    let mut more = false;
+    while let Some(row) = rows.next()? {
+        if orders.len() == PAGE_SIZE {
+            more = true;
+            break;
+        }
+        let order_id: String = row.get(0)?;
+        let state: String = row.get(1)?;
+        let quote: Quote = serde_json::from_str(&row.get::<_, String>(2)?)?;
+        let receipt: Option<String> = row.get(3)?;
+        ensure!(
+            id(&order_id) && quote.order_id == order_id && STATES.contains(&state.as_str()),
+            "Invalid order"
+        );
+        ensure!(
+            quote.signer_pubkey.len() == 64
+                && quote.signer_pubkey.bytes().all(|b| b.is_ascii_hexdigit()),
+            "Invalid customer key"
+        );
+        ensure!(
+            ["lightning", "lnurlcash"].contains(&quote.rail.as_str()),
+            "Invalid payment rail"
+        );
+        plain(&quote.offer.id, 128)?;
+        for n in [
+            quote.created_at,
+            quote.expires_at,
+            quote.offer.capacity_bytes,
+            quote.offer.price_msat,
+        ] {
+            safe(n)?;
+        }
+        ensure!(
+            quote.renews.as_ref().is_none_or(|v| id(v)),
+            "Invalid renewal reference"
+        );
+        let allowance = if let Some(receipt) = receipt {
+            let receipt: Receipt = serde_json::from_str(&receipt)?;
+            ensure!(id(&receipt.allowance_id), "Invalid allowance reference");
+            let current = store
+                .query_row(
+                    "SELECT signer,capacity,starts,ends,retains FROM paid_allowances WHERE id=?1",
+                    [&receipt.allowance_id],
+                    |r| {
+                        Ok((
+                            r.get::<_, String>(0)?,
+                            integer(r, 1)?,
+                            integer(r, 2)?,
+                            integer(r, 3)?,
+                            integer(r, 4)?,
+                        ))
+                    },
+                )
+                .optional()?;
+            match current {
+                Some((signer, capacity, starts, ends, retains)) => {
+                    ensure!(
+                        signer == quote.signer_pubkey && starts <= ends && ends <= retains,
+                        "Invalid allowance"
+                    );
+                    for n in [capacity, starts, ends, retains] {
+                        safe(n)?;
+                    }
+                    Some(
+                        json!({"capacity_bytes":capacity,"starts_at":starts,"writes_until":ends,"retains_until":retains,
+                        "status": if now<starts {"scheduled"} else if now<ends {"active"} else if now<retains {"grace"} else {"expired"}}),
+                    )
+                }
+                None => None,
+            }
+        } else {
+            None
+        };
+        orders.push(
+            json!({"order_id":order_id,"state":state,"customer_pubkey":quote.signer_pubkey,
+            "rail":quote.rail,"offer_id":quote.offer.id,"price_msat":quote.offer.price_msat,
+            "ordered_capacity_bytes":quote.offer.capacity_bytes,"created_at":quote.created_at,
+            "quote_expires_at":quote.expires_at,"renews":quote.renews,"allowance":allowance}),
+        );
+    }
+    let next = if more {
+        orders.last().map(|v| v["order_id"].clone())
+    } else {
+        None
+    };
+    Ok(
+        json!({"status":"ready","checked_at":now,"summary":{"orders":total,"paid_orders":paid,
+        "needs_attention":attention,"retained_customers":customers,"allocated_bytes":capacity},"orders":orders,"next_after":next}),
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::PermissionsExt;
+    struct Fixture {
+        root: tempfile::TempDir,
+        ledger: Connection,
+        store: Connection,
+    }
+    impl Fixture {
+        fn new() -> Self {
+            let root = tempfile::tempdir().unwrap();
+            std::fs::create_dir_all(root.path().join("operator/checkout")).unwrap();
+            let ledger =
+                Connection::open(root.path().join("operator/checkout/checkout.sqlite3")).unwrap();
+            ledger.execute_batch("PRAGMA journal_mode=WAL; PRAGMA user_version=1; CREATE TABLE orders (id TEXT PRIMARY KEY,state TEXT,quote TEXT,receipt TEXT,invoice TEXT,rotation TEXT);").unwrap();
+            let store = Connection::open(root.path().join("wildbloom.sqlite3")).unwrap();
+            store.execute_batch("PRAGMA journal_mode=WAL; CREATE TABLE paid_allowances(id TEXT PRIMARY KEY,signer TEXT,capacity INTEGER,starts INTEGER,ends INTEGER,retains INTEGER);").unwrap();
+            for base in [
+                root.path().join("operator/checkout/checkout.sqlite3"),
+                root.path().join("wildbloom.sqlite3"),
+            ] {
+                for suffix in ["", "-wal", "-shm"] {
+                    let p = base.with_file_name(format!(
+                        "{}{suffix}",
+                        base.file_name().unwrap().to_str().unwrap()
+                    ));
+                    std::fs::set_permissions(p, std::fs::Permissions::from_mode(0o600)).unwrap();
+                }
+            }
+            Self {
+                root,
+                ledger,
+                store,
+            }
+        }
+        fn order(&self, id: &str, state: &str, receipt: bool, renews: Option<&str>) {
+            let quote = json!({"order_id":id,"signer_pubkey":"ab".repeat(32),"rail":"lnurlcash",
+                "offer":{"id":"monthly","capacity_bytes":1024,"price_msat":500000},"created_at":10,"expires_at":20,"renews":renews,
+                "future_secret":"never-project-unknown-fields"});
+            let receipt = receipt.then(|| {
+                json!({"allowance_id":"allowance","writes_until":50,"retains_until":60}).to_string()
+            });
+            self.ledger
+                .execute(
+                    "INSERT INTO orders VALUES(?1,?2,?3,?4,'secret-invoice','secret-bearer-note')",
+                    params![id, state, quote.to_string(), receipt],
+                )
+                .unwrap();
+        }
+        fn allowance(&self) {
+            self.store
+                .execute(
+                    "INSERT INTO paid_allowances VALUES('allowance',?1,1024,10,200,300)",
+                    ["ab".repeat(32)],
+                )
+                .unwrap();
+        }
+        fn read(&self, request: PageRequest, now: u64) -> Value {
+            read_at(self.root.path(), true, &request, now).unwrap()
+        }
+    }
+    #[test]
+    fn sales_read_live_wal_and_project_no_payment_assets() {
+        let f = Fixture::new();
+        f.order("order-a", "active", true, None);
+        f.allowance();
