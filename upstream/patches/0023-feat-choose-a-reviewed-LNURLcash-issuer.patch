+pub const REFERENCE_KEY: &str =
+    "027f06257d0e9af2dbef2c1c64d03962a9240a65a987eb90b36000c64de34baa6d";
 pub static LOCK: tokio::sync::Mutex<()> = tokio::sync::Mutex::const_new(());
 
+#[derive(Clone, Copy, Debug)]
+pub struct Issuer {
+    pub id: &'static str,
+    pub name: &'static str,
+    pub host: &'static str,
+    pub origin: &'static str,
+    pub note_endpoint: &'static str,
+    pub callback: &'static str,
+    pub mint_pubkey: &'static str,
+    pub development: bool,
+    pub terms_url: Option<&'static str>,
+}
+
+pub fn issuer(id: &str) -> Option<Issuer> {
+    match id {
+        "lnurlcash-reference" => Some(Issuer {
+            id: "lnurlcash-reference",
+            name: "LNURLcash reference mint",
+            host: "mint.lnurlcash.com",
+            origin: "https://mint.lnurlcash.com/",
+            note_endpoint: "https://mint.lnurlcash.com/w",
+            callback: "https://mint.lnurlcash.com/w/cb",
+            mint_pubkey: REFERENCE_KEY,
+            development: false,
+            terms_url: None,
+        }),
+        "moneyer-dev" => Some(Issuer {
+            id: "moneyer-dev",
+            name: "Moneyer test/development mint",
+            host: "moneyer.dev",
+            origin: "https://moneyer.dev/",
+            note_endpoint: "https://moneyer.dev/w",
+            callback: "https://moneyer.dev/w/cb",
+            mint_pubkey: MONEYER_KEY,
+            development: true,
+            terms_url: Some("https://moneyer.dev/terms"),
+        }),
+        _ => None,
+    }
+}
+
+pub fn issuer_choices() -> Value {
+    json!(["lnurlcash-reference", "moneyer-dev"].map(|id| {
+        let i = issuer(id).expect("static issuer");
+        json!({"id":i.id,"name":i.name,"origin":i.origin,"development":i.development,
+            "terms_url":i.terms_url})
+    }))
+}
+
+fn legacy_issuer() -> String {
+    // Settings written before issuer selection existed were Moneyer settings.
+    // This default prevents an upgrade from reinterpreting their pinned IPs.
+    "moneyer-dev".into()
+}
