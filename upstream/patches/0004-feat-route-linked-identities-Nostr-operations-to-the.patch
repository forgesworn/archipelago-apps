+            async move { encrypt(&r, &s, "same").await }
+        });
+        while signer.calls() == 0 {
+            tokio::task::yield_now().await;
+        }
+        // The HTTP request goes away mid-prompt.
+        caller.abort();
+        assert!(caller.await.unwrap_err().is_cancelled());
+
+        // The person answers on the device; the retry joins that answer.
+        let retry = tokio::spawn({
+            let (r, s) = (requests.clone(), signer.clone());
+            async move { encrypt(&r, &s, "same").await }
+        });
+        signer.release();
+        retry.await.unwrap().unwrap();
+        assert_eq!(signer.calls(), 1);
