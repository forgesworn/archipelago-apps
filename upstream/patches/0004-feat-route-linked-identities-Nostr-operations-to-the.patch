+/// The four NIP-46 encryption methods.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum CipherOp {
+    Nip04Encrypt,
+    Nip04Decrypt,
+    Nip44Encrypt,
+    Nip44Decrypt,
+}
+
+impl CipherOp {
+    /// The NIP-46 method name.
+    pub fn method(self) -> &'static str {
+        match self {
+            CipherOp::Nip04Encrypt => "nip04_encrypt",
+            CipherOp::Nip04Decrypt => "nip04_decrypt",
+            CipherOp::Nip44Encrypt => "nip44_encrypt",
+            CipherOp::Nip44Decrypt => "nip44_decrypt",
+        }
+    }
+
+    pub async fn apply(
+        self,
+        signer: &dyn RemoteSigner,
+        peer: &PublicKey,
+        text: &str,
+    ) -> Result<String, RemoteSignerError> {
+        match self {
+            CipherOp::Nip04Encrypt => signer.nip04_encrypt(peer, text).await,
+            CipherOp::Nip04Decrypt => signer.nip04_decrypt(peer, text).await,
+            CipherOp::Nip44Encrypt => signer.nip44_encrypt(peer, text).await,
+            CipherOp::Nip44Decrypt => signer.nip44_decrypt(peer, text).await,
+        }
+    }
+}
