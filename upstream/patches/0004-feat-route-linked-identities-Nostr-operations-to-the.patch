+impl RemoteSignerSource for RemoteSessions {
+    fn open(&self, identity_id: &str, linked: &LinkedSigner) -> Result<Arc<dyn RemoteSigner>> {
+        let fingerprint = fingerprint(linked);
+        let now = Instant::now();
+        // `sessions` first, then `forgotten`, as in `forget`: holding
+        // `sessions` across the check means a concurrent `forget` either
+        // runs before it (and is seen) or after the insert (and removes it).
+        let mut sessions = lock(&self.sessions);
+        if lock(&self.forgotten).contains(identity_id) {
+            anyhow::bail!("Identity not found: {}", identity_id);
+        }
+        let current = sessions
+            .get_mut(identity_id)
+            .filter(|s| s.fingerprint == fingerprint && now - s.last_used < SESSION_IDLE);
+        let (id, signer, last_reply) = match current {
+            Some(session) => {
+                session.last_used = now;
+                (
+                    session.id,
+                    Arc::clone(&session.signer),
+                    Arc::clone(&session.last_reply),
+                )
+            }
+            None => {
+                let signer = (self.open)(linked)?;
+                let id = self.next_id.fetch_add(1, Ordering::Relaxed);
+                sessions.remove(identity_id);
+                if sessions.len() >= MAX_SESSIONS {
+                    let oldest = sessions
+                        .iter()
+                        .min_by_key(|(_, s)| s.last_used)
+                        .map(|(k, _)| k.clone());
+                    if let Some(oldest) = oldest {
+                        sessions.remove(&oldest);
+                    }
+                }
+                let last_reply = Arc::new(Mutex::new(None));
+                sessions.insert(
+                    identity_id.to_string(),
+                    Session {
+                        id,
+                        fingerprint,
+                        signer: Arc::clone(&signer),
+                        last_used: now,
+                        last_reply: Arc::clone(&last_reply),
+                    },
+                );
+                (id, signer, last_reply)
+            }
+        };
+        Ok(Arc::new(SessionSigner {
+            identity_id: identity_id.to_string(),
+            session_id: id,
+            inner: signer,
+            sessions: Arc::clone(&self.sessions),
+            relays: linked.relays.join(", "),
+            last_reply,
+        }))
+    }
+
+    fn forget(&self, identity_id: &str) {
+        let mut sessions = lock(&self.sessions);
+        lock(&self.forgotten).insert(identity_id.to_string());
+        sessions.remove(identity_id);
+    }
+}
