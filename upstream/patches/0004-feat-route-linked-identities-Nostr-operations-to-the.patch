+/// How long an unused signer session stays open.
+pub const SESSION_IDLE: Duration = Duration::from_secs(5 * 60);
+/// The most signer sessions kept open at once.
+pub const MAX_SESSIONS: usize = 32;
+
+type OpenSigner = dyn Fn(&LinkedSigner) -> Result<Arc<dyn RemoteSigner>> + Send + Sync;
+
+struct Session {
+    id: u64,
+    /// Digest of the linked-signer record the session was opened for, so a
+    /// re-link under the same identity id gets a fresh session.
+    fingerprint: String,
+    signer: Arc<dyn RemoteSigner>,
+    last_used: Instant,
+    /// When a request through this session last got a verified reply.
+    last_reply: Arc<Mutex<Option<Instant>>>,
+}
+
+type SessionMap = Arc<Mutex<HashMap<String, Session>>>;
+
+/// Open signer sessions, one per linked identity, so requests share a relay
+/// connection and `connect` is sent once per session rather than once per
+/// request. A session is closed after [`SESSION_IDLE`] unused, after a
+/// transport failure (the next request reconnects), when its identity is
+/// deleted or re-linked, and when [`MAX_SESSIONS`] are open and it is the
+/// least recently used.
+pub struct RemoteSessions {
+    open: Box<OpenSigner>,
+    sessions: SessionMap,
+    /// Identities deleted while this process runs. A request that read the
+    /// identity just before its deletion must not reopen a session for it.
+    /// Identity ids are fresh UUIDs, so an id never comes back.
+    forgotten: Mutex<HashSet<String>>,
+    next_id: AtomicU64,
+}
+
+impl RemoteSessions {
+    pub fn new<F>(open: F) -> Self
+    where
+        F: Fn(&LinkedSigner) -> Result<Arc<dyn RemoteSigner>> + Send + Sync + 'static,
+    {
+        Self {
+            open: Box::new(open),
+            sessions: Arc::default(),
+            forgotten: Mutex::default(),
+            next_id: AtomicU64::new(0),
+        }
+    }
+
+    /// The process-wide NIP-46 sessions, with a sweeper that closes idle
+    /// ones. The sweeper is spawned on the runtime of the first caller, which
+    /// is always inside one (`IdentityManager::new` is async). Without it,
+    /// an idle session would still be replaced on its next use, but not
+    /// closed until then.
+    pub fn global() -> Arc<Self> {
+        static GLOBAL: OnceLock<Arc<RemoteSessions>> = OnceLock::new();
+        Arc::clone(GLOBAL.get_or_init(|| {
+            let sessions = Arc::new(Self::new(|linked| {
+                Ok(Arc::new(NostrConnectSigner::from_linked(linked)?))
+            }));
+            if let Ok(runtime) = tokio::runtime::Handle::try_current() {
+                let sweeper = Arc::downgrade(&sessions);
+                runtime.spawn(async move {
+                    let mut tick = tokio::time::interval(Duration::from_secs(60));
+                    loop {
+                        tick.tick().await;
+                        match sweeper.upgrade() {
+                            Some(sessions) => sessions.close_idle(),
+                            None => break,
+                        }
+                    }
+                });
+            }
+            sessions
+        }))
+    }
+
+    /// Close sessions unused for [`SESSION_IDLE`].
+    pub fn close_idle(&self) {
+        let now = Instant::now();
+        lock(&self.sessions).retain(|_, s| now - s.last_used < SESSION_IDLE);
+    }
+
+    #[cfg(test)]
+    pub fn len(&self) -> usize {
+        lock(&self.sessions).len()
+    }
+}
+
+fn lock<T>(mutex: &Mutex<T>) -> std::sync::MutexGuard<'_, T> {
+    mutex.lock().unwrap_or_else(|e| e.into_inner())
+}
