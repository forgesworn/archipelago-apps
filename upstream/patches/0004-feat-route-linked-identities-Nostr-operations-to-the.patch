+    async fn nip04_decrypt(
+        &self,
+        peer: &PublicKey,
+        ciphertext: &str,
+    ) -> Result<String, RemoteSignerError> {
+        self.watched(self.inner.nip04_decrypt(peer, ciphertext))
+            .await
+    }
+
+    async fn nip44_encrypt(
+        &self,
+        peer: &PublicKey,
+        plaintext: &str,
+    ) -> Result<String, RemoteSignerError> {
+        self.watched(self.inner.nip44_encrypt(peer, plaintext))
+            .await
