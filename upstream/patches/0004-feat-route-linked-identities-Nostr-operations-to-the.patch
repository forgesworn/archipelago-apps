+        fake.set_mode(FakeMode::Offline);
+        assert!(!sign_through(&sessions, "id-1", &record).await);
+        assert_eq!(sessions.len(), 0);
+        fake.set_mode(FakeMode::Honest);
+        assert!(sign_through(&sessions, "id-1", &record).await);
+        assert_eq!(opened.load(Ordering::SeqCst), 2);
