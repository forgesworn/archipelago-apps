+    async fn recently_answered() -> (Arc<FakeSigner>, Arc<dyn RemoteSigner>) {
+        let fake = Arc::new(FakeSigner::gated(Keys::generate(), FakeMode::Honest));
+        let (sessions, _) = fake_sessions(fake.clone());
+        let signer = sessions
+            .open("id-1", &linked("2026-10-03T00:00:00Z"))
+            .unwrap();
+        fake.release();
+        signer
+            .sign_event(sample_request(&Keys::generate()))
+            .await
+            .unwrap();
+        fake.pings.store(0, Ordering::SeqCst);
+        fake.calls.store(0, Ordering::SeqCst);
+        (fake, signer)
