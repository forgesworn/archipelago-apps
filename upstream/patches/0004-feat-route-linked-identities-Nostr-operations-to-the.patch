+/// Whether a session's `connect` has been accepted, and when to send it
+/// again, as Cambium does with Heartwood:
+///
+/// - Until the signer accepts `connect`, each request first sends it (from
+///   the stored client key, with the stored secret if any) and goes ahead
+///   whatever the outcome: a refusal, or silence within
+///   [`SESSION_CONNECT_WAIT`], may still come from a signer that serves the
+///   client key it authorised before, and the request itself says whether it
+///   does. Only unreachable relays fail the request.
+/// - Any reply to `connect` ends its wait at once. A request that succeeds
+///   marks the session accepted too: the signer evidently knows the client,
+///   so a signer that refuses a second use of its secret is not sent
+///   `connect` before every request.
+/// - Once accepted, a request answered `Unauthorised` (the signer no longer
+///   knows this client, as after a restart) sends `connect` once more and,
+///   if that is accepted, retries the request once. An unauthorised answer
+///   comes without a prompt, so the retry raises at most the one prompt the
+///   request was going to raise anyway. A person's refusal (`Denied`) is
+///   never retried.
+#[derive(Default)]
+pub(crate) struct ConnectGate {
+    accepted: tokio::sync::Mutex<bool>,
+}
+
+impl ConnectGate {
+    /// Mark `connect` as accepted (it was, at link or pairing time).
+    pub(crate) fn accept(&mut self) {
+        *self.accepted.get_mut() = true;
+    }
+
+    /// Send `connect` unless it has been accepted; whether it now is.
+    async fn ensure<C, CF>(&self, connect: &C) -> Result<bool, RemoteSignerError>
+    where
+        C: Fn() -> CF,
+        CF: Future<Output = Result<bool, RemoteSignerError>>,
+    {
+        let mut accepted = self.accepted.lock().await;
+        if !*accepted {
+            match connect().await {
+                Ok(ok) => *accepted = ok,
+                Err(e @ RemoteSignerError::Offline(_)) => return Err(e),
+                Err(e) => {
+                    tracing::debug!(error = %e, "Linked signer did not accept connect; trying the request anyway");
+                }
+            }
+        }
+        Ok(*accepted)
+    }
+
+    /// Run `request` under the rules above.
+    pub(crate) async fn run<C, CF, R, RF, T>(
+        &self,
+        connect: C,
+        request: R,
+    ) -> Result<T, RemoteSignerError>
+    where
+        C: Fn() -> CF,
+        CF: Future<Output = Result<bool, RemoteSignerError>>,
+        R: Fn() -> RF,
+        RF: Future<Output = Result<T, RemoteSignerError>>,
+    {
+        let accepted = self.ensure(&connect).await?;
+        let result = match request().await {
+            Err(RemoteSignerError::Unauthorised) if accepted => {
+                *self.accepted.lock().await = false;
+                if self.ensure(&connect).await? {
+                    request().await
+                } else {
+                    Err(RemoteSignerError::Unauthorised)
+                }
+            }
+            other => other,
+        };
+        if result.is_ok() {
+            *self.accepted.lock().await = true;
+        }
+        result
+    }
+}
