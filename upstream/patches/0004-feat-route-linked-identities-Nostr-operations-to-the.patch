+/// Digest of everything a session depends on.
+fn fingerprint(linked: &LinkedSigner) -> String {
+    use sha2::{Digest, Sha256};
+    let mut hasher = Sha256::new();
+    for part in [
+        linked.remote_signer_pubkey.as_str(),
+        linked.user_pubkey.as_str(),
+        linked.client_secret_hex.as_str(),
+        linked.bunker_secret.as_deref().unwrap_or(""),
+        linked.linked_at.as_str(),
+    ]
+    .into_iter()
+    .chain(linked.relays.iter().map(String::as_str))
+    {
+        hasher.update(part.as_bytes());
+        hasher.update([0]);
+    }
+    hex::encode(hasher.finalize())
+}
