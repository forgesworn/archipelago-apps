+    /// Have a linked identity's remote signer sign `unsigned`, whose pubkey
+    /// must be the identity's. The result has been checked against the
+    /// request with `verify_remote_event`. Retries of the same event (same
+    /// id) join the pending request rather than prompting again.
+    pub async fn sign_linked_event(
+        &self,
+        id: &str,
+        mut unsigned: nostr_sdk::UnsignedEvent,
+    ) -> Result<nostr_sdk::Event> {
+        let digest = unsigned.id().to_hex();
+        let pubkey = unsigned.pubkey;
+        self.remote_sign(id, digest, Some(pubkey), move |_| unsigned)
+            .await
+    }
+
+    /// Like [`Self::sign_linked_event`] for an event that arrived without
+    /// `created_at`. The timestamp is filled in once, when the request first
+    /// goes to the signer, and the request is keyed on the pubkey, kind, tags
+    /// and content, so a retry joins it (or gets its result) instead of
+    /// prompting again. The signed event carries the timestamp used.
+    pub async fn sign_linked_event_now(
+        &self,
+        id: &str,
+        kind: nostr_sdk::Kind,
+        tags: Vec<nostr_sdk::Tag>,
+        content: String,
+    ) -> Result<nostr_sdk::Event> {
+        let linked = self
+            .linked_signer(id)
+            .await?
+            .ok_or_else(|| anyhow::anyhow!("Identity is not linked to a remote signer"))?;
+        let digest = {
+            use sha2::{Digest, Sha256};
+            let tag_values: Vec<&[String]> = tags.iter().map(|t| t.as_slice()).collect();
+            let fields =
+                serde_json::json!([linked.user_pubkey, kind.as_u16(), tag_values, content]);
+            format!(
+                "undated:{}",
+                hex::encode(Sha256::digest(fields.to_string()))
+            )
+        };
+        self.remote_sign(id, digest, None, move |pubkey| {
+            nostr_sdk::UnsignedEvent::new(pubkey, nostr_sdk::Timestamp::now(), kind, tags, content)
+        })
+        .await
+    }
