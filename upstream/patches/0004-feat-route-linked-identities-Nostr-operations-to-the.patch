+/// A session's signer as handed to one caller. Before a request it makes
+/// sure the signer is there: unless it replied within [`LIVENESS_WINDOW`], a
+/// `ping` must get some reply within [`PING_TIMEOUT`], or the request fails
+/// as offline without being sent. While the request is out it keeps
+/// checking: no reply within [`PING_TIMEOUT`] sends a `ping`, and silence to
+/// that fails the request as offline; an answered `ping` (the signer is
+/// there, likely waiting on a person) is repeated every [`PROBE_INTERVAL`].
+/// Signers answer `ping` while an approval is pending, so a person deciding
+/// is never cut off. A transport failure closes the session, so the next
+/// request reconnects.
+struct SessionSigner {
+    identity_id: String,
+    session_id: u64,
+    inner: Arc<dyn RemoteSigner>,
+    sessions: SessionMap,
+    /// For the offline message.
+    relays: String,
+    last_reply: Arc<Mutex<Option<Instant>>>,
+}
+
+impl SessionSigner {
+    /// Record a reply (any answer, refusals included), and close the session
+    /// on a transport failure.
+    fn check<T>(&self, result: Result<T, RemoteSignerError>) -> Result<T, RemoteSignerError> {
+        match &result {
+            Err(RemoteSignerError::Offline(_) | RemoteSignerError::Timeout) => {
+                let mut sessions = lock(&self.sessions);
+                if sessions
+                    .get(&self.identity_id)
+                    .is_some_and(|s| s.id == self.session_id)
+                {
+                    sessions.remove(&self.identity_id);
+                }
+            }
+            _ => *lock(&self.last_reply) = Some(Instant::now()),
+        }
+        result
+    }
+
+    /// Ping the signer unless it replied within [`LIVENESS_WINDOW`].
+    async fn ensure_alive(&self) -> Result<(), RemoteSignerError> {
+        let seen = (*lock(&self.last_reply)).max(self.inner.last_reply());
+        if seen.is_some_and(|at| Instant::now() - at < LIVENESS_WINDOW) {
+            return Ok(());
+        }
+        self.probe().await
+    }
+
+    /// `ping` with [`PING_TIMEOUT`]: `Ok` for any answer (a refusal
+    /// included), the offline error for silence.
+    async fn probe(&self) -> Result<(), RemoteSignerError> {
+        // Relays first, so PING_TIMEOUT times only the ping itself.
+        if let Err(e) = self.inner.ready().await {
+            return self.check(Err(e));
+        }
+        let pinged = match tokio::time::timeout(PING_TIMEOUT, self.inner.ping()).await {
+            Ok(Err(RemoteSignerError::Timeout)) | Err(_) => {
+                Err(RemoteSignerError::Offline(self.relays.clone()))
+            }
+            Ok(other) => other,
+        };
+        match self.check(pinged) {
+            Err(e @ RemoteSignerError::Offline(_)) => Err(e),
+            _ => Ok(()),
+        }
+    }
+
+    /// Run a request, probing the signer while it is out (see the type's
+    /// documentation), and record its outcome.
+    async fn watched<T>(
+        &self,
+        request: impl Future<Output = Result<T, RemoteSignerError>>,
+    ) -> Result<T, RemoteSignerError> {
+        self.ensure_alive().await?;
+        tokio::pin!(request);
+        let mut next_probe = Instant::now() + PING_TIMEOUT;
+        let result = loop {
+            tokio::select! {
+                result = &mut request => break result,
+                _ = tokio::time::sleep_until(next_probe) => {
+                    let probe = self.probe();
+                    tokio::pin!(probe);
+                    tokio::select! {
+                        result = &mut request => break result,
+                        alive = &mut probe => match alive {
+                            Ok(()) => next_probe = Instant::now() + PROBE_INTERVAL,
+                            Err(offline) => break Err(offline),
+                        },
+                    }
+                }
+            }
+        };
+        self.check(result)
+    }
+}
