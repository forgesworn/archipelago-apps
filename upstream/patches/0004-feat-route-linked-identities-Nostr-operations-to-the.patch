+/// How long a completed request's result answers retries of it.
+pub const RESULT_TTL: Duration = Duration::from_secs(60);
+/// The most requests kept before completed ones are dropped, oldest first.
+/// Pending requests are never dropped, so they can take the map past this;
+/// they are bounded by the request timeouts instead.
+pub const MAX_RESULTS: usize = 256;
+
+/// Identifies one remote request for de-duplication: the identity, the
+/// NIP-46 method and a digest of the request (the event id for
+/// `sign_event`).
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct RequestKey {
+    pub identity_id: String,
+    pub method: &'static str,
+    pub digest: String,
+}
+
+/// What a remote request produced.
+#[derive(Debug, Clone)]
+pub enum RemoteReply {
+    Event(Box<Event>),
+    Text(String),
+}
+
+type SharedReply = Shared<BoxFuture<'static, Result<RemoteReply, RemoteSignerError>>>;
+
+struct PendingRequest {
+    generation: u64,
+    reply: SharedReply,
+    completed_at: Option<Instant>,
+}
+
+/// De-duplicates remote signer requests.
+///
+/// The dashboard's RPC client gives up after 15 s and retries, while a person
+/// may take far longer to answer a prompt on their signer. So each request
+/// runs on its own task, which a dropped HTTP request cannot cancel; a retry
+/// with the same [`RequestKey`] waits on that task instead of raising a second
+/// prompt; and a success keeps answering retries for [`RESULT_TTL`], then is
+/// dropped. A failure is forgotten as soon as it is delivered, so the next
+/// attempt starts afresh. A result is only ever handed to a request with the
+/// same [`RequestKey`]: the same identity, method and request digest.
+#[derive(Default)]
+pub struct RemoteRequests {
+    pending: Mutex<HashMap<RequestKey, PendingRequest>>,
+    next_generation: AtomicU64,
+}
+
+impl RemoteRequests {
+    /// The process-wide instance. `IdentityManager` is built per RPC call, so
+    /// the state has to live here.
+    pub fn global() -> Arc<Self> {
+        static GLOBAL: OnceLock<Arc<RemoteRequests>> = OnceLock::new();
+        Arc::clone(GLOBAL.get_or_init(|| Arc::new(Self::default())))
+    }
+
+    /// Run `work` for `key`, or join the run already pending (or recently
+    /// completed) for it. `work` is dropped unpolled when joining.
+    pub async fn run<F>(
+        self: &Arc<Self>,
+        key: RequestKey,
+        work: F,
+    ) -> Result<RemoteReply, RemoteSignerError>
+    where
+        F: Future<Output = Result<RemoteReply, RemoteSignerError>> + Send + 'static,
+    {
+        let reply = {
+            let mut pending = lock(&self.pending);
+            let now = Instant::now();
+            pending.retain(|_, p| p.completed_at.is_none_or(|at| now - at < RESULT_TTL));
+            match pending.get(&key) {
+                Some(existing) => existing.reply.clone(),
+                None => {
+                    if pending.len() >= MAX_RESULTS {
+                        let mut completed: Vec<(Instant, RequestKey)> = pending
+                            .iter()
+                            .filter_map(|(k, p)| p.completed_at.map(|at| (at, k.clone())))
+                            .collect();
+                        completed.sort_by_key(|(at, _)| *at);
+                        let excess = pending.len() + 1 - MAX_RESULTS;
+                        for (_, old) in completed.into_iter().take(excess) {
+                            pending.remove(&old);
+                        }
+                    }
+                    let generation = self.next_generation.fetch_add(1, Ordering::Relaxed);
+                    let requests = Arc::clone(self);
+                    let task_key = key.clone();
+                    let task = tokio::spawn(async move {
+                        // Catch a panic so the key is still released: an
+                        // entry left pending would answer every later
+                        // retry with this failure.
+                        let result = std::panic::AssertUnwindSafe(work).catch_unwind().await;
+                        requests.finish(&task_key, generation, matches!(result, Ok(Ok(_))));
+                        result.unwrap_or_else(|_| {
+                            Err(RemoteSignerError::BadResponse(
+                                "the request task panicked".to_string(),
+                            ))
+                        })
+                    });
+                    let reply = async move {
+                        task.await.unwrap_or_else(|_| {
+                            Err(RemoteSignerError::BadResponse(
+                                "the request task failed".to_string(),
+                            ))
+                        })
+                    }
+                    .boxed()
+                    .shared();
+                    pending.insert(
+                        key,
+                        PendingRequest {
+                            generation,
+                            reply: reply.clone(),
+                            completed_at: None,
+                        },
+                    );
+                    reply
+                }
+            }
+        };
+        reply.await
+    }
+
+    fn finish(self: &Arc<Self>, key: &RequestKey, generation: u64, succeeded: bool) {
+        let mut pending = lock(&self.pending);
+        if pending.get(key).is_none_or(|p| p.generation != generation) {
+            return;
+        }
+        if !succeeded {
+            pending.remove(key);
+            return;
+        }
+        if let Some(p) = pending.get_mut(key) {
+            p.completed_at = Some(Instant::now());
+        }
+        // Drop the result when it expires, even if no request comes along to
+        // prune it: it may be a decrypted message.
+        let requests = Arc::clone(self);
+        let key = key.clone();
+        tokio::spawn(async move {
+            tokio::time::sleep(RESULT_TTL).await;
+            let mut pending = lock(&requests.pending);
+            if pending
+                .get(&key)
+                .is_some_and(|p| p.generation == generation)
+            {
+                pending.remove(&key);
+            }
+        });
+    }
+
+    #[cfg(test)]
+    pub fn len(&self) -> usize {
+        lock(&self.pending).len()
+    }
 }
 
