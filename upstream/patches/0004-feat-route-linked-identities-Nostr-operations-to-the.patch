+/// Wait for the signer's reply while the request is still being sent.
+///
+/// Sending finishes only when every relay has acknowledged the event (or
+/// failed to): a relay may take up to 10 s to do so, or ask for NIP-42 AUTH
+/// first, while the signer has long since answered on another relay. So the
+/// reply is taken as soon as it arrives. `send` reports whether any relay
+/// accepted the request; if none did and no reply has come, the signer is
+/// offline.
+async fn first_reply<S, R>(
+    send: S,
+    reply: R,
+    offline: RemoteSignerError,
+) -> Result<String, RemoteSignerError>
+where
+    S: Future<Output = bool>,
+    R: Future<Output = Result<String, RemoteSignerError>>,
+{
+    tokio::pin!(send);
+    tokio::pin!(reply);
+    tokio::select! {
+        biased;
+        answer = &mut reply => answer,
+        accepted = &mut send => {
+            if accepted {
+                reply.await
+            } else {
+                Err(offline)
+            }
+        }
+    }
+}
