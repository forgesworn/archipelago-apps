+        request_answers: Mutex<Vec<Result<&'static str, RemoteSignerError>>>,
+    }
+
+    impl GateScript {
+        fn new(
+            connect_answers: Vec<Result<bool, RemoteSignerError>>,
+            request_answers: Vec<Result<&'static str, RemoteSignerError>>,
+        ) -> Arc<Self> {
+            Arc::new(Self {
+                connects: AtomicUsize::new(0),
+                requests: AtomicUsize::new(0),
+                connect_answers: Mutex::new(connect_answers),
+                request_answers: Mutex::new(request_answers),
+            })
+        }
+
+        async fn run(
+            self: &Arc<Self>,
+            gate: &ConnectGate,
+        ) -> Result<&'static str, RemoteSignerError> {
+            gate.run(
+                || async {
+                    self.connects.fetch_add(1, Ordering::SeqCst);
+                    self.connect_answers.lock().unwrap().remove(0)
+                },
+                || async {
+                    self.requests.fetch_add(1, Ordering::SeqCst);
+                    self.request_answers.lock().unwrap().remove(0)
