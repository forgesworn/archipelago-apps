+    /// Sign through the remote signer, de-duplicated on `digest`. `make`
+    /// builds the event from the identity's key when the request first runs;
+    /// `expected_pubkey`, if given, must be that key.
+    async fn remote_sign<F>(
+        &self,
+        id: &str,
+        digest: String,
+        expected_pubkey: Option<nostr_sdk::PublicKey>,
+        make: F,
+    ) -> Result<nostr_sdk::Event>
+    where
+        F: FnOnce(nostr_sdk::PublicKey) -> nostr_sdk::UnsignedEvent + Send + 'static,
+    {
+        let linked = self
+            .linked_signer(id)
+            .await?
+            .ok_or_else(|| anyhow::anyhow!("Identity is not linked to a remote signer"))?;
+        let user_pubkey = nostr_sdk::PublicKey::from_hex(&linked.user_pubkey)
+            .context("Invalid linked signer user key")?;
+        if expected_pubkey.is_some_and(|pk| pk != user_pubkey) {
+            anyhow::bail!("Invalid event: its pubkey is not this identity's Nostr key");
+        }
+        let signer = self.remote_signers.open(id, &linked)?;
+        let key = RequestKey {
+            identity_id: id.to_string(),
+            method: "sign_event",
+            digest,
+        };
+        let reply = self
+            .remote_requests
+            .run(key, async move {
+                let unsigned = make(user_pubkey);
+                let signed = signer.sign_event(unsigned.clone()).await?;
+                verify_remote_event(&user_pubkey, &unsigned, &signed)?;
+                Ok(RemoteReply::Event(Box::new(signed)))
+            })
+            .await?;
+        match reply {
+            RemoteReply::Event(event) => Ok(*event),
+            RemoteReply::Text(_) => anyhow::bail!("linked signer sent a bad response"),
+        }
+    }
+
+    /// Run a NIP-04/NIP-44 operation on a linked identity's remote signer,
+    /// de-duplicated on the peer and text.
+    async fn remote_cipher(
+        &self,
+        id: &str,
+        linked: LinkedSigner,
+        op: CipherOp,
+        peer_pubkey_hex: &str,
+        text: &str,
+    ) -> Result<String> {
+        let peer_pk =
+            nostr_sdk::PublicKey::from_hex(peer_pubkey_hex).context("Invalid peer pubkey hex")?;
+        let digest = {
+            use sha2::{Digest, Sha256};
+            let mut hasher = Sha256::new();
+            hasher.update(peer_pk.to_hex().as_bytes());
+            hasher.update(b"\n");
+            hasher.update(text.as_bytes());
+            hex::encode(hasher.finalize())
+        };
+        let signer = self.remote_signers.open(id, &linked)?;
+        let key = RequestKey {
+            identity_id: id.to_string(),
+            method: op.method(),
+            digest,
+        };
+        let text = text.to_string();
+        let reply = self
+            .remote_requests
+            .run(key, async move {
+                let out = op.apply(signer.as_ref(), &peer_pk, &text).await?;
+                Ok(RemoteReply::Text(out))
+            })
+            .await?;
+        match reply {
+            RemoteReply::Text(out) => Ok(out),
+            RemoteReply::Event(_) => anyhow::bail!("linked signer sent a bad response"),
+        }
+    }
