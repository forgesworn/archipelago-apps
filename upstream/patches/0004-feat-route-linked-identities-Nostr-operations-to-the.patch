+
+    async fn nip44_decrypt(
+        &self,
+        peer: &PublicKey,
+        ciphertext: &str,
+    ) -> Result<String, RemoteSignerError> {
+        self.watched(self.inner.nip44_decrypt(peer, ciphertext))
+            .await
+    }
