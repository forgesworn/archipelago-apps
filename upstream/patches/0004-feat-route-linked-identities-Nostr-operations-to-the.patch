+        // Re-linking under the same id opens a fresh session.
+        let relinked = linked("2026-10-04T00:00:00Z");
+        assert!(sign_through(&sessions, "id-1", &relinked).await);
+        assert_eq!(opened.load(Ordering::SeqCst), 3);
