+/// How long a `nostrconnect://` pairing waits for the signer.
+pub const PAIRING_TTL: Duration = Duration::from_secs(5 * 60);
+/// How long a proof that started before [`PAIRING_TTL`] ran out may still
+/// take. Its own requests are bounded well within this; it is a backstop.
+pub const PROOF_ALLOWANCE: Duration = Duration::from_secs(3 * 60);
+/// How long a settled pairing keeps answering `finish` with its outcome, so a
+/// poll whose response was lost can ask again.
+pub const OUTCOME_GRACE: Duration = Duration::from_secs(60);
+/// The most pairings waiting at once.
+pub const MAX_PAIRINGS: usize = 4;
+/// The longest one `finish` call waits before answering `pending`, below the
+/// dashboard RPC client's 15 s timeout.
+pub const FINISH_WAIT: Duration = Duration::from_secs(10);
+/// Permissions requested in a `nostrconnect://` link.
+const PAIRING_PERMS: &str = "sign_event,nip44_encrypt,nip44_decrypt,nip04_encrypt,nip04_decrypt";
+
+/// Build the `nostrconnect://` link a signer scans to pair with
+/// `client_pubkey`.
+pub fn nostrconnect_uri(client_pubkey: &PublicKey, relays: &[RelayUrl], secret: &str) -> String {
+    let mut url = reqwest::Url::parse(&format!("nostrconnect://{}", client_pubkey.to_hex()))
+        .expect("a hex public key is a valid host");
+    {
+        let mut query = url.query_pairs_mut();
+        for relay in relays {
+            query.append_pair("relay", relay.as_str());
+        }
+        query
+            .append_pair("secret", secret)
+            .append_pair("name", "Archipelago")
+            .append_pair("perms", PAIRING_PERMS);
+    }
+    url.to_string()
+}
+
+/// The signer's key if `event` is its `connect` response to our
+/// `nostrconnect://` link: a NIP-46 response to `client_keys` whose result
+/// is `secret`. Anyone can publish to the relay, so anything else is `None`.
+pub fn pairing_response(client_keys: &Keys, event: &Event, secret: &str) -> Option<PublicKey> {
+    // Checked before decryption, as in `reply_to`: the author we return
+    // becomes the identity's remote signer.
+    if event.kind != Kind::NostrConnect || event.verify().is_err() {
+        return None;
+    }
+    let secret_key = client_keys.secret_key();
+    let json = nostr_sdk::nips::nip44::decrypt(secret_key, &event.pubkey, &event.content)
+        .ok()
+        .or_else(|| {
+            nostr_sdk::nips::nip04::decrypt(secret_key, &event.pubkey, &event.content).ok()
+        })?;
+    match NostrConnectMessage::from_json(json) {
+        Ok(NostrConnectMessage::Response {
+            result: Some(result),
+            ..
+        }) if result == secret => Some(event.pubkey),
+        _ => None,
+    }
+}
+
+/// The relay side of `nostrconnect://` pairing. A seam so tests can swap
+/// the network for a fake.
+#[async_trait]
+pub trait PairingTransport: Send + Sync {
+    /// Wait for the signer's `connect` response carrying `secret`; returns
+    /// the remote-signer key (its author). Runs until it arrives.
+    async fn wait_for_signer(
+        &self,
+        client_keys: &Keys,
+        relays: &[RelayUrl],
+        secret: &str,
+    ) -> Result<PublicKey, RemoteSignerError>;
+    /// A signer session for the client key the signer just paired with.
+    fn signer(
+        &self,
+        client_keys: Keys,
+        remote_signer_pubkey: PublicKey,
+        relays: Vec<RelayUrl>,
+    ) -> Arc<dyn RemoteSigner>;
+}
+
+/// The real pairing transport: NIP-46 over the given relays.
+pub struct NostrConnectPairing;
+
+/// A random 16-byte token as hex, drawn through the KEY-05 entropy guard:
+/// whoever holds a pairing secret can pair a signer to this node.
+pub(crate) fn random_token() -> Result<String> {
+    let mut bytes = [0u8; 16];
+    crate::entropy::draw_key_bytes(&mut OsRng, &mut bytes).map_err(|e| {
+        anyhow::anyhow!("refusing to mint a pairing token from degenerate entropy: {e}")
+    })?;
+    Ok(hex::encode(bytes))
+}
+
+#[async_trait]
+impl PairingTransport for NostrConnectPairing {
+    async fn wait_for_signer(
+        &self,
+        client_keys: &Keys,
+        relays: &[RelayUrl],
+        secret: &str,
+    ) -> Result<PublicKey, RemoteSignerError> {
+        let offline = || {
+            let list: Vec<String> = relays.iter().map(|r| r.to_string()).collect();
+            RemoteSignerError::Offline(list.join(", "))
+        };
+        let client = ShutdownGuard::new(Client::new(client_keys.clone()));
+        for relay in relays {
+            client
+                .client()
+                .add_relay(relay.clone())
+                .await
+                .map_err(|_| offline())?;
+        }
+        if client
+            .client()
+            .try_connect(CONNECT_TIMEOUT)
+            .await
+            .success
+            .is_empty()
+        {
+            return Err(offline());
+        }
+        let filter = Filter::new()
+            .kind(Kind::NostrConnect)
+            .pubkey(client_keys.public_key());
+        let started = Timestamp::now();
+        let mut notifications = client.client().notifications();
+        let subscribed = client
+            .client()
+            .subscribe(filter.clone().limit(0), None)
+            .await;
+        if !subscribed.is_ok_and(|out| !out.success.is_empty()) {
+            return Err(offline());
+        }
+        loop {
+            match notifications.recv().await {
+                Ok(RelayPoolNotification::Event { event, .. }) => {
+                    if let Some(pubkey) = pairing_response(client_keys, &event, secret) {
+                        return Ok(pubkey);
+                    }
+                }
+                Ok(_) => {}
+                // Notifications were dropped: look on the relays instead.
+                Err(RecvError::Lagged(_)) => {
+                    let since = filter.clone().since(started - LAG_LOOKBACK);
+                    if let Ok(events) = client.client().fetch_events(since, CONNECT_TIMEOUT).await {
+                        if let Some(pubkey) = events
+                            .iter()
+                            .find_map(|e| pairing_response(client_keys, e, secret))
+                        {
+                            return Ok(pubkey);
+                        }
+                    }
+                }
+                Err(RecvError::Closed) => return Err(offline()),
+            }
+        }
+    }
+
+    fn signer(
+        &self,
+        client_keys: Keys,
+        remote_signer_pubkey: PublicKey,
+        relays: Vec<RelayUrl>,
+    ) -> Arc<dyn RemoteSigner> {
+        Arc::new(NostrConnectSigner::paired(
+            client_keys,
+            remote_signer_pubkey,
+            relays,
+        ))
+    }
+}
+
+/// Where a pairing has got to.
+#[derive(Debug, Clone)]
+pub enum PairingState {
+    /// Waiting for the signer to scan the link and answer.
+    Waiting,
+    /// The signer answered; its key is being proven.
+    Proving,
+    Linked(Box<IdentityRecord>),
+    Failed(String),
+}
+
+struct Pairing {
+    state: tokio::sync::watch::Receiver<PairingState>,
+}
+
+fn settled(state: &PairingState) -> bool {
+    matches!(state, PairingState::Linked(_) | PairingState::Failed(_))
+}
+
+/// Pairings waiting on a `nostrconnect://` link, each with a task that
+/// listens for the signer and then links the identity. The signer has
+/// [`PAIRING_TTL`] to answer; a proof under way then runs to completion. A
+/// settled pairing is kept for [`OUTCOME_GRACE`] so `finish` can report it
+/// again, then removed. At most [`MAX_PAIRINGS`] unsettled pairings run at
+/// once.
+#[derive(Default)]
+pub struct Pairings {
+    pending: Mutex<HashMap<String, Pairing>>,
+}
+
+impl Pairings {
+    /// The process-wide pairings.
+    pub fn global() -> Arc<Self> {
+        static GLOBAL: OnceLock<Arc<Pairings>> = OnceLock::new();
+        Arc::clone(GLOBAL.get_or_init(|| Arc::new(Self::default())))
+    }
+
+    /// Start a pairing that runs `work` until it settles. `work` is given
+    /// the sender to report progress through and the deadline for the signer
+    /// to answer ([`PAIRING_TTL`] from now); a proof already running at that
+    /// deadline is left to finish. Returns the pairing id.
+    pub fn start<F, Fut>(self: &Arc<Self>, work: F) -> Result<String>
+    where
+        F: FnOnce(tokio::sync::watch::Sender<PairingState>, Instant) -> Fut,
+        Fut: Future<Output = ()> + Send + 'static,
+    {
+        let mut pending = lock(&self.pending);
+        let unsettled = pending
+            .values()
+            .filter(|p| !settled(&p.state.borrow()))
+            .count();
+        if unsettled >= MAX_PAIRINGS {
+            anyhow::bail!(
+                "linked signer pairings are at their limit of {MAX_PAIRINGS}; finish one or wait for it to expire"
+            );
+        }
+        let id = random_token()?;
+        let (state_tx, state_rx) = tokio::sync::watch::channel(PairingState::Waiting);
+        let listen_until = Instant::now() + PAIRING_TTL;
+        let work = work(state_tx, listen_until);
+        let pairings = Arc::clone(self);
+        let task_id = id.clone();
+        tokio::spawn(async move {
+            let _ = tokio::time::timeout_at(listen_until + PROOF_ALLOWANCE, work).await;
+            tokio::time::sleep(OUTCOME_GRACE).await;
+            lock(&pairings.pending).remove(&task_id);
+        });
+        pending.insert(id.clone(), Pairing { state: state_rx });
+        Ok(id)
+    }
+
+    /// Wait up to [`FINISH_WAIT`] for the pairing to settle: `Ok(None)` while
+    /// it is still waiting or proving, the new identity once linked, and an
+    /// error if it failed, expired or never existed. A settled pairing gives
+    /// the same answer to every poll for [`OUTCOME_GRACE`].
+    pub async fn finish(&self, id: &str) -> Result<Option<IdentityRecord>> {
+        let gone = || anyhow::anyhow!("linked signer pairing is unknown or has expired");
+        let mut state = lock(&self.pending)
+            .get(id)
+            .map(|p| p.state.clone())
+            .ok_or_else(gone)?;
+        let outcome = match tokio::time::timeout(FINISH_WAIT, state.wait_for(settled)).await {
+            Err(_) => return Ok(None),
+            // The pairing's task ended without an outcome.
+            Ok(Err(_)) => return Err(gone()),
+            Ok(Ok(outcome)) => outcome.clone(),
+        };
+        match outcome {
+            PairingState::Linked(record) => Ok(Some(*record)),
+            PairingState::Failed(message) => Err(anyhow::anyhow!(message)),
+            PairingState::Waiting | PairingState::Proving => Ok(None),
+        }
+    }
+
+    #[cfg(test)]
+    pub fn len(&self) -> usize {
+        lock(&self.pending).len()
+    }
+}
