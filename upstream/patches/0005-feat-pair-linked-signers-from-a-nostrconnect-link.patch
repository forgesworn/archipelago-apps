+    /// Start pairing a new linked identity from a `nostrconnect://` link.
+    ///
+    /// Generates a client key and secret, and spawns a listener on `relays`
+    /// for the signer's `connect` response. When it arrives, the signer's key
+    /// goes through the same proof and duplicate checks as a `bunker://`
+    /// link ([`Self::create_linked`]), with no secret to keep. Returns the
+    /// pairing id and the link to show the signer; poll
+    /// [`Pairings::finish`] for the outcome.
+    pub fn start_nostrconnect_pairing(
+        self: &Arc<Self>,
+        pairings: &Arc<Pairings>,
+        transport: Arc<dyn PairingTransport>,
+        name: String,
+        purpose: IdentityPurpose,
+        relays: Vec<nostr_sdk::RelayUrl>,
+        node_nostr_pubkey: Option<String>,
+    ) -> Result<(String, String)> {
+        let client_keys = nostr_sdk::Keys::generate();
+        let secret = random_token()?;
+        let uri = nostrconnect_uri(&client_keys.public_key(), &relays, &secret);
+
+        let manager = Arc::clone(self);
+        let pairing_id = pairings.start(move |state, listen_until| async move {
+            let outcome = async {
+                let remote_signer_pubkey = tokio::time::timeout_at(
+                    listen_until,
+                    transport.wait_for_signer(&client_keys, &relays, &secret),
+                )
+                .await
+                .map_err(|_| {
+                    anyhow::anyhow!(
+                        "linked signer pairing expired: no signer answered within 5 minutes"
+                    )
+                })??;
+                // From here the proof runs to completion, past the deadline
+                // if need be: its own requests are bounded.
+                state.send_replace(PairingState::Proving);
+                let signer =
+                    transport.signer(client_keys.clone(), remote_signer_pubkey, relays.clone());
+                let target = BunkerUri {
+                    remote_signer_pubkey,
+                    relays,
+                    secret: None,
+                };
+                manager
+                    .create_linked(
+                        name,
+                        purpose,
+                        &target,
+                        &client_keys,
+                        signer.as_ref(),
+                        node_nostr_pubkey.as_deref(),
+                    )
+                    .await
+            }
+            .await;
+            state.send_replace(match outcome {
+                Ok(record) => PairingState::Linked(Box::new(record)),
+                Err(e) => PairingState::Failed(e.to_string()),
+            });
+        })?;
+        Ok((pairing_id, uri))
+    }
+
