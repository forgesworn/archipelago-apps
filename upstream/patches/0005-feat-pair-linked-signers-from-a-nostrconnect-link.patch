+    #[test]
+    fn pairing_relays_are_one_to_eight_websocket_urls() {
+        let relays = |n: usize| {
+            let list: Vec<String> = (0..n)
+                .map(|i| format!("wss://relay{i}.example.com"))
+                .collect();
+            serde_json::json!({ "relays": list })
+        };
+        assert_eq!(pairing_relays(&relays(1)).unwrap().len(), 1);
+        assert_eq!(
+            pairing_relays(&relays(MAX_RELAYS)).unwrap().len(),
+            MAX_RELAYS
+        );
+        assert_eq!(
+            pairing_relays(&relays(MAX_RELAYS + 1))
+                .unwrap_err()
+                .to_string(),
+            "Invalid relays: at most 8"
+        );
+        assert_eq!(
+            pairing_relays(&relays(0)).unwrap_err().to_string(),
+            "Missing required parameter: relays"
+        );
+        assert!(
+            pairing_relays(&serde_json::json!({ "relays": ["https://relay.example.com"] }))
+                .unwrap_err()
+                .to_string()
+                .starts_with("Invalid relay")
+        );
+    }
+}
