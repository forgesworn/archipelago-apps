+/// `name` (required, at most 100 characters) and `purpose` (default
+/// personal) for the link methods.
+fn link_name_and_purpose(params: &serde_json::Value) -> Result<(String, IdentityPurpose)> {
+    let name = params
+        .get("name")
+        .and_then(|v| v.as_str())
+        .map(str::trim)
+        .filter(|n| !n.is_empty())
+        .ok_or_else(|| anyhow::anyhow!("Missing required parameter: name"))?;
+    if name.len() > 100 {
+        anyhow::bail!("Identity name must be 100 characters or fewer");
+    }
+    let purpose = match params.get("purpose").and_then(|v| v.as_str()) {
+        Some("business") => IdentityPurpose::Business,
+        Some("anonymous") => IdentityPurpose::Anonymous,
+        _ => IdentityPurpose::Personal,
+    };
+    Ok((name.to_string(), purpose))
+}
+
+/// A newly linked identity, in the shape `identity.get` uses.
+fn linked_identity_json(record: &IdentityRecord) -> serde_json::Value {
+    serde_json::json!({
+        "id": record.id,
+        "name": record.name,
+        "purpose": record.purpose,
+        "pubkey": record.pubkey_hex,
+        "did": record.did,
+        "created_at": record.created_at,
+        "nostr_pubkey": record.nostr_pubkey,
+        "nostr_npub": record.nostr_npub,
+        "profile": record.profile,
+        "origin": record.origin,
+        "signer": record.signer,
+    })
+}
+
+/// The `relays` for a `nostrconnect://` pairing: one to [`MAX_RELAYS`]
+/// `ws(s)://` URLs.
+fn pairing_relays(params: &serde_json::Value) -> Result<Vec<nostr_sdk::RelayUrl>> {
+    let relays = params
+        .get("relays")
+        .and_then(|v| v.as_array())
+        .filter(|r| !r.is_empty())
+        .ok_or_else(|| anyhow::anyhow!("Missing required parameter: relays"))?;
+    if relays.len() > MAX_RELAYS {
+        anyhow::bail!("Invalid relays: at most {MAX_RELAYS}");
+    }
+    relays
+        .iter()
+        .map(|r| {
+            r.as_str()
+                .and_then(|r| nostr_sdk::RelayUrl::parse(r).ok())
+                .ok_or_else(|| {
+                    anyhow::anyhow!("Invalid relay {}: expected a ws:// or wss:// URL", r)
+                })
+        })
+        .collect()
+}
