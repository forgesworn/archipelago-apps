+    /// Nostr public keys of the identities the app identity picker offers, for
+    /// the `{{NODE_IDENTITY_PUBKEYS}}` derived-env placeholder. The node
+    /// identity is recognised the way `identity.list` marks `is_node`: by the
+    /// node key loaded at startup into `server_info.pubkey`. An empty set is
+    /// an error, so an app is never handed an empty owner list.
+    async fn node_identity_pubkeys(&self) -> Result<String> {
+        let node =
+            crate::identity::NodeIdentity::load_or_create(&self.data_dir.join("identity")).await?;
+        let pubkeys = crate::identity_manager::IdentityManager::new(&self.data_dir)
+            .await?
+            .app_signable_nostr_pubkeys(&node.pubkey_hex())
+            .await?;
+        anyhow::ensure!(
+            !pubkeys.is_empty(),
+            "no node identity with a Nostr key is available for apps to sign with"
+        );
+        Ok(pubkeys)
+    }
