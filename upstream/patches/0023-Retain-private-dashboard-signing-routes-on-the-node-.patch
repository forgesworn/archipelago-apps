-               f'    if ($host != {host}) {{ return 421; }}\n'
-               '    add_header Referrer-Policy no-referrer always;\n')
+    public += f'map $ssl_server_name $archy_node_sni {{ hostnames; default 0; {host} 1; }}\n'
     common = ('        if ($args != "") { return 404; }\n'
+              '        client_max_body_size 64k;\n        client_body_timeout 10s;\n'
               '        proxy_http_version 1.1;\n        proxy_connect_timeout 5s;\n'
               '        proxy_read_timeout 75s;\n        proxy_send_timeout 15s;\n'
               '        proxy_buffering off;\n        proxy_request_buffering on;\n'
@@ -147,10 +139,33 @@ def plan(text, host, certificate, key):
               '        proxy_set_header Proxy-Authorization "";\n'
               '        proxy_set_header X-Forwarded-For $remote_addr;\n'
               '        proxy_set_header X-Forwarded-Proto https;\n'
-              '        proxy_hide_header Set-Cookie;\n        proxy_hide_header Proxy-Authenticate;\n')
+              '        proxy_hide_header Set-Cookie;\n        proxy_hide_header Proxy-Authenticate;\n'
+              '        proxy_hide_header Referrer-Policy;\n        add_header Referrer-Policy no-referrer always;\n'
+              '        add_header X-Content-Type-Options nosniff always;\n')
     paths = {'/node/v1/info': 3750, '/node/v1/status': 3750, '/node/v1/claim': 3750,
              '/node/v1/enrol': 3750, '/node/v1/access': 3750, '/node/v1/close': 3750,
              '/node/v1/operation': 3750, '/groups/v1/events': 3750, '/v1/credentials': 3751, '/events': 3752}
+    public += ('map "$archy_management_private_source:$archy_management_private_client:$archy_management_public_ingress:$uri" $archy_node_management_denied {\n'
+               '    default 1;\n    ~^1:1:0: 0;\n')
+    for path in paths:
+        public += '    "~^[01]:[01]:[01]:' + re.escape(path) + '$" 0;\n'
+    public += '}\n'
+    # Keep the exact dashboard, signing-frame and app proxy routes for private
+    # owner clients. Public requests get only the explicit node exceptions.
+    dashboard = LISTEN.sub('', block)
+    dashboard = dashboard.replace('    server_name _;', f'    server_name {host};', 1)
+    dashboard = dashboard.replace('ssl_certificate /etc/archipelago/ssl/archipelago.crt;', f'ssl_certificate {certificate};', 1)
+    dashboard = dashboard.replace('ssl_certificate_key /etc/archipelago/ssl/archipelago.key;', f'ssl_certificate_key {key};', 1)
+    if dashboard.count('if ($archy_management_denied) { return 404; }') != 1:
+        raise ValueError('Expected the managed dashboard source guard')
+    dashboard = dashboard.replace('if ($archy_management_denied)', 'if ($archy_node_management_denied)', 1)
+    dashboard = dashboard.replace('server {', 'server {\n' +
+        f'    listen unix:{SOCKET} ssl proxy_protocol;\n'
+        '    set_real_ip_from unix:;\n    real_ip_header proxy_protocol;\n'
+        '    access_log off;\n    error_log /dev/null crit;\n'
+        '    if ($archy_node_sni = 0) { return 421; }\n'
+        f'    if ($host != {host}) {{ return 421; }}\n', 1)
+    public += dashboard[:dashboard.rfind('}')]
     for path, port in paths.items():
         public += f'    location = {path} {{\n' + (common.replace('proxy_read_timeout 75s;', 'proxy_read_timeout 1h;') if path == '/events' else common)
         if path == '/events':
@@ -161,7 +176,7 @@ def plan(text, host, certificate, key):
         else:
             public += '        proxy_set_header Connection "";\n'
         public += f'        proxy_pass http://127.0.0.1:{port};\n    }}\n'
-    public += '    location / { return 404; }\n}\n'
+    public += '}\n'
     return {'site': updated.encode(), 'stream': stream.encode(), 'public': public.encode(), 'addresses': addresses,
             'tmpfiles': (MARK + f'd {RUNTIME} 0750 root www-data -\n').encode()}
 
